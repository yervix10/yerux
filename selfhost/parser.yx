// Source parser over the token rows emitted by lexer.yx.
import std.env
import std.fs

struct Token { kind: String, value: String, text: String, line: Int, col: Int }
struct Parser {
  tokens: List<Token>,
  structs: List<String>,
  imports: List<String>,
  tuple_arities: List<Int>,
  i: Int,
  failed: Bool,
  error_line: Int,
  legacy: Bool,
  build: Bool,
  depth: Int,
  // the first bare `match` arm of the statement being read (token index + 1; 0: none)
  bare_at: Int,
  // the first diagnostic of the parse, worded like the Rust compiler (build mode prints it)
  message: String,
  notes: List<String>,
  err_line: Int,
  err_col: Int,
  err_len: Int,
}

fn hex(s: view String) -> String {
  let digits = String.from("0123456789abcdef")
  var out = String.new()
  for i in 0..s.len() {
    let b = s.byte(i)
    out.push_byte(digits.byte(b / 16))
    out.push_byte(digits.byte(b % 16))
  }
  return out
}

fn nibble(b: Int) -> Int {
  if b >= 97 { return b - 87 }
  return b - 48
}

fn unhex(s: view String) -> String {
  var out = String.new()
  for i in 0..s.len() / 2 {
    out.push_byte(nibble(s.byte(i * 2)) * 16 + nibble(s.byte(i * 2 + 1)))
  }
  return out
}

fn current(p: view Parser, offset: Int) -> Int {
  return min(p.i + offset, p.tokens.len() - 1)
}

fn kind(p: view Parser, k: Text) -> Bool {
  return p.tokens.at(p.i).kind == k
}

fn sym_at(p: view Parser, offset: Int, s: Text) -> Bool {
  let i = current(p, offset)
  return p.tokens.at(i).kind == "Sym" && p.tokens.at(i).text == s
}

fn kw_at(p: view Parser, offset: Int, s: Text) -> Bool {
  let i = current(p, offset)
  return p.tokens.at(i).kind == "Id" && p.tokens.at(i).text == s
}

fn sym(p: view Parser, s: Text) -> Bool { return sym_at(p, 0, s) }
fn kw(p: view Parser, s: Text) -> Bool { return kw_at(p, 0, s) }

fn reserved(n: view String) -> Bool {
  return n == "fn" || n == "let" || n == "var" || n == "if" || n == "else" ||
    n == "while" || n == "return" || n == "move" || n == "view" || n == "mut" ||
    n == "true" || n == "false" || n == "struct" || n == "enum" || n == "match" ||
    n == "defer" || n == "trait" || n == "dyn" || n == "impl" || n == "for" ||
    n == "in" || n == "break" || n == "continue" || n == "unsafe" ||
    n == "spawn" || n == "parallel" || n == "scope"
}

fn is_name(p: view Parser, offset: Int) -> Bool {
  let i = current(p, offset)
  return p.tokens.at(i).kind == "Id" && !reserved(p.tokens.at(i).text)
}

fn bump(p: mut Parser) -> String {
  let value = String.from(p.tokens.at(p.i).value)
  if !kind(p, "Eof") { p.i = p.i + 1 }
  return value
}

fn eat(p: mut Parser, s: Text) -> Bool {
  if !sym(p, s) { return false }
  p.i = p.i + 1
  return true
}

fn eat_kw(p: mut Parser, s: Text) -> Bool {
  if !kw(p, s) { return false }
  p.i = p.i + 1
  return true
}

// Length of token `at` for the underline; 0 leaves literals for the driver to measure in the source.
fn token_len(p: view Parser, at: Int) -> Int {
  let k = p.tokens.at(at).kind.slice(0, p.tokens.at(at).kind.len())
  if k == "Id" || k == "Sym" { return p.tokens.at(at).text.len() }
  if k == "Eof" { return 1 }
  return 0
}

// Fail at token `at` with `message`. Only the first failure counts (true when this one is it).
fn fail_at(p: mut Parser, at: Int, message: view String) -> Bool {
  if p.failed { return false }
  p.failed = true
  p.message = String.from(message)
  // the end of the file is reported at its last token, like the Rust compiler
  var shown = at
  if shown > 0 && p.tokens.at(shown).kind == "Eof" { shown = shown - 1 }
  p.err_line = p.tokens.at(shown).line
  p.err_col = p.tokens.at(shown).col
  p.err_len = token_len(p, shown)
  return true
}

fn fail(p: mut Parser, message: view String) -> Bool { return fail_at(p, p.i, message) }

// `fail_at` with a span from token `from` to token `to`
fn fail_span(p: mut Parser, from: Int, to: Int, message: view String) -> Bool {
  if !fail_at(p, from, message) { return false }
  if p.tokens.at(from).line == p.tokens.at(to).line && p.tokens.at(to).col >= p.tokens.at(from).col {
    p.err_len = p.tokens.at(to).col + token_len(p, to) - p.tokens.at(from).col
  }
  return true
}

fn note(p: mut Parser, text: view String) { p.notes.push(String.from(text)) }

fn expect(p: mut Parser, s: Text) {
  if !eat(p, s) { let first = fail(p, "expected '{s}'") }
}

fn ident(p: mut Parser) -> String {
  if !is_name(p, 0) { let first = fail(p, "expected a name"); return String.new() }
  return bump(p)
}

// Whether a list ends here. At the end of the file the next element is read anyway and reports what it expected.
fn at_close(p: view Parser, close: Text) -> Bool {
  return p.failed || sym(p, close)
}

fn same_line(p: view Parser) -> Bool {
  return p.i > 0 && p.tokens.at(p.i - 1).line == p.tokens.at(p.i).line
}

fn node1(tag: Text, a: view String) -> String { return "{tag}({a})" }
fn node2(tag: Text, a: view String, b: view String) -> String { return "{tag}({a},{b})" }
fn node3(tag: Text, a: view String, b: view String, c: view String) -> String { return "{tag}({a},{b},{c})" }
fn missing() -> String { return String.from("_") }
fn empty_list() -> String { return String.from("[]") }

fn append(out: mut String, item: view String) {
  if out.len() > 1 { out.push_str(",") }
  out.push_str(item)
}

fn finish(out: mut String) { out.push_str("]") }

fn unary(p: view Parser, op: view String, value: view String) -> String {
  if p.legacy { return "Un({op}, {value})" }
  return node2("Un", op, value)
}

// `,Pos(line,col)` of token `at` when building with columns (the driver): where a panic of that node is reported
fn pos_of(p: view Parser, at: Int) -> String {
  if !p.build || p.tokens.at(at).col == 0 { return String.new() }
  var size = p.tokens.at(at).value.len() / 2
  if p.tokens.at(at).kind == "Num" { size = p.tokens.at(at).value.len() }
  if p.tokens.at(at).kind == "Str" { size = size + 2 }
  return ",Pos({p.tokens.at(at).line},{p.tokens.at(at).col},{size})"
}

// `node` with the position of token `at` as its last child (columns mode only): diagnostics point there
fn positioned(p: view Parser, node: String, at: Int) -> String {
  if !p.build || p.tokens.at(at).col == 0 { return node }
  let mark = pos_of(p, at)
  return "{node.slice(0, node.len() - 1)}{mark})"
}

fn call(p: view Parser, name: view String, args: view String) -> String {
  if p.legacy { return "Call({name}, {args})" }
  return node2("Call", name, args)
}

fn path_tail(p: mut Parser, path: mut String) {
  while sym(p, ".") && is_name(p, 1) {
    p.i = p.i + 1
    path.push_str("2e")
    let segment = ident(p)
    path.push_str(segment)
  }
}

fn path(p: mut Parser) -> String {
  var out = ident(p)
  path_tail(p, out)
  return out
}

fn mode(p: mut Parser) -> String {
  if eat_kw(p, "view") { return String.from("View") }
  if eat_kw(p, "mut") { return String.from("Mut") }
  return String.from("Own")
}

fn length(p: mut Parser) -> String {
  if kind(p, "Num") { return node1("Int", bump(p)) }
  let first = ident(p)
  // `module.CONST`
  if sym(p, ".") && is_name(p, 1) {
    p.i = p.i + 1
    return node2("Field", node1("Var", first), ident(p))
  }
  return node1("Var", first)
}

fn bad_bound(p: mut Parser) {
  if fail(p, "range bounds must be integer constants") {
    note(p, "help: write the bounds as literals, e.g. `Int<0..255>`; the bounds are inclusive")
  }
}

fn int_bound(p: mut Parser) -> String {
  let neg = eat(p, "-")
  var value = String.new()
  if kind(p, "Num") { value = bump(p) }
  else if kind(p, "NumT") {
    let raw = bump(p)
    if raw.byte(raw.len() - 1) == 58 { value = raw.slice(0, raw.len() - 1) }
    else { p.i = p.i - 1; bad_bound(p) }
  } else { bad_bound(p) }
  if neg { return "-{value}" }
  return value
}

fn type_args(p: mut Parser, name: view String) -> String {
  var name_at = p.i
  if name_at > 0 { name_at = name_at - 1 }
  if !eat(p, "<") { return empty_list() }
  if name == "496e74" {
    var lo = missing()
    var hi = missing()
    if !sym(p, "..") { lo = int_bound(p) }
    expect(p, "..")
    if !sym(p, ">") { hi = int_bound(p) }
    expect(p, ">")
    var low = 0
    var high = 0
    if p.build && lo.parse_int(low) && hi.parse_int(high) && low > high {
      if fail_at(p, name_at, "empty integer range {low}..{high}") {
        note(p, "the bounds of `Int<lo..hi>` are inclusive and `lo` must not exceed `hi`")
      }
    }
    return "[Range({lo},{hi})]"
  }
  return types(p, ">")
}

fn types(p: mut Parser, close: Text) -> String {
  var count = 0
  return counted_types(p, close, count)
}

fn counted_types(p: mut Parser, close: Text, count: mut Int) -> String {
  var items = String.from("[")
  while !at_close(p, close) {
    let item = parse_type(p)
    append(items, item)
    count = count + 1
    if !eat(p, ",") { break }
  }
  expect(p, close)
  finish(items)
  return items
}

fn tuple_name(p: mut Parser, count: Int) -> String {
  if !p.build { return hex("Tuple{count}") }
  if !p.tuple_arities.contains(count) { p.tuple_arities.push(count) }
  return hex("$tuple{count}")
}

fn tuple_type(p: mut Parser) -> String {
  let open = p.i - 1
  var count = 0
  let items = counted_types(p, ")", count)
  if !p.build { return node1("TupleType", items) }
  if count < 2 || count > 6 {
    if fail_span(p, open, p.i - 1, "a tuple type has 2 to 6 elements, this one has {count}") {
      note(p, "help: for more elements, define a struct with named fields")
    }
    return String.new()
  }
  let name = tuple_name(p, count)
  return node2("Type", name, items)
}

fn return_type(p: mut Parser) -> String {
  if eat(p, "->") { return parse_type(p) }
  return missing()
}

fn parse_type(p: mut Parser) -> String {
  if p.failed || !enter(p) { return String.new() }
  let value = type_inner(p)
  p.depth = p.depth - 1
  return value
}

fn type_inner(p: mut Parser) -> String {
  if eat_kw(p, "fn") {
    expect(p, "(")
    var params = String.from("[")
    while !at_close(p, ")") {
      let m = mode(p)
      let t = parse_type(p)
      append(params, node2("TypeParam", m, t))
      if !eat(p, ",") { break }
    }
    expect(p, ")")
    finish(params)
    return node2("FnType", params, return_type(p))
  }
  if eat_kw(p, "dyn") { return node1("DynType", path(p)) }
  if eat(p, "[") {
    let item = parse_type(p)
    var len = missing()
    if eat(p, ";") { len = length(p) }
    else if !sym(p, "]") && fail(p, "expected `;` or `]` in an array type") {
      note(p, "help: `[Int; 4]` is an array of 4 Ints, `view [Int]` a slice parameter")
    }
    expect(p, "]")
    return node2("BracketType", item, len)
  }
  if eat(p, "(") { return tuple_type(p) }
  let name = path(p)
  return node2("Type", name, type_args(p, name))
}

fn precedence(p: view Parser) -> Int {
  if sym(p, "||") { return 1 }
  if sym(p, "&&") { return 2 }
  if sym(p, "==") || sym(p, "!=") { return 3 }
  if sym(p, "<") || sym(p, ">") || sym(p, "<=") || sym(p, ">=") { return 4 }
  if sym(p, "+") || sym(p, "-") { return 5 }
  if sym(p, "*") || sym(p, "/") || sym(p, "%") { return 6 }
  return 0
}

fn args(p: mut Parser) -> String {
  expect(p, "(")
  var out = String.from("[")
  while !at_close(p, ")") {
    let arg = parse_expr(p)
    append(out, arg)
    if !eat(p, ",") { break }
  }
  expect(p, ")")
  finish(out)
  return out
}

fn fields(p: mut Parser) -> String {
  expect(p, "{{")
  var out = String.from("[")
  while !at_close(p, "}}") {
    let field = ident(p)
    if sym(p, ",") || sym(p, "}}") {
      append(out, node2("FieldInit", field, node1("Var", field)))
    } else {
      expect(p, ":")
      append(out, node2("FieldInit", field, parse_expr(p)))
    }
    if !eat(p, ",") { break }
  }
  expect(p, "}}")
  finish(out)
  return out
}

fn uppercase(s: view String) -> Bool {
  if s.len() == 0 { return false }
  let b = s.byte(0)
  return b >= 65 && b <= 90
}

fn constructor_name(p: view Parser, start: Int, end: Int) -> Bool {
  if start == end { return p.structs.contains(p.tokens.at(start - 1).value) }
  // An imported constructor can have a single module qualifier.
  return end == start + 2 && p.imports.contains(p.tokens.at(start - 1).value) &&
    uppercase(p.tokens.at(end - 1).text)
}

fn after_name(p: mut Parser, name: view String) -> String {
  let start = p.i
  var full_path = String.from(name)
  path_tail(p, full_path)
  let angle = p.i
  var generic = missing()
  if sym(p, "<") {
    generic = type_args(p, full_path)
    if p.failed || !(sym(p, ".") || sym(p, "{{")) {
      p.i = angle
      p.failed = false
      p.error_line = 0
      p.message.clear()
      p.notes.clear()
      generic = missing()
    }
  }
  let has_fields = is_name(p, 1) && sym_at(p, 2, ":") && !kw_at(p, 3, "while") && !kw_at(p, 3, "for")
  let empty_literal = sym_at(p, 1, "}}") && (generic != "_" || constructor_name(p, start, angle))
  let shorthand = is_name(p, 1) && (sym_at(p, 2, ",") || sym_at(p, 2, "}}")) && constructor_name(p, start, angle)
  if sym(p, "{{") && (has_fields || empty_literal || shorthand) {
    return node3("StructLit", full_path, generic, fields(p))
  }
  if generic != "_" {
    expect(p, ".")
    let member = ident(p)
    var values = empty_list()
    if sym(p, "(") { values = args(p) }
    return "GenericMember({full_path},{generic},{member},{values})"
  }
  p.i = start
  if sym(p, "(") {
    let values = args(p)
    if name == hex("panic") || name == hex("assert") || name == hex("assert_eq") || name == hex("assert_ne") {
      return "Call({name},{values}{pos_of(p, start - 1)})"
    }
    return call(p, name, values)
  }
  return positioned(p, node1("Var", name), start - 1)
}

fn tuple_or_group(p: mut Parser) -> String {
  let open = p.i - 1
  let line = p.tokens.at(p.i - 1).line
  let first = parse_expr(p)
  if !sym(p, ",") {
    expect(p, ")")
    return first
  }
  var n = 1
  var out = String.from("[")
  append(out, node2("FieldInit", String.from("5f30"), first))
  while eat(p, ",") && !at_close(p, ")") {
    let field = "_{n}"
    append(out, node2("FieldInit", hex(field), parse_expr(p)))
    n = n + 1
  }
  expect(p, ")")
  if !p.failed && n < 2 {
    p.error_line = line
    if fail_span(p, open, p.i - 1, "a tuple needs at least two elements") {
      note(p, "help: write the value itself, without parentheses and comma")
    }
  } else if !p.failed && n > 6 {
    p.error_line = line
    if fail_span(p, open, p.i - 1, "a tuple has at most 6 elements, this one has {n}") {
      note(p, "help: for more elements, define a struct with named fields")
    }
  }
  finish(out)
  let name = tuple_name(p, n)
  return node3("StructLit", name, missing(), out)
}

fn array(p: mut Parser) -> String {
  let first = parse_expr(p)
  if eat(p, ";") {
    let len = length(p)
    expect(p, "]")
    return node2("ArrayFill", first, len)
  }
  var out = String.from("[")
  append(out, first)
  while eat(p, ",") && !at_close(p, "]") {
    append(out, parse_expr(p))
  }
  expect(p, "]")
  finish(out)
  return node1("Array", out)
}

fn assignment_or_expr(p: mut Parser, value: view String, wrap: Bool) -> String {
  if eat(p, "=") {
    let right = parse_expr(p)
    return node2("Assign", value, right)
  }
  if wrap { return node1("Expr", value) }
  return node1("Return", value)
}

fn closure(p: mut Parser, moved: Bool, worker: Bool) -> String {
  var params = String.from("[")
  if !eat(p, "||") {
    expect(p, "|")
    var names = List<String>.new()
    while !at_close(p, "|") {
      let line = p.tokens.at(p.i).line
      let at = p.i
      let name = ident(p)
      if !p.failed && names.contains(name) {
        p.error_line = line
        if fail_at(p, at, "duplicate closure parameter '{p.tokens.at(at).text}'") {
          note(p, "help: rename or remove the repeated declaration")
        }
        break
      }
      names.push(String.from(name))
      var m = String.from("Own")
      var t = missing()
      if eat(p, ":") { m = mode(p); t = parse_type(p) }
      append(params, node3("Param", name, m, t))
      if !eat(p, ",") { break }
    }
    if !sym(p, "|") && fail(p, "expected `|` to end the closure parameters") {
      note(p, "help: closures are written `|x, y| x + y`, or `|x: Int| {{ .. }}` for a block body")
    }
    expect(p, "|")
  }
  finish(params)
  let ret = return_type(p)
  let expr_body = !sym(p, "{{")
  var body = String.new()
  if expr_body {
    if ret != "_" && fail(p, "a closure with `-> Type` needs a block body") {
      note(p, "help: write `|x| -> Int {{ return x + 1 }}`, or drop the return type: `|x| x + 1`")
    }
    let value = parse_expr(p)
    let statement = assignment_or_expr(p, value, false)
    body = "Block([{statement}])"
  } else { body = block(p) }
  return "Closure({moved},{expr_body},false,{worker},{params},{ret},{body})"
}

fn primary(p: mut Parser) -> String {
  if p.failed { return String.new() }
  if kind(p, "Num") {
    let at = p.i
    return positioned(p, node1("Int", bump(p)), at)
  }

  if kind(p, "NumT") {
    let raw = bump(p)
    let split = raw.find(":")
    return node2("NumT", raw.slice(0, split), raw.slice(split + 1, raw.len()))
  }
  if kind(p, "Float") {
    let raw = bump(p)
    let split = raw.find(":")
    let value = raw.slice(0, split)
    if p.legacy { return node1("Float", value) }
    return node2("Float", value, raw.slice(split + 1, raw.len()))
  }
  if kind(p, "Str") {
    let at = p.i
    return positioned(p, node1("Text", bump(p)), at)
  }
  if kind(p, "Char") {
    let at = p.i
    return positioned(p, node1("Char", bump(p)), at)
  }
  if kw(p, "true") {
    let at = p.i
    p.i = p.i + 1
    return positioned(p, String.from("Bool(true)"), at)
  }
  if kw(p, "false") {
    let at = p.i
    p.i = p.i + 1
    return positioned(p, String.from("Bool(false)"), at)
  }
  if eat(p, "(") { return tuple_or_group(p) }
  if eat(p, "[") { return array(p) }
  if sym(p, "|") || sym(p, "||") { return closure(p, false, false) }
  if eat_kw(p, "move") {
    if sym(p, "|") || sym(p, "||") { return closure(p, true, false) }
    return node1("Move", ident(p))
  }
  if eat_kw(p, "spawn") {
    if !eat_kw(p, "move") { let first = fail(p, "spawn requires a move closure"); return String.new() }
    var worker = String.new()
    if sym(p, "{{") {
      let body = block(p)
      worker = "Closure(true,false,false,true,[],_,{body})"
    } else { worker = closure(p, true, true) }
    return "Call(5f5f737061776e5f6f776e6564,[{worker}])"
  }
  if kw(p, "if") { return if_expr(p) }
  if kw(p, "match") { return match_value(p) }
  if is_name(p, 0) {
    let name = ident(p)
    return after_name(p, name)
  }
  no_expression(p)
  return String.new()
}

fn no_expression(p: mut Parser) {
  if kind(p, "Id") && reserved(p.tokens.at(p.i).text) {
    let word = String.from(p.tokens.at(p.i).text)
    if fail(p, "unexpected keyword '{word}' here") && word == "let" && p.i > 0 &&
        (p.tokens.at(p.i - 1).text == "if" || p.tokens.at(p.i - 1).text == "while") {
      note(p, "there is no `if let` or `while let`")
      note(p, "help: use `match value {{ Some(x) => {{ .. }} None => {{}} }}` (in a loop: `while true` with `None => {{ break }}`)")
    }
    return
  }
  if sym(p, "=") && p.i > 0 && p.tokens.at(p.i - 1).line == p.tokens.at(p.i).line &&
      p.tokens.at(p.i - 1).col + 1 == p.tokens.at(p.i).col {
    let at = p.i - 1
    let op = String.from(p.tokens.at(at).text)
    if p.tokens.at(at).kind == "Sym" && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
      if fail_at(p, at, "`{op}=` does not exist: assignment has no compound form") {
        note(p, "help: write the operation out: `n = n + 2`")
      }
      return
    }
  }
  let first = fail(p, "expected an expression")
}

fn postfix(p: mut Parser, base: String, first: Int) -> String {
  var out = move base
  let at = pos_of(p, first)
  while !p.failed {
    if sym(p, "(") && same_line(p) &&
        (out.starts_with("Call(") || out.starts_with("CallFn(") || out.starts_with("Method(")) {
      let values = args(p)
      out = node2("CallFn", out, values)
    } else if sym(p, "[") && same_line(p) {
      p.i = p.i + 1
      var lo = missing()
      if !sym(p, "..") { lo = parse_expr(p) }
      if eat(p, "..") {
        var hi = missing()
        if !sym(p, "]") { hi = parse_expr(p) }
        expect(p, "]")
        out = "Slice({out},{lo},{hi}{at})"
      } else {
        expect(p, "]")
        out = "Method({out},6174,[{lo}]{at})"
      }
    } else if eat(p, "?") {
      out = unary(p, String.from("3f"), out)
    } else if eat(p, ".") {
      if kind(p, "Num") {
        let index = bump(p)
        let field = "_{index}"
        out = node2("Field", out, hex(field))
      } else {
        let member = ident(p)
        if sym(p, "(") {
          let values = args(p)
          out = "Method({out},{member},{values}{at})"
        } else { out = node2("Field", out, member) }
      }
    } else { break }
  }
  return out
}

// Syntactic nesting (blocks, types, patterns, operands) is bounded like the Rust parser's: 2000 levels.
fn enter(p: mut Parser) -> Bool {
  p.depth = p.depth + 1
  if p.depth > 2000 {
    p.depth = p.depth - 1
    if fail(p, "this is nested more than 2000 levels deep") {
      note(p, "no real program needs this much nesting; split the inner part into its own function or a `let`")
    }
    return false
  }
  return true
}

fn parse_unary(p: mut Parser) -> String {
  if p.failed || !enter(p) { return String.new() }
  let value = unary_inner(p)
  p.depth = p.depth - 1
  return value
}

fn unary_inner(p: mut Parser) -> String {
  if p.failed { return String.new() }
  if sym(p, "!") || sym(p, "-") {
    let op = bump(p)
    let value = parse_unary(p)
    return unary(p, op, value)
  }
  if eat(p, "*") {
    let value = parse_unary(p)
    return "Method({value},676574,[])"
  }
  if kw(p, "comptime") && (p.tokens.at(current(p, 1)).kind == "Id" ||
      p.tokens.at(current(p, 1)).kind == "Num" || p.tokens.at(current(p, 1)).kind == "Char" ||
      sym_at(p, 1, "(") || sym_at(p, 1, "-") || sym_at(p, 1, "!")) {
    p.i = p.i + 1
    let value = parse_unary(p)
    return "Call(5f5f636f6d7074696d65,[{value}])"
  }
  let first = p.i
  let base = primary(p)
  return postfix(p, move base, first)
}

fn binary(p: mut Parser, minimum: Int) -> String {
  var left = parse_unary(p)
  while !p.failed && precedence(p) >= minimum {
    let next = precedence(p) + 1
    let op = bump(p)
    let right = binary(p, next)
    if p.legacy { left = "Bin({op}, {left}, {right})" }
    else { left = node3("Bin", op, left, right) }
  }
  return left
}

fn parse_expr(p: mut Parser) -> String {
  let value = binary(p, 1)
  if !same_line(p) || !eat_kw(p, "as") { return value }
  let ty = parse_type(p)
  var otherwise = missing()
  if eat_kw(p, "else") { otherwise = block(p) }
  return node3("Cast", value, ty, otherwise)
}

fn pattern_bound(p: mut Parser, value: mut Int, char: mut Bool) -> Bool {
  let neg = sym(p, "-")
  var offset = 0
  if neg { offset = 1 }
  let i = current(p, offset)
  let is_char = p.tokens.at(i).kind == "Char"
  if p.tokens.at(i).kind != "Num" && (!is_char || neg) { return false }
  char = is_char
  p.i = p.i + offset
  let number = bump(p)
  if !number.parse_int(value) { p.failed = true }
  if neg { value = 0 - value }
  return true
}

fn missing_bound(p: mut Parser) {
  let first = fail(p, "expected a number or a character after `..=`")
}

fn pat_range(p: mut Parser, at: Int, lower: view String, is_char: Bool, inclusive: Bool) -> String {
  var hi = 0
  var char = false
  var upper = missing()
  var range_char = is_char
  if pattern_bound(p, hi, char) {
    if lower == "_" { range_char = char }
    else if char != is_char && fail_at(p, at, "both ends of a range pattern must be the same kind") {
      note(p, "write numbers on both sides (`1..=9`) or characters on both sides (`'a'..='z'`)")
    }
    if !inclusive {
      if hi == -9223372036854775807 - 1 { let first = fail_at(p, at, "this range is empty") }
      else { hi = hi - 1 }
    }
    var lo = 0
    if lower.parse_int(lo) && lo > hi && fail_at(p, at, "this range pattern is empty: the start is after the end") {
      note(p, "help: write the smaller value first, e.g. `1..=9`")
    }
    upper = "{hi}"
  } else if inclusive { missing_bound(p) }
  return "PatRange({range_char},{lower},{upper})"
}

fn pattern_atom(p: mut Parser) -> String {
  if p.failed { return String.new() }
  let at = p.i
  if eat(p, "..=") { return pat_range(p, at, missing(), false, true) }
  var number = 0
  var char = false
  if pattern_bound(p, number, char) {
    let value = "{number}"
    if eat(p, "..=") { return pat_range(p, at, value, char, true) }
    if eat(p, "..") { return pat_range(p, at, value, char, false) }
    if char { return node1("Char", value) }
    return node1("Int", value)
  }
  if eat(p, "(") {
    let first = pattern(p)
    if !sym(p, ",") {
      expect(p, ")")
      return first
    }
    var out = String.from("[")
    append(out, first)
    var count = 1
    while eat(p, ",") && !at_close(p, ")") {
      append(out, pattern(p))
      count = count + 1
    }
    expect(p, ")")
    if count < 2 || count > 6 { let first = fail_span(p, at, p.i - 1, "a tuple pattern has 2 to 6 elements") }
    finish(out)
    return node1("TuplePat", out)
  }
  if eat_kw(p, "true") { return String.from("Bool(true)") }
  if eat_kw(p, "false") { return String.from("Bool(false)") }
  if eat_kw(p, "_") { return String.from("Wild()") }
  if !is_name(p, 0) { no_pattern(p); return String.new() }
  let upper = uppercase(p.tokens.at(p.i).text)
  var name = ident(p)
  if eat(p, "@") { return node2("Bind", name, pattern_atom(p)) }
  let qualified = eat(p, ".")
  if qualified {
    let tail = ident(p)
    name.push_str("2e")
    name.push_str(tail)
    path_tail(p, name)
  }
  if qualified || upper || sym(p, "(") {
    var items = String.from("[")
    if eat(p, "(") {
      while !at_close(p, ")") {
        append(items, pattern(p))
        if !eat(p, ",") { break }
      }
      expect(p, ")")
    }
    finish(items)
    return node2("Variant", name, items)
  }
  return node2("Bind", name, missing())
}

fn no_pattern(p: mut Parser) {
  if kind(p, "Str") {
    if fail(p, "a string cannot be a pattern") {
      note(p, "patterns match enum variants, tuples, Int, Char and Bool")
      note(p, "help: compare strings with `if s.eq(\"a\") {{ .. }} else if s.eq(\"b\") {{ .. }}`")
    }
  } else if fail(p, "expected a pattern") {
    note(p, "patterns: `Variant(x)`, `_`, a name, `1`, `1..=9`, `'a'`, `true`, `(a, b)`, `A | B`, `n @ 1..=9`")
  }
}

fn pattern(p: mut Parser) -> String {
  if p.failed || !enter(p) { return String.new() }
  let value = pattern_inner(p)
  p.depth = p.depth - 1
  return value
}

fn pattern_inner(p: mut Parser) -> String {
  let first = pattern_atom(p)
  if !sym(p, "|") { return first }
  var out = String.from("[")
  append(out, first)
  while !p.failed && eat(p, "|") {
    append(out, pattern_atom(p))
  }
  finish(out)
  return node1("Or", out)
}

fn unpack(p: mut Parser, mutable: Bool) -> String {
  if !eat(p, "(") {
    let n = ident(p)
    return "UnpackBind({n},{mutable})"
  }
  let open = p.i - 1
  var out = String.from("[")
  var count = 0
  while !at_close(p, ")") {
    append(out, unpack(p, mutable))
    count = count + 1
    if !eat(p, ",") { break }
  }
  expect(p, ")")
  if count < 2 && fail_span(p, open, p.i - 1, "a tuple pattern needs at least two names") {
    note(p, "example: `let (a, b) = pair`; use `_` for an element you do not need")
  }
  finish(out)
  return node1("UnpackTuple", out)
}

fn block(p: mut Parser) -> String {
  if p.failed || !enter(p) { return String.new() }
  let value = block_inner(p)
  p.depth = p.depth - 1
  return value
}

fn block_inner(p: mut Parser) -> String {
  expect(p, "{{")
  var out = String.from("[")
  while !at_close(p, "}}") && !unclosed(p) {
    append(out, statement(p))
  }
  expect(p, "}}")
  finish(out)
  return node1("Block", out)
}

fn unclosed(p: mut Parser) -> Bool {
  if !kind(p, "Eof") { return false }
  let first = fail(p, "missing closing '}}'")
  return true
}

// A block whose last statement is its value (a branch of an `if`/`match` used as a value). A trailing `if` or
// `match` is a value too, so its `match` arms may be bare expressions.
fn value_block(p: mut Parser) -> String {
  if p.failed || !enter(p) { return String.new() }
  let value = value_block_inner(p)
  p.depth = p.depth - 1
  return value
}

fn bare_arm_error(p: mut Parser, at: Int) {
  if fail_at(p, at, "a `match` statement arm needs a block `{{ .. }}`") {
    note(p, "a bare expression arm (`P => e,`) is only for a `match` used as a value")
    note(p, "help: write `P => {{ e }}`, or `let x = match v {{ P => e, .. }}` to use the value")
  }
}

fn value_block_inner(p: mut Parser) -> String {
  expect(p, "{{")
  var out = String.from("[")
  while !at_close(p, "}}") && !unclosed(p) {
    if !kw(p, "if") && !kw(p, "match") {
      append(out, statement(p))
      continue
    }
    let outer = p.bare_at
    p.bare_at = 0
    var item = String.new()
    if eat_kw(p, "if") { item = if_stmt_in(p, true) } else {
      p.i = p.i + 1
      item = match_arms(p, "Match", true)
    }
    // bare arms need a value, so the statement that holds them must end the block
    if p.bare_at != 0 && !sym(p, "}}") {
      if !p.failed { p.error_line = p.tokens.at(p.bare_at - 1).line }
      bare_arm_error(p, p.bare_at - 1)
    }
    if outer != 0 { p.bare_at = outer }
    append(out, item)
  }
  expect(p, "}}")
  finish(out)
  return node1("Block", out)
}

fn binding(p: mut Parser, mutable: Bool) -> String {
  if sym(p, "(") {
    let pat = unpack(p, mutable)
    expect(p, "=")
    return node2("Unpack", pat, parse_expr(p))
  }
  let n = ident(p)
  var ty = missing()
  if eat(p, ":") { ty = parse_type(p) }
  expect(p, "=")
  var value = parse_expr(p)
  if ty != "_" { value = node2("Ascribe", ty, value) }
  if p.legacy { return "Let({n}, {mutable}, {value})" }
  return "Let({n},{mutable},{value})"
}

fn if_stmt(p: mut Parser) -> String {
  return if_stmt_in(p, false)
}

// With `value`, the statement may give the value of the enclosing branch (see `value_block`).
fn if_stmt_in(p: mut Parser, value: Bool) -> String {
  let cond = parse_expr(p)
  var yes = String.new()
  if value { yes = value_block(p) } else { yes = block(p) }
  var no = missing()
  if eat_kw(p, "else") {
    if eat_kw(p, "if") {
      let inner = if_stmt_in(p, value)
      no = "Block([{inner}])"
    } else if value { no = value_block(p) } else { no = block(p) }
  }
  return node3("If", cond, yes, no)
}

fn loop_stmt(p: mut Parser, label: view String, is_parallel: Bool) -> String {
  let line = p.tokens.at(p.i).line
  if !is_parallel && eat_kw(p, "while") {
    let cond = parse_expr(p)
    return node3("While", label, cond, block(p))
  }
  var parallel_at = p.i
  if is_parallel { parallel_at = p.i - 1 }
  if !eat_kw(p, "for") {
    if is_parallel { let first = fail(p, "expected 'for' after 'parallel'") }
    else { p.failed = true }
    return String.new()
  }
  let mutable = eat_kw(p, "mut")
  let n = ident(p)
  if !eat_kw(p, "in") && fail(p, "expected `in` after the loop variable") {
    note(p, "example: `for i in 0..10 {{ .. }}` or `for x in list {{ .. }}`")
  }
  let first = parse_expr(p)
  var end = missing()
  var inclusive = false
  var iter = String.from(first)
  if sym(p, "..") || sym(p, "..=") {
    inclusive = sym(p, "..=")
    p.i = p.i + 1
    end = parse_expr(p)
    iter = "IterRange({first},{end},{inclusive})"
  }
  var step = missing()
  if eat_kw(p, "step") { step = parse_expr(p) }
  let body = block(p)
  if is_parallel {
    if mutable || step != "_" {
      if !p.failed { p.error_line = line }
      let first = fail_at(p, parallel_at, "parallel for requires a read-only iterator without a step")
    }
    if end != "_" {
      let closure = "Closure(false,false,true,false,[Param({n},Own,Type(496e74,[]))],_,{body})"
      return "Expr(Call(5f5f706172616c6c656c5f72616e6765,[{first},{end},Bool({inclusive}),{closure}]))"
    }
    let closure = "Closure(false,false,true,false,[Param({n},View,_)],_,{body})"
    return "Expr(Call(5f5f706172616c6c656c5f6c697374,[{first},{closure}]))"
  }
  return "For({label},{n},{mutable},{iter},{step},{body})"
}

// `if c { .. v } else { .. w }` where a value is wanted: both branches are required.
fn if_expr(p: mut Parser) -> String {
  let at = p.i
  let line = p.tokens.at(p.i).line
  p.i = p.i + 1
  let cond = parse_expr(p)
  let yes = value_block(p)
  if !eat_kw(p, "else") {
    if !p.failed { p.error_line = line }
    if fail_at(p, at, "an `if` used as a value needs an `else`") {
      note(p, "both branches must produce a value of the same type")
      note(p, "help: write `if cond {{ a }} else {{ b }}`, or use an `if` statement when no value is needed")
    }
    return String.new()
  }
  var no = String.new()
  if eat_kw(p, "if") {
    let inner = if_stmt_in(p, true)
    no = "Block([{inner}])"
  } else { no = value_block(p) }
  return node3("IfExpr", cond, yes, no)
}

fn match_value(p: mut Parser) -> String {
  p.i = p.i + 1
  return match_arms(p, "MatchExpr", true)
}

fn match_stmt(p: mut Parser) -> String {
  return match_arms(p, "Match", false)
}

fn match_arms(p: mut Parser, tag: Text, as_value: Bool) -> String {
  let mutable = eat_kw(p, "mut")
  var value = parse_expr(p)
  if mutable { value = node2("Un", String.from("6d7574"), value) }
  expect(p, "{{")
  var arms = String.from("[")
  var count = 0
  while !at_close(p, "}}") {
    if count >= 10000 { let first = fail(p, "this `match` has more than 10000 arms"); return String.new() }
    count = count + 1
    let pat = pattern(p)
    var guard = missing()
    if eat_kw(p, "if") { guard = parse_expr(p) }
    if !sym(p, "=>") && fail(p, "expected '=>' after the pattern") {
      note(p, "example: `Some(x) if x > 3 => {{ .. }}`")
    }
    expect(p, "=>")
    var body = String.new()
    if !as_value && !sym(p, "{{") && !p.failed { bare_arm_error(p, p.i) }
    if as_value && !sym(p, "{{") {
      if p.bare_at == 0 { p.bare_at = p.i + 1 }
      let value = parse_expr(p)
      body = "Block([Expr({value})])"
    } else if as_value { body = value_block(p) } else { body = block(p) }
    append(arms, node3("Arm", pat, guard, body))
    let comma = eat(p, ",")
  }
  expect(p, "}}")
  finish(arms)
  return node2(tag, value, arms)
}

fn statement(p: mut Parser) -> String {
  var out = String.new()
  if kw(p, "let") || kw(p, "var") {
    let mutable = kw(p, "var")
    p.i = p.i + 1
    out = binding(p, mutable)
  } else if eat_kw(p, "return") {
    var value = missing()
    if !(sym(p, "}}") || sym(p, ";") || (p.legacy && kind(p, "Eof"))) { value = parse_expr(p) }
    if p.legacy && value == "_" { value = String.from("None") }
    out = node1("Return", value)
  } else if eat_kw(p, "unsafe") {
    out = node1("Unsafe", block(p))
  } else if eat_kw(p, "scope") {
    out = node1("Scope", block(p))
  } else if eat_kw(p, "if") {
    return if_stmt(p)
  } else if eat_kw(p, "match") {
    return match_stmt(p)
  } else if eat_kw(p, "parallel") {
    out = loop_stmt(p, missing(), true)
  } else if kw(p, "while") || kw(p, "for") {
    return loop_stmt(p, missing(), false)
  } else if is_name(p, 0) && sym_at(p, 1, ":") && (kw_at(p, 2, "while") || kw_at(p, 2, "for")) {
    let label = ident(p)
    expect(p, ":")
    return loop_stmt(p, label, false)
  } else if kw(p, "break") || kw(p, "continue") {
    let breaking = eat_kw(p, "break")
    if !breaking { p.i = p.i + 1 }
    var label = missing()
    if same_line(p) && is_name(p, 0) { label = ident(p) }
    if breaking { out = node1("Break", label) }
    else { out = node1("Continue", label) }
  } else if eat_kw(p, "defer") {
    if (kw(p, "let") || kw(p, "var") || kw(p, "return") || kw(p, "if") || kw(p, "while") || kw(p, "match") ||
        kw(p, "defer")) && fail(p, "`defer` takes a single call or assignment") {
      note(p, "help: put the work in a function and defer the call: `defer cleanup(x)`")
    }
    let value = parse_expr(p)
    out = node1("Defer", assignment_or_expr(p, value, true))
  } else {
    let value = parse_expr(p)
    out = assignment_or_expr(p, value, true)
  }
  let semi = eat(p, ";")
  return out
}

fn generics(p: mut Parser) -> String {
  var bound = 0
  return bounded_generics(p, bound)
}

// `bound`: token index of the first trait bound (0: none)
fn bounded_generics(p: mut Parser, bound: mut Int) -> String {
  if !eat(p, "<") { return empty_list() }
  var out = String.from("[")
  var names = List<String>.new()
  while !at_close(p, ">") {
    let constant = kw(p, "const") && p.tokens.at(current(p, 1)).kind == "Id"
    if constant { p.i = p.i + 1 }
    let at = p.i
    let n = ident(p)
    if p.build && !p.failed {
      if names.contains(n) {
        let first = fail_at(p, at, "type parameter '{p.tokens.at(at).text}' is declared twice")
      }
      names.push(String.from(n))
    }
    if constant {
      expect(p, ":")
      if p.build && is_name(p, 0) && p.tokens.at(p.i).text != "Int" {
        let first = fail(p, "a const parameter must be an Int: `const N: Int`")
      }
      append(out, node2("ConstParam", n, parse_type(p)))
    } else {
      var bounds = String.from("[")
      if eat(p, ":") {
        if bound == 0 { bound = p.i }
        append(bounds, path(p))
        while !p.failed && eat(p, "+") { append(bounds, path(p)) }
      }
      finish(bounds)
      append(out, node2("Generic", n, bounds))
    }
    if !eat(p, ",") { break }
  }
  expect(p, ">")
  if p.build && out == "[" { let first = fail(p, "a generic list needs at least one type parameter") }
  finish(out)
  return out
}

fn function(p: mut Parser, body: Bool, method: Bool, external: Bool) -> String {
  if !eat_kw(p, "fn") { p.failed = true; return String.new() }
  let n = ident(p)
  let generic = generics(p)
  expect(p, "(")
  var params = String.from("[")
  var names = List<String>.new()
  while !at_close(p, ")") {
    let first = params.len() == 1
    if external && first && sym(p, "..") {
      let found = fail(p, "a variadic extern function needs at least one fixed parameter before `...`")
    }
    if external && !first && eat(p, "..") {
      expect(p, ".")
      if !sym(p, ")") { let found = fail(p, "`...` must be the last parameter") }
      append(params, String.from("Variadic()"))
      break
    }
    var at = 0
    if kw(p, "view") || kw(p, "mut") { at = 1 }
    if first && method && kw_at(p, at, "self") && (sym_at(p, at + 1, ",") || sym_at(p, at + 1, ")")) {
      let m = mode(p)
      p.i = p.i + 1
      append(params, node1("Self", m))
    } else {
      let at = p.i
      let param = ident(p)
      if p.build && !p.failed {
        if names.contains(param) { duplicate(p, at, "parameter") }
        names.push(String.from(param))
      }
      expect(p, ":")
      let m = mode(p)
      append(params, node3("Param", param, m, parse_type(p)))
    }
    if !eat(p, ",") { break }
  }
  expect(p, ")")
  finish(params)
  let ret = return_type(p)
  var statements = missing()
  if body || (method && !external && sym(p, "{{")) { statements = block(p) }
  else { let semi = eat(p, ";") }
  return "Fn({n},{generic},{params},{ret},{statements})"
}

fn duplicate(p: mut Parser, at: Int, what: Text) {
  if fail_at(p, at, "duplicate {what} '{p.tokens.at(at).text}'") {
    note(p, "help: rename or remove the repeated declaration")
  }
}

// What an `impl` (`body && method`), a `trait` or an `extern` block expects instead of `fn`
fn no_method(p: mut Parser, body: Bool, method: Bool) {
  if method && body && kw(p, "pub") {
    let first = fail(p, "methods take no `pub`: they are visible wherever their type is")
  } else if method && body { let first = fail(p, "expected 'fn' inside `impl`") }
  else if method { let first = fail(p, "expected 'fn' (a trait lists method signatures)") }
  else { let first = fail(p, "expected 'fn', 'struct', 'enum', 'trait' or 'impl'") }
}

fn functions(p: mut Parser, body: Bool, method: Bool, external: Bool) -> String {
  expect(p, "{{")
  var out = String.from("[")
  var names = List<String>.new()
  while !at_close(p, "}}") {
    if !kw(p, "fn") { no_method(p, body, method) }
    else if p.build && body && method && is_name(p, 1) {
      let name = String.from(p.tokens.at(p.i + 1).text)
      if names.contains(name) { let first = fail_at(p, p.i + 1, "method '{name}' is defined twice in this impl") }
      names.push(move name)
    }
    append(out, function(p, body, method, external))
  }
  expect(p, "}}")
  finish(out)
  return out
}

fn str_value(p: mut Parser) -> String {
  if !kind(p, "Str") { p.failed = true; return String.new() }
  return bump(p)
}

fn aggregate(p: mut Parser, is_struct: Bool) -> String {
  let n = ident(p)
  var bound = 0
  let generic = bounded_generics(p, bound)
  if p.build && bound != 0 && fail_at(p, bound, "type parameters of a struct or enum cannot have bounds") {
    note(p, "help: put the bounds on the functions that use the type, e.g. `fn f<T: Ordered>(p: view Pair<T, T>)`")
  }
  expect(p, "{{")
  var entries = String.from("[")
  var names = List<String>.new()
  while !at_close(p, "}}") {
    if is_struct && kw(p, "pub") && fail(p, "a struct field takes no `pub`") {
      note(p, "the fields of a `pub struct` are public and those of a private struct are private: write `name: Type`")
    }
    let at = p.i
    let entry = ident(p)
    if p.build && !p.failed {
      if names.contains(entry) {
        if is_struct { duplicate(p, at, "field") } else { duplicate(p, at, "variant") }
      }
      names.push(String.from(entry))
      if !is_struct && names.len() > 5000 { let first = fail_at(p, at, "this enum has more than 5000 variants") }
    }
    if is_struct {
      expect(p, ":")
      append(entries, node2("FieldDef", entry, parse_type(p)))
    } else {
      var payload = empty_list()
      var tag: Text = "VariantDef"
      if eat(p, "(") {
        payload = types(p, ")")
        if p.build && payload == "[]" { tag = "VariantDefEmptyArgs" }
      }
      append(entries, node2(tag, entry, payload))
    }
    if !eat(p, ",") { break }
  }
  expect(p, "}}")
  finish(entries)
  if is_struct { return node3("Struct", n, generic, entries) }
  return node3("Enum", n, generic, entries)
}

fn item(p: mut Parser) -> String {
  let public = eat_kw(p, "pub")
  var attribute = missing()
  if eat(p, "@") { attribute = ident(p) }
  var out = String.new()
  if kw(p, "fn") {
    out = function(p, true, false, false)
  } else if eat_kw(p, "import") {
    let module_path = path(p)
    let last = p.i - 1
    var alias = missing()
    if eat_kw(p, "as") {
      alias = ident(p)
      p.imports.push(String.from(alias))
    } else {
      p.imports.push(String.from(p.tokens.at(last).value))
    }
    let semi = eat(p, ";")
    out = node2("Import", module_path, alias)
  } else if p.build && eat_kw(p, "derive") {
    var traits = String.from("[")
    append(traits, path(p))
    while eat(p, ",") { append(traits, path(p)) }
    finish(traits)
    if !eat_kw(p, "for") { p.failed = true }
    out = node2("Derive", ident(p), traits)
  } else if eat_kw(p, "test") {
    let n = str_value(p)
    out = node2("Test", n, block(p))
  } else if eat_kw(p, "link") {
    if !kind(p, "Str") { let first = fail(p, "expected a library name string after `link`") }
    out = node1("Link", str_value(p))
  } else if eat_kw(p, "extern") {
    if p.build && !(kind(p, "Str") && p.tokens.at(p.i).value == "43") {
      let first = fail_at(p, p.i - 1, "only `extern \"C\"` is supported")
    }
    let abi = str_value(p)
    out = node2("Extern", abi, functions(p, false, false, true))
  } else if eat_kw(p, "const") {
    let n = ident(p)
    var ty = missing()
    if eat(p, ":") { ty = parse_type(p) }
    expect(p, "=")
    out = node3("Const", n, ty, parse_expr(p))
    let semi = eat(p, ";")
  } else if eat_kw(p, "type") {
    let n = ident(p)
    expect(p, "=")
    out = node2("Alias", n, parse_type(p))
    let semi = eat(p, ";")
  } else if eat_kw(p, "struct") {
    out = aggregate(p, true)
  } else if eat_kw(p, "enum") {
    out = aggregate(p, false)
  } else if eat_kw(p, "trait") {
    let n = ident(p)
    out = node2("Trait", n, functions(p, false, true, false))
  } else if eat_kw(p, "impl") {
    let generic = generics(p)
    var target = parse_type(p)
    var trait_type = missing()
    if eat_kw(p, "for") {
      trait_type = String.from(target)
      target = parse_type(p)
    }
    let methods = functions(p, true, true, false)
    out = "Impl({generic},{trait_type},{target},{methods})"
  } else { let first = fail(p, "expected 'fn', 'struct', 'enum', 'trait' or 'impl'") }
  return "Item({public},{attribute},{out})"
}

fn tuple_declaration(count: Int) -> String {
  var generics = String.from("[")
  var fields = String.from("[")
  for i in 0..count {
    let parameter = hex("T{i}")
    let field = hex("_{i}")
    append(generics, "Generic({parameter},[])")
    append(fields, "FieldDef({field},Type({parameter},[]))")
  }
  finish(generics)
  finish(fields)
  let name = hex("$tuple{count}")
  return "Item(false,_,Struct({name},{generics},{fields}))"
}

// The Rust parser first walks over every item to find the generic ones, so unbalanced braces are reported
// before any other syntax error.
fn check_braces(p: mut Parser) {
  var i = 0
  let end = p.tokens.len() - 1
  while i < end {
    let word = String.from(p.tokens.at(i).text)
    let named = p.tokens.at(i + 1).kind == "Id"
    if (word == "const" || word == "type" || word == "import" || word == "derive") && named {
      let line = p.tokens.at(i).line
      while i < end && p.tokens.at(i).line == line { i = i + 1 }
      continue
    }
    if word == "@" {
      let attribute = String.from(p.tokens.at(i + 1).text)
      let target = String.from(p.tokens.at(current(p, i + 2 - p.i)).text)
      if p.tokens.at(i + 1).kind != "Id" || attribute != "thread_bound" || !(target == "struct" || target == "enum") {
        let first = fail_at(p, i + 1, "expected @thread_bound on a struct or enum")
        return
      }
      i = i + 2
    }
    while i < end && !(p.tokens.at(i).kind == "Sym" && p.tokens.at(i).text == "{{") { i = i + 1 }
    if i >= end { let first = fail_at(p, end, "missing '{{'"); return }
    let open = i
    var depth = 0
    while i < end {
      if p.tokens.at(i).kind == "Sym" {
        if p.tokens.at(i).text == "{{" { depth = depth + 1 }
        else if p.tokens.at(i).text == "}}" { depth = depth - 1 }
      }
      i = i + 1
      if depth == 0 { break }
    }
    if depth != 0 { let first = fail_at(p, open, "missing closing '}}'"); return }
  }
}

// A second top-level type with a name fails where it is read. A second function is reported after the whole
// file reads (the Rust checker finds it): `twice` keeps the token of its name.
fn check_redefined(p: mut Parser, at: Int, functions: mut List<String>, types: mut List<String>, twice: mut Int) {
  let word = String.from(p.tokens.at(at).text)
  if !(word == "fn" || word == "struct" || word == "enum") || p.tokens.at(at + 1).kind != "Id" { return }
  let name = String.from(p.tokens.at(at + 1).text)
  if word == "fn" {
    if twice == 0 && functions.contains(name) { twice = at + 1 }
    functions.push(move name)
  } else {
    if types.contains(name) { let first = fail_at(p, at + 1, "type '{name}' is defined twice") }
    types.push(move name)
  }
}

fn parse_file(p: mut Parser) -> String {
  var out = String.from("[")
  var functions = List<String>.new()
  var types = List<String>.new()
  var twice = 0
  if p.build { check_braces(p) }
  while !p.failed && !kind(p, "Eof") {
    if !p.build && eat_kw(p, "derive") {
      // `derive Clone, Equal for Name` generates impls in the real compiler; it adds no item to the AST
      let first = ident(p)
      while eat(p, ",") {
        let more = ident(p)
      }
      if !eat_kw(p, "for") { p.failed = true }
      let target = ident(p)
    } else {
      var at = p.i
      if kw(p, "pub") { at = at + 1 }
      append(out, item(p))
      if p.build && !p.failed { check_redefined(p, at, functions, types, twice) }
    }
  }
  if twice != 0 && fail_at(p, twice, "function '{p.tokens.at(twice).text}' is defined twice") {
    p.error_line = p.err_line
  }
  for count in p.tuple_arities { append(out, tuple_declaration(count)) }
  finish(out)
  return node1("File", out)
}

fn main() {
  match env.arg(1) {
    None => { print("usage: parser.yx token-dump.txt"); env.exit(2) }
    Some(path) => {
      match fs.read_to_string(path) {
        Err(e) => { print("could not read token dump: {e.message}"); env.exit(2) }
        Ok(source) => {
          var build = false
          match env.arg(2) {
            Some(flag) => { build = flag == "--build" }
            None => {}
          }
          run(source, build)
        }
      }
    }
  }
}

fn run(source: view String, build: Bool) {
  var tokens = List<Token>.new()
  var legacy = true
  for row in source.split("\n") {
    if row.len() == 0 { continue }
    var line = 0
    var start = 0
    let colon = row.find(":")
    if colon >= 0 && row.slice(0, colon).parse_int(line) {
      legacy = false
      start = colon + 1
    }
    var col = 0
    // `line:col:Kind..` (the lexer's --columns): a second number before the kind
    let second = row.slice(start, row.len()).find(":")
    if start > 0 && second > 0 && row.slice(start, start + second).parse_int(col) { start = start + second + 1 }
    else { col = 0 }
    let rest = row.slice(start, row.len())
    let split = rest.find(":")
    var tag = String.from(rest)
    var value = String.new()
    var decoded = String.new()
    if split >= 0 {
      tag = rest.slice(0, split)
      value = rest.slice(split + 1, rest.len())
      if tag == "Id" || tag == "Sym" { decoded = unhex(value) }
    }
    tokens.push(Token { kind: move tag, value: move value, text: move decoded, line: line, col: col })
  }
  if tokens.len() == 0 || tokens.at(tokens.len() - 1).kind != "Eof" {
    print("invalid token dump")
    env.exit(2)
  }
  var structs = List<String>.new()
  for i in 0..tokens.len() - 1 {
    if tokens.at(i).kind == "Id" && tokens.at(i).text == "struct" && tokens.at(i + 1).kind == "Id" {
      structs.push(String.from(tokens.at(i + 1).value))
    }
  }
  var p = Parser {
    tokens: move tokens, structs: move structs, imports: List<String>.new(), tuple_arities: List<Int>.new(),
    i: 0, failed: false, error_line: 0, legacy: legacy, build: build, depth: 0, bare_at: 0,
    message: String.new(), notes: List<String>.new(), err_line: 0, err_col: 0, err_len: 0,
  }
  var ast = String.new()
  if legacy {
    if kw(p, "let") || kw(p, "var") || kw(p, "return") { ast = statement(p) }
    else { ast = parse_expr(p) }
  } else { ast = parse_file(p) }
  if p.failed || !kind(p, "Eof") {
    var line = p.error_line
    if line == 0 { line = p.tokens.at(p.i).line }
    // the driver draws the same diagnostic as the Rust compiler from this row (`ast-file` has only the line)
    if p.build && p.message.len() > 0 {
      print("Error:{hex(p.message)}:{p.err_line}:{p.err_col}:{p.err_len}")
      for row in p.notes { print("Note:{hex(row)}") }
    } else { print("SyntaxError:{line}") }
    env.exit(1)
  }
  print(ast)
}
