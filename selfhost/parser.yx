// Expression parser over the canonical token rows emitted by lexer.yx.
// The Rust side provides the AST-shape oracle via `yerux ast-expr`.
import std.env
import std.fs

struct Token { kind: String, value: String }
struct Parser { tokens: List<Token>, i: Int }

fn token_kind(p: view Parser) -> Int {
  if p.tokens.at(p.i).kind == "Eof" { return 0 }
  if p.tokens.at(p.i).kind == "Id" { return 1 }
  if p.tokens.at(p.i).kind == "Num" { return 2 }
  if p.tokens.at(p.i).kind == "Float" { return 3 }
  if p.tokens.at(p.i).kind == "Str" { return 4 }
  if p.tokens.at(p.i).kind == "Char" { return 5 }
  if p.tokens.at(p.i).kind == "Sym" { return 6 }
  return 7
}

fn is_sym(p: view Parser, encoded: Text) -> Bool {
  return p.tokens.at(p.i).kind == "Sym" && p.tokens.at(p.i).value == encoded
}

fn precedence(p: view Parser) -> Int {
  if is_sym(p, "7c7c") { return 1 }
  if is_sym(p, "2626") { return 2 }
  if is_sym(p, "3d3d") || is_sym(p, "213d") { return 3 }
  if is_sym(p, "3c") || is_sym(p, "3e") || is_sym(p, "3c3d") || is_sym(p, "3e3d") { return 4 }
  if is_sym(p, "2b") || is_sym(p, "2d") { return 5 }
  if is_sym(p, "2a") || is_sym(p, "2f") || is_sym(p, "25") { return 6 }
  return 0
}

fn atom(tag: Text, value: view String) -> String {
  var out = String.from(tag)
  out.push_str("(")
  out.push_str(value)
  out.push_str(")")
  return out
}

fn unary(op: view String, x: view String) -> String {
  var out = String.from("Un(")
  out.push_str(op)
  out.push_str(", ")
  out.push_str(x)
  out.push_str(")")
  return out
}

fn binary(op: view String, left: view String, right: view String) -> String {
  var out = String.from("Bin(")
  out.push_str(op)
  out.push_str(", ")
  out.push_str(left)
  out.push_str(", ")
  out.push_str(right)
  out.push_str(")")
  return out
}

fn call(name: view String, args: view String) -> String {
  var out = String.from("Call(")
  out.push_str(name)
  out.push_str(", ")
  out.push_str(args)
  out.push_str(")")
  return out
}

fn parse_primary(p: mut Parser) -> String {
  let kind = token_kind(p)
  if kind == 2 {
    let value = String.from(p.tokens.at(p.i).value)
    p.i = p.i + 1
    return atom("Int", value)
  }
  if kind == 3 {
    let value = String.from(p.tokens.at(p.i).value)
    let colon = value.find(":")
    var text = String.from(value)
    if colon >= 0 { text = text.slice(0, colon) }
    p.i = p.i + 1
    return atom("Float", text)
  }
  if kind == 4 { let value = String.from(p.tokens.at(p.i).value); p.i = p.i + 1; return atom("Text", value) }
  if kind == 5 { let value = String.from(p.tokens.at(p.i).value); p.i = p.i + 1; return atom("Char", value) }
  if kind == 1 {
    let name = String.from(p.tokens.at(p.i).value)
    p.i = p.i + 1
    if name == "74727565" { return atom("Bool", String.from("true")) }
    if name == "66616c7365" { return atom("Bool", String.from("false")) }
    if is_sym(p, "28") {
      p.i = p.i + 1
      var args = String.from("[")
      var first = true
      while !is_sym(p, "29") && token_kind(p) != 0 {
        if !first { args.push_str(",") }
        let arg = parse_expr(p, 1)
        args.push_str(arg)
        first = false
        if is_sym(p, "2c") { p.i = p.i + 1 }
        else { break }
      }
      if is_sym(p, "29") { p.i = p.i + 1 }
      args.push_str("]")
      return call(name, args)
    }
    return atom("Var", name)
  }
  if is_sym(p, "2d") || is_sym(p, "21") {
    let op = String.from(p.tokens.at(p.i).value)
    p.i = p.i + 1
    let x = parse_expr(p, 7)
    return unary(op, x)
  }
  if is_sym(p, "28") {
    p.i = p.i + 1
    let value = parse_expr(p, 1)
    if is_sym(p, "29") { p.i = p.i + 1 }
    return value
  }
  p.i = p.i + 1
  return String.from("Unsupported")
}

fn parse_expr(p: mut Parser, min_prec: Int) -> String {
  var left = parse_primary(p)
  while precedence(p) >= min_prec {
    let op = String.from(p.tokens.at(p.i).value)
    let prec = precedence(p)
    p.i = p.i + 1
    let right = parse_expr(p, prec + 1)
    left = binary(op, left, right)
  }
  return left
}

fn parse_stmt(p: mut Parser) -> String {
  if token_kind(p) == 1 && (p.tokens.at(p.i).value == "6c6574" || p.tokens.at(p.i).value == "766172") {
    let mutable = p.tokens.at(p.i).value == "766172"
    p.i = p.i + 1
    let name = String.from(p.tokens.at(p.i).value)
    p.i = p.i + 1
    if is_sym(p, "3d") { p.i = p.i + 1 }
    let value = parse_expr(p, 1)
    var out = String.from("Let(")
    out.push_str(name)
    if mutable { out.push_str(", true, ") }
    else { out.push_str(", false, ") }
    out.push_str(value)
    out.push_str(")")
    return out
  }
  if token_kind(p) == 1 && p.tokens.at(p.i).value == "72657475726e" {
    p.i = p.i + 1
    if token_kind(p) == 0 { return String.from("Return(None)") }
    let value = parse_expr(p, 1)
    var out = String.from("Return(")
    out.push_str(value)
    out.push_str(")")
    return out
  }
  let value = parse_expr(p, 1)
  var out = String.from("Expr(")
  out.push_str(value)
  out.push_str(")")
  return out
}

fn main() {
  match env.arg(1) {
    None => { print("usage: parser.yx token-dump.txt"); return }
    Some(path) => {
      match fs.read_to_string(path) {
        Err(e) => { print("could not read token dump: {e.message}"); return }
        Ok(source) => { run(source) }
      }
    }
  }
}

fn run(source: view String) {
  let lines = source.split("\n")
  var tokens = List<Token>.new()
  for line in lines {
    if line.len() > 0 {
      let colon = line.find(":")
      if colon < 0 { tokens.push(Token { kind: String.from(line), value: String.new() }) }
      else { tokens.push(Token { kind: line.slice(0, colon), value: line.slice(colon + 1, line.len()) }) }
    }
  }
  var p = Parser { tokens: move tokens, i: 0 }
  if token_kind(p) == 1 && (p.tokens.at(p.i).value == "6c6574" || p.tokens.at(p.i).value == "766172" || p.tokens.at(p.i).value == "72657475726e") {
    print(parse_stmt(p))
  } else { print(parse_expr(p, 1)) }
}
