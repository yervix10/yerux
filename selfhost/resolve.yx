// Resolve module names against the canonical source AST from parser.yx.
import std.env
import std.fs
import std.path
import std.io
import ast
import locals

struct Symbol { name: String, is_function: Bool, is_const: Bool, public: Bool }
struct Module { key: String, owner: String, loading: Bool, symbols: List<Symbol> }
struct Alias { name: String, module_id: Int }
struct FileContext { module_id: Int, aliases: List<Alias>, shadowed: List<String> }
struct Resolver {
  cache: String, root: String, modules: List<Module>, errors: Int,
  link: Bool, bootstrap: Bool, output: String, emitted_tuples: List<String>,
}

fn module_index(resolver: view Resolver, key: view String) -> Int {
  for i in 0..resolver.modules.len() {
    if resolver.modules.at(i).key == key { return i }
  }
  return -1
}

fn symbol_index(symbols: view List<Symbol>, name: view String) -> Int {
  for i in 0..symbols.len() {
    if symbols.at(i).name == name { return i }
  }
  return -1
}

fn alias_module(ctx: view FileContext, name: view String) -> Int {
  for a in ctx.aliases {
    if a.name == name { return a.module_id }
  }
  return -1
}

fn symbol_kind(is_function: Bool, is_const: Bool) -> Text {
  if is_function { return "function" }
  if is_const { return "constant" }
  return "type"
}

fn visibility(public: Bool) -> Text {
  if public { return "public" }
  return "private"
}

fn mangle(owner: view String, name: view String) -> String {
  if owner == "@" { return String.from(name) }
  let prefix = owner.replace(".", "__")
  return "{prefix}__{name}"
}

fn issue(resolver: mut Resolver, module_id: Int, message: view String) {
  let owner = String.from(resolver.modules.at(module_id).owner)
  let row = "error:{owner}:{message}"
  if resolver.link { io.eprintln(row) }
  else { print(row) }
  resolver.errors = resolver.errors + 1
}

fn dependency_file(resolver: view Resolver, dep: view String) -> String {
  let relative = dep.replace(".", "/")
  let file = "{relative}.yx"
  if dep.starts_with("std.") {
    let standard = path.join(resolver.cache, String.from("src"))
    let embedded = path.join(standard, file)
    if fs.is_file(embedded) { return embedded }
  }
  let source = path.join(resolver.root, file)
  return path.join(resolver.cache, source)
}

fn import_module(resolver: mut Resolver, ctx: mut FileContext, tree: view List<ast.AstNode>, decl: Int) {
  let dep = ast.name_at(tree, decl, 0)
  let rename = ast.child(tree, decl, 1)
  var alias = String.new()
  if tree.at(rename).tag == "_" {
    let segments = dep.split(".")
    alias = String.from(segments.at(segments.len() - 1))
  } else { alias = ast.decoded_name(tree, rename) }

  if alias_module(ctx, alias) >= 0 {
    issue(resolver, ctx.module_id, "duplicate-alias:{alias}:{dep}")
    return
  }
  var id = module_index(resolver, dep)
  if id >= 0 && resolver.modules.at(id).loading {
    issue(resolver, ctx.module_id, "cycle:{dep}")
    return
  }
  if id < 0 {
    let file = dependency_file(resolver, dep)
    if !fs.is_file(file) {
      issue(resolver, ctx.module_id, "missing-module:{dep}")
      return
    }
    id = load_module(resolver, dep, dep, file)
  }
  let owner = String.from(resolver.modules.at(ctx.module_id).owner)
  if !resolver.link { print("import:{owner}:{alias}:{dep}") }
  ctx.aliases.push(Alias { name: move alias, module_id: id })
}

fn collect_symbol(symbols: mut List<Symbol>, tree: view List<ast.AstNode>, item: Int, decl: Int) {
  let tag = String.from(tree.at(decl).tag)
  if tag != "Fn" && tag != "Struct" && tag != "Enum" && tag != "Trait" && tag != "Alias" && tag != "Const" { return }
  let name = ast.name_at(tree, decl, 0)
  let old = symbol_index(symbols, name)
  let public = tree.at(ast.child(tree, item, 0)).tag == "true"
  let symbol = Symbol { name: move name, is_function: tag == "Fn", is_const: tag == "Const", public: public }
  if old < 0 { symbols.push(move symbol) }
  else { symbols.set(old, move symbol) }
}

fn resolve_qualified(resolver: mut Resolver, ctx: view FileContext, alias: view String, name: view String) -> Bool {
  let id = alias_module(ctx, alias)
  if id < 0 { return false }
  let dep = String.from(resolver.modules.at(id).key)
  let index = symbol_index(resolver.modules.at(id).symbols, name)
  if index < 0 {
    issue(resolver, ctx.module_id, "unknown-item:{alias}:{dep}:{name}")
  } else if !resolver.modules.at(id).symbols.at(index).public {
    issue(resolver, ctx.module_id, "private-item:{alias}:{dep}:{name}")
  } else {
    let owner = String.from(resolver.modules.at(ctx.module_id).owner)
    let kind = symbol_kind(resolver.modules.at(id).symbols.at(index).is_function, resolver.modules.at(id).symbols.at(index).is_const)
    let target = mangle(dep, name)
    if !resolver.link { print("qualified:{owner}:{alias}:{dep}:{name}:{kind}:{target}") }
  }
  return true
}

fn resolve_name(resolver: mut Resolver, ctx: view FileContext, name: view String, use_kind: Text) {
  if alias_module(ctx, name) >= 0 {
    if !ctx.shadowed.contains(name) {
      issue(resolver, ctx.module_id, "module-value:{name}")
    }
    return
  }
  if use_kind == "value" { return }

  let own = symbol_index(resolver.modules.at(ctx.module_id).symbols, name)
  if own >= 0 {
    if use_kind == "function" && resolver.modules.at(ctx.module_id).symbols.at(own).is_function {
      let owner = String.from(resolver.modules.at(ctx.module_id).owner)
      let target = mangle(owner, name)
      if !resolver.link { print("call:{owner}:{name}:{target}") }
    }
    return
  }
  for a in ctx.aliases {
    let index = symbol_index(resolver.modules.at(a.module_id).symbols, name)
    if index >= 0 && resolver.modules.at(a.module_id).symbols.at(index).public &&
        !resolver.modules.at(a.module_id).symbols.at(index).is_const &&
        resolver.modules.at(a.module_id).symbols.at(index).is_function == (use_kind == "function") {
      issue(resolver, ctx.module_id, "unqualified:{name}:{use_kind}")
      return
    }
  }
}

fn resolve_path(resolver: mut Resolver, ctx: view FileContext, name: view String, use_kind: Text) {
  let pieces = name.split(".")
  if pieces.len() > 1 {
    let found = resolve_qualified(resolver, ctx, pieces.at(0), pieces.at(1))
  } else { resolve_name(resolver, ctx, name, use_kind) }
}

fn visit(resolver: mut Resolver, ctx: mut FileContext, tree: view List<ast.AstNode>, index: Int) {
  let tag = String.from(tree.at(index).tag)
  var first = index + 1
  // locals that hide a module alias (parameters, loop/match/closure binds, `let`s) end with their scope
  let mark = ctx.shadowed.len()
  var late_shadow = String.new()
  var skip_children = false
  if tag == "Field" || tag == "Method" {
    let recv = ast.child(tree, index, 0)
    if tree.at(recv).tag == "Var" {
      let alias = ast.name_at(tree, recv, 0)
      let member = ast.name_at(tree, index, 1)
      if !ctx.shadowed.contains(alias) && resolve_qualified(resolver, ctx, alias, member) {
        first = tree.at(recv).end
      }
    }
  } else if tag == "Type" || tag == "DynType" || tag == "StructLit" {
    resolve_path(resolver, ctx, ast.name_at(tree, index, 0), "type")
  } else if tag == "GenericMember" || tag == "Variant" {
    resolve_path(resolver, ctx, ast.name_at(tree, index, 0), "value")
  } else if tag == "Generic" {
    let bounds = ast.child(tree, index, 1)
    for i in bounds + 1..tree.at(bounds).end {
      resolve_path(resolver, ctx, ast.decoded_name(tree, i), "value")
    }
  } else if tag == "Call" {
    resolve_name(resolver, ctx, ast.name_at(tree, index, 0), "function")
  } else if tag == "Var" || tag == "Move" {
    resolve_name(resolver, ctx, ast.name_at(tree, index, 0), "value")
  } else if tag == "Let" {
    // the initializer still sees the module: the name is hidden only after it
    late_shadow = ast.name_at(tree, index, 0)
  } else if tag == "Unpack" {
    // RHS still sees the module; pattern names hide it afterwards (like `let`)
    visit(resolver, ctx, tree, ast.child(tree, index, 1))
    visit(resolver, ctx, tree, ast.child(tree, index, 0))
    skip_children = true
  } else if tag == "Param" {
    let name = ast.name_at(tree, index, 0)
    if alias_module(ctx, name) >= 0 { ctx.shadowed.push(move name) }
  } else if tag == "Bind" || tag == "UnpackBind" {
    let name = ast.name_at(tree, index, 0)
    if name != "_" && alias_module(ctx, name) >= 0 { ctx.shadowed.push(move name) }
  } else if tag == "For" {
    let name = ast.name_at(tree, index, 1)
    if alias_module(ctx, name) >= 0 { ctx.shadowed.push(move name) }
  }

  if !skip_children {
    var i = first
    while i < tree.at(index).end {
      visit(resolver, ctx, tree, i)
      i = tree.at(i).end
    }
  }
  if late_shadow.len() > 0 && alias_module(ctx, late_shadow) >= 0 { ctx.shadowed.push(move late_shadow) }
  if tag == "Block" || tag == "Fn" || tag == "For" || tag == "Arm" || tag == "Closure" {
    ctx.shadowed.truncate(mark)
  }
}

fn module_items(resolver: mut Resolver, ctx: mut FileContext, tree: view List<ast.AstNode>, interface_only: Bool) {
  let items = ast.child(tree, 0, 0)
  let end = tree.at(items).end
  var start = items + 1
  while start < end {
    let decl = ast.child(tree, start, 2)
    if tree.at(decl).tag != "Import" { break }
    if !interface_only { import_module(resolver, ctx, tree, decl) }
    start = tree.at(start).end
  }

  var i = start
  while i < end {
    let decl = ast.child(tree, i, 2)
    if tree.at(decl).tag == "Import" {
      issue(resolver, ctx.module_id, String.from("late-import"))
      break
    }
    i = tree.at(i).end
  }

  // Mirror the compiler's module namespace and its top-level item scan.
  var symbols = List<Symbol>.new()
  var scanned = start
  while scanned < end {
    let decl = ast.child(tree, scanned, 2)
    let tag = String.from(tree.at(decl).tag)
    if tag == "Derive" {
      // Derives generate methods but do not introduce module symbols.
    } else if tag == "Test" {
      if tree.at(ast.child(tree, scanned, 0)).tag == "true" {
        issue(resolver, ctx.module_id, String.from("public-test"))
      }
    } else {
      if tag != "Fn" && tag != "Struct" && tag != "Enum" && tag != "Trait" && tag != "Alias" && tag != "Const" && tag != "Impl" { break }
      if tag == "Const" && tree.at(ast.child(tree, scanned, 0)).tag == "true" && tree.at(ast.child(tree, decl, 1)).tag == "_" {
        issue(resolver, ctx.module_id, String.from("pub-const-untyped"))
      }
      collect_symbol(symbols, tree, scanned, decl)
    }
    scanned = tree.at(scanned).end
  }

  let owner = String.from(resolver.modules.at(ctx.module_id).owner)
  for symbol in symbols {
    let kind = symbol_kind(symbol.is_function, symbol.is_const)
    let access = visibility(symbol.public)
    let target = mangle(owner, symbol.name)
    if !resolver.link { print("symbol:{owner}:{symbol.name}:{kind}:{access}:{target}") }
  }
  resolver.modules.at(ctx.module_id).symbols = move symbols
  if interface_only { return }

  i = start
  while i < scanned {
    let decl = ast.child(tree, i, 2)
    if tree.at(decl).tag != "Test" {
      ctx.shadowed = List<String>.new()
      visit(resolver, ctx, tree, decl)
    }
    i = tree.at(i).end
  }
  if resolver.link {
    let bindings = locals.resolve(tree)
    i = start
    while i < end {
      let decl = ast.child(tree, i, 2)
      let tag = String.from(tree.at(decl).tag)
      if tag == "Struct" {
        let name = ast.name_at(tree, decl, 0)
        if name.starts_with("$tuple") {
          if resolver.emitted_tuples.contains(name) {
            i = tree.at(i).end
            continue
          }
          resolver.emitted_tuples.push(move name)
        }
      }
      if tag != "Test" && tag != "Import" {
        if resolver.output.len() != 0 { resolver.output.push_str(",") }
        resolver.output.push_str("Item(false,_,")
        linked_node(resolver, ctx, tree, bindings, decl, true)
        resolver.output.push_str(")")
      }
      i = tree.at(i).end
    }
  }
}

fn load_module(resolver: mut Resolver, key: view String, owner: view String, file: view String) -> Int {
  let module_id = resolver.modules.len()
  resolver.modules.push(Module {
    key: String.from(key), owner: String.from(owner), loading: true, symbols: List<Symbol>.new(),
  })
  if !resolver.link { print("module:{owner}") }
  match fs.read_to_string(file) {
    Err(e) => { io.eprintln("could not read {file}: {e.message}"); env.exit(2) }
    Ok(source) => {
      let tree = ast.decode(move source)
      var ctx = FileContext { module_id: module_id, aliases: List<Alias>.new(), shadowed: List<String>.new() }
      // These modules have bootstrap C shims. Resolve their namespaces from
      // source, while leaving implementation bodies to the bootstrap backend.
      let interface_only = resolver.bootstrap && ast.bootstrap_module(owner)
      module_items(resolver, ctx, tree.nodes, interface_only)
    }
  }
  resolver.modules.at(module_id).loading = false
  return module_id
}

fn encoded(name: view String) -> String {
  let digits = String.from("0123456789abcdef")
  var result = String.new()
  for i in 0..name.len() {
    let b = name.byte(i)
    result.push_byte(digits.byte(b / 16))
    result.push_byte(digits.byte(b % 16))
  }
  return result
}

fn linked_name(resolver: view Resolver, ctx: view FileContext, name: view String) -> String {
  if name.starts_with("$tuple") { return String.from(name) }
  let pieces = name.split(".")
  if pieces.len() == 1 {
    if symbol_index(resolver.modules.at(ctx.module_id).symbols, name) >= 0 {
      return mangle(resolver.modules.at(ctx.module_id).owner, name)
    }
  } else if pieces.len() == 2 {
    let id = alias_module(ctx, pieces.at(0))
    if id >= 0 { return mangle(resolver.modules.at(id).owner, pieces.at(1)) }
  }
  return String.from(name)
}

fn linked_node(resolver: mut Resolver, ctx: view FileContext, tree: view List<ast.AstNode>,
    bindings: view locals.Locals, node: Int, declaration: Bool) {
  let tag = String.from(tree.at(node).tag)
  let finish = tree.at(node).end
  if tag == "Generic" {
    let name = String.from(tree.at(ast.child(tree, node, 0)).tag)
    let bounds = ast.child(tree, node, 1)
    resolver.output.push_str("Generic({name},[")
    for i in bounds + 1..tree.at(bounds).end {
      if i != bounds + 1 { resolver.output.push_str(",") }
      let bound = ast.decoded_name(tree, i)
      resolver.output.push_str(encoded(linked_name(resolver, ctx, bound)))
    }
    resolver.output.push_str("])")
    return
  }
  if tag == "Method" || tag == "Field" {
    let receiver = ast.child(tree, node, 0)
    if tree.at(receiver).tag == "Var" && bindings.identities.at(receiver) < 0 {
      let alias = ast.name_at(tree, receiver, 0)
      let id = alias_module(ctx, alias)
      if id >= 0 {
        let member = ast.name_at(tree, node, 1)
        let name = encoded(mangle(resolver.modules.at(id).owner, member))
        if tag == "Method" {
          resolver.output.push_str("Call(")
          resolver.output.push_str(name)
          resolver.output.push_str(",")
          linked_node(resolver, ctx, tree, bindings, ast.child(tree, node, 2), false)
        } else {
          resolver.output.push_str("Var(")
          resolver.output.push_str(name)
        }
        resolver.output.push_str(")")
        return
      }
    }
  }
  resolver.output.push_str(tag)
  if finish == node + 1 {
    if tag == "[" { resolver.output.push_str("]") }
    return
  }
  if tag != "[" { resolver.output.push_str("(") }
  var at = node + 1
  let symbol_decl = declaration && (tag == "Fn" || tag == "Struct" || tag == "Enum" || tag == "Trait" || tag == "Alias" || tag == "Const")
  let identifier = tag == "Type" || tag == "StructLit" || tag == "GenericMember" || tag == "DynType" || tag == "Derive"
  let global_use = (tag == "Call" || tag == "Var") && bindings.identities.at(node) < 0
  if symbol_decl || identifier || global_use {
    let raw = ast.decoded_name(tree, at)
    let renamed = encoded(linked_name(resolver, ctx, raw))
    resolver.output.push_str(renamed)
    at = tree.at(at).end
  }
  while at < finish {
    if at != node + 1 { resolver.output.push_str(",") }
    linked_node(resolver, ctx, tree, bindings, at, false)
    at = tree.at(at).end
  }
  if tag == "[" { resolver.output.push_str("]") }
  else { resolver.output.push_str(")") }
}

fn main() {
  let args = env.args()
  let bootstrap = args.len() == 4 && args.at(1) == "--bootstrap-link"
  let link = bootstrap || (args.len() == 4 && args.at(1) == "--link")
  if args.len() != 3 && !link {
    ast.artifact_error("usage: resolve [--link|--bootstrap-link] AST_ROOT ENTRY.yx")
    return
  }
  var index = 1
  if link { index = 2 }
  let entry = String.from(args.at(index + 1))
  if path.is_absolute(entry) {
    ast.artifact_error("ENTRY.yx must be relative to AST_ROOT")
    return
  }
  let cache = String.from(args.at(index))
  let input = path.join(cache, entry)
  let key = path.stem(entry)
  var resolver = Resolver {
    cache: move cache, root: path.parent(entry), modules: List<Module>.new(), errors: 0,
    link: link, bootstrap: bootstrap, output: String.new(), emitted_tuples: List<String>.new(),
  }
  let id = load_module(resolver, key, String.from("@"), input)
  if resolver.errors > 0 { env.exit(1) }
  else if link {
    // Layouts used by the bootstrap C shims.
    if bootstrap && (module_index(resolver, String.from("std.fs")) >= 0 || module_index(resolver, String.from("std.io")) >= 0 ||
        module_index(resolver, String.from("std.process")) >= 0 ||
        module_index(resolver, String.from("std.env")) >= 0) {
      let ty = encoded(String.from("std__io__IoError"))
      if resolver.output.len() != 0 { resolver.output.push_str(",") }
      let decl = "Item(false,_,Struct({ty},[],[FieldDef(6d657373616765,Type(537472696e67,[]))]))"
      resolver.output.push_str(decl)
    }
    if bootstrap && module_index(resolver, String.from("std.process")) >= 0 {
      let status = encoded(String.from("std__process__ExitStatus"))
      let output = encoded(String.from("std__process__Output"))
      let int = encoded(String.from("Int"))
      let string = encoded(String.from("String"))
      resolver.output.push_str(",Item(false,_,Struct({status},[],[FieldDef(636f6465,Type({int},[])),FieldDef(7369676e616c,Type({int},[]))]))")
      resolver.output.push_str(",Item(false,_,Struct({output},[],[FieldDef(737461747573,Type({status},[])),FieldDef(7374646f7574,Type({string},[])),FieldDef(737464657272,Type({string},[]))]))")
    }
    print("File([{resolver.output}])")
  }
}
