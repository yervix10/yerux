// Resolve module names against the canonical source AST from parser.yx.
import std.env
import std.fs
import std.path

// A flat syntax tree. Children immediately follow their parent; end skips a subtree.
struct AstNode { tag: String, end: Int }
struct AstReader { source: String, cursor: Int, nodes: List<AstNode> }

struct Symbol { name: String, is_function: Bool, public: Bool }
struct Module { key: String, owner: String, loading: Bool, symbols: List<Symbol> }
struct Alias { name: String, module_id: Int }
struct FileContext { module_id: Int, aliases: List<Alias>, shadowed: List<String> }
struct Resolver { cache: String, root: String, modules: List<Module>, errors: Int }

fn artifact_error(message: Text) {
  print(message)
  env.exit(2)
}

fn delimiter(b: Int) -> Bool {
  return b == 40 || b == 41 || b == 91 || b == 93 || b == 44 || b == 10 || b == 13
}

fn tree_byte(reader: view AstReader) -> Int {
  if reader.cursor >= reader.source.len() { return -1 }
  return reader.source.byte(reader.cursor)
}

fn read_node(reader: mut AstReader) {
  let start = reader.cursor
  var close = 0
  var label = String.from("[")
  if tree_byte(reader) == 91 {
    close = 93
    reader.cursor = reader.cursor + 1
  } else {
    while tree_byte(reader) >= 0 && !delimiter(tree_byte(reader)) {
      reader.cursor = reader.cursor + 1
    }
    label = reader.source.slice(start, reader.cursor)
    if tree_byte(reader) == 40 {
      close = 41
      reader.cursor = reader.cursor + 1
    }
  }

  let index = reader.nodes.len()
  reader.nodes.push(AstNode { tag: move label, end: index + 1 })
  if close == 0 { return }

  if tree_byte(reader) != close {
    read_node(reader)
    while tree_byte(reader) == 44 {
      reader.cursor = reader.cursor + 1
      read_node(reader)
    }
  }
  if tree_byte(reader) != close {
    artifact_error("invalid source AST delimiter")
    return
  }
  reader.cursor = reader.cursor + 1
  reader.nodes.at(index).end = reader.nodes.len()
}

fn decode(source: String) -> AstReader {
  var reader = AstReader { source: move source, cursor: 0, nodes: List<AstNode>.new() }
  read_node(reader)
  let next = tree_byte(reader)
  if reader.nodes.at(0).tag != "File" || !(next == -1 || next == 10 || next == 13) {
    artifact_error("expected a File AST")
  }
  return move reader
}

fn child(tree: view List<AstNode>, parent: Int, offset: Int) -> Int {
  var i = parent + 1
  for j in 0..offset {
    if i >= tree.at(parent).end { artifact_error("invalid source AST node arity"); return parent }
    i = tree.at(i).end
  }
  if i >= tree.at(parent).end { artifact_error("invalid source AST node arity"); return parent }
  return i
}

fn nibble(b: Int) -> Int {
  if b >= 97 { return b - 87 }
  return b - 48
}

fn decoded_name(tree: view List<AstNode>, index: Int) -> String {
  let text = String.from(tree.at(index).tag)
  var out = String.new()
  for i in 0..text.len() / 2 {
    out.push_byte(nibble(text.byte(i * 2)) * 16 + nibble(text.byte(i * 2 + 1)))
  }
  return out
}

fn name_at(tree: view List<AstNode>, parent: Int, offset: Int) -> String {
  return decoded_name(tree, child(tree, parent, offset))
}

fn module_index(resolver: view Resolver, key: view String) -> Int {
  for i in 0..resolver.modules.len() {
    if resolver.modules.at(i).key == key { return i }
  }
  return -1
}

fn symbol_index(symbols: view List<Symbol>, name: view String) -> Int {
  for i in 0..symbols.len() {
    if symbols.at(i).name == name { return i }
  }
  return -1
}

fn alias_module(ctx: view FileContext, name: view String) -> Int {
  for a in ctx.aliases {
    if a.name == name { return a.module_id }
  }
  return -1
}

fn symbol_kind(is_function: Bool) -> Text {
  if is_function { return "function" }
  return "type"
}

fn visibility(public: Bool) -> Text {
  if public { return "public" }
  return "private"
}

fn mangle(owner: view String, name: view String) -> String {
  if owner == "@" { return String.from(name) }
  let prefix = owner.replace(".", "__")
  return "{prefix}__{name}"
}

fn issue(resolver: mut Resolver, module_id: Int, message: view String) {
  let owner = String.from(resolver.modules.at(module_id).owner)
  print("error:{owner}:{message}")
  resolver.errors = resolver.errors + 1
}

fn dependency_file(resolver: view Resolver, dep: view String) -> String {
  let relative = dep.replace(".", "/")
  let file = "{relative}.yx"
  if dep.starts_with("std.") {
    let standard = path.join(resolver.cache, String.from("src"))
    let embedded = path.join(standard, file)
    if fs.is_file(embedded) { return embedded }
  }
  let source = path.join(resolver.root, file)
  return path.join(resolver.cache, source)
}

fn import_module(resolver: mut Resolver, ctx: mut FileContext, tree: view List<AstNode>, decl: Int) {
  let dep = name_at(tree, decl, 0)
  let rename = child(tree, decl, 1)
  var alias = String.new()
  if tree.at(rename).tag == "_" {
    let segments = dep.split(".")
    alias = String.from(segments.at(segments.len() - 1))
  } else { alias = decoded_name(tree, rename) }

  if alias_module(ctx, alias) >= 0 {
    issue(resolver, ctx.module_id, "duplicate-alias:{alias}:{dep}")
    return
  }
  var id = module_index(resolver, dep)
  if id >= 0 && resolver.modules.at(id).loading {
    issue(resolver, ctx.module_id, "cycle:{dep}")
    return
  }
  if id < 0 {
    let file = dependency_file(resolver, dep)
    if !fs.is_file(file) {
      issue(resolver, ctx.module_id, "missing-module:{dep}")
      return
    }
    id = load_module(resolver, dep, dep, file)
  }
  let owner = String.from(resolver.modules.at(ctx.module_id).owner)
  print("import:{owner}:{alias}:{dep}")
  ctx.aliases.push(Alias { name: move alias, module_id: id })
}

fn collect_symbol(symbols: mut List<Symbol>, tree: view List<AstNode>, item: Int, decl: Int) {
  let tag = String.from(tree.at(decl).tag)
  if tag != "Fn" && tag != "Struct" && tag != "Enum" && tag != "Trait" { return }
  let name = name_at(tree, decl, 0)
  let old = symbol_index(symbols, name)
  let public = tree.at(child(tree, item, 0)).tag == "true"
  let symbol = Symbol { name: move name, is_function: tag == "Fn", public: public }
  if old < 0 { symbols.push(move symbol) }
  else { symbols.set(old, move symbol) }
}

fn resolve_qualified(resolver: mut Resolver, ctx: view FileContext, alias: view String, name: view String) -> Bool {
  let id = alias_module(ctx, alias)
  if id < 0 { return false }
  let dep = String.from(resolver.modules.at(id).key)
  let index = symbol_index(resolver.modules.at(id).symbols, name)
  if index < 0 {
    issue(resolver, ctx.module_id, "unknown-item:{alias}:{dep}:{name}")
  } else if !resolver.modules.at(id).symbols.at(index).public {
    issue(resolver, ctx.module_id, "private-item:{alias}:{dep}:{name}")
  } else {
    let owner = String.from(resolver.modules.at(ctx.module_id).owner)
    let kind = symbol_kind(resolver.modules.at(id).symbols.at(index).is_function)
    let target = mangle(dep, name)
    print("qualified:{owner}:{alias}:{dep}:{name}:{kind}:{target}")
  }
  return true
}

fn resolve_name(resolver: mut Resolver, ctx: view FileContext, name: view String, use_kind: Text) {
  if alias_module(ctx, name) >= 0 {
    if !ctx.shadowed.contains(name) {
      issue(resolver, ctx.module_id, "module-value:{name}")
    }
    return
  }
  if use_kind == "value" { return }

  let own = symbol_index(resolver.modules.at(ctx.module_id).symbols, name)
  if own >= 0 {
    if use_kind == "function" && resolver.modules.at(ctx.module_id).symbols.at(own).is_function {
      let owner = String.from(resolver.modules.at(ctx.module_id).owner)
      let target = mangle(owner, name)
      print("call:{owner}:{name}:{target}")
    }
    return
  }
  for a in ctx.aliases {
    let index = symbol_index(resolver.modules.at(a.module_id).symbols, name)
    if index >= 0 && resolver.modules.at(a.module_id).symbols.at(index).public &&
        resolver.modules.at(a.module_id).symbols.at(index).is_function == (use_kind == "function") {
      issue(resolver, ctx.module_id, "unqualified:{name}:{use_kind}")
      return
    }
  }
}

fn resolve_path(resolver: mut Resolver, ctx: view FileContext, name: view String, use_kind: Text) {
  let pieces = name.split(".")
  if pieces.len() > 1 {
    let found = resolve_qualified(resolver, ctx, pieces.at(0), pieces.at(1))
  } else { resolve_name(resolver, ctx, name, use_kind) }
}

fn visit(resolver: mut Resolver, ctx: mut FileContext, tree: view List<AstNode>, index: Int) {
  let tag = String.from(tree.at(index).tag)
  var first = index + 1
  if tag == "Field" || tag == "Method" {
    let recv = child(tree, index, 0)
    if tree.at(recv).tag == "Var" {
      let alias = name_at(tree, recv, 0)
      let member = name_at(tree, index, 1)
      if resolve_qualified(resolver, ctx, alias, member) {
        first = tree.at(recv).end
      }
    }
  } else if tag == "Type" || tag == "DynType" || tag == "StructLit" {
    resolve_path(resolver, ctx, name_at(tree, index, 0), "type")
  } else if tag == "GenericMember" || tag == "Variant" {
    resolve_path(resolver, ctx, name_at(tree, index, 0), "value")
  } else if tag == "Generic" {
    let bounds = child(tree, index, 1)
    for i in bounds + 1..tree.at(bounds).end {
      resolve_path(resolver, ctx, decoded_name(tree, i), "value")
    }
  } else if tag == "Call" {
    resolve_name(resolver, ctx, name_at(tree, index, 0), "function")
  } else if tag == "Var" || tag == "Move" {
    resolve_name(resolver, ctx, name_at(tree, index, 0), "value")
  } else if tag == "Let" {
    let name = name_at(tree, index, 0)
    if alias_module(ctx, name) >= 0 {
      issue(resolver, ctx.module_id, "alias-shadow:{name}")
      ctx.shadowed.push(move name)
    }
  }

  var i = first
  while i < tree.at(index).end {
    visit(resolver, ctx, tree, i)
    i = tree.at(i).end
  }
}

fn module_items(resolver: mut Resolver, ctx: mut FileContext, tree: view List<AstNode>) {
  let items = child(tree, 0, 0)
  let end = tree.at(items).end
  var start = items + 1
  while start < end {
    let decl = child(tree, start, 2)
    if tree.at(decl).tag != "Import" { break }
    import_module(resolver, ctx, tree, decl)
    start = tree.at(start).end
  }

  var i = start
  while i < end {
    let decl = child(tree, i, 2)
    if tree.at(decl).tag == "Import" {
      issue(resolver, ctx.module_id, String.from("late-import"))
      break
    }
    i = tree.at(i).end
  }

  // Mirror the compiler's module namespace and its top-level item scan.
  var symbols = List<Symbol>.new()
  var scanned = start
  while scanned < end {
    let decl = child(tree, scanned, 2)
    let tag = String.from(tree.at(decl).tag)
    if tag == "Test" {
      if tree.at(child(tree, scanned, 0)).tag == "true" {
        issue(resolver, ctx.module_id, String.from("public-test"))
      }
    } else {
      if tag != "Fn" && tag != "Struct" && tag != "Enum" && tag != "Trait" && tag != "Impl" { break }
      collect_symbol(symbols, tree, scanned, decl)
    }
    scanned = tree.at(scanned).end
  }

  let owner = String.from(resolver.modules.at(ctx.module_id).owner)
  for symbol in symbols {
    let kind = symbol_kind(symbol.is_function)
    let access = visibility(symbol.public)
    let target = mangle(owner, symbol.name)
    print("symbol:{owner}:{symbol.name}:{kind}:{access}:{target}")
  }
  resolver.modules.at(ctx.module_id).symbols = move symbols

  i = start
  while i < scanned {
    let decl = child(tree, i, 2)
    if tree.at(decl).tag != "Test" {
      ctx.shadowed = List<String>.new()
      visit(resolver, ctx, tree, decl)
    }
    i = tree.at(i).end
  }
}

fn load_module(resolver: mut Resolver, key: view String, owner: view String, file: view String) -> Int {
  let module_id = resolver.modules.len()
  resolver.modules.push(Module {
    key: String.from(key), owner: String.from(owner), loading: true, symbols: List<Symbol>.new(),
  })
  print("module:{owner}")
  match fs.read_to_string(file) {
    Err(e) => { print("could not read {file}: {e.message}"); env.exit(2) }
    Ok(source) => {
      let tree = decode(move source)
      var ctx = FileContext { module_id: module_id, aliases: List<Alias>.new(), shadowed: List<String>.new() }
      module_items(resolver, ctx, tree.nodes)
    }
  }
  resolver.modules.at(module_id).loading = false
  return module_id
}

fn main() {
  let args = env.args()
  if args.len() != 3 {
    artifact_error("usage: resolve AST_ROOT ENTRY.yx")
    return
  }
  let entry = String.from(args.at(2))
  if path.is_absolute(entry) {
    artifact_error("ENTRY.yx must be relative to AST_ROOT")
    return
  }
  let cache = String.from(args.at(1))
  let ast = path.join(cache, entry)
  let key = path.stem(entry)
  var resolver = Resolver {
    cache: move cache, root: path.parent(entry), modules: List<Module>.new(), errors: 0,
  }
  let id = load_module(resolver, key, String.from("@"), ast)
  if resolver.errors > 0 { env.exit(1) }
}
