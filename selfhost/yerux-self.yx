// Driver for the self-hosted compiler. The stage binaries are installed beside it.
import std.env
import std.fs
import std.io
import std.path
import std.process
import ast

struct Build {
  runtime: String,
  stages: String,
  root: String,
  work: String,
  seen: List<String>,
  keep_c: Bool,
  // the program is one of the compiler stages: it runs on a large stack (c_selfhost_stage.c)
  stage: Bool,
  debug: Bool,
  optimize: Bool,
}

fn report(step: view String, message: view String) {
  io.eprintln("yerux-self: {step}: {message}")
}

fn invoke(program: view String, args: view List<String>, step: view String) -> Option<String> {
  match process.run(program, args) {
    Err(error) => { report(step, error.message); return None }
    Ok(output) => {
      if output.stderr.len() > 0 { let written = io.write_stderr(output.stderr) }
      if output.status.code == 0 { return Some(String.from(output.stdout)) }
      if output.stdout.len() > 0 { let written = io.write_stderr(output.stdout) }
      if output.status.signal != 0 { report(step, "signal {output.status.signal}") }
      else { report(step, "exit code {output.status.code}") }
      return None
    }
  }
}

// Lexer and parser rejections arrive as `Error:message:line:col:length` (hex message) and `Note:` rows on
// stdout, like `yerux tokens`; draw them like the Rust compiler does.
fn front_stage(program: view String, args: view List<String>, step: view String, source: view String,
    shown: view String) -> Option<String> {
  match process.run(program, args) {
    Err(error) => { report(step, error.message); return None }
    Ok(output) => {
      if output.stderr.len() > 0 { let written = io.write_stderr(output.stderr) }
      if output.status.code == 0 { return Some(String.from(output.stdout)) }
      let rows = output.stdout.split("\n")
      var first = 0
      while first < rows.len() && !rows.at(first).starts_with("Error:") { first = first + 1 }
      if first < rows.len() { draw_error(rows, first, source, shown) }
      else if output.stdout.len() > 0 { let written = io.write_stderr(output.stdout) }
      if output.status.signal != 0 { report(step, "signal {output.status.signal}") }
      else { report(step, "exit code {output.status.code}") }
      return None
    }
  }
}

fn unhex(s: view String) -> String {
  var out = String.new()
  for i in 0..s.len() / 2 {
    var high = s.byte(i * 2) - 48
    if high > 9 { high = high - 39 }
    var low = s.byte(i * 2 + 1) - 48
    if low > 9 { low = low - 39 }
    out.push_byte(high * 16 + low)
  }
  return out
}

fn word_byte(byte: Int) -> Bool { return name_byte(byte) || byte >= 128 }

// Characters of the literal that starts at character `at` of `line` (the parser leaves their length at 0)
fn literal_len(line: view String, offsets: view List<Int>, at: Int) -> Int {
  if at >= offsets.len() { return 1 }
  var i = offsets.at(at)
  var quote = line.byte(i)
  var raw = false
  if quote == 114 {
    var j = i + 1
    while j < line.len() && line.byte(j) == 35 { j = j + 1 }
    if j < line.len() && line.byte(j) == 34 { raw = true; quote = 34; i = j }
  }
  var end = i + 1
  if quote == 34 || quote == 39 {
    while end < line.len() && line.byte(end) != quote {
      if !raw && line.byte(end) == 92 { end = end + 1 }
      end = end + 1
    }
    end = end + 1
    if raw { while end < line.len() && line.byte(end) == 35 { end = end + 1 } }
  } else {
    let number = quote >= 48 && quote <= 57
    while end < line.len() && (word_byte(line.byte(end)) ||
        (number && line.byte(end) == 46 && end + 1 < line.len() && line.byte(end + 1) >= 48 && line.byte(end + 1) <= 57)) {
      end = end + 1
    }
  }
  var size = 0
  for k in at..offsets.len() { if offsets.at(k) < end { size = size + 1 } }
  return max(size, 1)
}

fn draw_error(rows: view List<String>, first: Int, source: view String, shown: view String) {
  let parts = rows.at(first).split(":")
  var line = 0
  var col = 0
  var size = 0
  if parts.len() != 5 || !parts.at(2).parse_int(line) || !parts.at(3).parse_int(col) || !parts.at(4).parse_int(size) {
    io.eprintln(rows.at(first))
    return
  }
  io.eprintln("error: {unhex(parts.at(1))}")
  let lines = read_text(source).split("\n")
  var text = String.new()
  if line >= 1 && line <= lines.len() { text = String.from(lines.at(line - 1)) }
  while text.ends_with("\r") { text = text.slice(0, text.len() - 1) }
  var offsets = List<Int>.new()
  var at = 0
  while at < text.len() {
    offsets.push(at)
    at = at + text.char_size(at)
  }
  if size == 0 { size = literal_len(text, offsets, col - 1) }
  // a very long line is shown as a window around the column
  let column = col
  let total = offsets.len()
  if total > 200 {
    let center = min(max(col - 1, 0), total)
    let start = max(center - 80, 0)
    let stop = min(center + 80, total)
    var window = String.new()
    var lead = 0
    if start > 0 { window.push_str("..."); lead = 3 }
    var from = text.len()
    if start < total { from = offsets.at(start) }
    var to = text.len()
    if stop < total { to = offsets.at(stop) }
    window.push_str(text.slice(from, to))
    if stop < total { window.push_str("...") }
    col = center - start + lead + 1
    size = max(min(size, stop - center), 1)
    text = move window
  }
  let number = "{line}"
  var pad = String.new()
  for i in 0..number.len() { pad.push_str(" ") }
  var marks = String.new()
  for i in 1..col { marks.push_str(" ") }
  for i in 0..max(size, 1) { marks.push_str("^") }
  io.eprintln("{pad}--> {shown}:{line}:{column}")
  io.eprintln("{pad} |")
  io.eprintln("{number} | {text}")
  io.eprintln("{pad} | {marks}")
  for k in first + 1..rows.len() {
    if rows.at(k).starts_with("Note:") {
      let row = rows.at(k)
      io.eprintln("{pad} = {unhex(row.slice(5, row.len()))}")
    }
  }
}

fn write(file: view String, contents: view String) -> Bool {
  match fs.write(file, contents) {
    Ok(count) => { return true }
    Err(error) => { report(file, error.message); return false }
  }
}

// `derive Equal, Show for T` is expanded the way the production compiler does it: as Yerux source for the
// impls, appended to the module. (`derive Clone` is lowered by the code generator itself.)
fn derive_header(tree: view List<ast.AstNode>, def: Int, name: view String, kind: view String) -> List<String> {
  // result: [impl header, type spelling]
  var generics = List<String>.new()
  let list = ast.child(tree, def, 1)
  var at = list + 1
  while at < tree.at(list).end {
    generics.push(ast.name_at(tree, at, 0))
    at = tree.at(at).end
  }
  var out = List<String>.new()
  if generics.len() == 0 {
    out.push("impl {kind}")
    out.push(String.from(name))
  } else {
    var bounds = List<String>.new()
    for g in generics { bounds.push("{g}: {kind}") }
    out.push("impl<{bounds.join(", ")}> {kind}")
    out.push("{name}<{generics.join(", ")}>")
  }
  return out
}

fn variant_pattern(name: view String, prefix: view String, count: Int) -> String {
  if count == 0 { return String.from(name) }
  var parts = List<String>.new()
  for k in 0..count { parts.push("{prefix}{k}") }
  return "{name}({parts.join(", ")})"
}

fn derive_one(tree: view List<ast.AstNode>, def: Int, name: view String, kind: view String) -> String {
  let ob = String.from("{{")
  let cb = String.from("}}")
  let head = derive_header(tree, def, name, kind)
  let ih = String.from(head.at(0))
  let ty = String.from(head.at(1))
  let items = ast.child(tree, def, 2)
  var text = String.new()
  if tree.at(def).tag == "Struct" {
    var fields = List<String>.new()
    var at = items + 1
    while at < tree.at(items).end {
      fields.push(ast.name_at(tree, at, 0))
      at = tree.at(at).end
    }
    if kind == "Equal" {
      var body = String.new()
      for f in fields { body.push_str("if self.{f} != other.{f} {ob} return false {cb}\n") }
      return "{ih} for {ty} {ob} fn eq(view self, other: view {ty}) -> Bool {ob}\n{body}return true {cb} {cb}\n"
    }
    var shown = List<String>.new()
    for f in fields { shown.push("{f}: {ob}self.{f}{cb}") }
    var label = String.from(name)
    if shown.len() > 0 { label = "{name} {ob}{ob} {shown.join(", ")} {cb}{cb}" }
    return "{ih} for {ty} {ob} fn show(view self) -> String {ob} return \"{label}\" {cb} {cb}\n"
  }
  var arms = String.new()
  var at = items + 1
  while at < tree.at(items).end {
    let variant = ast.name_at(tree, at, 0)
    let count = child_total(tree, ast.child(tree, at, 1))
    let a = variant_pattern(variant, "a", count)
    if kind == "Equal" {
      let b = variant_pattern(variant, "b", count)
      var tests = List<String>.new()
      for k in 0..count { tests.push("a{k} == b{k}") }
      var result = String.from("true")
      if count > 0 { result = tests.join(" && ") }
      arms.push_str("{a} => {ob} match other {ob} {b} => {ob} return {result} {cb} _ => {ob} return false {cb} {cb} {cb}\n")
    } else {
      var label = String.from(variant)
      if count > 0 {
        var parts = List<String>.new()
        for k in 0..count { parts.push("{ob}a{k}{cb}") }
        label = "{variant}({parts.join(", ")})"
      }
      arms.push_str("{a} => {ob} return \"{label}\" {cb}\n")
    }
    at = tree.at(at).end
  }
  if kind == "Equal" {
    return "{ih} for {ty} {ob} fn eq(view self, other: view {ty}) -> Bool {ob} match self {ob}\n{arms}{cb} {cb} {cb}\n"
  }
  return "{ih} for {ty} {ob} fn show(view self) -> String {ob} match self {ob}\n{arms}{cb} {cb} {cb}\n"
}

fn child_total(tree: view List<ast.AstNode>, list: Int) -> Int {
  var n = 0
  var at = list + 1
  while at < tree.at(list).end {
    n = n + 1
    at = tree.at(at).end
  }
  return n
}

fn derive_source(tree: view List<ast.AstNode>) -> String {
  var out = String.new()
  var explicit_equal = List<String>.new()
  var implicit_equal = List<Int>.new()
  let items = ast.child(tree, 0, 0)
  var at = items + 1
  while at < tree.at(items).end {
    let item = ast.child(tree, at, 2)
    let tag = String.from(tree.at(item).tag)
    if tag == "Enum" && child_total(tree, ast.child(tree, item, 1)) == 0 {
      let variants = ast.child(tree, item, 2)
      var variant = variants + 1
      while variant < tree.at(variants).end && tree.at(variant).tag == "VariantDef" &&
          child_total(tree, ast.child(tree, variant, 1)) == 0 {
        variant = tree.at(variant).end
      }
      if variant > variants + 1 && variant == tree.at(variants).end { implicit_equal.push(item) }
    } else if tag == "Impl" {
      let trait_type = ast.child(tree, item, 1)
      let owner = ast.child(tree, item, 2)
      if tree.at(trait_type).tag == "Type" && ast.name_at(tree, trait_type, 0).eq("Equal") &&
          tree.at(owner).tag == "Type" {
        explicit_equal.push(ast.name_at(tree, owner, 0))
      }
    } else if tag == "Derive" {
      let target = ast.name_at(tree, item, 0)
      var definition = -1
      var scan = items + 1
      while scan < tree.at(items).end {
        let candidate = ast.child(tree, scan, 2)
        let tag = String.from(tree.at(candidate).tag)
        if tag == "Struct" || tag == "Enum" {
          let declared = ast.name_at(tree, candidate, 0)
          if declared == target { definition = candidate }
        }
        scan = tree.at(scan).end
      }
      let traits = ast.child(tree, item, 1)
      var trait_at = traits + 1
      while trait_at < tree.at(traits).end {
        let kind = ast.decoded_name(tree, trait_at)
        if kind == "Equal" { explicit_equal.push(String.from(target)) }
        if definition >= 0 && (kind == "Equal" || kind == "Show") {
          out.push_str(derive_one(tree, definition, target, kind))
        }
        trait_at = tree.at(trait_at).end
      }
    }
    at = tree.at(at).end
  }
  for def in implicit_equal {
    let name = ast.name_at(tree, def, 0)
    if !explicit_equal.contains(name) { out.push_str(derive_one(tree, def, name, "Equal")) }
  }
  return out
}

// A stage whose failure is not reported: the same source is read again, and reported then
fn quietly(program: view String, args: view List<String>) -> Option<String> {
  match process.run(program, args) {
    Err(error) => { return None }
    Ok(output) => {
      if output.status.code == 0 { return Some(String.from(output.stdout)) }
      return None
    }
  }
}

// Source text for `source` with the derived impls appended, or "" when it derives nothing here.
fn derived_source(build: view Build, source: view String, key: view String) -> String {
  let text = read_text(source)
  if !uses(text, "enum") && !(uses(text, "derive ") && (uses(text, "Equal") || uses(text, "Show"))) {
    return String.new()
  }
  let tokens_path = path.join(build.work, "derive-tokens")
  var args = List<String>.new()
  args.push(String.from(source))
  args.push(String.from("--positioned"))
  match quietly(path.join(build.stages, "lexer"), args) {
    None => { return String.new() }
    Some(tokens) => { if !write(tokens_path, tokens) { return String.new() } }
  }
  args.clear()
  args.push(String.from(tokens_path))
  args.push(String.from("--build"))
  var generated = String.new()
  match quietly(path.join(build.stages, "parser"), args) {
    None => { return String.new() }
    Some(contents) => {
      let parsed = ast.decode(move contents)
      generated = derive_source(parsed.nodes)
    }
  }
  if generated.len() == 0 { return String.new() }
  let combined = path.join(build.work, "derived-{key.replace("/", "_")}")
  if !write(combined, "{text}\n{generated}") { return String.new() }
  return combined
}

// `shown`: the file named by diagnostics (the user's file when `original` is a generated copy with the preludes)
fn cache_source(build: mut Build, original: view String, key: view String, shown: view String) -> Bool {
  if build.seen.contains(key) { return true }
  build.seen.push(String.from(key))
  var source = String.from(original)
  let derived = derived_source(build, original, key)
  if derived.len() > 0 { source = String.from(derived) }
  let tokens_path = path.join(build.work, "tokens")
  let lexer = path.join(build.stages, "lexer")
  var args = List<String>.new()
  args.push(String.from(source))
  args.push(String.from("--positioned"))
  args.push(String.from("--columns"))
  match front_stage(lexer, args, "lexing {source}", source, shown) {
    None => { return false }
    Some(tokens) => { if !write(tokens_path, tokens) { return false } }
  }
  let parser = path.join(build.stages, "parser")
  args.clear()
  args.push(String.from(tokens_path))
  args.push(String.from("--build"))
  match front_stage(parser, args, "parsing {source}", source, shown) {
    None => { return false }
    Some(contents) => {
      let cache_path = path.join(build.work, key)
      args.clear()
      args.push(String.from("-p"))
      args.push(String.from("--"))
      args.push(path.parent(cache_path))
      match invoke("mkdir", args, "creating AST cache") {
        None => { return false }
        Some(ok) => { if !write(cache_path, contents) { return false } }
      }

      let parsed = ast.decode(move contents)
      let items = ast.child(parsed.nodes, 0, 0)
      var at = items + 1
      while at < parsed.nodes.at(items).end {
        let declaration = ast.child(parsed.nodes, at, 2)
        if parsed.nodes.at(declaration).tag == "Import" {
          let module = ast.name_at(parsed.nodes, declaration, 0)
          if !cache_import(build, module) { return false }
        }
        at = parsed.nodes.at(at).end
      }
    }
  }
  return true
}

fn cache_import(build: mut Build, name: view String) -> Bool {
  let parts = name.replace(".", "/")
  let file = "{parts}.yx"
  if name.starts_with("std.") {
    let source = path.join(build.runtime, file)
    if fs.is_file(source) { return cache_source(build, source, "src/{file}", source) }
  }
  let source = path.join(build.root, file)
  if fs.is_file(source) { return cache_source(build, source, file, source) }
  report("resolving {name}", "source file not found: {source}")
  return false
}

// Map, Set and Arena are written in Yerux (prelude_map.yx, prelude_arena.yx); a program that names them
// gets the prelude in front of its source, like the Rust compiler's embedded prelude.
fn uses(text: view String, needle: view String) -> Bool {
  return text.split(needle).len() > 1
}

fn name_byte(byte: Int) -> Bool {
  return byte == 95 || (byte >= 48 && byte <= 57) ||
    (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
}

fn uses_word(text: view String, word: view String) -> Bool {
  var start = text.find(word)
  while start >= 0 {
    let end = start + word.len()
    if (start == 0 || !name_byte(text.byte(start - 1))) &&
        (end == text.len() || !name_byte(text.byte(end))) { return true }
    start = text.find_from(word, end)
  }
  return false
}

fn read_text(file: view String) -> String {
  match fs.read_to_string(file) {
    Err(error) => { return String.new() }
    Ok(contents) => { return String.from(contents) }
  }
  return String.new()
}

// A user type with `fn next(mut self) -> Option<T>` gets `into_iter(self) -> Iter<T>` (the Rust compiler adds the
// same impl), which is what lets the Iter adapters and `for` work on it. Line-based: `impl Name {` opens the
// impl, the `fn` lines are matched inside it.
fn iterator_impls(text: view String) -> String {
  var out = String.new()
  var names = List<String>.new()
  var items = List<String>.new()
  var done = List<String>.new()
  var current = String.new()
  for line in text.split("\n") {
    let t = line.trim()
    if t.starts_with("impl ") {
      current = String.new()
      if t.ends_with("{{") && !t.contains(" for ") && !t.contains("<") { current = String.from(t.slice(5, t.len() - 1).trim()) }
    } else if t.starts_with("fn into_iter(") {
      done.push(String.from(current))
    } else if t.starts_with("fn next(mut self) -> Option<") {
      let rest = t.slice(28, t.len())
      var close = rest.len() - 1
      while close > 0 && rest.byte(close) != 62 { close = close - 1 }
      if close > 0 && current.len() > 0 {
        names.push(String.from(current))
        items.push(String.from(rest.slice(0, close)))
      }
    }
  }
  for i in 0..names.len() {
    if done.contains(names.at(i)) { continue }
    let name = String.from(names.at(i))
    let item = String.from(items.at(i))
    out.push_str("impl {name} {{ fn into_iter(self) -> Iter<{item}> {{ var s = move self\nreturn Iter<{item}> {{ nxt: move || {{ return s.next() }} }} }} }}\n")
  }
  return out
}

// The text of the modules `text` imports (recursively): the prelude a module needs (Map, Iter, ..) is linked
// for the whole program.
fn imported_text(build: view Build, text: view String, depth: Int) -> String {
  var out = String.new()
  if depth > 8 { return out }
  for line in text.split("\n") {
    let t = line.trim()
    if !t.starts_with("import ") { continue }
    var name = String.from(t.slice(7, t.len()).trim())
    let space = name.find(" ")
    if space > 0 { name = String.from(name.slice(0, space)) }
    let file = "{name.replace(".", "/")}.yx"
    var location = path.join(build.root, file)
    if name.starts_with("std.") { location = path.join(build.runtime, file) }
    if !fs.is_file(location) { continue }
    let module = read_text(location)
    out.push_str(module)
    out.push_str("\n")
    out.push_str(imported_text(build, module, depth + 1))
  }
  return out
}

fn with_prelude(build: view Build, source: view String) -> String {
  let text = read_text(source)
  let scan = "{text}\n{imported_text(build, text, 0)}"
  var head = String.new()
  if uses_word(scan, "Atomic") {
    head.push_str(read_text(path.join(build.runtime, "prelude_atomic.yx")))
  }
  if uses(scan, "parallel") {
    head.push_str(read_text(path.join(build.runtime, "prelude_parallel.yx")))
  }
  let iterates = uses(scan, "Iter<") || uses(scan, "Iter.") || uses(scan, ".into_iter(") || uses(scan, "fn next(mut self) -> Option<")
  // the iterator prelude has to_set / to_map, which need Set and Map
  if iterates || uses(scan, "Map<") || uses(scan, "Set<") || uses(scan, "Map.") || uses(scan, "Set.") {
    head.push_str(read_text(path.join(build.runtime, "prelude_map.yx")))
  }
  if iterates {
    head.push_str(read_text(path.join(build.runtime, "prelude_iter.yx")))
  }
  if uses(scan, ".context(") || uses(scan, ".with_context(") || uses(scan, ".wrap(") {
    head.push_str(read_text(path.join(build.runtime, "prelude_error.yx")))
  }
  var synchronized = false
  for word in ["Sender", "Receiver", "Shared", "Locked", "Mutex", "RwLock", "thread_pool", "select2"] {
    if uses(scan, word) { synchronized = true }
  }
  if synchronized { head.push_str(read_text(path.join(build.runtime, "prelude_sync.yx"))) }
  if uses_word(scan, "spawn") || uses_word(scan, "JoinHandle") || uses_word(scan, "ThreadPanic") {
    head.push_str(read_text(path.join(build.runtime, "prelude_spawn.yx")))
  }
  if uses(scan, "Arena") {
    head.push_str(read_text(path.join(build.runtime, "prelude_arena.yx")))
  }
  var tail = String.new()
  if iterates { tail = iterator_impls(text) }
  if head.len() == 0 && tail.len() == 0 { return String.new() }
  // imports must stay first: the prelude goes after the leading import lines
  var top = String.new()
  var rest = String.new()
  var in_top = true
  for line in text.split("\n") {
    if in_top && !(line.starts_with("import ") || line.starts_with("//") || line.len() == 0) { in_top = false }
    if in_top { top.push_str(line); top.push_str("\n") }
    else { rest.push_str(line); rest.push_str("\n") }
  }
  let combined = path.join(build.work, "with_prelude.yx")
  if !write(combined, "{top}{rest}\n{head}\n{tail}") { return String.new() }
  return combined
}

// Keep emitted C usable without a separate copy of the installed runtime.
fn emit_c(build: view Build, body: view String, output: view String) -> Bool {
  var contents = String.new()
  for row in body.split("\n") {
    if row.starts_with("#include \"c_") && row.ends_with(".h\"") {
      let header = path.join(build.runtime, row.slice(10, row.len() - 1))
      match fs.read_to_string(header) {
        Err(error) => { report(header, error.message); return false }
        Ok(text) => { contents.push_str(text) }
      }
    } else {
      contents.push_str(row)
    }
    contents.push_str("\n")
  }
  if output.len() > 0 { return publish(path.join(build.work, "program.c"), output, contents) }
  match io.write_stdout(contents) {
    Err(error) => { report("writing C", error.message); return false }
    Ok(count) => { return true }
  }
}

fn compile(build: mut Build, source: view String, output: view String, mode: view String) -> Bool {
  let entry = path.file_name(source)
  var origin = String.from(source)
  let combined = with_prelude(build, source)
  if combined.len() > 0 { origin = String.from(combined) }
  if !cache_source(build, origin, entry, source) { return false }
  let resolver = path.join(build.stages, "resolve")
  let linked_path = path.join(build.work, "linked.ast")
  var args = List<String>.new()
  args.push(String.from("--link"))
  args.push(String.from(build.work))
  args.push(move entry)
  match invoke(resolver, args, "resolving {source}") {
    None => { return false }
    Some(linked) => {
      if mode == "ast" { return publish(linked_path, output, linked) }
      if !write(linked_path, linked) { return false }
    }
  }
  let generator = path.join(build.stages, "codegen")
  let c_file = path.join(build.work, "program.c")
  args.clear()
  args.push(move linked_path)
  // panic locations: the name printed after `at`, and how many lines are the user's (the prelude follows them)
  let user_lines = read_text(source).split("\n").len()
  args.push(String.from(source))
  args.push("{user_lines}")
  match invoke(generator, args, "checking and generating C for {source}") {
    None => { return false }
    Some(body) => {
      if mode == "check" { print("ok: no type or ownership errors"); return true }
      if mode == "c" { return emit_c(build, body, output) }
      if !write(c_file, body) { return false }
    }
  }

  if build.keep_c {
    args.clear()
    args.push(String.from("--"))
    args.push(String.from(c_file))
    args.push("{output}.c")
    match invoke("cp", args, "keeping the generated C") {
      None => { return false }
      Some(ok) => {}
    }
  }

  let exe = path.join(build.work, "program")
  args = String.from("-std=gnu11,-w,-fno-math-errno,-ffp-contract=off,-pthread,-I").split(",")
  args.push(String.from(build.runtime))
  args.push(move c_file)
  args.push(String.from("-o"))
  args.push(String.from(exe))
  if build.stage {
    args.push(String.from("-Dmain=sc_stage_main"))
    args.push(path.join(build.runtime, "c_selfhost_stage.c"))
  }
  args.push(String.from("-lm"))
  if build.optimize { args.push(String.from("-O2")) }
  else { args.push(String.from("-O0")) }
  if build.debug { args.push(String.from("-g")) }
  let flags = env.get_or("YERUX_CC_FLAGS", "").replace("\t", " ").replace("\n", " ").replace("\r", " ")
  for flag in flags.split(" ") {
    if flag.len() > 0 { args.push(String.from(flag)) }
  }
  var cc = env.get_or("YERUX_CC", "cc")
  if cc.len() == 0 { cc = String.from("cc") }
  match invoke(cc, args, "compiling C for {source}") {
    None => { return false }
    Some(ok) => {}
  }
  return move_output(exe, output)
}

fn publish(file: view String, output: view String, contents: view String) -> Bool {
  return write(file, contents) && move_output(file, output)
}

fn move_output(file: view String, output: view String) -> Bool {
  var args = List<String>.new()
  args.push(String.from("-T"))
  args.push(String.from("--"))
  args.push(String.from(file))
  args.push(String.from(output))
  match invoke("mv", args, "publishing {output}") {
    None => { return false }
    Some(ok) => { return true }
  }
}

fn valid_name(name: view String) -> Bool {
  if name.len() == 0 { return false }
  for i in 0..name.len() {
    let c = name.byte(i)
    if !(c >= 48 && c <= 57) && !(c >= 65 && c <= 90) && !(c >= 97 && c <= 122) &&
        c != 45 && c != 95 { return false }
  }
  return true
}

fn package_name(manifest: view String) -> Option<String> {
  match fs.read_to_string(manifest) {
    Err(error) => { report(manifest, error.message); return None }
    Ok(contents) => {
      var section = String.new()
      var name = String.new()
      for raw in contents.split("\n") {
        let row = raw.trim()
        if row.len() == 0 || row.starts_with("#") { continue }
        if row.starts_with("[") {
          section = String.from(row)
        } else if section == "[dependencies]" {
          report(manifest, "package dependencies are unsupported")
          return None
        } else if section == "[package]" {
          let sep = row.find("=")
          if sep < 0 { continue }
          let key = row.slice(0, sep).trim()
          if key == "name" {
            let value = row.slice(sep + 1, row.len()).trim()
            if value.len() >= 2 && value.starts_with("\"") && value.ends_with("\"") {
              name = value.slice(1, value.len() - 1)
            }
          }
        }
      }
      if valid_name(name) { return Some(move name) }
      report(manifest, "expected a quoted package name with ASCII letters, digits, '-' or '_'")
      return None
    }
  }
}

fn usage() {
  print("usage: yerux-self [build|check|c] [FILE.yx|PROJECT_DIR|yerux.toml] [-o OUTPUT] [--debug|--release] [--no-opt] [--runtime DIRECTORY] [--emit-ast] [--keep-c] | --stage2 [--sources DIR] [-o DIR]")
}

// Rebuild every compiler stage (and this driver) from `sources` with the stages installed next to this
// executable. The result directory is a complete installation: running its yerux-self with --stage2 again
// builds the next generation, and tests/selfhost_stage2.sh compares the generated C of both.
fn build_stage2(stages: view String, runtime: view String, sources: view String, output: view String) {
  var out = String.from(output)
  if out.len() == 0 { out = String.from("target/stage2") }
  let names = String.from("lexer,parser,resolve,types,codegen,fmt,yerux-self").split(",")
  var args = List<String>.new()
  args.push(String.from("-p"))
  args.push(String.from("--"))
  args.push(String.from(out))
  match invoke("mkdir", args, "creating {out}") {
    None => { env.exit(1); return }
    Some(ok) => {}
  }
  let driver = path.join(stages, "yerux-self")
  for name in names {
    args.clear()
    args.push(String.from("build"))
    args.push(path.join(sources, "{name}.yx"))
    args.push(String.from("-o"))
    args.push(path.join(out, name))
    args.push(String.from("--keep-c"))
    args.push(String.from("--stage"))
    args.push(String.from("--runtime"))
    args.push(String.from(runtime))
    match invoke(driver, args, "building stage {name}") {
      None => { env.exit(1); return }
      Some(ok) => { print("stage2: {name}") }
    }
  }
  args.clear()
  args.push(String.from("-R"))
  args.push(String.from("-T"))
  args.push(String.from("--"))
  args.push(String.from(runtime))
  args.push(path.join(out, "runtime"))
  match invoke("cp", args, "installing the runtime") {
    None => { env.exit(1) }
    Some(ok) => {}
  }
}

fn main() {
  let cli = env.args()
  var input = String.new()
  var output = String.new()
  var runtime = String.new()
  var mode = String.from("build")
  var keep_c = false
  var debug = false
  var release = false
  var no_opt = false
  var stage2 = false
  var stage = false
  var sources = String.new()
  var i = 1
  if i < cli.len() && (cli.at(i) == "build" || cli.at(i) == "check" || cli.at(i) == "c") {
    mode = String.from(cli.at(i))
    i = i + 1
  }
  while i < cli.len() {
    let arg = String.from(cli.at(i))
    if arg == "--help" || arg == "-h" { usage(); return }
    if arg == "--emit-ast" && mode == "build" { mode = String.from("ast") }
    else if arg == "--keep-c" { keep_c = true }
    else if arg == "--debug" { debug = true }
    else if arg == "--release" { release = true }
    else if arg == "--no-opt" { no_opt = true }
    else if arg == "--stage2" { stage2 = true }
    else if arg == "--stage" { stage = true }
    else if arg == "-o" || arg == "--runtime" || arg == "--sources" {
      i = i + 1
      if i >= cli.len() { usage(); env.exit(2); return }
      if arg == "-o" { output = String.from(cli.at(i)) }
      else if arg == "--sources" { sources = String.from(cli.at(i)) }
      else { runtime = String.from(cli.at(i)) }
    } else if arg.starts_with("-") || input.len() != 0 {
      usage()
      env.exit(2)
      return
    } else { input = move arg }
    i = i + 1
  }
  if (debug && release) || (mode == "check" && output.len() > 0) ||
      (keep_c && mode != "build") || (!stage2 && sources.len() > 0) ||
      (stage2 && (input.len() > 0 || mode != "build" || keep_c || debug || release || no_opt)) {
    usage()
    env.exit(2)
    return
  }

  var stages = String.new()
  match env.current_exe() {
    Err(error) => { report("locating stage binaries", error.message); env.exit(1); return }
    Ok(exe) => { stages = path.parent(exe) }
  }
  if runtime.len() == 0 { runtime = path.join(stages, "runtime") }
  if !fs.is_file(path.join(runtime, "c_runtime.h")) {
    report(runtime, "runtime headers not found")
    env.exit(1)
    return
  }

  if stage2 {
    if sources.len() == 0 { sources = String.from("selfhost") }
    build_stage2(stages, runtime, sources, output)
    return
  }

  var args = List<String>.new()
  if !input.ends_with(".yx") {
    if input.len() == 0 { input = String.from(".") }
    var manifest = path.join(input, "yerux.toml")
    let base = path.file_name(input)
    if base == "yerux.toml" {
      manifest = String.from(input)
      input = path.parent(input)
    }
    match package_name(manifest) {
      None => { env.exit(1); return }
      Some(name) => {
        if output.len() == 0 && (mode == "build" || mode == "ast") {
          let target = path.join(input, "target")
          args.push(String.from("-p"))
          args.push(String.from("--"))
          args.push(String.from(target))
          match invoke("mkdir", args, "creating project target directory") {
            None => { env.exit(1); return }
            Some(ok) => {
              output = path.join(target, name)
              if mode == "ast" { output.push_str(".ast") }
            }
          }
        }
      }
    }
    input = path.join(input, "src/main.yx")
  } else if output.len() == 0 {
    if mode == "ast" { output = path.with_extension(input, "ast") }
    if mode == "build" { output = path.with_extension(input, "") }
  }

  args.clear()
  args.push(String.from("-d"))
  if output.len() > 0 {
    args.push(String.from("--"))
    args.push(path.join(path.parent(output), ".yerux-self.XXXXXX"))
  }
  match invoke("mktemp", args, "creating build directory") {
    None => { env.exit(1) }
    Some(created) => {
      var build = Build {
        runtime: move runtime, stages: move stages, root: path.parent(input),
        work: created.slice(0, created.len() - 1), seen: List<String>.new(),
        keep_c: keep_c, stage: stage, debug: debug, optimize: !(debug || no_opt),
      }
      let success = compile(build, input, output, mode)
      args.clear()
      args.push(String.from("-rf"))
      args.push(String.from("--"))
      args.push(String.from(build.work))
      match invoke("rm", args, "removing build directory") {
        None => { env.exit(1) }
        Some(ok) => { if !success { env.exit(1) } }
      }
    }
  }
}
