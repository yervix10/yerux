// Type checking over the source AST and its lexical binding identities.
import std.env
import std.fs
import ast
import locals
import type_terms
import ownership

struct FieldType { name: String, ty: String }
struct Variant { name: String, payload: List<String> }
struct Shape { name: String, generics: List<String>, fields: List<FieldType>, variants: List<Variant>, is_enum: Bool, user_drop: Bool }
pub struct Parameter { mode: String, ty: String }
struct Signature {
  name: String, spelling: String, args: List<Parameter>, result: String,
  owner: String, receiver: String, generics: List<String>, copy_params: List<String>, ordered_params: List<String>,
  required_trait: String,
}
struct Function { node: Int, signature: Int, impl_params: Int }
struct Frozen { binding: Int, place: String, exclusive: Bool, from_let: Bool }
struct Types {
  identities: List<Int>,
  declarations: List<Int>,
  captures: List<locals.Capture>,
  bindings: List<String>,
  shapes: List<Shape>,
  signatures: List<Signature>,
  errors: Int,
  generics: List<String>,
  function_params: Int,
  impl_params: Int,
  return_type: String,
  verify_ownership: Bool,
  copy_params: List<String>,
  ordered_params: List<String>,
  modes: List<String>,
  equal_types: List<String>,
  lead: Int,
  variadics: List<String>,
  lead_type: String,
  shown_types: List<String>,
  ordered_types: List<String>,
  aliases: List<String>,
  moved: List<Bool>,
  loops: List<LoopFlow>,
  deferred: List<Int>,
  defer_floor: Int,
  frozen: List<Frozen>,
  trace: Bool,
  expressions: List<String>,
  borrowed_closures: List<Bool>,
  box_places: List<Bool>,
  messages: List<String>,
}
pub struct Checked {
  bindings: List<String>, expressions: List<String>, messages: List<String>, borrowed_closures: List<Bool>, errors: Int,
}
struct LoopFlow { label: String, breaks: List<Bool>, continues: List<Bool>, continued: Bool, deferred: Int }
struct PatternRow { nodes: List<Int> }
// `want` marks the tail of an `if`/`match` used as a value: its last line produces `value`.
struct Returns { expected: String, inferred: String, want: Bool, hint: String, value: String }

fn unknown() -> String { return String.from("?") }
fn unit() -> String { return String.from("nothing") }

fn issue(types: mut Types, message: view String) {
  types.messages.push("error: {message}")
  types.errors = types.errors + 1
}

fn expect_type(types: mut Types, expected: view String, actual: view String) {
  if !type_terms.compatible(expected, actual) {
    issue(types, "expected {expected} but this is {actual}")
  }
}

fn integer(ty: view String) -> Bool {
  return ty == "Int" || ty == "Int8" || ty == "Int16" || ty == "Int32" ||
    ty == "UInt8" || ty == "UInt16" || ty == "UInt32" || ty == "UInt64"
}

fn floating(ty: view String) -> Bool { return ty == "Float" || ty == "Float32" }

pub fn numeric_conversion(name: view String) -> String {
  var target = String.new()
  if name.starts_with("to_") { target = name.slice(3, name.len()) }
  if name.starts_with("truncate_") { target = name.slice(9, name.len()) }
  if target == "int" || target == "int64" { return String.from("Int") }
  if target == "int8" { return String.from("Int8") }
  if target == "int16" { return String.from("Int16") }
  if target == "int32" { return String.from("Int32") }
  if target == "uint8" { return String.from("UInt8") }
  if target == "uint16" { return String.from("UInt16") }
  if target == "uint32" { return String.from("UInt32") }
  if target == "uint64" { return String.from("UInt64") }
  if name == "to_float" || name == "to_float64" { return String.from("Float") }
  if name == "to_float32" { return String.from("Float32") }
  return unknown()
}

pub fn math_arity(name: view String) -> Int {
  if name == "atan2" || name == "pow" || name == "min" || name == "max" || name == "copysign" { return 2 }
  if name == "sqrt" || name == "sin" || name == "cos" || name == "tan" || name == "asin" ||
      name == "acos" || name == "atan" || name == "exp" || name == "ln" || name == "floor" ||
      name == "ceil" || name == "round" || name == "trunc" || name == "abs" || name == "to_bits" ||
      name == "floor_int" || name == "ceil_int" || name == "round_int" || name == "is_nan" ||
      name == "is_inf" || name == "is_finite" { return 1 }
  return 0
}

fn check_math(types: mut Types, tree: view List<ast.AstNode>, name: view String, args: Int,
    receiver: view String) -> String {
  let arity = math_arity(name)
  let method = receiver != ""
  var expected = arity
  if method { expected = expected - 1 }
  if child_count(tree, args) != expected {
    issue(types, "{name} expects {expected} argument(s)")
    return unknown()
  }
  var ty = numeric_type(receiver)
  var next = args + 1
  if !method {
    ty = numeric_type(infer(types, tree, next, unknown()))
    next = tree.at(next).end
  }
  if arity == 2 { expect_type(types, ty, infer(types, tree, next, ty)) }
  if ty == "?" { return ty }
  if !floating(ty) {
    if integer(ty) && (name == "min" || name == "max" || (name == "abs" && !ty.starts_with("UInt"))) {
      return ty
    }
    issue(types, "{name} is unavailable for {ty}")
    return unknown()
  }
  if name == "is_nan" || name == "is_inf" || name == "is_finite" { return String.from("Bool") }
  if name == "floor_int" || name == "ceil_int" || name == "round_int" { return String.from("Int") }
  if name == "to_bits" {
    if ty == "Float32" { return String.from("UInt32") }
    return String.from("UInt64")
  }
  return ty
}

fn suffix_type(suffix: view String) -> String {
  if suffix == "i8" { return String.from("Int8") }
  if suffix == "i16" { return String.from("Int16") }
  if suffix == "i32" { return String.from("Int32") }
  if suffix == "i64" { return String.from("Int") }
  if suffix == "u8" { return String.from("UInt8") }
  if suffix == "u16" { return String.from("UInt16") }
  if suffix == "u32" { return String.from("UInt32") }
  if suffix == "u64" { return String.from("UInt64") }
  if suffix == "f32" { return String.from("Float32") }
  if suffix == "f64" { return String.from("Float") }
  return unknown()
}

fn shape_index(types: view Types, name: view String) -> Int {
  let base = type_terms.base(name)
  for i in 0..types.shapes.len() {
    if types.shapes.at(i).name == base { return i }
  }
  return -1
}

fn field_index(shape: view Shape, name: view String) -> Int {
  for i in 0..shape.fields.len() {
    if shape.fields.at(i).name == name { return i }
  }
  return -1
}

fn signature_index(types: view Types, name: view String, by_type: Bool) -> Int {
  for i in 0..types.signatures.len() {
    if by_type {
      if types.signatures.at(i).owner == "" && types.signatures.at(i).generics.len() == 0 &&
          types.signatures.at(i).spelling == name { return i }
    } else if types.signatures.at(i).owner == "" && types.signatures.at(i).name == name { return i }
  }
  return -1
}

fn add_signature(types: mut Types, name: view String, args: List<Parameter>, ret: view String) -> String {
  var text = String.from("fn(")
  for i in 0..args.len() {
    if i > 0 { text.push_str(", ") }
    if args.at(i).mode == "View" { text.push_str("view ") }
    if args.at(i).mode == "Mut" { text.push_str("mut ") }
    text.push_str(args.at(i).ty)
  }
  text.push_str(")")
  if ret != "nothing" {
    text.push_str(" -> ")
    text.push_str(ret)
  }
  types.signatures.push(Signature {
    name: String.from(name), spelling: String.from(text), args: move args, result: String.from(ret),
    owner: String.new(), receiver: String.new(), generics: List<String>.new(),
    copy_params: List<String>.new(), ordered_params: List<String>.new(), required_trait: String.new(),
  })
  return text
}

fn value_signature(types: mut Types, ty: view String) -> Int {
  let existing = signature_index(types, ty, true)
  if existing >= 0 || !ty.starts_with("fn(") { return existing }
  var parts = type_terms.function_parts(ty)
  let result = parts.pop()
  var parameters = List<Parameter>.new()
  for part in parts { parameters.push(function_parameter(part)) }
  let index = types.signatures.len()
  let spelling = add_signature(types, String.new(), move parameters, result)
  return index
}

pub fn function_parameter(part: view String) -> Parameter {
  let prefix = type_terms.parameter_prefix(part)
  var mode = String.from("Own")
  if prefix == 5 { mode = String.from("View") }
  else if prefix == 4 { mode = String.from("Mut") }
  return Parameter { mode: move mode, ty: part.slice(prefix, part.len()) }
}

fn source_type(types: mut Types, tree: view List<ast.AstNode>, index: Int) -> String {
  if tree.at(index).tag == "_" { return unknown() }
  if tree.at(index).tag == "DynType" {
    let name = ast.name_at(tree, index, 0)
    return "$dyn<{name}>"
  }
  if tree.at(index).tag == "BracketType" {
    let item = source_type(types, tree, ast.child(tree, index, 0))
    let size = ast.child(tree, index, 1)
    if tree.at(size).tag == "_" { return type_terms.bracket(item, String.from("_")) }
    let length = ast.fold_const(tree, size, 0)
    if length.len() > 0 { return type_terms.bracket(item, length) }
    // `[T; K]` with a `const K: Int` generic parameter: the length is the parameter's name until it is bound
    if tree.at(size).tag == "Var" && types.generics.contains(ast.name_at(tree, size, 0)) {
      return type_terms.bracket(item, ast.name_at(tree, size, 0))
    }
    return unknown()
  }
  if tree.at(index).tag == "Type" {
    let name = ast.name_at(tree, index, 0)
    let args = ast.child(tree, index, 1)
    if name == "Int" { return ast.range_type(tree, args) }
    if name == "Int64" { return String.from("Int") }
    if name == "Float64" { return String.from("Float") }
    if integer(name) || floating(name) || name == "Bool" || name == "Char" ||
        name == "Text" || name == "String" || shape_index(types, name) >= 0 ||
        types.generics.contains(name) || name == "List" || name == "Box" || name == "Ptr" ||
        name == "JoinHandle" || name == "ThreadPanic" || name == "ThreadDone" {
      return type_terms.apply(name, source_types(types, tree, ast.child(tree, index, 1)))
    }
    let target = ast.alias_target(tree, name)
    if target >= 0 {
      if types.aliases.contains(name) {
        issue(types, "cyclic type alias {name}")
        return unknown()
      }
      types.aliases.push(String.from(name))
      let ty = source_type(types, tree, target)
      let unused = types.aliases.pop()
      return ty
    }
  }
  if tree.at(index).tag == "FnType" {
    let ps = ast.child(tree, index, 0)
    let ret = return_type(types, tree, ast.child(tree, index, 1))
    var args = List<Parameter>.new()
    var i = ps + 1
    while i < tree.at(ps).end {
      let mode = String.from(tree.at(ast.child(tree, i, 0)).tag)
      let ty = source_type(types, tree, ast.child(tree, i, 1))
      args.push(Parameter { mode: move mode, ty: move ty })
      i = tree.at(i).end
    }
    return add_signature(types, String.new(), move args, ret)
  }
  return unknown()
}

fn source_types(types: mut Types, tree: view List<ast.AstNode>, list: Int) -> List<String> {
  var args = List<String>.new()
  var i = list + 1
  while i < tree.at(list).end {
    args.push(source_type(types, tree, i))
    i = tree.at(i).end
  }
  return move args
}

fn generic_names(tree: view List<ast.AstNode>, list: Int) -> List<String> {
  var names = List<String>.new()
  var i = list + 1
  while i < tree.at(list).end {
    names.push(ast.name_at(tree, i, 0))
    i = tree.at(i).end
  }
  return move names
}

fn copy_names(names: view List<String>) -> List<String> {
  var copy = List<String>.new()
  for name in names { copy.push(String.from(name)) }
  return move copy
}

fn instantiate(ty: view String, names: view List<String>, actual: view String) -> String {
  var sub = type_terms.with_names(names)
  let args = type_terms.arguments(actual)
  for i in 0..min(args.len(), names.len()) {
    sub.values.set(i, String.from(args.at(i)))
  }
  return type_terms.substitute(ty, sub)
}

fn return_type(types: mut Types, tree: view List<ast.AstNode>, index: Int) -> String {
  if tree.at(index).tag == "_" { return unit() }
  return source_type(types, tree, index)
}

fn param_types(types: mut Types, tree: view List<ast.AstNode>, params: Int, hint: Int, assign: Bool) -> List<Parameter> {
  var args = List<Parameter>.new()
  var i = params + 1
  while i < tree.at(params).end {
    if tree.at(i).tag == "Param" {
      let type_node = ast.child(tree, i, 2)
      var ty = source_type(types, tree, type_node)
      var mode = String.from(tree.at(ast.child(tree, i, 1)).tag)
      if hint >= 0 && args.len() < types.signatures.at(hint).args.len() && tree.at(type_node).tag == "_" {
        ty = String.from(types.signatures.at(hint).args.at(args.len()).ty)
        mode = String.from(types.signatures.at(hint).args.at(args.len()).mode)
      }
      if assign {
        let id = types.identities.at(i)
        if id >= 0 {
          types.bindings.set(id, String.from(ty))
          types.modes.set(id, String.from(mode))
        }
      }
      args.push(Parameter { mode: move mode, ty: move ty })
    }
    i = tree.at(i).end
  }
  return args
}

fn int_literal(types: mut Types, number: view String, ty: view String, negative: Bool) -> String {
  // Keep UInt64 payloads as text since they can exceed the host's Int.
  var lo = -9223372036854775807 - 1
  var hi = 9223372036854775807
  if ty == "Int8" { lo = -128; hi = 127 }
  else if ty == "Int16" { lo = -32768; hi = 32767 }
  else if ty == "Int32" { lo = -2147483648; hi = 2147483647 }
  else if ty == "UInt8" { lo = 0; hi = 255 }
  else if ty == "UInt16" { lo = 0; hi = 65535 }
  else if ty == "UInt32" { lo = 0; hi = 4294967295 }

  var signed = String.from(number)
  if negative { signed = "-{number}" }
  var n = 0
  if ty == "UInt64" {
    if negative && number != "0" {
      issue(types, "the literal {signed} does not fit UInt64 (0 to 18446744073709551615)")
    }
  } else if !signed.parse_int(n) || n < lo || n > hi {
    issue(types, "the literal {signed} does not fit {ty} ({lo} to {hi})")
  }
  return String.from(ty)
}

fn literal_integer(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String, negative: Bool) -> String {
  var ty = unknown()
  if tree.at(index).tag == "NumT" {
    ty = suffix_type(tree.at(ast.child(tree, index, 1)).tag)
  }
  if ty == "?" {
    if floating(hint) { return String.from(hint) }
    if integer(hint) { ty = String.from(hint) }
    else { ty = String.from("Int") }
  }
  let number = ast.child(tree, index, 0)
  return int_literal(types, tree.at(number).tag, ty, negative)
}

fn child_count(tree: view List<ast.AstNode>, index: Int) -> Int {
  var count = 0
  var i = index + 1
  while i < tree.at(index).end {
    count = count + 1
    i = tree.at(i).end
  }
  return count
}

fn is_owned(types: view Types, ty: view String, visiting: mut List<String>) -> Bool {
  let base = type_terms.base(ty)
  if base == "String" || base == "List" || ty.starts_with("fn(") { return true }
  if types.generics.contains(ty) { return !types.copy_params.contains(ty) }
  let shape = shape_index(types, ty)
  if shape < 0 { return base == "Box" || base == "$dyn" || base == "JoinHandle" }
  if visiting.contains(ty) { return false }
  if types.shapes.at(shape).user_drop { return true }
  visiting.push(String.from(ty))
  var owns = false
  for field in types.shapes.at(shape).fields {
    let inner = instantiate(field.ty, types.shapes.at(shape).generics, ty)
    if is_owned(types, inner, visiting) { owns = true; break }
  }
  if !owns {
    for variant in types.shapes.at(shape).variants {
      for payload in variant.payload {
        let inner = instantiate(payload, types.shapes.at(shape).generics, ty)
        if is_owned(types, inner, visiting) { owns = true; break }
      }
      if owns { break }
    }
  }
  let last = visiting.pop()
  return owns
}

fn owns_value(types: view Types, ty: view String) -> Bool {
  if !types.verify_ownership { return false }
  var visiting = List<String>.new()
  return is_owned(types, ty, visiting)
}

fn root_place(types: view Types, tree: view List<ast.AstNode>, node: Int) -> Int {
  if tree.at(node).tag == "Var" { return node }
  if tree.at(node).tag == "Field" || tree.at(node).tag == "Slice" {
    return root_place(types, tree, ast.child(tree, node, 0))
  }
  if tree.at(node).tag == "Method" &&
      (tree.at(ast.child(tree, node, 1)).tag == "6174" || types.box_places.at(node)) {
    return root_place(types, tree, ast.child(tree, node, 0))
  }
  return -1
}

fn through_lock(tree: view List<ast.AstNode>, node: Int) -> Bool {
  var at = node
  while tree.at(at).tag == "Method" || tree.at(at).tag == "Field" || tree.at(at).tag == "Slice" {
    if tree.at(at).tag == "Method" {
      let member = ast.name_at(tree, at, 1)
      if member == "locked_value" { return true }
    }
    at = ast.child(tree, at, 0)
  }
  return false
}

fn place_name(tree: view List<ast.AstNode>, node: Int) -> String {
  if tree.at(node).tag == "Slice" {
    let base = place_name(tree, ast.child(tree, node, 0))
    return "{base}[..]"
  }
  if tree.at(node).tag == "Method" {
    let base = place_name(tree, ast.child(tree, node, 0))
    let name = ast.name_at(tree, node, 1)
    if name == "get" { return "{base}.get()" }
    return "{base}.at(..)"
  }
  if tree.at(node).tag == "Field" {
    let base = place_name(tree, ast.child(tree, node, 0))
    let field = ast.name_at(tree, node, 1)
    return "{base}.{field}"
  }
  return ast.name_at(tree, node, 0)
}

fn check_frozen(types: mut Types, id: Int, name: view String, write: Bool) {
  for i in 0..types.frozen.len() {
    if types.frozen.at(i).binding == id {
      let place = String.from(types.frozen.at(i).place)
      if name != place && !name.starts_with("{place}.") && !name.starts_with("{place}[") &&
          !place.starts_with("{name}.") && !place.starts_with("{name}[") { continue }
      if types.frozen.at(i).from_let {
        // a name borrowed from the list (`let x = l.at(i)`): changing the list would leave it dangling
        if write {
          issue(types, "cannot change '{name}' while a name borrowed from it is alive")
          return
        }
        continue
      }
      if types.frozen.at(i).exclusive {
        issue(types, "cannot use '{name}' inside the `match mut` arm that borrows it")
        return
      }
      if write {
        issue(types, "cannot change '{name}' while a `match` arm is borrowing its payloads")
        return
      }
    }
  }
}

fn read_binding(types: mut Types, id: Int, name: view String) {
  read_place(types, id, name, name)
}

fn read_place(types: mut Types, id: Int, name: view String, place: view String) {
  if !types.verify_ownership || id < 0 { return }
  check_frozen(types, id, place, false)
  if types.moved.at(id) {
    issue(types, "cannot use '{name}': it was already moved")
    types.moved.set(id, false)
  }
}

fn move_binding(types: mut Types, id: Int, name: view String) {
  if types.modes.at(id) != "Own" {
    issue(types, "cannot move '{name}': it is only borrowed")
  } else {
    check_frozen(types, id, name, true)
    types.moved.set(id, true)
  }
}

fn require_value(types: mut Types, tree: view List<ast.AstNode>, node: Int, ty: view String) {
  if !owns_value(types, ty) { return }
  if tree.at(node).tag == "Ascribe" {
    require_value(types, tree, ast.child(tree, node, 1), ty)
    return
  }
  let root = root_place(types, tree, node)
  if root >= 0 && types.identities.at(root) >= 0 {
    let name = place_name(tree, node)
    if root == node { issue(types, "'{name}' is a {ty} and is not copied") }
    else { issue(types, "cannot move '{name}' out of its struct") }
  }
}

fn immutable_reason(types: view Types, tree: view List<ast.AstNode>, id: Int) -> String {
  if types.modes.at(id) == "View" { return String.from("it is only borrowed for reading (`view`)") }
  if types.modes.at(id) == "Capture" { return String.new() }
  let decl = types.declarations.at(id)
  if (tree.at(decl).tag == "Let" || tree.at(decl).tag == "UnpackBind") &&
      tree.at(ast.child(tree, decl, 1)).tag == "false" {
    return String.from("it was declared with `let` (immutable)")
  }
  return String.new()
}

fn record_loan(types: mut Types, tree: view List<ast.AstNode>, loans: mut List<ownership.Loan>,
    node: Int, mode: view String, ty: view String, receiver: Bool) {
  if !types.verify_ownership { return }
  let owns = owns_value(types, ty)
  if mode != "Mut" && !owns { return }
  let explicit = tree.at(node).tag == "Move"
  if explicit && mode != "Own" {
    issue(types, String.from("this function only borrows: remove `move`"))
    return
  }
  let implicit = receiver && owns && mode == "Own" && tree.at(node).tag == "Var"
  if mode == "Own" && !explicit && !implicit {
    require_value(types, tree, node, ty)
    return
  }
  var root = root_place(types, tree, node)
  if explicit { root = node }
  if root < 0 {
    if mode == "Mut" && !(ty.starts_with("fn(") && tree.at(node).tag == "Closure") {
      issue(types, String.from("pass a variable here (the function borrows it)"))
    }
    return
  }
  let id = types.identities.at(root)
  if id < 0 { return }
  let name = place_name(tree, root)
  if implicit { move_binding(types, id, name) }
  if mode == "Mut" {
    var why = immutable_reason(types, tree, id)
    // a lock hands out its value to `view` holders: `lock.locked_value()` is mutable interior state
    if through_lock(tree, node) { why = String.new() }
    let place = place_name(tree, node)
    check_frozen(types, id, place, true)
    if why != "" {
      issue(types, "cannot lend '{place}' as `mut`: {why}")
    }
  }
  let exclusive = mode != "View"
  for prior in loans {
    if prior.binding == id && (exclusive || prior.exclusive) {
      issue(types, "'{name}' appears twice in the same call and one use modifies or moves it")
    }
  }
  loans.push(ownership.Loan { binding: id, exclusive: exclusive })
}

fn call_args(types: mut Types, tree: view List<ast.AstNode>, args: Int, name: view String, sig: Int, owner: view String, receiver: Int) -> String {
  let lead = types.lead
  types.lead = -1
  var count = child_count(tree, args)
  if lead >= 0 { count = count + 1 }
  if sig >= 0 {
    let expected = types.signatures.at(sig).args.len()
    let variadic = types.variadics.contains(name) && count > expected
    if count != expected && !variadic {
      if types.signatures.at(sig).receiver != "" {
        issue(types, "method '{name}' of {owner} expects {expected} argument(s) besides the receiver but got {count}")
      } else {
        issue(types, "'{name}' expects {expected} argument(s) but got {count}")
      }
      return unknown()
    }
  }
  var sub = type_terms.empty()
  if sig >= 0 {
    sub = type_terms.with_names(types.signatures.at(sig).generics)
    type_terms.bind(sub, types.signatures.at(sig).owner, owner)
  }
  let before = types.errors
  var loans = List<ownership.Loan>.new()
  if sig >= 0 && receiver >= 0 {
    let mode = String.from(types.signatures.at(sig).receiver)
    record_loan(types, tree, loans, receiver, mode, owner, true)
  }
  var nodes = List<Int>.new()
  var order = List<Int>.new()
  if lead >= 0 {
    // `it.map(f)` calls the free function `std__iter_map(it, f)`: the receiver is its first argument
    order.push(0)
    nodes.push(lead)
  }
  var i = args + 1
  while i < tree.at(args).end {
    if sub.names.len() == 0 || tree.at(i).tag != "Closure" { order.push(nodes.len()) }
    nodes.push(i)
    i = tree.at(i).end
  }
  // Other arguments can fix the types of a generic callback's parameters.
  if sub.names.len() > 0 {
    for at in 0..nodes.len() {
      if tree.at(nodes.at(at)).tag == "Closure" { order.push(at) }
    }
  }
  for at in order {
    let i = nodes.at(at)
    var expected = unknown()
    var formal = unknown()
    if sig >= 0 {
      if at < types.signatures.at(sig).args.len() {
        formal = String.from(types.signatures.at(sig).args.at(at).ty)
        expected = type_terms.substitute(formal, sub)
      }
    }
    var hint = String.from(expected)
    let generic = owner == "?" && type_terms.mentions(formal, sub.names)
    if generic && !formal.starts_with("fn(") { hint = unknown() }
    var mode = String.from("View")
    if sig >= 0 && at < types.signatures.at(sig).args.len() { mode = String.from(types.signatures.at(sig).args.at(at).mode) }
    var actual = unknown()
    var rejected_move = false
    if types.verify_ownership && sig >= 0 && mode != "Own" && tree.at(i).tag == "Move" {
      let id = types.identities.at(i)
      if id >= 0 && (mode == "Mut" || owns_value(types, types.bindings.at(id))) {
        actual = String.from(types.bindings.at(id))
        rejected_move = true
      }
    }
    if tree.at(i).tag == "Closure" && mode != "Own" && expected.starts_with("fn(") {
      actual = closure_type(types, tree, i, hint, true)
    } else if i == lead { actual = String.from(types.lead_type) }
    else if !rejected_move { actual = infer(types, tree, i, hint) }
    if sig >= 0 && i != lead { record_loan(types, tree, loans, i, mode, actual, false) }
    type_terms.bind(sub, formal, actual)
    let resolved = type_terms.substitute(formal, sub)
    let text_argument = mode == "View" && resolved == "String" && actual == "Text"
    let elem = type_terms.element(actual)
    let slice_argument = resolved.starts_with("Slice<") && elem != "?" &&
      type_terms.compatible(type_terms.element(resolved), elem)
    if !text_argument && !slice_argument && !type_terms.compatible(resolved, actual) {
      if generic && sub.names.contains(formal) {
        let ordinal = at + 1
        issue(types, "argument {ordinal} of '{name}' is {actual}, but {formal} was already fixed to {resolved} by an earlier argument")
      } else if generic { expect_type(types, formal, actual) }
      else { expect_type(types, resolved, actual) }
    }
  }
  if sig >= 0 {
    if owner == "?" && types.errors == before {
      for at in 0..sub.names.len() {
        if sub.values.at(at) == "?" {
          let param = String.from(sub.names.at(at))
          issue(types, "cannot infer the type parameter {param} of '{name}'")
          return unknown()
        }
      }
      for at in 0..sub.names.len() {
        let param = String.from(sub.names.at(at))
        if types.signatures.at(sig).copy_params.contains(param) {
          let actual = String.from(sub.values.at(at))
          var visiting = List<String>.new()
          if actual == "nothing" || is_owned(types, actual, visiting) {
            issue(types, "{actual} does not implement Copy, which '{name}' needs for {param}")
          }
        }
      }
      if name == "__parallel_list" && sub.values.len() == 1 {
        let element = String.from(sub.values.at(0))
        var visited = List<String>.new()
        if !transferable(types, element, visited) {
          issue(types, "parallel for cannot read list elements of type {element}")
        }
      }
      if types.errors != before { return unknown() }
    }
    return type_terms.substitute(types.signatures.at(sig).result, sub)
  }
  if name == "print" {
    if count != 1 { issue(types, String.from("print expects exactly 1 argument")) }
    return unit()
  }
  return unknown()
}

fn struct_literal(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String) -> String {
  let n = ast.name_at(tree, index, 0)
  let shape = shape_index(types, n)
  var sub = type_terms.empty()
  if shape >= 0 {
    sub = type_terms.with_names(types.shapes.at(shape).generics)
    let args = source_types(types, tree, ast.child(tree, index, 1))
    for i in 0..min(args.len(), sub.names.len()) {
      sub.values.set(i, String.from(args.at(i)))
    }
    // `Iter { .. }` where the context expects `Iter<U>`: the expected type fixes the type arguments
    let hinted = type_terms.base(hint)
    if args.len() == 0 && sub.names.len() > 0 && hinted == n {
      type_terms.bind(sub, type_terms.apply(n, sub.names), hint)
    }
  }
  let fields = ast.child(tree, index, 2)
  var appeared = List<String>.new()
  var i = fields + 1
  while i < tree.at(fields).end {
    let name = ast.name_at(tree, i, 0)
    var field = -1
    var formal = unknown()
    if shape >= 0 {
      field = field_index(types.shapes.at(shape), name)
      if field >= 0 { formal = String.from(types.shapes.at(shape).fields.at(field).ty) }
    }
    let value = ast.child(tree, i, 1)
    let actual = infer(types, tree, value, type_terms.substitute(formal, sub))
    require_value(types, tree, value, actual)
    type_terms.bind(sub, formal, actual)
    if shape >= 0 {
      if field < 0 { issue(types, "struct {n} has no field '{name}'") }
      else {
        expect_type(types, type_terms.substitute(formal, sub), actual)
        if appeared.contains(name) { issue(types, "field '{name}' is given twice") }
        else { appeared.push(String.from(name)) }
      }
    }
    i = tree.at(i).end
  }
  if shape < 0 { return unknown() }
  var missing = List<String>.new()
  for f in types.shapes.at(shape).fields {
    if !appeared.contains(f.name) { missing.push(String.from(f.name)) }
  }
  if missing.len() > 0 {
    let names = missing.join(", ")
    issue(types, "missing field(s) in {n}: {names}")
  }
  return type_terms.apply(n, sub.values)
}

fn variant_index(shape: view Shape, name: view String) -> Int {
  for i in 0..shape.variants.len() {
    if shape.variants.at(i).name == name { return i }
  }
  return -1
}

fn nominal_constructor(types: mut Types, tree: view List<ast.AstNode>, owner: view String,
    name: view String, args: Int, hint: view String) -> String {
  let shape = shape_index(types, owner)
  let variant = variant_index(types.shapes.at(shape), name)
  if variant < 0 {
    let base = String.from(types.shapes.at(shape).name)
    issue(types, "enum {base} has no variant '{name}'")
    return unknown()
  }
  var sub = type_terms.with_names(types.shapes.at(shape).generics)
  var explicit = type_terms.arguments(owner)
  let base = type_terms.base(owner)
  if explicit.len() == 0 && base == type_terms.base(hint) { explicit = type_terms.arguments(hint) }
  for i in 0..min(explicit.len(), sub.names.len()) {
    sub.values.set(i, String.from(explicit.at(i)))
  }
  let expected = types.shapes.at(shape).variants.at(variant).payload.len()
  var count = 0
  if args >= 0 { count = child_count(tree, args) }
  if count != expected {
    issue(types, "{owner}.{name} expects {expected} value(s), got {count}")
    return unknown()
  }
  var node = args + 1
  for i in 0..count {
    let formal = String.from(types.shapes.at(shape).variants.at(variant).payload.at(i))
    let actual = infer(types, tree, node, type_terms.substitute(formal, sub))
    require_value(types, tree, node, actual)
    type_terms.bind(sub, formal, actual)
    expect_type(types, type_terms.substitute(formal, sub), actual)
    node = tree.at(node).end
  }
  var missing = List<String>.new()
  for i in 0..sub.names.len() {
    if sub.values.at(i) == "?" { missing.push(String.from(sub.names.at(i))) }
  }
  if missing.len() > 0 {
    let names = missing.join(", ")
    issue(types, "cannot infer the type argument(s) {names} of {base}.{name}")
    return unknown()
  }
  return type_terms.apply(base, sub.values)
}

fn check_range_member(types: mut Types, tree: view List<ast.AstNode>, range: view String,
    name: view String, args: Int) -> String {
  if child_count(tree, args) != 1 {
    issue(types, "{range}.{name} expects one argument")
    return unknown()
  }
  let actual = numeric_type(infer(types, tree, args + 1, unknown()))
  if actual != "?" && !integer(actual) { issue(types, "expected an integer but this is {actual}") }
  if name == "try_from" {
    if actual == "UInt64" { issue(types, String.from("try_from does not take a UInt64")) }
    return "Result<{range}, Int>"
  }
  return String.from(range)
}

fn bound_method(types: view Types, tree: view List<ast.AstNode>, params: Int,
    owner: view String, name: view String) -> Int {
  if params < 0 { return -1 }
  var i = params + 1
  while i < tree.at(params).end {
    let parameter = ast.name_at(tree, i, 0)
    if tree.at(i).tag == "Generic" && parameter == owner {
      let bounds = ast.child(tree, i, 1)
      for j in bounds + 1..tree.at(bounds).end {
        let bound = ast.decoded_name(tree, j)
        for k in 0..types.signatures.len() {
          if types.signatures.at(k).required_trait == bound && types.signatures.at(k).name == name { return k }
        }
      }
    }
    i = tree.at(i).end
  }
  return -1
}

// The Iter<T> a user type turns into through its `into_iter(self) -> Iter<T>`, or "" when it is not an iterator.
fn user_iterator(types: view Types, owner: view String) -> String {
  var has_next = false
  var result = String.new()
  for i in 0..types.signatures.len() {
    if types.signatures.at(i).owner != owner || types.signatures.at(i).receiver == "" { continue }
    if types.signatures.at(i).name == "next" { has_next = true }
    if types.signatures.at(i).name == "into_iter" {
      result = String.from(types.signatures.at(i).result)
    }
  }
  if !has_next || !result.starts_with("Iter<") { return String.new() }
  return result
}

fn member(types: mut Types, tree: view List<ast.AstNode>, owner: view String,
    name: view String, args: Int, receiver: Int, hint: view String) -> String {
  var payload = unknown()
  let builtin_box = shape_index(types, String.from("Box")) < 0
  if builtin_box { payload = type_terms.box_payload(owner) }
  if receiver >= 0 && owner.starts_with("JoinHandle<") && name == "join" {
    if child_count(tree, args) != 0 || tree.at(receiver).tag != "Var" {
      issue(types, String.from("'join' expects an owning handle and no arguments"))
      return unknown()
    }
    var loans = List<ownership.Loan>.new()
    record_loan(types, tree, loans, receiver, String.from("Own"), owner, true)
    let result = owner.slice(11, owner.len() - 1)
    return "Result<{result}, ThreadPanic>"
  }
  if builtin_box && receiver < 0 && payload != "?" && name == "from_runtime_word" {
    if child_count(tree, args) != 1 { issue(types, String.from("'from_runtime_word' takes the address")) }
    else { expect_type(types, String.from("Int"), infer(types, tree, args + 1, String.from("Int"))) }
    return String.from(owner)
  }
  if builtin_box && receiver < 0 && (owner == "Box" || payload != "?") && name == "new" {
    if child_count(tree, args) != 1 {
      issue(types, String.from("'Box.new' expects 1 argument"))
      return unknown()
    }
    var expected = String.from(owner)
    if expected == "Box" { expected = String.from(hint) }
    let inner = type_terms.box_payload(expected)
    let erased = type_terms.dyn_trait(inner)
    var value_hint = String.from(inner)
    if erased != "" { value_hint = unknown() }
    let actual = infer(types, tree, args + 1, value_hint)
    require_value(types, tree, args + 1, actual)
    if erased != "" { return expected }
    expect_type(types, inner, actual)
    if inner != "?" { return expected }
    return "Box<{actual}>"
  }
  if receiver >= 0 && payload != "?" && (name == "get" || name == "take") {
    if child_count(tree, args) != 0 { issue(types, "'{name}' takes no arguments") }
    if name == "take" {
      if payload.starts_with("$dyn<") {
        issue(types, String.from("cannot take an erased value out of a Box"))
      } else if tree.at(receiver).tag != "Var" {
        issue(types, String.from("'take' needs an owning Box variable"))
      } else {
        var loans = List<ownership.Loan>.new()
        record_loan(types, tree, loans, receiver, String.from("Own"), owner, true)
      }
    }
    return payload
  }
  var trait_name = type_terms.dyn_trait(owner)
  if payload != "?" { trait_name = type_terms.dyn_trait(payload) }
  if receiver >= 0 && trait_name != "" {
    for i in 0..types.signatures.len() {
      if types.signatures.at(i).required_trait == trait_name && types.signatures.at(i).name == name {
        return call_args(types, tree, args, name, i, owner, receiver)
      }
    }
    issue(types, "trait {trait_name} has no method '{name}'")
    return unknown()
  }
  if receiver < 0 && (name == "from" || name == "try_from") {
    let target = ast.alias_target(tree, owner)
    if target >= 0 {
      let range = source_type(types, tree, target)
      if range.starts_with("Int<") { return check_range_member(types, tree, range, name, args) }
    }
  }
  if owner.starts_with("Ptr<") {
    if receiver < 0 && name == "null" && child_count(tree, args) == 0 { return String.from(owner) }
    if receiver < 0 && name == "alloc" && child_count(tree, args) == 1 {
      let size = String.from("Int")
      expect_type(types, size, infer(types, tree, args + 1, size))
      return String.from(owner)
    }
    if receiver >= 0 && name == "is_null" && child_count(tree, args) == 0 { return String.from("Bool") }
    if receiver >= 0 && name == "free" && child_count(tree, args) == 0 { return unit() }
  }
  if receiver >= 0 && (name == "split_at" || name == "split_at_mut") && child_count(tree, args) == 2 &&
      (owner.starts_with("Array<") || owner.starts_with("Slice<") || owner.starts_with("List<") || owner == "List") {
    let size = String.from("Int")
    expect_type(types, size, infer(types, tree, args + 1, size))
    let half = type_terms.bracket(type_terms.element(owner), String.from("_"))
    var halves = List<Parameter>.new()
    halves.push(Parameter { mode: String.from("Own"), ty: String.from(half) })
    halves.push(Parameter { mode: String.from("Own"), ty: String.from(half) })
    let hint = add_signature(types, String.new(), move halves, unit())
    let found = infer(types, tree, tree.at(args + 1).end, hint)
    return unit()
  }
  if receiver >= 0 && (name == "chunks" || name == "windows") && child_count(tree, args) == 1 &&
      (owner.starts_with("Array<") || owner.starts_with("Slice<") || owner.starts_with("List<") || owner == "List") {
    // an iterable of slices of the receiver; only `for` consumes it
    let size = String.from("Int")
    expect_type(types, size, infer(types, tree, args + 1, size))
    return "Pieces<{type_terms.element(owner)}>"
  }
  if receiver >= 0 && (owner.starts_with("Array<") || owner.starts_with("Slice<")) {
    return sequence_member(types, tree, owner, name, args, receiver)
  }
  if receiver >= 0 {
    let number = numeric_type(owner)
    if integer(number) || floating(number) {
      let conversion = numeric_conversion(name)
      if conversion != "?" {
        if child_count(tree, args) != 0 { issue(types, "{name} takes no arguments") }
        if floating(number) && name.starts_with("truncate_") { issue(types, "{name} requires an integer") }
        return conversion
      }
      if math_arity(name) != 0 { return check_math(types, tree, name, args, owner) }
    }
  }
  if receiver >= 0 && name == "show" && child_count(tree, args) == 0 {
    return String.from("String")
  }
  if receiver >= 0 && name == "clone" && (owner.starts_with("$tuple") || owner.starts_with("Array<")) && child_count(tree, args) == 0 {
    return String.from(owner)
  }
  let shape = shape_index(types, owner)
  if receiver >= 0 && (name == "wrapping_add" || name == "wrapping_sub" || name == "wrapping_mul") {
    let number = numeric_type(owner)
    if floating(number) {
      issue(types, "'{name}' is for integers, not {number}")
      return unknown()
    }
    if integer(number) {
      if child_count(tree, args) != 1 {
        issue(types, "'{name}' expects 1 argument")
        return unknown()
      }
      expect_type(types, number, infer(types, tree, args + 1, number))
      return number
    }
  }
  if receiver >= 0 && name == "cmp" {
    let number = numeric_type(owner)
    if integer(number) || floating(number) {
      if child_count(tree, args) != 1 {
        issue(types, "'cmp' expects 1 argument")
        return unknown()
      }
      expect_type(types, number, infer(types, tree, args + 1, number))
      return String.from("Int")
    }
  }
  if receiver < 0 && shape >= 0 && types.shapes.at(shape).is_enum {
    return nominal_constructor(types, tree, owner, name, args, hint)
  }
  var method_owner = String.from(owner)
  if receiver >= 0 && owner.starts_with("Int<") { method_owner = String.from("Int") }
  if receiver < 0 && !owner.contains("<") {
    // `Atomic.new(0)`: impls for single instances (`impl Atomic<Int>`, `impl Atomic<Bool>`); the first argument picks one
    var chosen = -1
    var count = 0
    for i in 0..types.signatures.len() {
      let formal = String.from(types.signatures.at(i).owner)
      let base = type_terms.base(formal)
      if base == owner && formal != owner && types.signatures.at(i).name == name && types.signatures.at(i).receiver == "" &&
          types.signatures.at(i).generics.len() == 0 && types.signatures.at(i).required_trait == "" {
        count = count + 1
        if chosen < 0 { chosen = i }
        if count > 1 && child_count(tree, args) > 0 && types.signatures.at(i).args.len() > 0 {
          let seen = infer(types, tree, args + 1, unknown())
          if types.signatures.at(i).args.at(0).ty == seen { chosen = i }
        }
      }
    }
    if chosen >= 0 {
      let formal = String.from(types.signatures.at(chosen).owner)
      return call_args(types, tree, args, name, chosen, formal, receiver)
    }
  }
  for i in 0..types.signatures.len() {
    let formal = String.from(types.signatures.at(i).owner)
    let mode = String.from(types.signatures.at(i).receiver)
    if types.signatures.at(i).required_trait != "" { continue }
    if types.signatures.at(i).name == name && ((receiver >= 0) == (mode != "")) {
      if formal == method_owner {
        if !types.trace && method_owner != owner { types.expressions.set(receiver, String.from(method_owner)) }
        return call_args(types, tree, args, name, i, method_owner, receiver)
      }
      let base = type_terms.base(formal)
      if types.signatures.at(i).generics.len() > 0 && base == type_terms.base(owner) {
        return call_args(types, tree, args, name, i, owner, receiver)
      }
    }
  }
  if receiver >= 0 && types.generics.contains(owner) {
    var signature = bound_method(types, tree, types.function_params, owner, name)
    if signature < 0 { signature = bound_method(types, tree, types.impl_params, owner, name) }
    if signature >= 0 { return call_args(types, tree, args, name, signature, owner, receiver) }
  }
  if receiver >= 0 && (owner.starts_with("List<") || owner == "List") && name == "sort" {
    let element = type_terms.element(owner)
    if child_count(tree, args) != 0 { issue(types, String.from("'sort' takes no arguments")) }
    if element != "?" && !ordered_type(types, element) { issue(types, "{element} does not implement Ordered") }
    var loans = List<ownership.Loan>.new()
    record_loan(types, tree, loans, receiver, String.from("Mut"), owner, true)
    return unit()
  }
  if receiver >= 0 {
    // runtime handles: `shared.get()` is the cell's value, `locked.locked_value()` the protected value, and a
    // Shared forwards the methods it does not have to the value it holds
    let family = type_terms.base(owner)
    if family == "Shared" && child_count(tree, args) == 0 && name == "get" { return type_terms.first_argument(owner) }
    if family == "Locked" && child_count(tree, args) == 0 && name == "locked_value" { return type_terms.first_argument(owner) }
    if family == "Locked" && (name == "with" || name == "with_view") {
      let lock_fn = signature_index(types, "__locked_{name}", false)
      if lock_fn >= 0 {
        types.lead = receiver
        types.lead_type = String.from(owner)
        return call_args(types, tree, args, name, lock_fn, "?", -1)
      }
    }
    if family == "Shared" && name != "clone" && name != "new" {
      let held = type_terms.first_argument(owner)
      return member(types, tree, held, name, args, receiver, hint)
    }
  }
  if receiver >= 0 && name != "into_iter" && name != "next" {
    // a user iterator (`next` plus the generated `into_iter`) uses the adapters of Iter: `it.map(f)` is
    // `it.into_iter().map(f)`
    let adapted = user_iterator(types, owner)
    if adapted != "" { return member(types, tree, adapted, name, args, receiver, hint) }
  }
  if receiver >= 0 {
    let free = signature_index(types, "std__iter_{name}", false)
    if free >= 0 {
      types.lead = receiver
      types.lead_type = String.from(owner)
      return call_args(types, tree, args, name, free, "?", -1)
    }
  }
  if receiver >= 0 && (shape >= 0 || owner == "Bool" || owner == "Text") {
    issue(types, "type {owner} has no method '{name}'")
    return unknown()
  }
  return call_args(types, tree, args, name, -1, unknown(), -1)
}

fn sequence_member(types: mut Types, tree: view List<ast.AstNode>, owner: view String,
    name: view String, args: Int, receiver: Int) -> String {
  let elem = type_terms.element(owner)
  let integer_type = String.from("Int")
  if name == "clone" && owner.starts_with("Array<") && child_count(tree, args) == 0 { return String.from(owner) }
  if name == "show" && child_count(tree, args) == 0 { return String.from("String") }
  if (name == "eq" || name == "cmp") && child_count(tree, args) == 1 {
    // element-wise comparison with another sequence
    let other = infer(types, tree, args + 1, owner)
    if name == "eq" { return String.from("Bool") }
    return integer_type
  }
  var count = 1
  if name == "len" { count = 0 }
  else if name == "set" || name == "swap" { count = 2 }
  else if name != "at" && name != "get" { return unknown() }
  if child_count(tree, args) != count { return unknown() }
  if count == 0 { return integer_type }
  expect_type(types, integer_type, infer(types, tree, args + 1, integer_type))
  if count == 1 { return elem }
  var loans = List<ownership.Loan>.new()
  record_loan(types, tree, loans, receiver, String.from("Mut"), owner, true)
  var expected = String.from(elem)
  if name == "swap" { expected = String.from(integer_type) }
  let second = tree.at(args + 1).end
  expect_type(types, expected, infer(types, tree, second, expected))
  return unit()
}

fn static_owner(types: view Types, tree: view List<ast.AstNode>, index: Int) -> String {
  if tree.at(index).tag == "Var" && types.identities.at(index) < 0 {
    return ast.name_at(tree, index, 0)
  }
  return unknown()
}

fn scalar_literal(tree: view List<ast.AstNode>, node: Int) -> Bool {
  if tree.at(node).tag == "Un" && tree.at(ast.child(tree, node, 0)).tag == "2d" {
    return scalar_literal(tree, ast.child(tree, node, 1))
  }
  return tree.at(node).tag == "Int" || (tree.at(node).tag == "Float" &&
    tree.at(ast.child(tree, node, 1)).tag == "")
}

fn numeric_type(ty: view String) -> String {
  if ty.starts_with("Int<") { return String.from("Int") }
  return String.from(ty)
}

fn zero_in_range(ty: view String) -> Bool {
  let bounds = ty.slice(4, ty.len() - 1).split("..")
  var lo = 0
  var hi = 0
  let has_lo = bounds.at(0).parse_int(lo)
  let has_hi = bounds.at(1).parse_int(hi)
  return (!has_lo || lo <= 0) && (!has_hi || hi >= 0)
}

// Does `ty` have an Equal impl (a generic impl `impl<T> Equal for Pair<T>` covers every instance)?
fn equal_type(types: view Types, ty: view String) -> Bool {
  if types.equal_types.contains(ty) { return true }
  let base = type_terms.base(ty)
  for known in types.equal_types {
    let candidate = type_terms.base(known)
    if candidate == base { return true }
  }
  return false
}

fn ordered_type(types: view Types, ty: view String) -> Bool {
  if types.ordered_types.contains(ty) || types.ordered_params.contains(ty) || integer(numeric_type(ty)) || floating(ty) ||
      ty == "Bool" || ty == "Char" || ty == "String" || ty == "Text" { return true }
  let element = type_terms.element(ty)
  return element != "?" && ordered_type(types, element)
}

fn binary(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String) -> String {
  let op = ast.name_at(tree, index, 0)
  let left = ast.child(tree, index, 1)
  let right = ast.child(tree, index, 2)
  let boolean = String.from("Bool")
  if op == "&&" || op == "||" {
    expect_type(types, boolean, infer(types, tree, left, boolean))
    let before = ownership.snapshot(types.moved)
    expect_type(types, boolean, infer(types, tree, right, boolean))
    ownership.join(types.moved, before)
    return boolean
  }
  var lhs = unknown()
  var rhs = unknown()
  if scalar_literal(tree, left) && !scalar_literal(tree, right) {
    rhs = infer(types, tree, right, hint)
    lhs = infer(types, tree, left, rhs)
  } else {
    lhs = infer(types, tree, left, hint)
    rhs = infer(types, tree, right, lhs)
  }
  let a = numeric_type(lhs)
  let b = numeric_type(rhs)
  let ordered = op == "<" || op == ">" || op == "<=" || op == ">="
  let equal = op == "==" || op == "!="
  if a == "?" || b == "?" {
    if ordered || equal { return boolean }
    return unknown()
  }
  if equal {
    if integer(a) || floating(a) || a == "Char" || a == "Bool" || a == "String" || a == "Text" {
      if !((a == "String" && b == "Text") || (a == "Text" && b == "String")) { expect_type(types, a, b) }
    } else if equal_type(types, a) || a.starts_with("Option<") { expect_type(types, a, b) }
    else if shape_index(types, a) >= 0 {
      issue(types, "cannot compare values of type {a}")
    }
    return boolean
  }
  if op == "+" && a == "String" && root_place(types, tree, left) >= 0 {
    if b != "Text" { expect_type(types, a, b) }
    return a
  }
  if ordered && (a == "Char" || a == "String" || a == "Text") {
    if !((a == "String" && b == "Text") || (a == "Text" && b == "String")) { expect_type(types, a, b) }
    return boolean
  }
  if !ordered && (a == "Char" || b == "Char") {
    issue(types, "cannot use `{op}` on a Char")
    return unknown()
  }
  if !integer(a) && !floating(a) {
    if ordered {
      if !ordered_type(types, a) {
        issue(types, "cannot use `{op}` on values of type {a}: it does not implement Ordered")
      } else if root_place(types, tree, left) < 0 && (a == "Bool" || types.generics.contains(a) || types.ordered_types.contains(a)) {
        issue(types, "cannot use `{op}` here: the left side is a {a} value that is not a variable")
      } else { expect_type(types, a, b) }
      return boolean
    }
    if types.generics.contains(a) { return unknown() }
    expect_type(types, String.from("Int"), a)
    return unknown()
  }
  if a != b && integer(a) && floating(b) && scalar_literal(tree, left) {
    lhs = infer(types, tree, left, b)
    if lhs == b {
      if ordered { return boolean }
      return b
    }
  }
  if a != b && integer(a) && floating(b) {
    expect_type(types, b, a)
    if ordered { return boolean }
    return b
  }
  expect_type(types, a, b)
  if ordered { return boolean }
  if op == "%" && floating(a) { issue(types, "`%` is not defined for {a}") }
  if (op == "/" || op == "%") && rhs.starts_with("Int<") && zero_in_range(rhs) {
    issue(types, String.from("the divisor may be 0"))
  }
  return a
}

fn check_deferred(types: mut Types, tree: view List<ast.AstNode>, start: Int) {
  if !types.verify_ownership { return }
  for i in start..types.deferred.len() {
    let node = types.deferred.at(i)
    for at in node..tree.at(node).end {
      let tag = String.from(tree.at(at).tag)
      if tag == "Var" || tag == "Call" || tag == "Move" {
        let id = types.identities.at(at)
        if id >= 0 && types.moved.at(id) {
          let name = ast.name_at(tree, at, 0)
          let message = "this deferred statement uses '{name}', but '{name}' has already been moved when it runs"
          issue(types, message)
          break
        }
      }
    }
  }
}

fn propagate(types: mut Types, tree: view List<ast.AstNode>, node: Int) -> String {
  let operand = infer(types, tree, node, unknown())
  if operand == "?" { return unknown() }
  let family = type_terms.base(operand)
  if family != "Result" && family != "Option" {
    issue(types, "`?` needs a Result or an Option, but this is {operand}")
    return unknown()
  }
  require_value(types, tree, node, operand)
  let floor = types.defer_floor
  check_deferred(types, tree, floor)
  let ret = String.from(types.return_type)
  if ret == "?" { return unknown() }
  let ret_family = type_terms.base(ret)
  if ret_family != "Result" && ret_family != "Option" {
    issue(types, "cannot use `?` in a function that returns {ret}")
    return unknown()
  }
  if family != ret_family {
    issue(types, "`?` is used on {operand} but this function returns {ret}")
    return unknown()
  }
  let args = type_terms.arguments(operand)
  let returned = type_terms.arguments(ret)
  if args.len() == 0 || returned.len() == 0 { return unknown() }
  if family == "Result" && args.len() == 2 && returned.len() == 2 && args.at(1) != returned.at(1) {
    let from_type = String.from(args.at(1))
    let to_type = String.from(returned.at(1))
    let conversion = "{type_terms.snake(to_type)}_from_{type_terms.snake(from_type)}"
    var found = false
    for i in 0..types.signatures.len() {
      if types.signatures.at(i).name == conversion && types.signatures.at(i).owner == "" { found = true }
    }
    let displayable = integer(numeric_type(from_type)) || floating(from_type) || from_type == "Bool" ||
      from_type == "Char" || from_type == "Text" || types.shown_types.contains(from_type)
    if !found && !(to_type == "String" && displayable) {
      issue(types, "`?` cannot turn the error {from_type} into the {to_type} this function returns")
      return unknown()
    }
  }
  return String.from(args.at(0))
}

fn closure_type(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String,
    borrow_argument: Bool) -> String {
  let hinted = value_signature(types, hint)
  let args = param_types(types, tree, ast.child(tree, index, 4), hinted, true)
  let ret = ast.child(tree, index, 5)
  var expected = source_type(types, tree, ret)
  if tree.at(ret).tag == "_" && hinted >= 0 {
    expected = String.from(types.signatures.at(hinted).result)
  }
  var state = Returns { expected: move expected, inferred: unit(), want: false, hint: String.new(), value: String.new() }
  let outer = String.from(types.return_type)
  let floor = types.defer_floor
  types.defer_floor = types.deferred.len()
  types.return_type = String.from(state.expected)
  let moving = tree.at(ast.child(tree, index, 0)).tag == "true"
  let borrowing = borrow_argument && !moving
  let worker = tree.at(ast.child(tree, index, 3)).tag == "true"
  let parallel_body = tree.at(ast.child(tree, index, 2)).tag == "true"
  var captures = List<Int>.new()
  var modes = List<String>.new()
  if types.verify_ownership && (!borrowing || parallel_body) {
    captures = locals.capture_ids(types.captures, index)
    for id in captures {
      modes.push(String.from(types.modes.at(id)))
      let ty = String.from(types.bindings.at(id))
      let name = binding_name(types, tree, id)
      read_binding(types, id, name)
      if worker || parallel_body {
        if worker && modes.at(modes.len() - 1) != "Own" {
          issue(types, "spawn cannot capture borrowed binding '{name}'")
        }
        var visited = List<String>.new()
        if !transferable(types, ty, visited) {
          if parallel_body { issue(types, "parallel for cannot transfer '{name}' of type {ty}") }
          else { issue(types, "spawn cannot transfer '{name}' of type {ty}") }
        }
        if parallel_body { types.modes.set(id, String.from("View")) }
        else { types.modes.set(id, String.from("Own")) }
      }
      else if moving { types.modes.set(id, String.from("Capture")) }
      else {
        if owns_value(types, ty) { issue(types, "closure must move its owned capture '{name}'") }
        types.modes.set(id, String.from("View"))
      }
    }
  }
  let before = ownership.snapshot(types.moved)
  let body = ast.child(tree, index, 6)
  let first = ast.child(tree, body, 0) + 1
  if tree.at(ast.child(tree, index, 1)).tag == "true" && tree.at(first).tag == "Return" {
    let expression = ast.child(tree, first, 0)
    let actual = infer(types, tree, expression, state.expected)
    if state.expected != "nothing" {
      expect_type(types, state.expected, actual)
      require_value(types, tree, expression, actual)
    }
    state.inferred = move actual
  } else { let exits = check_body(types, state, tree, body) }
  types.moved = move before
  for i in 0..captures.len() {
    let id = captures.at(i)
    types.modes.set(id, String.from(modes.at(i)))
    if moving && owns_value(types, types.bindings.at(id)) {
      let name = binding_name(types, tree, id)
      move_binding(types, id, name)
    }
  }
  types.return_type = move outer
  types.defer_floor = floor
  var result = String.from(state.expected)
  if result == "?" { result = String.from(state.inferred) }
  else if result.contains("?") && !state.inferred.contains("?") {
    // the expected result had unresolved arguments (`Option<?>`): the body decides them
    let wanted = type_terms.base(result)
    let found = type_terms.base(state.inferred)
    if wanted == found { result = String.from(state.inferred) }
  }
  if worker && types.verify_ownership {
    var visited = List<String>.new()
    if !transferable(types, result, visited) { issue(types, "spawn cannot return a value of type {result}") }
  }
  let spelling = add_signature(types, String.new(), move args, result)
  if !types.trace {
    types.expressions.set(index, String.from(spelling))
    types.borrowed_closures.set(index, borrowing)
  }
  return spelling
}

fn binding_name(types: view Types, tree: view List<ast.AstNode>, id: Int) -> String {
  let declaration = types.declarations.at(id)
  if tree.at(declaration).tag == "Self" { return String.from("self") }
  if tree.at(declaration).tag == "For" { return ast.name_at(tree, declaration, 1) }
  return ast.name_at(tree, declaration, 0)
}

fn transferable(types: view Types, ty: view String, visited: mut List<String>) -> Bool {
  let base = type_terms.base(ty)
  if base == "$dyn" || base == "Slice" || base == "JoinHandle" || base == "Ptr" ||
      ty.starts_with("fn(") { return false }
  if visited.contains(ty) { return true }
  visited.push(String.from(ty))
  for part in type_terms.arguments(ty) {
    if !transferable(types, part, visited) { return false }
  }
  let shape = shape_index(types, ty)
  if shape >= 0 {
    for field in types.shapes.at(shape).fields {
      if !transferable(types, instantiate(field.ty, types.shapes.at(shape).generics, ty), visited) {
        return false
      }
    }
    for variant in types.shapes.at(shape).variants {
      for part in variant.payload {
        if !transferable(types, instantiate(part, types.shapes.at(shape).generics, ty), visited) {
          return false
        }
      }
    }
  }
  return true
}

// The type of a module-level `const` (its annotation, or the type of its initializer).
fn const_type(types: mut Types, tree: view List<ast.AstNode>, name: view String) -> String {
  let items = ast.child(tree, 0, 0)
  var at = items + 1
  while at < tree.at(items).end {
    let item = ast.child(tree, at, 2)
    if tree.at(item).tag == "Const" {
      let declared = ast.name_at(tree, item, 0)
      if declared == name {
        let kind = ast.child(tree, item, 1)
        if tree.at(kind).tag != "_" { return source_type(types, tree, kind) }
        return infer(types, tree, ast.child(tree, item, 2), unknown())
      }
    }
    at = tree.at(at).end
  }
  return unknown()
}

fn infer(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String) -> String {
  let ty = infer_expr(types, tree, index, hint)
  if !types.trace { types.expressions.set(index, String.from(ty)) }
  return ty
}

fn infer_field(types: mut Types, tree: view List<ast.AstNode>, index: Int, access: Int,
    hint: view String) -> String {
  let node = ast.child(tree, index, 0)
  let name = ast.name_at(tree, index, 1)
  let owner = static_owner(types, tree, node)
  if owner != "?" {
    let shape = shape_index(types, owner)
    if shape >= 0 && types.shapes.at(shape).is_enum {
      return nominal_constructor(types, tree, owner, name, -1, hint)
    }
  }
  var receiver = unknown()
  let binding = types.identities.at(node)
  if tree.at(node).tag == "Var" && binding >= 0 {
    receiver = String.from(types.bindings.at(binding))
    let place = place_name(tree, access)
    let root = ast.name_at(tree, node, 0)
    read_place(types, binding, root, place)
  } else if tree.at(node).tag == "Field" {
    receiver = infer_field(types, tree, node, access, unknown())
  } else { receiver = infer(types, tree, node, unknown()) }
  if !types.trace { types.expressions.set(node, String.from(receiver)) }
  let shape = shape_index(types, receiver)
  if shape >= 0 && !types.shapes.at(shape).is_enum {
    let field = field_index(types.shapes.at(shape), name)
    if field >= 0 {
      return instantiate(types.shapes.at(shape).fields.at(field).ty, types.shapes.at(shape).generics, receiver)
    }
    issue(types, "struct {receiver} has no field '{name}'")
  }
  return unknown()
}

pub fn raw_arity(name: view String) -> Int {
  if name == "__syscall" { return 7 }
  if name == "__store8" || name == "__store64" { return 2 }
  if name == "__atomic_store" || name == "__atomic_fetch_add" || name == "__futex_park" || name == "__futex_wake" { return 2 }
  if name == "__atomic_cmpxchg" { return 3 }
  if name == "__atomic_load" || name == "__thread_wait" { return 1 }
  if name == "__alloc" || name == "__free" || name == "__global" ||
      name == "__load8" || name == "__load64" { return 1 }
  return 0
}

fn bootstrap_call(types: mut Types, tree: view List<ast.AstNode>, name: view String, args: Int) -> String {
  if name == "__check_shared_content" && child_count(tree, args) == 1 {
    let ignored = infer(types, tree, args + 1, unknown())
    return unit()
  }
  if name == "__locked_unbox" && child_count(tree, args) == 1 {
    let lock = infer(types, tree, args + 1, unknown())
    return "Box<{type_terms.first_argument(lock)}>"
  }
  if name == "__box_address" && child_count(tree, args) == 1 {
    let box = infer(types, tree, args + 1, unknown())
    let payload = type_terms.box_payload(box)
    if payload == "?" || payload.starts_with("$dyn<") || shape_index(types, box) >= 0 {
      issue(types, "expected a builtin Box for __box_address, got {box}")
    }
    return String.from("Int")
  }
  if name == "__parallel_address" && child_count(tree, args) == 1 {
    let expected = String.from("fn(Int)")
    let actual = infer(types, tree, args + 1, expected)
    expect_type(types, expected, actual)
    if tree.at(args + 1).tag != "Var" {
      issue(types, String.from("__parallel_address requires a named callback"))
    }
    return String.from("Int")
  }
  if name == "__parallel_call" && child_count(tree, args) == 2 {
    let expected = String.from("Int")
    expect_type(types, expected, infer(types, tree, args + 1, expected))
    expect_type(types, expected, infer(types, tree, tree.at(args + 1).end, expected))
    return unit()
  }
  if name == "__spawn_owned" && child_count(tree, args) == 1 && tree.at(args + 1).tag == "Closure" &&
      tree.at(ast.child(tree, args + 1, 3)).tag == "true" {
    let entry = infer(types, tree, args + 1, unknown())
    var parts = type_terms.function_parts(entry)
    if parts.len() != 1 {
      issue(types, String.from("spawn closure must take no arguments"))
      return unknown()
    }
    let result = parts.pop()
    if result == "nothing" { return String.from("JoinHandle<ThreadDone>") }
    return "JoinHandle<{result}>"
  }
  if (name == "__thread_start" || name == "__thread_start_recover") && child_count(tree, args) == 1 {
    // a raw worker: the closure runs on a new thread, the result is its handle word
    let entry = infer(types, tree, args + 1, unknown())
    return String.from("Int")
  }
  var result = unknown()
  let int_type = String.from("Int")
  let arity = raw_arity(name)
  if arity > 0 {
    if child_count(tree, args) != arity {
      issue(types, "'{name}' expects {arity} argument(s)")
      return unknown()
    }
    if name == "__global" {
      let arg = args + 1
      var index = -1
      if tree.at(arg).tag == "Int" {
        let parsed = tree.at(ast.child(tree, arg, 0)).tag.parse_int(index)
        if !parsed { index = -1 }
      }
      if index < 0 || index >= 64 {
        issue(types, String.from("__global needs an integer literal between 0 and 63"))
      }
    }
    var at = args + 1
    while at < tree.at(args).end {
      expect_type(types, int_type, infer(types, tree, at, int_type))
      at = tree.at(at).end
    }
    if name == "__free" || name.starts_with("__store") || name == "__atomic_store" { return unit() }
    return int_type
  }
  if name == "ok_or" && child_count(tree, args) == 2 {
    let lhs = infer(types, tree, args + 1, unknown())
    let values = type_terms.arguments(lhs)
    let next = tree.at(args + 1).end
    let error = infer(types, tree, next, unknown())
    require_value(types, tree, args + 1, lhs)
    require_value(types, tree, next, error)
    let family = type_terms.base(lhs)
    if family == "Option" && values.len() == 1 { return "Result<{values.at(0)}, {error}>" }
    return unknown()
  }
  if name == "assert_eq" {
    if child_count(tree, args) != 2 {
      issue(types, String.from("assert_eq expects two arguments"))
      return unknown()
    }
    let lhs = infer(types, tree, args + 1, unknown())
    let number = numeric_type(lhs)
    if !integer(number) && !floating(number) && lhs != "Bool" && lhs != "?" {
      issue(types, "assert_eq compares numbers or Bool values, not {lhs}")
    }
    expect_type(types, lhs, infer(types, tree, tree.at(args + 1).end, lhs))
    return unit()
  }
  if math_arity(name) != 0 { return check_math(types, tree, name, args, String.new()) }
  if name == "float_from_bits" || name == "float32_from_bits" {
    if child_count(tree, args) != 1 {
      issue(types, "{name} expects one argument")
      return unknown()
    }
    var bits = String.from("UInt64")
    var float = String.from("Float")
    if name == "float32_from_bits" {
      bits = String.from("UInt32")
      float = String.from("Float32")
    }
    expect_type(types, bits, infer(types, tree, args + 1, bits))
    return float
  }
  if name == "__comptime" && child_count(tree, args) == 1 {
    // `comptime e` has the type of `e`; the value is computed at run time here
    return infer(types, tree, args + 1, unknown())
  }
  if name == "std__fmt_lit" || name == "std__fmt_val" {
    if child_count(tree, args) != 2 { return unknown() }
    let first = infer(types, tree, args + 1, unknown())
    let last = infer(types, tree, tree.at(args + 1).end, unknown())
    return String.from("String")
  }
  if name == "std__print_owned" || name == "std__io__eprintln" || name == "std__io__eprint" ||
      name == "std__env__exit" || name == "std__io__exit" || name == "std__io__exit_clean" { result = unit() }
  else if name == "std__env__arg" { result = String.from("Option<String>") }
  else if name == "std__env__get_or" { result = String.from("String") }
  else if name == "std__env__args" || name == "std__io__args" { result = String.from("List<String>") }
  else if name == "std__env__arg_count" || name == "std__env__pid" || name == "std__io__process_id" || name == "max" || name == "min" { result = String.from(int_type) }
  else if name == "std__io__read_line" { result = String.from("Result<Option<String>, std__io__IoError>") }
  else if name == "std__io__read_all" || name == "std__fs__read_to_string" || name == "std__env__current_exe" { result = String.from("Result<String, std__io__IoError>") }
  else if name == "std__process__run" { result = String.from("Result<std__process__Output, std__io__IoError>") }
  else if name == "std__fs__write" || name == "std__io__write_stdout" || name == "std__io__write_stderr" { result = String.from("Result<Int, std__io__IoError>") }
  else if name == "std__fs__is_file" { result = String.from("Bool") }
  else { return result }
  var i = args + 1
  while i < tree.at(args).end {
    let actual = infer(types, tree, i, unknown())
    i = tree.at(i).end
  }
  return result
}

fn infer_expr(types: mut Types, tree: view List<ast.AstNode>, index: Int, hint: view String) -> String {
  let tag = String.from(tree.at(index).tag)
  if tag == "Int" || tag == "NumT" { return literal_integer(types, tree, index, hint, false) }
  if tag == "Float" {
    let suffix = ast.child(tree, index, 1)
    let explicit = suffix_type(tree.at(suffix).tag)
    if explicit != "?" { return explicit }
    if floating(hint) { return String.from(hint) }
    return String.from("Float")
  }
  if tag == "Char" || tag == "Bool" { return tag }
  if tag == "Text" {
    if hint == "String" { return String.from("String") }
    return tag
  }
  if tag == "Var" || tag == "Move" {
    let id = types.identities.at(index)
    let n = ast.name_at(tree, index, 0)
    if id >= 0 {
      let ty = String.from(types.bindings.at(id))
      read_binding(types, id, n)
      if tag == "Move" && owns_value(types, ty) { move_binding(types, id, n) }
      return ty
    }
    let sig = signature_index(types, n, false)
    if sig >= 0 { return String.from(types.signatures.at(sig).spelling) }
    if tag == "Var" && n == "None" {
      return nominal_constructor(types, tree, String.from("Option"), n, -1, hint)
    }
    if tag == "Var" {
      let found = const_type(types, tree, n)
      if found != "?" { return found }
      // a `const K: Int` generic parameter is an Int value
      if types.generics.contains(n) { return String.from("Int") }
    }
    return unknown()
  }
  if tag == "Cast" {
    let expected = source_type(types, tree, ast.child(tree, index, 1))
    if expected.starts_with("Int<") {
      let actual = numeric_type(infer(types, tree, ast.child(tree, index, 0), unknown()))
      if actual != "?" && !integer(actual) { issue(types, "expected an integer but this is {actual}") }
      let otherwise = ast.child(tree, index, 2)
      if tree.at(otherwise).tag != "_" {
        if actual == "UInt64" { issue(types, String.from("as with an else block does not take a UInt64")) }
        let before = ownership.snapshot(types.moved)
        let result = String.from(types.return_type)
        var returns = Returns { expected: move result, inferred: unit(), want: false, hint: String.new(), value: String.new() }
        if !check_body(types, returns, tree, otherwise) {
          issue(types, String.from("the else block of a checked conversion must exit"))
        }
        types.moved = move before
      }
      return expected
    }
  }
  if tag == "IfExpr" || tag == "MatchExpr" {
    var state = Returns { expected: String.from(types.return_type), inferred: unit(), want: true, hint: String.from(hint), value: String.new() }
    let exits = check_body(types, state, tree, index)
    if state.value == "" {
      if types.errors == 0 { issue(types, String.from("this `if`/`match` never produces a value")) }
      return unknown()
    }
    return String.from(state.value)
  }
  if tag == "Ascribe" {
    let expected = source_type(types, tree, ast.child(tree, index, 0))
    let actual = infer(types, tree, ast.child(tree, index, 1), expected)
    expect_type(types, expected, actual)
    return expected
  }
  if tag == "Call" {
    let n = ast.name_at(tree, index, 0)
    let id = types.identities.at(index)
    var sig = -1
    if id >= 0 {
      read_binding(types, id, n)
      let ty = String.from(types.bindings.at(id))
      sig = value_signature(types, ty)
      if sig < 0 && ty != "?" {
        issue(types, "'{n}' is a variable of type {ty}, not a function, so it cannot be called")
      }
    } else { sig = signature_index(types, n, false) }
    let args = ast.child(tree, index, 1)
    if id < 0 && sig < 0 {
      if n == "Some" {
        return nominal_constructor(types, tree, String.from("Option"), n, args, hint)
      }
      if n == "Ok" || n == "Err" {
        return nominal_constructor(types, tree, String.from("Result"), n, args, hint)
      }
    }
    if id < 0 && sig < 0 {
      let builtin = bootstrap_call(types, tree, n, args)
      if builtin != "?" { return builtin }
    }
    return call_args(types, tree, args, n, sig, unknown(), -1)
  }
  if tag == "CallFn" {
    let callee = infer(types, tree, ast.child(tree, index, 0), unknown())
    let sig = value_signature(types, callee)
    return call_args(types, tree, ast.child(tree, index, 1), String.from("function value"), sig, unknown(), -1)
  }
  if tag == "Closure" { return closure_type(types, tree, index, hint, false) }
  if tag == "StructLit" { return struct_literal(types, tree, index, hint) }
  if tag == "Array" || tag == "ArrayFill" {
    var expected = type_terms.element(hint)
    if tag == "ArrayFill" {
      let len = ast.child(tree, index, 1)
      let folded = ast.fold_const(tree, len, 0)
      if folded.len() == 0 { return unknown() }
      let value = infer(types, tree, ast.child(tree, index, 0), expected)
      return type_terms.bracket(value, folded)
    }
    let items = ast.child(tree, index, 0)
    var i = items + 1
    var count = 0
    while i < tree.at(items).end {
      let item = infer(types, tree, i, expected)
      if expected == "?" { expected = String.from(item) }
      else { expect_type(types, expected, item) }
      count = count + 1
      i = tree.at(i).end
    }
    return type_terms.bracket(expected, "{count}")
  }
  if tag == "Slice" {
    let value = infer(types, tree, ast.child(tree, index, 0), unknown())
    let integer_type = String.from("Int")
    for offset in 1..3 {
      let bound = ast.child(tree, index, offset)
      if tree.at(bound).tag != "_" { expect_type(types, integer_type, infer(types, tree, bound, integer_type)) }
    }
    return type_terms.bracket(type_terms.element(value), String.from("_"))
  }
  if tag == "Field" { return infer_field(types, tree, index, index, hint) }
  if tag == "Method" {
    let node = ast.child(tree, index, 0)
    let name = ast.name_at(tree, index, 1)
    let owner = static_owner(types, tree, node)
    let args = ast.child(tree, index, 2)
    if owner != "?" { return member(types, tree, owner, name, args, -1, hint) }
    let receiver = infer(types, tree, node, unknown())
    let handle = type_terms.base(receiver)
    if (name == "get" || name == "locked_value") && (handle == "Shared" || handle == "Locked") {
      types.box_places.set(index, true)
    }
    if name == "get" && receiver.starts_with("Box<") && shape_index(types, receiver) < 0 {
      types.box_places.set(index, true)
    }
    let shape = shape_index(types, receiver)
    if shape >= 0 && !types.shapes.at(shape).is_enum && name != "at" && root_place(types, tree, node) >= 0 {
      let field = field_index(types.shapes.at(shape), name)
      if field >= 0 {
        let ty = instantiate(types.shapes.at(shape).fields.at(field).ty, types.shapes.at(shape).generics, receiver)
        let signature = value_signature(types, ty)
        if signature >= 0 { return call_args(types, tree, args, name, signature, unknown(), -1) }
      }
    }
    return member(types, tree, receiver, name, args, node, hint)
  }
  if tag == "GenericMember" {
    let base = ast.name_at(tree, index, 0)
    let params = ast.child(tree, index, 1)
    let name = ast.name_at(tree, index, 2)
    if base == "Int" && (name == "from" || name == "try_from") {
      let range = ast.range_type(tree, params)
      return check_range_member(types, tree, range, name, ast.child(tree, index, 3))
    }
    let owner = type_terms.apply(base, source_types(types, tree, params))
    return member(types, tree, owner, name, ast.child(tree, index, 3), -1, hint)
  }
  if tag == "Bin" { return binary(types, tree, index, hint) }
  if tag == "Un" {
    let op = ast.name_at(tree, index, 0)
    let value = ast.child(tree, index, 1)
    if op == "!" {
      let ty = String.from("Bool")
      expect_type(types, ty, infer(types, tree, value, ty))
      return ty
    }
    if op == "?" { return propagate(types, tree, value) }
    if op == "-" {
      if tree.at(value).tag == "Int" || tree.at(value).tag == "NumT" {
        return literal_integer(types, tree, value, hint, true)
      }
      let ty = numeric_type(infer(types, tree, value, hint))
      if ty.starts_with("UInt") {
        issue(types, "cannot negate a {ty}: unsigned numbers have no minus sign")
      } else if !integer(ty) && !floating(ty) {
        expect_type(types, String.from("Int"), ty)
        return unknown()
      }
      return ty
    }
  }
  return unknown()
}

fn check_assignment(types: mut Types, tree: view List<ast.AstNode>, index: Int) {
  let target = ast.child(tree, index, 0)
  var left = unknown()
  let binding = types.identities.at(target)
  if binding >= 0 && tree.at(target).tag == "Var" { left = String.from(types.bindings.at(binding)) }
  else { left = infer(types, tree, target, unknown()) }
  let root = root_place(types, tree, target)
  var id = -1
  if root >= 0 { id = types.identities.at(root) }
  let value = ast.child(tree, index, 1)
  let right = infer(types, tree, value, left)
  require_value(types, tree, value, right)
  if id >= 0 && (target == root || types.verify_ownership) {
    let name = place_name(tree, target)
    if types.verify_ownership { check_frozen(types, id, name, true) }
    let why = immutable_reason(types, tree, id)
    if why != "" {
      issue(types, "cannot reassign '{name}': {why}")
      return
    }
    if types.verify_ownership && target == root { types.moved.set(id, false) }
  }
  expect_type(types, left, right)
}

fn pattern_head(tree: view List<ast.AstNode>, node: Int) -> Int {
  var head = node
  while head >= 0 && tree.at(head).tag == "Bind" {
    head = ast.child(tree, head, 1)
  }
  return head
}

fn whole_pattern(tree: view List<ast.AstNode>, node: Int) -> Bool {
  return node < 0 || tree.at(node).tag == "_" || tree.at(node).tag == "Wild"
}

fn check_pattern(types: mut Types, tree: view List<ast.AstNode>, node: Int, subject: view String, mode: view String, borrows: mut Bool) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Bind" {
    let id = types.identities.at(node)
    if id >= 0 {
      types.bindings.set(id, String.from(subject))
      if mode == "Mut" || (mode == "View" && owns_value(types, subject)) {
        types.modes.set(id, String.from(mode))
        borrows = true
      }
    }
    check_pattern(types, tree, ast.child(tree, node, 1), subject, mode, borrows)
  } else if tag == "Or" {
    let items = ast.child(tree, node, 0)
    var i = items + 1
    while i < tree.at(items).end {
      check_pattern(types, tree, i, subject, mode, borrows)
      i = tree.at(i).end
    }
  } else if tag == "Variant" {
    let shape = shape_index(types, subject)
    if shape < 0 || !types.shapes.at(shape).is_enum { return }
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let variant = variant_index(types.shapes.at(shape), name)
    if variant < 0 {
      issue(types, "enum {subject} has no variant '{name}'")
      return
    }
    let items = ast.child(tree, node, 1)
    let count = child_count(tree, items)
    let expected = types.shapes.at(shape).variants.at(variant).payload.len()
    if count != expected {
      issue(types, "{subject}.{name} carries {expected} value(s) but the pattern binds {count}")
      return
    }
    var i = items + 1
    for at in 0..count {
      let payload = instantiate(types.shapes.at(shape).variants.at(variant).payload.at(at),
        types.shapes.at(shape).generics, subject)
      check_pattern(types, tree, i, payload, mode, borrows)
      i = tree.at(i).end
    }
  } else if tag == "TuplePat" {
    if !subject.starts_with("$tuple") { return }
    let parts = type_terms.arguments(subject)
    let items = ast.child(tree, node, 0)
    if child_count(tree, items) != parts.len() {
      issue(types, "the tuple pattern binds {child_count(tree, items)} value(s) but the tuple has {parts.len()}")
      return
    }
    var i = items + 1
    for part in parts {
      check_pattern(types, tree, i, part, mode, borrows)
      i = tree.at(i).end
    }
  } else if tag == "PatRange" {
    let char = tree.at(ast.child(tree, node, 0)).tag == "true"
    if char { expect_type(types, subject, String.from("Char")) }
    else if !integer(subject) { expect_type(types, subject, String.from("Int")) }
  } else if tag == "Text" {
    if subject != "String" { expect_type(types, subject, String.from("Text")) }
  } else if tag == "Bool" || tag == "Int" || tag == "Char" {
    var ty = String.from(tag)
    if tag == "Int" && integer(subject) { ty = String.from(subject) }
    expect_type(types, subject, ty)
  }
}

fn specialize_row(tree: view List<ast.AstNode>, rows: mut List<PatternRow>, row: view PatternRow,
    node: Int, name: view String, arity: Int) {
  let head = pattern_head(tree, node)
  var prefix = List<Int>.new()
  if whole_pattern(tree, head) {
    for i in 0..arity { prefix.push(-1) }
  } else if tree.at(head).tag == "Or" {
    let items = ast.child(tree, head, 0)
    var i = items + 1
    while i < tree.at(items).end {
      specialize_row(tree, rows, row, i, name, arity)
      i = tree.at(i).end
    }
    return
  } else if tree.at(head).tag == "Variant" {
    let variant = type_terms.last_name(ast.name_at(tree, head, 0))
    if name == "" || variant != name { return }
    let pats = ast.child(tree, head, 1)
    if child_count(tree, pats) != arity { return }
    var i = pats + 1
    while i < tree.at(pats).end {
      prefix.push(i)
      i = tree.at(i).end
    }
  } else if tree.at(head).tag == "TuplePat" {
    if name != "$tuple" { return }
    let pats = ast.child(tree, head, 0)
    if child_count(tree, pats) != arity { return }
    var i = pats + 1
    while i < tree.at(pats).end {
      prefix.push(i)
      i = tree.at(i).end
    }
  } else if !(tree.at(head).tag == "Bool" && tree.at(ast.child(tree, head, 0)).tag == name) {
    return
  }
  for i in 1..row.nodes.len() { prefix.push(row.nodes.at(i)) }
  rows.push(PatternRow { nodes: move prefix })
}

fn specialized_witness(types: view Types, tree: view List<ast.AstNode>, rows: view List<PatternRow>,
    columns: view List<String>, name: view String, payload: view List<String>, out: mut List<String>) -> Bool {
  var next_rows = List<PatternRow>.new()
  for row in rows { specialize_row(tree, next_rows, row, row.nodes.at(0), name, payload.len()) }
  var next_types = copy_names(payload)
  for i in 1..columns.len() { next_types.push(String.from(columns.at(i))) }
  var witness = List<String>.new()
  if !missing_pattern(types, tree, next_rows, next_types, witness) { return false }
  if name == "" { out.push(String.from("_")) }
  else if payload.len() == 0 { out.push(String.from(name)) }
  else {
    var parts = List<String>.new()
    for i in 0..payload.len() { parts.push(String.from(witness.at(i))) }
    let text = parts.join(", ")
    if name == "$tuple" { out.push("({text})") }
    else { out.push("{name}({text})") }
  }
  for i in payload.len()..witness.len() { out.push(String.from(witness.at(i))) }
  return true
}

fn variant_witness(types: view Types, tree: view List<ast.AstNode>, rows: view List<PatternRow>,
    columns: view List<String>, shape: Int, variant: view Variant, out: mut List<String>) -> Bool {
  var payload = List<String>.new()
  for ty in variant.payload {
    payload.push(instantiate(ty, types.shapes.at(shape).generics, columns.at(0)))
  }
  return specialized_witness(types, tree, rows, columns, variant.name, payload, out)
}

fn missing_pattern(types: view Types, tree: view List<ast.AstNode>, rows: view List<PatternRow>,
    columns: view List<String>, out: mut List<String>) -> Bool {
  if columns.len() == 0 { return rows.len() == 0 }
  if rows.len() == 0 {
    for col in columns { out.push(String.from("_")) }
    return true
  }
  // A column made exclusively of wildcards does not require constructor expansion.
  var wild = true
  for row in rows {
    if !whole_pattern(tree, pattern_head(tree, row.nodes.at(0))) { wild = false; break }
  }
  let shape = shape_index(types, columns.at(0))
  let none = List<String>.new()
  if !wild && shape >= 0 && types.shapes.at(shape).is_enum {
    for variant in types.shapes.at(shape).variants {
      if variant_witness(types, tree, rows, columns, shape, variant, out) { return true }
    }
    return false
  }
  if !wild && columns.at(0).starts_with("$tuple") {
    let parts = type_terms.arguments(columns.at(0))
    return specialized_witness(types, tree, rows, columns, String.from("$tuple"), parts, out)
  }
  if !wild && columns.at(0) == "Bool" {
    return specialized_witness(types, tree, rows, columns, String.from("false"), none, out) ||
      specialized_witness(types, tree, rows, columns, String.from("true"), none, out)
  }
  return specialized_witness(types, tree, rows, columns, String.new(), none, out)
}

fn flat_variant(tree: view List<ast.AstNode>, node: Int) -> Bool {
  if tree.at(node).tag != "Variant" { return tree.at(node).tag == "Wild" }
  let payload = ast.child(tree, node, 1)
  var i = payload + 1
  while i < tree.at(payload).end {
    if tree.at(i).tag != "Bind" || tree.at(ast.child(tree, i, 1)).tag != "_" { return false }
    i = tree.at(i).end
  }
  return true
}

fn check_match(types: mut Types, returns: mut Returns, tree: view List<ast.AstNode>, index: Int) -> Bool {
  var scrutinee = ast.child(tree, index, 0)
  var mutable = false
  if tree.at(scrutinee).tag == "Un" && tree.at(ast.child(tree, scrutinee, 0)).tag == "6d7574" {
    mutable = true
    scrutinee = ast.child(tree, scrutinee, 1)
  }
  let subject = infer(types, tree, scrutinee, unknown())
  let root = root_place(types, tree, scrutinee)
  var mode = String.from("Own")
  var id = -1
  if root >= 0 && types.verify_ownership {
    id = types.identities.at(root)
    if id >= 0 && mutable {
      mode = String.from("Mut")
      let why = immutable_reason(types, tree, id)
      if why != "" {
        let name = place_name(tree, scrutinee)
        issue(types, "cannot `match mut` on '{name}': {why}")
      }
    } else if id >= 0 && owns_value(types, subject) { mode = String.from("View") }
  }
  let before = ownership.snapshot(types.moved)
  var after = List<Bool>.new()
  var falls_through = false
  let shape = shape_index(types, subject)
  let arms = ast.child(tree, index, 1)
  var rows = List<PatternRow>.new()
  var seen = List<String>.new()
  var flat = true
  var covered = false
  let errors = types.errors
  var i = arms + 1
  while i < tree.at(arms).end {
    let pat = ast.child(tree, i, 0)
    let guard = ast.child(tree, i, 1)
    if !flat_variant(tree, pat) || tree.at(guard).tag != "_" { flat = false }
    i = tree.at(i).end
  }
  i = arms + 1
  while i < tree.at(arms).end {
    let pat = ast.child(tree, i, 0)
    let guard = ast.child(tree, i, 1)
    types.moved = ownership.snapshot(before)
    var borrows = false
    check_pattern(types, tree, pat, subject, mode, borrows)
    if borrows {
      types.frozen.push(Frozen { binding: id, place: place_name(tree, scrutinee), exclusive: mutable, from_let: false })
    }
    if tree.at(guard).tag == "_" {
      var row = List<Int>.new()
      row.push(pat)
      rows.push(PatternRow { nodes: move row })
      if flat && tree.at(pat).tag == "Variant" {
        let name = type_terms.last_name(ast.name_at(tree, pat, 0))
        if seen.contains(name) { issue(types, "variant '{name}' is matched twice") }
        else { seen.push(move name) }
      }
      if whole_pattern(tree, pattern_head(tree, pat)) { covered = true }
    } else {
      let boolean = String.from("Bool")
      expect_type(types, boolean, infer(types, tree, guard, boolean))
    }
    let exits = check_body(types, returns, tree, ast.child(tree, i, 2))
    if borrows { let unused = types.frozen.pop() }
    if !exits {
      if falls_through { ownership.join(after, types.moved) }
      else { after = ownership.snapshot(types.moved) }
      falls_through = true
    }
    i = tree.at(i).end
  }
  if falls_through { types.moved = move after }
  else { types.moved = ownership.snapshot(before) }
  if covered { return !falls_through }
  if types.errors != errors { return false }
  var columns = List<String>.new()
  columns.push(String.from(subject))
  var missing = List<String>.new()
  if shape >= 0 && types.shapes.at(shape).is_enum {
    for variant in types.shapes.at(shape).variants {
      if flat {
        if !seen.contains(variant.name) { missing.push(String.from(variant.name)) }
      } else {
        var witness = List<String>.new()
        if variant_witness(types, tree, rows, columns, shape, variant, witness) {
          missing.push(String.from(witness.at(0)))
        }
      }
    }
  } else if subject == "Bool" {
    let uncovered = missing_pattern(types, tree, rows, columns, missing)
  }
  if missing.len() > 0 {
    let text = missing.join(", ")
    issue(types, "`match` is not exhaustive: missing {text}")
    return false
  }
  return !falls_through && (shape >= 0 || subject == "Bool")
}

fn check_loop(types: mut Types, returns: mut Returns, tree: view List<ast.AstNode>, index: Int) {
  let label_node = ast.child(tree, index, 0)
  var label = String.new()
  if tree.at(label_node).tag != "_" { label = ast.decoded_name(tree, label_node) }
  let before = ownership.snapshot(types.moved)
  var body = ast.child(tree, index, 2)
  let for_loop = tree.at(index).tag == "For"
  if for_loop {
    let iter = ast.child(tree, index, 3)
    var element = unknown()
    if tree.at(iter).tag == "IterRange" {
      let lo = infer(types, tree, ast.child(tree, iter, 0), unknown())
      let hi = infer(types, tree, ast.child(tree, iter, 1), lo)
      expect_type(types, lo, hi)
      element = numeric_type(lo)
      let step = ast.child(tree, index, 4)
      if tree.at(step).tag != "_" { expect_type(types, element, infer(types, tree, step, element)) }
    } else {
      let iterable = infer(types, tree, iter, unknown())
      element = type_terms.element(iterable)
      if iterable == "Chars" { element = String.from("Char") }
      let iterable_base = type_terms.base(iterable)
      if iterable_base == "Pieces" {
        let piece_args = type_terms.arguments(iterable)
        element = type_terms.bracket(piece_args.at(0), String.from("_"))
      }
      if element == "?" {
        let base = type_terms.base(iterable)
        for signature in types.signatures {
          let candidate_base = type_terms.base(signature.owner)
          if signature.name == "next" && signature.receiver == "Mut" && signature.args.len() == 0 &&
              candidate_base == base {
            var sub = type_terms.with_names(signature.generics)
            type_terms.bind(sub, signature.owner, iterable)
            let owner = type_terms.substitute(signature.owner, sub)
            if owner != iterable { continue }
            let result = type_terms.substitute(signature.result, sub)
            let args = type_terms.arguments(result)
            let result_base = type_terms.base(result)
            if result_base == "Option" && args.len() == 1 {
              element = String.from(args.at(0))
              break
            }
          }
        }
        if element != "?" {
          if root_place(types, tree, iter) >= 0 && tree.at(iter).tag != "Move" {
            var loans = List<ownership.Loan>.new()
            record_loan(types, tree, loans, iter, String.from("Mut"), iterable, true)
          }
          if tree.at(ast.child(tree, index, 2)).tag == "true" {
            issue(types, String.from("mut iteration is only supported for sequences"))
          }
        }
      } else if owns_value(types, element) && tree.at(iter).tag != "Move" && root_place(types, tree, iter) >= 0 {
        let id = types.identities.at(index)
        types.modes.set(id, String.from("View"))
      }
    }
    let id = types.identities.at(index)
    if tree.at(ast.child(tree, index, 2)).tag == "true" { types.modes.set(id, String.from("Mut")) }
    types.bindings.set(id, move element)
    body = ast.child(tree, index, 5)
  } else {
    let boolean = String.from("Bool")
    expect_type(types, boolean, infer(types, tree, ast.child(tree, index, 1), boolean))
  }
  let entry = ownership.snapshot(types.moved)
  var iteration = ownership.snapshot(before)
  if for_loop { iteration = ownership.snapshot(entry) }
  let deferred = types.deferred.len()
  types.loops.push(LoopFlow {
    deferred: deferred, label: move label, breaks: ownership.snapshot(entry),
    continues: ownership.snapshot(entry), continued: false,
  })
  let exits = check_body(types, returns, tree, body)
  let flow = types.loops.pop()
  if flow.continued {
    if exits { types.moved = ownership.snapshot(flow.continues) }
    else { ownership.join(types.moved, flow.continues) }
  }
  if !exits || flow.continued {
    for id in 0..types.moved.len() {
      let decl = types.declarations.at(id)
      if decl < index && types.moved.at(id) && !iteration.at(id) {
        var name = String.from("self")
        if tree.at(decl).tag != "Self" {
          var offset = 0
          if tree.at(decl).tag == "For" { offset = 1 }
          name = ast.name_at(tree, decl, offset)
        }
        issue(types, "'{name}' is moved inside the loop and would be used again on the next iteration")
      }
    }
  } else { types.moved = move entry }
  ownership.join(types.moved, flow.breaks)
}

fn loop_exit(types: mut Types, tree: view List<ast.AstNode>, index: Int, stop: Bool) {
  let label_node = ast.child(tree, index, 0)
  var label = String.new()
  if tree.at(label_node).tag != "_" { label = ast.decoded_name(tree, label_node) }
  var level = types.loops.len()
  while level > 0 {
    level = level - 1
    if label == "" || label == types.loops.at(level).label {
      let start = types.loops.at(level).deferred
      check_deferred(types, tree, start)
      let current = ownership.snapshot(types.moved)
      if stop { ownership.join(types.loops.at(level).breaks, current) }
      else {
        ownership.join(types.loops.at(level).continues, current)
        types.loops.at(level).continued = true
      }
      return
    }
  }
}

fn check_unpack(types: mut Types, tree: view List<ast.AstNode>, pattern: Int, ty: view String) {
  if tree.at(pattern).tag == "UnpackBind" {
    let id = types.identities.at(pattern)
    if id >= 0 {
      types.bindings.set(id, String.from(ty))
      if types.trace && ty != "?" {
        let name = ast.name_at(tree, pattern, 0)
        types.messages.push("type:{name}:{numeric_type(ty)}")
      }
    }
    return
  }
  let fields = ast.child(tree, pattern, 0)
  let args = type_terms.arguments(ty)
  if !ty.starts_with("$tuple") || child_count(tree, fields) != args.len() {
    if ty != "?" { issue(types, "tuple pattern does not match {ty}") }
    return
  }
  var at = fields + 1
  for arg in args {
    check_unpack(types, tree, at, arg)
    at = tree.at(at).end
  }
}

fn check_body(types: mut Types, returns: mut Returns, tree: view List<ast.AstNode>, index: Int) -> Bool {
  let want = returns.want
  if want {
    let tag = String.from(tree.at(index).tag)
    if tag != "Block" && tag != "[" && tag != "If" && tag != "IfExpr" && tag != "Match" && tag != "MatchExpr" && tag != "Expr" {
      returns.want = false
    }
  }
  let exits = check_statement(types, returns, tree, index)
  returns.want = want
  return exits
}

fn borrows_element(types: view Types, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Bool {
  if tree.at(node).tag != "Method" || tree.at(ast.child(tree, node, 1)).tag != "6174" { return false }
  return owns_value(types, ty) && root_place(types, tree, node) >= 0
}

fn check_statement(types: mut Types, returns: mut Returns, tree: view List<ast.AstNode>, index: Int) -> Bool {
  let tag = String.from(tree.at(index).tag)
  if tag == "Let" {
    let initializer = ast.child(tree, index, 2)
    var ty = infer(types, tree, initializer, unknown())
    // `let x = list.at(i)` borrows the element
    let id = types.identities.at(index)
    var named_borrow = false
    if borrows_element(types, tree, initializer, ty) {
      named_borrow = true
      types.modes.set(id, String.from("View"))
      let list = ast.child(tree, initializer, 0)
      let root = root_place(types, tree, list)
      if types.verify_ownership && tree.at(ast.child(tree, index, 1)).tag == "false" && root >= 0 && types.identities.at(root) >= 0 {
        types.frozen.push(Frozen { binding: types.identities.at(root), place: place_name(tree, list), exclusive: false, from_let: true })
      }
    }
    else { require_value(types, tree, initializer, ty) }
    if ty == "nothing" {
      issue(types, String.from("this expression produces no value"))
      ty = unknown()
    }
    types.bindings.set(id, String.from(ty))
    // the Rust checker binds a borrowed element without a typed-let trace line
    if types.trace && ty != "?" && !(named_borrow && types.verify_ownership) {
      let name = ast.name_at(tree, index, 0)
      let display = numeric_type(ty)
      types.messages.push("type:{name}:{display}")
    }
  } else if tag == "Unpack" {
    let initializer = ast.child(tree, index, 1)
    let ty = infer(types, tree, initializer, unknown())
    require_value(types, tree, initializer, ty)
    check_unpack(types, tree, ast.child(tree, index, 0), ty)
  } else if tag == "Return" {
    let value = ast.child(tree, index, 0)
    var ty = unit()
    if tree.at(value).tag != "_" {
      ty = infer(types, tree, value, returns.expected)
      if tree.at(value).tag == "Var" && owns_value(types, ty) {
        let id = types.identities.at(value)
        if id >= 0 {
          let name = ast.name_at(tree, value, 0)
          if types.modes.at(id) == "Own" { move_binding(types, id, name) }
          else { issue(types, "cannot return '{name}': it is only borrowed") }
        }
      } else { require_value(types, tree, value, ty) }
    }
    expect_type(types, returns.expected, ty)
    let floor = types.defer_floor
    check_deferred(types, tree, floor)
    if returns.inferred == "nothing" { returns.inferred = move ty }
    return true
  } else if tag == "Assign" {
    check_assignment(types, tree, index)
  } else if tag == "Expr" {
    let value = ast.child(tree, index, 0)
    var hint = unknown()
    if returns.want {
      if returns.value != "" { hint = String.from(returns.value) }
      else { hint = String.from(returns.hint) }
    }
    let ty = infer(types, tree, value, hint)
    require_value(types, tree, value, ty)
    if tree.at(value).tag == "Call" && types.identities.at(value) < 0 {
      let name = ast.name_at(tree, value, 0)
      if name == "panic" && signature_index(types, name, false) < 0 { return true }
    }
    if returns.want {
      if ty == "nothing" { issue(types, String.from("this expression produces no value")) }
      else if returns.value == "" { returns.value = String.from(ty) }
      else { expect_type(types, returns.value, ty) }
    }
  } else if tag == "If" || tag == "IfExpr" {
    let boolean = String.from("Bool")
    expect_type(types, boolean, infer(types, tree, ast.child(tree, index, 0), boolean))
    let before = ownership.snapshot(types.moved)
    let then_exits = check_body(types, returns, tree, ast.child(tree, index, 1))
    let then_moved = ownership.snapshot(types.moved)
    types.moved = move before
    let else_exits = check_body(types, returns, tree, ast.child(tree, index, 2))
    if !then_exits && else_exits { types.moved = move then_moved }
    else if !then_exits { ownership.join(types.moved, then_moved) }
    return then_exits && else_exits
  } else if tag == "While" || tag == "For" {
    check_loop(types, returns, tree, index)
  } else if tag == "Break" || tag == "Continue" {
    loop_exit(types, tree, index, tag == "Break")
    return true
  } else if tag == "Match" || tag == "MatchExpr" {
    return check_match(types, returns, tree, index)
  } else if tag == "Defer" {
    let before = ownership.snapshot(types.moved)
    let inner = ast.child(tree, index, 0)
    let exits = check_body(types, returns, tree, inner)
    types.moved = move before
    if types.verify_ownership { types.deferred.push(inner) }
  } else if tag == "Block" || tag == "[" || tag == "Scope" || tag == "Unsafe" {
    var i = index + 1
    let deferred = types.deferred.len()
    var exits = false
    let tail = returns.want
    let frozen_before = types.frozen.len()
    while i < tree.at(index).end {
      returns.want = tail && tree.at(i).end == tree.at(index).end
      if check_body(types, returns, tree, i) {
        exits = true
        if types.verify_ownership { break }
      }
      i = tree.at(i).end
    }
    returns.want = tail
    // names borrowed from a list by `let x = l.at(i)` end with their block
    while types.frozen.len() > frozen_before { let unused = types.frozen.pop() }
    if !exits { check_deferred(types, tree, deferred) }
    while types.deferred.len() > deferred { let unused = types.deferred.pop() }
    return exits
  }
  return false
}

fn bounded_parameters(tree: view List<ast.AstNode>, generics: Int, bound: Text) -> List<String> {
  var names = List<String>.new()
  var i = generics + 1
  while i < tree.at(generics).end {
    if tree.at(i).tag == "Generic" {
      let bounds = ast.child(tree, i, 1)
      var j = bounds + 1
      while j < tree.at(bounds).end {
        let name = ast.decoded_name(tree, j)
        if name == bound { names.push(ast.name_at(tree, i, 0)); break }
        j = tree.at(j).end
      }
    }
    i = tree.at(i).end
  }
  return move names
}

fn prelude_method(types: mut Types, owner: view String, name: Text, receiver: Text, result: Text, arg: Text, mode: Text) {
  var args = List<Parameter>.new()
  if arg != "" { args.push(Parameter { mode: String.from(mode), ty: String.from(arg) }) }
  let index = types.signatures.len()
  let spelling = add_signature(types, String.from(name), move args, String.from(result))
  types.signatures.at(index).owner = String.from(owner)
  types.signatures.at(index).receiver = String.from(receiver)
  types.signatures.at(index).generics = type_terms.arguments(owner)
}

fn prelude_enum(name: Text, parameters: Text, first: Text, second: Text, second_type: Text) -> Shape {
  let names = String.from(parameters).split(", ")
  var variants = List<Variant>.new()
  var payload = List<String>.new()
  payload.push(String.from("T"))
  variants.push(Variant { name: String.from(first), payload: move payload })
  var other = List<String>.new()
  if second_type != "" { other.push(String.from(second_type)) }
  variants.push(Variant { name: String.from(second), payload: move other })
  return Shape {
    name: String.from(name), generics: move names, fields: List<FieldType>.new(),
    variants: move variants, is_enum: true, user_drop: false,
  }
}

fn declare_prelude(types: mut Types) {
  types.shapes.push(prelude_enum("Option", "T", "Some", "None", ""))
  types.shapes.push(prelude_enum("Result", "T, E", "Ok", "Err", "E"))
  let self_type = String.from("Self")
  let equal = types.signatures.len()
  prelude_method(types, self_type, "eq", "View", "Bool", "Self", "View")
  types.signatures.at(equal).required_trait = String.from("Equal")
  types.signatures.at(equal).generics.push(String.from(self_type))
  let ordered = types.signatures.len()
  prelude_method(types, self_type, "cmp", "View", "Int", "Self", "View")
  types.signatures.at(ordered).required_trait = String.from("Ordered")
  types.signatures.at(ordered).generics.push(move self_type)
  let string = String.from("String")
  prelude_method(types, string, "new", "", "String", "", "Own")
  prelude_method(types, string, "from", "", "String", "String", "View")
  let concat = types.signatures.len()
  prelude_method(types, string, "concat", "", "String", "String", "View")
  types.signatures.at(concat).args.push(Parameter { mode: String.from("View"), ty: String.from("String") })
  prelude_method(types, string, "clone", "View", "String", "", "Own")
  prelude_method(types, string, "len", "View", "Int", "", "Own")
  prelude_method(types, string, "byte", "View", "Int", "Int", "Own")
  prelude_method(types, string, "eq", "View", "Bool", "String", "View")
  prelude_method(types, string, "cmp", "View", "Int", "String", "View")
  prelude_method(types, string, "clear", "Mut", "nothing", "", "Own")
  prelude_method(types, string, "push_str", "Mut", "nothing", "String", "View")
  let push_slice = types.signatures.len()
  prelude_method(types, string, "push_slice", "Mut", "nothing", "String", "View")
  types.signatures.at(push_slice).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  types.signatures.at(push_slice).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  prelude_method(types, string, "reserve", "Mut", "nothing", "Int", "Own")
  prelude_method(types, string, "push_int", "Mut", "nothing", "Int", "Own")
  prelude_method(types, string, "push_byte", "Mut", "nothing", "Int", "Own")
  prelude_method(types, string, "push_char", "Mut", "nothing", "Char", "Own")
  prelude_method(types, string, "raw_addr", "View", "Int", "", "Own")
  let raw = types.signatures.len()
  prelude_method(types, string, "push_raw", "Mut", "nothing", "Int", "Own")
  types.signatures.at(raw).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  prelude_method(types, string, "char_size", "View", "Int", "Int", "Own")
  prelude_method(types, string, "is_empty", "View", "Bool", "", "Own")
  prelude_method(types, string, "is_boundary", "View", "Bool", "Int", "Own")
  prelude_method(types, string, "char_count", "View", "Int", "", "Own")
  prelude_method(types, string, "trim_start", "View", "String", "", "Own")
  prelude_method(types, string, "trim_end", "View", "String", "", "Own")
  prelude_method(types, string, "to_upper", "View", "String", "", "Own")
  prelude_method(types, string, "to_lower", "View", "String", "", "Own")
  prelude_method(types, string, "repeat", "View", "String", "Int", "Own")
  let find = types.signatures.len()
  prelude_method(types, string, "find_from", "View", "Int", "String", "View")
  types.signatures.at(find).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  prelude_method(types, string, "char_at", "View", "Char", "Int", "Own")
  let slice = types.signatures.len()
  prelude_method(types, string, "slice", "View", "String", "Int", "Own")
  types.signatures.at(slice).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  let replace = types.signatures.len()
  prelude_method(types, string, "replace", "View", "String", "String", "View")
  types.signatures.at(replace).args.push(Parameter { mode: String.from("View"), ty: String.from("String") })
  prelude_method(types, string, "trim", "View", "String", "", "Own")
  prelude_method(types, string, "starts_with", "View", "Bool", "String", "View")
  prelude_method(types, string, "ends_with", "View", "Bool", "String", "View")
  prelude_method(types, string, "contains", "View", "Bool", "String", "View")
  prelude_method(types, string, "find", "View", "Int", "String", "View")
  prelude_method(types, string, "split", "View", "List<String>", "String", "View")
  prelude_method(types, string, "lines", "View", "List<String>", "", "Own")
  prelude_method(types, string, "parse_int", "View", "Bool", "Int", "Mut")
  let char = String.from("Char")
  prelude_method(types, char, "to_int", "View", "Int", "", "Own")
  prelude_method(types, char, "utf8_len", "View", "Int", "", "Own")
  prelude_method(types, char, "from_int", "", "Char", "Int", "Own")
  prelude_method(types, char, "is_valid", "", "Bool", "Int", "Own")
  prelude_method(types, string, "chars", "View", "Chars", "", "Own")
  let number = String.from("Int")
  prelude_method(types, number, "max", "View", "Int", "Int", "Own")
  prelude_method(types, number, "min", "View", "Int", "Int", "Own")
  for spelling in String.from("Int,Int8,Int16,Int32,UInt8,UInt16,UInt32,UInt64,Bool,Char,Text").split(",") {
    let index = types.signatures.len()
    prelude_method(types, spelling, "clone", "View", "", "", "Own")
    types.signatures.at(index).result = String.from(spelling)
  }
  let list = String.from("List<T>")
  prelude_method(types, list, "clone", "View", "List<T>", "", "Own")
  prelude_method(types, list, "new", "", "List<T>", "", "Own")
  prelude_method(types, list, "len", "View", "Int", "", "Own")
  prelude_method(types, list, "at", "View", "T", "Int", "Own")
  prelude_method(types, list, "is_empty", "View", "Bool", "", "Own")
  prelude_method(types, list, "remove", "Mut", "T", "Int", "Own")
  prelude_method(types, list, "swap_remove", "Mut", "T", "Int", "Own")
  prelude_method(types, list, "reverse", "Mut", "nothing", "", "Own")
  prelude_method(types, list, "extend", "Mut", "nothing", "List<T>", "Own")
  prelude_method(types, list, "copy", "View", "List<T>", "", "Own")
  let insert = types.signatures.len()
  prelude_method(types, list, "insert", "Mut", "nothing", "Int", "Own")
  types.signatures.at(insert).args.push(Parameter { mode: String.from("Own"), ty: String.from("T") })
  let copy_range = types.signatures.len()
  prelude_method(types, list, "slice", "View", "List<T>", "Int", "Own")
  types.signatures.at(copy_range).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  prelude_method(types, list, "get", "View", "T", "Int", "Own")
  prelude_method(types, list, "push", "Mut", "nothing", "T", "Own")
  prelude_method(types, list, "pop", "Mut", "T", "", "Own")
  prelude_method(types, list, "clear", "Mut", "nothing", "", "Own")
  prelude_method(types, list, "truncate", "Mut", "nothing", "Int", "Own")
  let set = types.signatures.len()
  prelude_method(types, list, "set", "Mut", "nothing", "Int", "Own")
  types.signatures.at(set).args.push(Parameter { mode: String.from("Own"), ty: String.from("T") })
  let swap = types.signatures.len()
  prelude_method(types, list, "swap", "Mut", "nothing", "Int", "Own")
  types.signatures.at(swap).args.push(Parameter { mode: String.from("Own"), ty: String.from("Int") })
  prelude_method(types, list, "contains", "View", "Bool", "T", "View")
  prelude_method(types, list, "index_of", "View", "Int", "T", "View")
  let strings = String.from("List<String>")
  prelude_method(types, strings, "join", "View", "String", "String", "View")
  let option = String.from("Option<T>")
  prelude_method(types, option, "is_some", "View", "Bool", "", "Own")
  prelude_method(types, option, "is_none", "View", "Bool", "", "Own")
  prelude_method(types, option, "clone", "View", "Option<T>", "", "Own")
  prelude_method(types, option, "unwrap", "Own", "T", "", "Own")
  prelude_method(types, option, "expect", "Own", "T", "String", "View")
  prelude_method(types, option, "unwrap_or", "Own", "T", "T", "Own")
  prelude_method(types, option, "or", "Own", "Option<T>", "Option<T>", "Own")
  let result = String.from("Result<T, E>")
  prelude_method(types, result, "clone", "View", "Result<T, E>", "", "Own")
  prelude_method(types, result, "is_ok", "View", "Bool", "", "Own")
  prelude_method(types, result, "is_err", "View", "Bool", "", "Own")
  prelude_method(types, result, "ok", "Own", "Option<T>", "", "Own")
  prelude_method(types, result, "err", "Own", "Option<E>", "", "Own")
  prelude_method(types, result, "unwrap", "Own", "T", "", "Own")
  prelude_method(types, result, "expect", "Own", "T", "String", "View")
  prelude_method(types, result, "unwrap_or", "Own", "T", "T", "Own")
}

fn declare_shapes(types: mut Types, tree: view List<ast.AstNode>, items: Int) {
  var declarations = List<Int>.new()
  var i = items + 1
  while i < tree.at(items).end {
    let decl = ast.child(tree, i, 2)
    let tag = String.from(tree.at(decl).tag)
    if tag == "Struct" || tag == "Enum" {
      let generics = generic_names(tree, ast.child(tree, decl, 1))
      types.shapes.push(Shape {
        name: ast.name_at(tree, decl, 0), generics: move generics, fields: List<FieldType>.new(),
        variants: List<Variant>.new(), is_enum: tag == "Enum", user_drop: false,
      })
      declarations.push(decl)
    }
    i = tree.at(i).end
  }
  let offset = types.shapes.len() - declarations.len()
  for index in 0..declarations.len() {
    let at = index + offset
    types.generics = copy_names(types.shapes.at(at).generics)
    let fields = ast.child(tree, declarations.at(index), 2)
    i = fields + 1
    while i < tree.at(fields).end {
      let name = ast.name_at(tree, i, 0)
      let entry = ast.child(tree, i, 1)
      if tree.at(i).tag == "FieldDef" {
        let ty = source_type(types, tree, entry)
        types.shapes.at(at).fields.push(FieldType { name: move name, ty: move ty })
      } else {
        let payload = source_types(types, tree, entry)
        types.shapes.at(at).variants.push(Variant { name: move name, payload: move payload })
      }
      i = tree.at(i).end
    }
  }
  types.generics = List<String>.new()
}

fn declare_function(types: mut Types, tree: view List<ast.AstNode>, node: Int, owner: view String,
    impl_params: Int) -> Function {
  let method_params = ast.child(tree, node, 1)
  types.generics = generic_names(tree, method_params)
  var copy = bounded_parameters(tree, method_params, "Copy")
  var ordered = bounded_parameters(tree, method_params, "Ordered")
  if impl_params >= 0 {
    for name in generic_names(tree, impl_params) { types.generics.push(String.from(name)) }
    for name in bounded_parameters(tree, impl_params, "Copy") { copy.push(String.from(name)) }
    for name in bounded_parameters(tree, impl_params, "Ordered") { ordered.push(String.from(name)) }
  }
  let params_node = ast.child(tree, node, 2)
  var receiver = String.new()
  if tree.at(params_node).end > params_node + 1 && tree.at(params_node + 1).tag == "Self" {
    let self_node = params_node + 1
    receiver = String.from(tree.at(ast.child(tree, self_node, 0)).tag)
    let id = types.identities.at(self_node)
    types.bindings.set(id, String.from(owner))
    types.modes.set(id, String.from(receiver))
  }
  let params = param_types(types, tree, params_node, -1, true)
  let ret = return_type(types, tree, ast.child(tree, node, 3))
  let name = ast.name_at(tree, node, 0)
  for at in params_node + 1..tree.at(params_node).end {
    if tree.at(at).tag == "Variadic" { types.variadics.push(String.from(name)) }
  }
  let index = types.signatures.len()
  let spelling = add_signature(types, name, move params, ret)
  types.signatures.at(index).owner = String.from(owner)
  types.signatures.at(index).receiver = move receiver
  types.signatures.at(index).generics = copy_names(types.generics)
  types.signatures.at(index).copy_params = move copy
  types.signatures.at(index).ordered_params = move ordered
  return Function { node: node, signature: index, impl_params: impl_params }
}

fn declare_trait(types: mut Types, tree: view List<ast.AstNode>, node: Int) {
  let trait_name = ast.name_at(tree, node, 0)
  let methods = ast.child(tree, node, 1)
  var method = methods + 1
  while method < tree.at(methods).end {
    let params = ast.child(tree, method, 2)
    if params + 1 < tree.at(params).end && tree.at(params + 1).tag == "Self" {
      types.generics = generic_names(tree, ast.child(tree, method, 1))
      types.generics.push(String.from("Self"))
      let receiver = String.from(tree.at(ast.child(tree, params + 1, 0)).tag)
      let args = param_types(types, tree, params, -1, false)
      let result = return_type(types, tree, ast.child(tree, method, 3))
      let name = ast.name_at(tree, method, 0)
      let index = types.signatures.len()
      let spelling = add_signature(types, name, move args, result)
      types.signatures.at(index).owner = String.from("Self")
      types.signatures.at(index).receiver = move receiver
      types.signatures.at(index).generics = copy_names(types.generics)
      types.signatures.at(index).required_trait = String.from(trait_name)
    }
    method = tree.at(method).end
  }
  types.generics = List<String>.new()
}

pub fn check_file(tree: view List<ast.AstNode>, bindings: view locals.Locals, verify_ownership: Bool,
    trace: Bool) -> Checked {
  var types = Types {
    identities: List<Int>.new(), declarations: List<Int>.new(), captures: List<locals.Capture>.new(),
    bindings: List<String>.new(), shapes: List<Shape>.new(),
    signatures: List<Signature>.new(), errors: 0, generics: List<String>.new(),
    function_params: -1, impl_params: -1, return_type: unknown(),
    verify_ownership: verify_ownership, copy_params: List<String>.new(), ordered_params: List<String>.new(),
    modes: List<String>.new(), moved: List<Bool>.new(),
    loops: List<LoopFlow>.new(), deferred: List<Int>.new(), defer_floor: 0, frozen: List<Frozen>.new(),
    trace: trace, expressions: List<String>.new(), messages: List<String>.new(), equal_types: List<String>.new(), lead: -1, variadics: List<String>.new(), lead_type: String.new(), shown_types: List<String>.new(),
    ordered_types: List<String>.new(), aliases: List<String>.new(),
    borrowed_closures: List<Bool>.new(), box_places: List<Bool>.new(),
  }
  for i in 0..tree.len() { types.box_places.push(false) }
  if !trace {
    for i in 0..tree.len() {
      types.expressions.push(unknown())
      types.borrowed_closures.push(false)
    }
  }
  for capture in bindings.captures { types.captures.push(capture) }
  for id in bindings.identities { types.identities.push(id) }
  for binding in bindings.bindings {
    types.declarations.push(binding.node)
    types.bindings.push(unknown())
    types.modes.push(String.from("Own"))
    if verify_ownership { types.moved.push(false) }
  }
  let items = ast.child(tree, 0, 0)
  declare_prelude(types)
  declare_shapes(types, tree, items)

  var decl = items + 1
  while decl < tree.at(items).end {
    let item = ast.child(tree, decl, 2)
    if tree.at(item).tag == "Impl" {
      let trait_node = ast.child(tree, item, 1)
      if tree.at(trait_node).tag == "Type" {
        let name = ast.name_at(tree, trait_node, 0)
        let owner = source_type(types, tree, ast.child(tree, item, 2))
        if name == "Drop" {
          let shape = shape_index(types, owner)
          if shape >= 0 { types.shapes.at(shape).user_drop = true }
        } else if name == "Equal" { types.equal_types.push(String.from(owner)) }
        else if name == "Ordered" { types.ordered_types.push(String.from(owner)) }
        else if name == "Show" { types.shown_types.push(String.from(owner)) }
      }
    }
    decl = tree.at(decl).end
  }

  var derive = items + 1
  while derive < tree.at(items).end {
    let item = ast.child(tree, derive, 2)
    if tree.at(item).tag == "Derive" {
      let name = ast.name_at(tree, item, 0)
      let shape = shape_index(types, name)
      if shape >= 0 {
        let traits = ast.child(tree, item, 1)
        var trait_at = traits + 1
        while trait_at < tree.at(traits).end {
          let name = ast.decoded_name(tree, trait_at)
          if name == "Clone" {
            let owner = type_terms.apply(types.shapes.at(shape).name, types.shapes.at(shape).generics)
            let index = types.signatures.len()
            prelude_method(types, owner, "clone", "View", "", "", "Own")
            types.signatures.at(index).result = String.from(owner)
          }
          trait_at = tree.at(trait_at).end
        }
      }
    }
    derive = tree.at(derive).end
  }

  var functions = List<Function>.new()
  var i = items + 1
  while i < tree.at(items).end {
    let decl = ast.child(tree, i, 2)
    if tree.at(decl).tag == "Fn" {
      functions.push(declare_function(types, tree, decl, String.new(), -1))
    } else if tree.at(decl).tag == "Extern" {
      // foreign functions only need their signatures
      let list = ast.child(tree, decl, 1)
      var foreign = list + 1
      while foreign < tree.at(list).end {
        let declared = declare_function(types, tree, foreign, String.new(), -1)
        foreign = tree.at(foreign).end
      }
    } else if tree.at(decl).tag == "Trait" {
      declare_trait(types, tree, decl)
    } else if tree.at(decl).tag == "Impl" {
      let impl_params = ast.child(tree, decl, 0)
      types.generics = generic_names(tree, impl_params)
      let owner = source_type(types, tree, ast.child(tree, decl, 2))
      if owner != "?" {
        let methods = ast.child(tree, decl, 3)
        var m = methods + 1
        while m < tree.at(methods).end {
          functions.push(declare_function(types, tree, m, owner, impl_params))
          m = tree.at(m).end
        }
      }
    }
    i = tree.at(i).end
  }
  var constant = items + 1
  while constant < tree.at(items).end {
    let item = ast.child(tree, constant, 2)
    if tree.at(item).tag == "Const" {
      let kind = ast.child(tree, item, 1)
      var declared = unknown()
      if tree.at(kind).tag != "_" { declared = source_type(types, tree, kind) }
      let found = infer(types, tree, ast.child(tree, item, 2), declared)
    }
    constant = tree.at(constant).end
  }
  for fun in functions {
    types.function_params = ast.child(tree, fun.node, 1)
    types.impl_params = fun.impl_params
    types.generics = copy_names(types.signatures.at(fun.signature).generics)
    var state = Returns { expected: String.from(types.signatures.at(fun.signature).result), inferred: unit(), want: false, hint: String.new(), value: String.new() }
    types.return_type = String.from(state.expected)
    types.copy_params = copy_names(types.signatures.at(fun.signature).copy_params)
    types.ordered_params = copy_names(types.signatures.at(fun.signature).ordered_params)
    let exits = check_body(types, state, tree, ast.child(tree, fun.node, 4))
  }
  var borrowed_closures = List<Bool>.new()
  for borrowing in types.borrowed_closures { borrowed_closures.push(borrowing) }
  return Checked {
    bindings: copy_names(types.bindings), expressions: copy_names(types.expressions),
    messages: copy_names(types.messages), borrowed_closures: move borrowed_closures, errors: types.errors,
  }
}

fn main() {
  let args = env.args()
  if args.len() != 3 || !(args.at(1) == "locals" || args.at(1) == "types" || args.at(1) == "ownership") {
    ast.artifact_error("usage: types <locals|types|ownership> FILE.ast")
    return
  }
  match fs.read_to_string(args.at(2)) {
    Err(e) => { print(e.message); env.exit(2) }
    Ok(source) => {
      var file = ast.decode(String.from(source))
      if args.at(1) != "locals" { file = ast.decode_linked(move source) }
      let bindings = locals.resolve(file.nodes)
      if args.at(1) == "locals" {
        for row in bindings.rows { print(row) }
      } else {
        let checked = check_file(file.nodes, bindings, args.at(1) == "ownership", true)
        for row in checked.messages { print(row) }
        if checked.errors > 0 { env.exit(1) }
      }
    }
  }
}
