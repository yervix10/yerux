// Lower the checked source AST to C using the production C runtime.
import std.env
import std.fs
import std.io
import ast
import locals
import types
import type_terms

struct Value { ty: String, code: String }
struct Variant { name: String, payload: List<String> }
struct EnumLayout { ty: String, variants: List<Variant>, owned: Bool }
struct StructLayout { ty: String, owned: Bool, ready: Bool, destructor: Bool }
struct Method { owner: String, node: Int, params: Int, destructor: Bool, equality: Bool }
struct Instance { node: Int, owner: String, sub: type_terms.Substitution, key: String }
struct Loop { label: String, id: Int, deferred: Int }
struct Generator {
  checked: types.Checked,
  locals: locals.Locals,
  structs: List<Int>,
  enums: List<Int>,
  enum_layouts: List<EnumLayout>,
  struct_layouts: List<StructLayout>,
  methods: List<Method>,
  clone_types: List<String>,
  instances: List<Instance>,
  sub: type_terms.Substitution,
  prototypes: String,
  functions: List<Int>,
  collections: List<String>,
  globals: String,
  references: List<Bool>,
  out: String,
  indent: Int,
  temp: Int,
  loops: List<Loop>,
  deferred: List<Int>,
  result: String,
}

fn unsupported(message: view String) {
  io.eprintln("codegen: {message}")
  env.exit(3)
}

fn line(gen: mut Generator, text: view String) {
  for i in 0..gen.indent { gen.out.push_str("  ") }
  gen.out.push_str(text)
  gen.out.push_str("\n")
}

fn global(gen: mut Generator, text: view String) {
  gen.globals.push_str(text)
  gen.globals.push_str("\n")
}

fn collection_name(gen: view Generator, ty: view String) -> String {
  let id = gen.collections.index_of(ty)
  if id >= 0 { return "A{id}" }
  return String.new()
}

fn prepare_type(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String) {
  let item = type_terms.element(ty)
  if item != "?" && !gen.collections.contains(ty) {
    if item.starts_with("Slice<") { unsupported("slice stored inside a sequence") }
    prepare_type(gen, tree, item)
    let c = c_type(gen, tree, item)
    let id = gen.collections.len()
    let name = type_terms.base(ty)
    gen.collections.push(String.from(ty))
    if name == "Array" {
      if drop_fn(gen, tree, item).len() != 0 { unsupported("owned array elements") }
      let args = type_terms.arguments(ty)
      global(gen, "SC_ARRAY(A{id}, {c}, {args.at(1)})")
    } else if name == "Slice" {
      global(gen, "SC_SLICE(A{id}, {c})")
    } else {
      var drop = drop_fn(gen, tree, item)
      if drop == "" { drop = String.from("SC_COPY_ELEMENT") }
      global(gen, "SC_LIST(A{id}, {c}, {drop})")
      if item == "String" { global(gen, "SC_STRING_LIST(A{id})") }
    }
  }
  let base = type_terms.base(ty)
  if base == "Option" || base == "Result" || find_named(tree, gen.enums, base) >= 0 {
    prepare_enum(gen, tree, ty, base)
  }
  let structure = find_named(tree, gen.structs, base)
  if structure >= 0 { emit_struct(gen, tree, structure, ty) }
}

fn enum_index(gen: view Generator, ty: view String) -> Int {
  for i in 0..gen.enum_layouts.len() {
    if gen.enum_layouts.at(i).ty == ty { return i }
  }
  return -1
}

fn variant_index(layout: view EnumLayout, name: view String) -> Int {
  for i in 0..layout.variants.len() {
    if layout.variants.at(i).name == name { return i + 1 }
  }
  unsupported("unknown variant {name} of {layout.ty}")
  return -1
}

fn parameter_names(tree: view List<ast.AstNode>, params: Int) -> List<String> {
  var names = List<String>.new()
  var at = params + 1
  while at < tree.at(params).end {
    if tree.at(at).tag != "Generic" { unsupported("non-type generic parameters") }
    names.push(ast.name_at(tree, at, 0))
    at = tree.at(at).end
  }
  return move names
}

fn type_parameters(tree: view List<ast.AstNode>, decl: Int) -> List<String> {
  return parameter_names(tree, ast.child(tree, decl, 1))
}

fn enum_variants(gen: view Generator, tree: view List<ast.AstNode>, ty: view String,
    base: view String) -> List<Variant> {
  var cases = List<Variant>.new()
  let args = type_terms.arguments(ty)
  if base == "Option" || base == "Result" {
    var first = List<String>.new()
    var second = List<String>.new()
    if base == "Option" && args.len() == 1 {
      first.push(String.from(args.at(0)))
      cases.push(Variant { name: String.from("Some"), payload: move first })
      cases.push(Variant { name: String.from("None"), payload: move second })
    } else if base == "Result" && args.len() == 2 {
      first.push(String.from(args.at(0)))
      second.push(String.from(args.at(1)))
      cases.push(Variant { name: String.from("Ok"), payload: move first })
      cases.push(Variant { name: String.from("Err"), payload: move second })
    } else { unsupported("missing type parameters for {ty}") }
    return move cases
  }
  let decl = find_named(tree, gen.enums, base)
  let names = type_parameters(tree, decl)
  if names.len() != args.len() { unsupported("type parameters of {base}") }
  let sub = type_terms.Substitution { names: move names, values: move args }
  let variants = ast.child(tree, decl, 2)
  var at = variants + 1
  while at < tree.at(variants).end {
    let name = ast.name_at(tree, at, 0)
    let args = ast.child(tree, at, 1)
    var field = args + 1
    var payload = List<String>.new()
    while field < tree.at(args).end {
      payload.push(type_terms.substitute(declared_type(tree, field), sub))
      field = tree.at(field).end
    }
    cases.push(Variant { name: move name, payload: move payload })
    at = tree.at(at).end
  }
  return move cases
}

fn prepare_enum(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, base: view String) {
  if enum_index(gen, ty) >= 0 { return }
  let cases = enum_variants(gen, tree, ty, base)
  let id = gen.enum_layouts.len()
  // Reserve the identity before visiting payload types.
  gen.enum_layouts.push(EnumLayout { ty: String.from(ty), variants: List<Variant>.new(), owned: false })
  var fields = List<String>.new()
  var discard = List<String>.new()
  for i in 0..cases.len() {
    let slot = i + 1
    if cases.at(i).payload.len() > 0 { fields.push(String.from("struct {{")) }
    for j in 0..cases.at(i).payload.len() {
      let inner = String.from(cases.at(i).payload.at(j))
      prepare_type(gen, tree, inner)
      let c = c_type(gen, tree, inner)
      fields.push("{c} p{j};")
      let drop = drop_fn(gen, tree, inner)
      if drop != "" { discard.push("if (value->tag == {slot}) {drop}(&value->v{slot}.p{j});") }
    }
    if cases.at(i).payload.len() > 0 { fields.push("}} v{slot};") }
  }
  global(gen, "typedef struct {{ unsigned tag;")
  for field in fields { global(gen, field) }
  global(gen, "}} E{id};")
  if discard.len() > 0 {
    global(gen, "static inline void sc_drop_E{id}(E{id} *value) {{")
    for drop in discard { global(gen, drop) }
    global(gen, String.from("value->tag = 0; }}"))
    global(gen, "static inline E{id} sc_take_E{id}(E{id} *value) {{")
    global(gen, "E{id} result = *value; *value = (E{id}){{0}}; return result; }}")
    gen.enum_layouts.at(id).owned = true
  }
  gen.enum_layouts.at(id).variants = move cases
}

fn integer_c(ty: view String) -> String {
  if ty == "Int" || ty.starts_with("Int<") || ty == "Char" { return String.from("int64_t") }
  if ty == "Int8" { return String.from("int8_t") }
  if ty == "Int16" { return String.from("int16_t") }
  if ty == "Int32" { return String.from("int32_t") }
  if ty == "UInt8" { return String.from("uint8_t") }
  if ty == "UInt16" { return String.from("uint16_t") }
  if ty == "UInt32" { return String.from("uint32_t") }
  if ty == "UInt64" { return String.from("uint64_t") }
  return String.new()
}

fn integer_suffix(ty: view String) -> String {
  if ty == "Int" || ty.starts_with("Int<") { return String.new() }
  if ty == "Int8" { return String.from("_i8") }
  if ty == "Int16" { return String.from("_i16") }
  if ty == "Int32" { return String.from("_i32") }
  if ty == "UInt8" { return String.from("_u8") }
  if ty == "UInt16" { return String.from("_u16") }
  if ty == "UInt32" { return String.from("_u32") }
  if ty == "UInt64" { return String.from("_u64") }
  unsupported("arithmetic on {ty}")
  return String.new()
}

fn find_named(tree: view List<ast.AstNode>, nodes: view List<Int>, name: view String) -> Int {
  for node in nodes {
    let candidate = ast.name_at(tree, node, 0)
    if candidate == name { return node }
  }
  return -1
}

fn struct_index(gen: view Generator, ty: view String) -> Int {
  for i in 0..gen.struct_layouts.len() {
    if gen.struct_layouts.at(i).ty == ty { return i }
  }
  return -1
}

fn nominal_sub(tree: view List<ast.AstNode>, decl: Int, ty: view String) -> type_terms.Substitution {
  let names = type_parameters(tree, decl)
  let args = type_terms.arguments(ty)
  if names.len() != args.len() { unsupported("wrong type argument count for {ty}") }
  return type_terms.Substitution { names: move names, values: move args }
}

fn declared_for(tree: view List<ast.AstNode>, at: Int, sub: view type_terms.Substitution) -> String {
  return type_terms.substitute(declared_type(tree, at), sub)
}

fn c_type(gen: view Generator, tree: view List<ast.AstNode>, ty: view String) -> String {
  let int_type = integer_c(ty)
  if int_type != "" { return int_type }
  if ty == "Bool" { return String.from("bool") }
  if ty.starts_with("fn(") { return String.from("ScFn") }
  if ty == "Text" { return String.from("const char *") }
  if ty == "String" { return String.from("String") }
  if ty == "nothing" { return String.from("void") }
  let collection = collection_name(gen, ty)
  if collection != "" { return collection }
  let layout = enum_index(gen, ty)
  if layout >= 0 {
    if gen.enum_layouts.at(layout).variants.len() == 0 { unsupported("recursive or empty enum {ty}") }
    return "E{layout}"
  }
  let structure = struct_index(gen, ty)
  if structure >= 0 {
    if !gen.struct_layouts.at(structure).ready { unsupported("recursive by-value struct {ty}") }
    return "S{structure}"
  }
  unsupported("type {ty}")
  return String.new()
}

fn drop_fn(gen: view Generator, tree: view List<ast.AstNode>, ty: view String) -> String {
  if ty == "String" { return String.from("nx_str_free") }
  let layout = enum_index(gen, ty)
  if layout >= 0 && gen.enum_layouts.at(layout).owned { return "sc_drop_E{layout}" }
  let collection = collection_name(gen, ty)
  if collection != "" && (ty == "List" || ty.starts_with("List<")) { return "sc_drop_{collection}" }
  let structure = struct_index(gen, ty)
  if structure >= 0 && gen.struct_layouts.at(structure).owned { return "sc_drop_S{structure}" }
  return String.new()
}

fn declared_type(tree: view List<ast.AstNode>, node: Int) -> String {
  var aliases = List<String>.new()
  return declared_type_inner(tree, node, aliases)
}

fn declared_type_inner(tree: view List<ast.AstNode>, node: Int, aliases: mut List<String>) -> String {
  if tree.at(node).tag == "_" { return String.from("nothing") }
  if tree.at(node).tag == "BracketType" {
    let elem = declared_type_inner(tree, ast.child(tree, node, 0), aliases)
    let size = ast.child(tree, node, 1)
    if tree.at(size).tag == "_" { return type_terms.bracket(elem, String.from("_")) }
    if tree.at(size).tag != "Int" { unsupported("nonliteral array length") }
    return type_terms.bracket(elem, tree.at(ast.child(tree, size, 0)).tag)
  }
  if tree.at(node).tag == "FnType" {
    let params = ast.child(tree, node, 0)
    var parts = List<String>.new()
    var at = params + 1
    while at < tree.at(params).end {
      let mode = String.from(tree.at(ast.child(tree, at, 0)).tag)
      let ty = declared_type_inner(tree, ast.child(tree, at, 1), aliases)
      if mode == "View" { parts.push("view {ty}") }
      else if mode == "Mut" { parts.push("mut {ty}") }
      else { parts.push(String.from(ty)) }
      at = tree.at(at).end
    }
    let args = parts.join(", ")
    let ret = declared_type_inner(tree, ast.child(tree, node, 1), aliases)
    if ret == "nothing" { return "fn({args})" }
    return "fn({args}) -> {ret}"
  }
  if tree.at(node).tag != "Type" { unsupported("type {tree.at(node).tag}") }
  let args = ast.child(tree, node, 1)
  let name = ast.name_at(tree, node, 0)
  if name == "Int" { return ast.range_type(tree, args) }
  if name == "Int64" { return String.from("Int") }
  if name == "Float64" { return String.from("Float") }
  if tree.at(args).end == args + 1 {
    let target = ast.alias_target(tree, name)
    if target >= 0 {
      if aliases.contains(name) { unsupported("cyclic type alias {name}") }
      aliases.push(String.from(name))
      let ty = declared_type_inner(tree, target, aliases)
      let unused = aliases.pop()
      return ty
    }
  }
  var parameters = List<String>.new()
  var at = args + 1
  while at < tree.at(args).end {
    parameters.push(declared_type_inner(tree, at, aliases))
    at = tree.at(at).end
  }
  return type_terms.apply(name, parameters)
}

fn id_at(gen: view Generator, node: Int) -> Int {
  let id = gen.locals.identities.at(node)
  if id < 0 { unsupported("unresolved local binding") }
  return id
}

fn local_place(gen: view Generator, node: Int) -> Value {
  let id = id_at(gen, node)
  let ty = type_terms.substitute(gen.checked.bindings.at(id), gen.sub)
  if gen.references.at(id) { return Value { ty: move ty, code: "(*v{id})" } }
  return Value { ty: move ty, code: "v{id}" }
}

fn is_place(tree: view List<ast.AstNode>, node: Int) -> Bool {
  if tree.at(node).tag == "Var" { return true }
  if tree.at(node).tag == "Field" { return is_place(tree, ast.child(tree, node, 0)) }
  if tree.at(node).tag == "Method" && tree.at(ast.child(tree, node, 1)).tag == "6174" {
    return is_place(tree, ast.child(tree, node, 0))
  }
  return false
}

fn temp(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, code: view String) -> Value {
  if ty == "nothing" {
    line(gen, "{code};")
    return Value { ty: String.from(ty), code: String.new() }
  }
  prepare_type(gen, tree, ty)
  let id = gen.temp
  gen.temp = id + 1
  let c = c_type(gen, tree, ty)
  let name = "t{id}"
  let drop = drop_fn(gen, tree, ty)
  if drop != "" { line(gen, "{c} {name} __attribute__((cleanup({drop}))) = {code};") }
  else { line(gen, "{c} {name} = {code};") }
  return Value { ty: String.from(ty), code: move name }
}

fn text_view(value: view Value) -> String {
  if value.ty == "String" { return "nx_str_view(&({value.code}))" }
  if value.ty == "Text" { return "nx_str_text({value.code})" }
  unsupported("expected Text or String")
  return String.new()
}

fn coerce(gen: mut Generator, tree: view List<ast.AstNode>, value: Value, expected: view String) -> Value {
  if expected == "String" && value.ty == "Text" {
    return temp(gen, tree, expected, "nx_str_from({text_view(value)})")
  }
  if (value.ty == "Int" || value.ty.starts_with("Int<")) &&
      (expected == "Int" || expected.starts_with("Int<")) {
    return Value { ty: String.from(expected), code: String.from(value.code) }
  }
  if value.ty != expected { unsupported("expected {expected}, got {value.ty}") }
  return move value
}

fn transfer(gen: view Generator, tree: view List<ast.AstNode>, value: view Value) -> String {
  // The take helpers leave a zero value for the source slot's scope cleanup.
  if drop_fn(gen, tree, value.ty).len() != 0 { return "sc_take_{c_type(gen, tree, value.ty)}(&({value.code}))" }
  return String.from(value.code)
}

fn quoted_text(tree: view List<ast.AstNode>, node: Int) -> String {
  if tree.at(node).end == node + 1 { return String.from("\"\"") }
  let bytes = ast.decoded_name(tree, ast.child(tree, node, 0))
  var result = String.from("\"")
  // Three octal digits per byte keep C escape boundaries and UTF-8 deterministic.
  for i in 0..bytes.len() {
    let b = bytes.byte(i)
    result.push_byte(92)
    result.push_byte(48 + b / 64)
    result.push_byte(48 + (b / 8) % 8)
    result.push_byte(48 + b % 8)
  }
  result.push_byte(34)
  return result
}

fn number(tree: view List<ast.AstNode>, node: Int, ty: view String, negative: Bool) -> Value {
  let digits = String.from(tree.at(ast.child(tree, node, 0)).tag)
  let c = integer_c(ty)
  if c == "" { unsupported("numeric literal of type {ty}") }
  var code = "(({c})UINT64_C({digits}))"
  if negative {
    if ty == "Int" && digits == "9223372036854775808" { code = String.from("INT64_MIN") }
    else { code = "(({c})(-INT64_C({digits})))" }
  }
  return Value { ty: String.from(ty), code: move code }
}

fn binary(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let op = ast.name_at(tree, node, 0)
  let left = expression(gen, tree, ast.child(tree, node, 1))
  if left.ty == "String" || left.ty == "Text" {
    if op != "==" && op != "!=" && op != "<" && op != "<=" && op != ">" && op != ">=" {
      unsupported("operator {op} on {left.ty}")
    }
    let right = expression(gen, tree, ast.child(tree, node, 2))
    return temp(gen, tree, ty, "(sc_compare({text_view(left)}, {text_view(right)}) {op} 0)")
  }
  if op == "==" || op == "!=" {
    let method = equality_method(gen, left.ty)
    if method >= 0 {
      let right = expression(gen, tree, ast.child(tree, node, 2))
      let instance = schedule(gen, method, left.ty, type_terms.empty())
      var l = String.from(left.code)
      var r = String.from(right.code)
      if drop_fn(gen, tree, left.ty).len() != 0 {
        l = "&({l})"
        r = "&({r})"
      }
      var invert = String.new()
      if op == "!=" { invert = String.from("!") }
      return temp(gen, tree, ty, "{invert}F{instance}({l}, {r})")
    }
  }
  if drop_fn(gen, tree, left.ty).len() != 0 { unsupported("operator {op} on {left.ty}") }
  let saved = temp(gen, tree, left.ty, left.code)
  let right_node = ast.child(tree, node, 2)
  if op == "&&" || op == "||" {
    if saved.ty != "Bool" { unsupported("non-Bool logical operand") }
    var test = String.from(saved.code)
    if op == "||" { test = "!{test}" }
    line(gen, "if ({test}) {{")
    gen.indent = gen.indent + 1
    let right = expression(gen, tree, right_node)
    if right.ty != "Bool" { unsupported("non-Bool logical operand") }
    line(gen, "{saved.code} = {right.code};")
    gen.indent = gen.indent - 1
    line(gen, "}}")
    return move saved
  }
  let right = expression(gen, tree, right_node)
  if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
    if !type_terms.compatible(left.ty, right.ty) || (integer_c(left.ty).len() == 0 && left.ty != "Bool") {
      unsupported("comparison {op} on {left.ty} and {right.ty}")
    }
    return temp(gen, tree, ty, "({saved.code} {op} {right.code})")
  }
  var helper = String.new()
  if op == "+" { helper = String.from("add") }
  else if op == "-" { helper = String.from("sub") }
  else if op == "*" { helper = String.from("mul") }
  else if op == "/" { helper = String.from("div") }
  else if op == "%" { helper = String.from("mod") }
  else { unsupported("operator {op}") }
  let suffix = integer_suffix(ty)
  return temp(gen, tree, ty, "nx_{helper}{suffix}({saved.code}, {right.code})")
}

fn emit_print(gen: mut Generator, value: view Value) {
  if value.ty == "Bool" { line(gen, "puts({value.code} ? \"true\" : \"false\");") }
  else if value.ty == "Text" { line(gen, "printf(\"%s\\n\", {value.code});") }
  else if value.ty == "String" { line(gen, "nx_print_str({text_view(value)});") }
  else if value.ty == "Char" { line(gen, "nx_print_char({value.code});") }
  else if value.ty == "UInt64" { line(gen, "printf(\"%llu\\n\", (unsigned long long)({value.code}));") }
  else if integer_c(value.ty).len() != 0 { line(gen, "printf(\"%lld\\n\", (long long)({value.code}));") }
  else { unsupported("print of {value.ty}") }
}

fn construct_variant(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String,
    name: view String, args: Int) -> Value {
  prepare_type(gen, tree, ty)
  let layout = enum_index(gen, ty)
  if layout < 0 { unsupported("enum constructor {ty}.{name}") }
  let slot = variant_index(gen.enum_layouts.at(layout), name)
  let value = temp(gen, tree, ty, "{{ .tag = {slot} }}")
  var at = args + 1
  for i in 0..gen.enum_layouts.at(layout).variants.at(slot - 1).payload.len() {
    if args < 0 || at >= tree.at(args).end { unsupported("missing enum payload") }
    let expected = String.from(gen.enum_layouts.at(layout).variants.at(slot - 1).payload.at(i))
    let arg = expression(gen, tree, at)
    let field = coerce(gen, tree, move arg, expected)
    line(gen, "{value.code}.v{slot}.p{i} = {transfer(gen, tree, field)};")
    at = tree.at(at).end
  }
  if args >= 0 && at != tree.at(args).end { unsupported("extra enum payload") }
  return move value
}

fn enum_payload(gen: view Generator, value: view Value, slot: Int, field: Int) -> Value {
  let layout = enum_index(gen, value.ty)
  return Value {
    ty: String.from(gen.enum_layouts.at(layout).variants.at(slot - 1).payload.at(field)),
    code: "({value.code}).v{slot}.p{field}",
  }
}

fn option_result_method(gen: mut Generator, tree: view List<ast.AstNode>, receiver: view Value,
    name: view String, args: Int, ty: view String) -> Value {
  prepare_type(gen, tree, receiver.ty)
  let base = type_terms.base(receiver.ty)
  if name == "is_some" || name == "is_ok" { return temp(gen, tree, ty, "({receiver.code}).tag == 1") }
  if name == "is_none" || name == "is_err" { return temp(gen, tree, ty, "({receiver.code}).tag == 2") }
  let owned = temp(gen, tree, receiver.ty, transfer(gen, tree, receiver))
  if name == "ok" || name == "err" {
    let result = temp(gen, tree, ty, String.from("{{ .tag = 2 }}"))
    var slot = 1
    if name == "err" { slot = 2 }
    let payload = enum_payload(gen, owned, slot, 0)
    line(gen, "if ({owned.code}.tag == {slot}) {{")
    gen.indent = gen.indent + 1
    line(gen, "{result.code}.tag = 1;")
    line(gen, "{result.code}.v1.p0 = {transfer(gen, tree, payload)};")
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return move result
  }
  let payload = enum_payload(gen, owned, 1, 0)
  if name == "unwrap_or" {
    let arg = expression(gen, tree, args + 1)
    let fallback = coerce(gen, tree, move arg, ty)
    let default = temp(gen, tree, ty, transfer(gen, tree, fallback))
    return temp(gen, tree, ty, "{owned.code}.tag == 1 ? {transfer(gen, tree, payload)} : {transfer(gen, tree, default)}")
  }
  if base == "Option" && name == "unwrap" {
    line(gen, "if ({owned.code}.tag != 1) nx_panic(\"called `Option.unwrap()` on a `None` value\");")
    return temp(gen, tree, ty, transfer(gen, tree, payload))
  }
  unsupported("{base}.{name}")
  return move owned
}

fn emit_defers(gen: mut Generator, tree: view List<ast.AstNode>, start: Int) {
  var at = gen.deferred.len()
  while at > start {
    at = at - 1
    let node = gen.deferred.at(at)
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    statement(gen, tree, node)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  }
}

fn emit_return(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, code: view String) {
  if ty == "nothing" {
    emit_defers(gen, tree, 0)
    line(gen, String.from("return;"))
  } else if gen.deferred.len() == 0 {
    line(gen, "return {code};")
  } else {
    let saved = temp(gen, tree, ty, code)
    emit_defers(gen, tree, 0)
    line(gen, "return {transfer(gen, tree, saved)};")
  }
}

fn propagate_result(gen: mut Generator, tree: view List<ast.AstNode>, operand: view Value) -> Value {
  let owned = temp(gen, tree, operand.ty, transfer(gen, tree, operand))
  let result = String.from(gen.result)
  prepare_type(gen, tree, result)
  let dest = c_type(gen, tree, result)
  let base = type_terms.base(operand.ty)
  line(gen, "if ({owned.code}.tag == 2) {{")
  gen.indent = gen.indent + 1
  if base == "Option" {
    emit_return(gen, tree, result, "({dest}){{ .tag = 2 }}")
  } else if base == "Result" {
    let error = enum_payload(gen, owned, 2, 0)
    emit_return(gen, tree, result, "({dest}){{ .tag = 2, .v2.p0 = {transfer(gen, tree, error)} }}")
  } else { unsupported("try operator on {base}") }
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  let payload = enum_payload(gen, owned, 1, 0)
  return temp(gen, tree, payload.ty, transfer(gen, tree, payload))
}

fn function_signature(gen: view Generator, ty: view String) -> Int {
  for i in 0..gen.checked.signatures.len() {
    let sig = String.from(gen.checked.signatures.at(i).spelling)
    if sig == ty { return i }
  }
  unsupported("function value with signature {ty}")
  return -1
}

fn indirect_call(gen: mut Generator, tree: view List<ast.AstNode>, callee: view Value, args: Int,
    result: view String) -> Value {
  let signature = function_signature(gen, callee.ty)
  let saved = temp(gen, tree, callee.ty, callee.code)
  var c_types = List<String>.new()
  var values = List<String>.new()
  var arg = args + 1
  let size = gen.checked.signatures.at(signature).args.len()
  for i in 0..size {
    if arg >= tree.at(args).end { unsupported("function value arity") }
    let expected = String.from(gen.checked.signatures.at(signature).args.at(i).ty)
    let mode = String.from(gen.checked.signatures.at(signature).args.at(i).mode)
    prepare_type(gen, tree, expected)
    let c = c_type(gen, tree, expected)
    let ref = by_reference(gen, tree, expected, mode)
    if ref { c_types.push("{c} *") }
    else { c_types.push(String.from(c)) }
    values.push(call_argument(gen, tree, arg, expected, ref))
    arg = tree.at(arg).end
  }
  if arg != tree.at(args).end { unsupported("function value arity") }
  if c_types.len() == 0 { c_types.push(String.from("void")) }
  prepare_type(gen, tree, result)
  let ret = c_type(gen, tree, result)
  let types = c_types.join(", ")
  let actual = values.join(", ")
  return temp(gen, tree, result, "(({ret} (*)({types})){saved.code})({actual})")
}

fn closure(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  if gen.sub.names.len() != 0 || tree.at(ast.child(tree, node, 3)).tag == "true" {
    unsupported("Closure in generic code or a worker")
  }
  let finish = tree.at(node).end
  for at in node + 1..finish {
    let id = gen.locals.identities.at(at)
    if id < 0 { continue }
    let declaration = gen.locals.bindings.at(id).node
    if declaration < node || declaration >= finish { unsupported("Closure with captures") }
  }
  let instance = schedule(gen, node, ty, type_terms.empty())
  return temp(gen, tree, ty, "(ScFn)F{instance}")
}

fn call(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let name = ast.name_at(tree, node, 0)
  let args = ast.child(tree, node, 1)
  if gen.locals.identities.at(node) >= 0 {
    let callee = local_place(gen, node)
    return indirect_call(gen, tree, callee, args, ty)
  }
  let fun = find_named(tree, gen.functions, name)
  if fun < 0 {
    if name == "Some" || name == "Ok" || name == "Err" {
      return construct_variant(gen, tree, ty, name, args)
    }
    if name.starts_with("std__") || name == "max" || name == "min" {
      return bootstrap_call(gen, tree, name, args, ty)
    }
    if name != "print" && name != "assert" && name != "panic" { unsupported("call to {name}") }
    if tree.at(args).end == args + 1 || tree.at(args + 1).end != tree.at(args).end {
      unsupported("{name} arity")
    }
    let value = expression(gen, tree, args + 1)
    if name == "print" { emit_print(gen, value) }
    else if name == "panic" { line(gen, "nx_panic_str({text_view(value)});") }
    else {
      if value.ty != "Bool" { unsupported("assert argument type") }
      line(gen, "nx_assert({value.code});")
    }
    return Value { ty: String.from("nothing"), code: String.new() }
  }
  return emit_call(gen, tree, fun, String.new(), args, -1, ty)
}

fn bootstrap_call(gen: mut Generator, tree: view List<ast.AstNode>, name: view String, args: Int,
    ty: view String) -> Value {
  let first = args + 1
  let end = tree.at(args).end
  if first == end {
    if name == "std__io__read_line" || name == "std__io__read_all" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      let data = temp(gen, tree, String.from("String"), String.from("{{0}}"))
      var line_mode = String.from("false")
      if name == "std__io__read_line" { line_mode = String.from("true") }
      let state = temp(gen, tree, String.from("Int"), "sc_read_stdin({line_mode}, &{data.code}, &{result.code}.v2.p0.m6d657373616765)")
      line(gen, "if ({state.code} < 0) {{ {result.code}.tag = 2; }} else {{")
      line(gen, "{result.code}.tag = 1;")
      if name == "std__io__read_line" {
        line(gen, "{result.code}.v1.p0.tag = {state.code} == 0 ? 2 : 1;")
        line(gen, "{result.code}.v1.p0.v1.p0 = {transfer(gen, tree, data)};")
      } else {
        line(gen, "{result.code}.v1.p0 = {transfer(gen, tree, data)};")
      }
      line(gen, String.from("}}"))
      return move result
    }
    if name == "std__env__pid" || name == "std__io__process_id" {
      return temp(gen, tree, ty, "(int64_t)getpid()")
    }
    if name == "std__env__arg_count" { return temp(gen, tree, ty, String.from("sc_argc")) }
    if name == "std__env__current_exe" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      line(gen, "{result.code}.tag = sc_current_exe(&{result.code}.v1.p0, &{result.code}.v2.p0.m6d657373616765) ? 1 : 2;")
      return move result
    }
    if name == "std__env__args" || name == "std__io__args" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      let c = c_type(gen, tree, ty)
      line(gen, "for (int i = 0; i < sc_argc; ++i) sc_push_{c}(&{result.code}, sc_cstr(sc_argv[i]));")
      return move result
    }
    unsupported("bootstrap call {name}")
  }
  let left = expression(gen, tree, first)
  let second = tree.at(first).end
  if second == end {
    if name == "std__print_owned" {
      emit_print(gen, left)
      return Value { ty: String.from("nothing"), code: String.new() }
    }
    if name == "std__io__write_stdout" || name == "std__io__write_stderr" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      var fd = 1
      if name == "std__io__write_stderr" { fd = 2 }
      let written = temp(gen, tree, String.from("Int"), "sc_write_fd({fd}, {text_view(left)}, &{result.code}.v2.p0.m6d657373616765)")
      line(gen, "if ({written.code} < 0) {{ {result.code}.tag = 2; }}")
      line(gen, "else {{ {result.code}.tag = 1; {result.code}.v1.p0 = {written.code}; }}")
      return move result
    }
    if name == "std__io__eprintln" { return temp(gen, tree, ty, "sc_eprintln({text_view(left)})") }
    if name == "std__io__eprint" { return temp(gen, tree, ty, "sc_eprint({text_view(left)})") }
    if name == "std__env__exit" || name == "std__io__exit" || name == "std__io__exit_clean" { return temp(gen, tree, ty, "exit((int)({left.code}))") }
    if name == "std__fs__is_file" || name == "std__fs__read_to_string" {
      let path = coerce(gen, tree, move left, String.from("String"))
      if name == "std__fs__is_file" { return temp(gen, tree, ty, "sc_is_file(&({path.code}))") }
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      line(gen, "if (sc_read_file(&({path.code}), &{result.code}.v1.p0, &{result.code}.v2.p0.m6d657373616765)) {{")
      line(gen, "{result.code}.tag = 1;")
      line(gen, "}} else {{ {result.code}.tag = 2; }}")
      return move result
    }
    if name == "std__env__arg" {
      let index = temp(gen, tree, String.from("Int"), left.code)
      let result = temp(gen, tree, ty, String.from("{{ .tag = 2 }}"))
      line(gen, "if ({index.code} >= 0 && {index.code} < sc_argc) {{")
      line(gen, "{result.code}.tag = 1; {result.code}.v1.p0 = sc_cstr(sc_argv[{index.code}]);")
      line(gen, String.from("}}"))
      return move result
    }
  } else if tree.at(second).end == end {
    if name == "std__fs__write" || name == "std__process__run" {
      let right = expression(gen, tree, second)
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      if name == "std__fs__write" {
        line(gen, "if (sc_write_file({text_view(left)}, {text_view(right)}, &{result.code}.v2.p0.m6d657373616765)) {{")
        line(gen, "{result.code}.tag = 1; {result.code}.v1.p0 = {text_view(right)}.n;")
      } else {
        let args = "({right.code})"
        let output = "{result.code}.v1.p0"
        line(gen, "if (sc_run_process({text_view(left)}, {args}.d, {args}.len, &{output}.m737461747573.m636f6465, &{output}.m737461747573.m7369676e616c, &{output}.m7374646f7574, &{output}.m737464657272, &{result.code}.v2.p0.m6d657373616765)) {{")
        line(gen, "{result.code}.tag = 1;")
      }
      line(gen, "}} else {{ {result.code}.tag = 2; }}")
      return move result
    }
    if name == "std__fmt_lit" || name == "std__fmt_val" {
      let saved = temp(gen, tree, left.ty, transfer(gen, tree, left))
      let right = expression(gen, tree, second)
      let dst = transfer(gen, tree, saved)
      if right.ty == "Text" || right.ty == "String" {
        return temp(gen, tree, ty, "sc_fmt_text({dst}, {text_view(right)})")
      }
      if right.ty == "std__io__IoError" {
        return temp(gen, tree, ty, "sc_fmt_text({dst}, nx_str_view(&({right.code}).m6d657373616765))")
      }
      if right.ty == "Bool" { return temp(gen, tree, ty, "sc_fmt_bool({dst}, {right.code})") }
      if right.ty == "Char" { return temp(gen, tree, ty, "sc_fmt_char({dst}, {right.code})") }
      if right.ty == "UInt64" { return temp(gen, tree, ty, "sc_fmt_uint({dst}, {right.code})") }
      if integer_c(right.ty).len() != 0 { return temp(gen, tree, ty, "sc_fmt_int({dst}, {right.code})") }
    } else if name == "max" || name == "min" {
      let saved = temp(gen, tree, left.ty, left.code)
      let right = expression(gen, tree, second)
      var op = String.from(">")
      if name == "min" { op = String.from("<") }
      return temp(gen, tree, ty, "{saved.code} {op} {right.code} ? {saved.code} : {right.code}")
    }
  }
  unsupported("bootstrap call {name}")
  return Value { ty: String.new(), code: String.new() }
}

fn schedule(gen: mut Generator, node: Int, owner: view String, sub: type_terms.Substitution) -> Int {
  let params = sub.values.join(", ")
  let key = "{node}:{owner}:{params}"
  for i in 0..gen.instances.len() {
    if gen.instances.at(i).key == key { return i }
  }
  if gen.instances.len() == 1024 { unsupported("too many function specializations") }
  let id = gen.instances.len()
  gen.instances.push(Instance { node: node, owner: String.from(owner), sub: move sub, key: move key })
  return id
}

fn equality_method(gen: view Generator, ty: view String) -> Int {
  for method in gen.methods {
    if method.equality && method.owner == ty { return method.node }
  }
  return -1
}

fn match_method(gen: view Generator, tree: view List<ast.AstNode>, owner: view String,
    name: view String, has_receiver: Bool) -> Int {
  for method in gen.methods {
    var matches = method.owner == owner
    if !matches && method.params >= 0 {
      let names = parameter_names(tree, method.params)
      var sub = type_terms.with_names(names)
      type_terms.bind(sub, method.owner, owner)
      let concrete = type_terms.substitute(method.owner, sub)
      matches = concrete == owner
    }
    if matches {
      let candidate = ast.name_at(tree, method.node, 0)
      let params = ast.child(tree, method.node, 2)
      let has_self = tree.at(params).end > params + 1 && tree.at(params + 1).tag == "Self"
      if !method.destructor && !method.equality && candidate == name && has_self == has_receiver { return method.node }
    }
  }
  return -1
}

fn by_reference(gen: view Generator, tree: view List<ast.AstNode>, ty: view String, mode: view String) -> Bool {
  return !ty.starts_with("Slice<") && (mode == "Mut" || (mode == "View" && drop_fn(gen, tree, ty).len() != 0))
}

fn call_substitution(gen: view Generator, tree: view List<ast.AstNode>, fun: Int,
    owner: view String) -> type_terms.Substitution {
  var names = type_parameters(tree, fun)
  var pattern = String.new()
  for method in gen.methods {
    if method.node == fun && method.params >= 0 {
      for name in parameter_names(tree, method.params) { names.push(String.from(name)) }
      pattern = String.from(method.owner)
    }
  }
  var sub = type_terms.with_names(names)
  if pattern != "" { type_terms.bind(sub, pattern, owner) }
  return move sub
}

fn emit_call(gen: mut Generator, tree: view List<ast.AstNode>, fun: Int, owner: view String,
    args: Int, receiver: Int, ty: view String) -> Value {
  let params = ast.child(tree, fun, 2)
  var sub = call_substitution(gen, tree, fun, owner)
  var nodes = List<Int>.new()
  var forms = List<String>.new()
  var modes = List<String>.new()
  var formal = params + 1
  if receiver >= 0 {
    nodes.push(receiver)
    forms.push(String.from(owner))
    modes.push(String.from(tree.at(ast.child(tree, formal, 0)).tag))
    formal = tree.at(formal).end
  }
  var actual = args + 1
  while actual < tree.at(args).end && formal < tree.at(params).end {
    let expected = declared_type(tree, ast.child(tree, formal, 2))
    var inferred = type_terms.substitute(gen.checked.expressions.at(actual), gen.sub)
    if expected.starts_with("Slice<") {
      inferred = type_terms.bracket(type_terms.element(inferred), String.from("_"))
    }
    type_terms.bind(sub, expected, inferred)
    forms.push(move expected)
    modes.push(String.from(tree.at(ast.child(tree, formal, 1)).tag))
    nodes.push(actual)
    actual = tree.at(actual).end
    formal = tree.at(formal).end
  }
  if actual != tree.at(args).end || formal != tree.at(params).end { unsupported("function arity") }
  type_terms.bind(sub, declared_type(tree, ast.child(tree, fun, 3)), ty)
  for value in sub.values { if value == "?" { unsupported("generic argument inference") } }

  var values = List<String>.new()
  var borrows = List<Bool>.new()
  for i in 0..nodes.len() {
    let expected = type_terms.substitute(forms.at(i), sub)
    prepare_type(gen, tree, expected)
    let by_ref = by_reference(gen, tree, expected, modes.at(i))
    let deferred = (by_ref || expected.starts_with("Slice<")) && is_place(tree, nodes.at(i))
    values.push(String.new())
    borrows.push(deferred)
    if !deferred {
      let arg = call_argument(gen, tree, nodes.at(i), expected, by_ref)
      values.set(i, move arg)
    }
  }
  for i in 0..nodes.len() {
    if borrows.at(i) {
      let expected = type_terms.substitute(forms.at(i), sub)
      let by_ref = by_reference(gen, tree, expected, modes.at(i))
      let arg = call_argument(gen, tree, nodes.at(i), expected, by_ref)
      values.set(i, move arg)
    }
  }
  let instance = schedule(gen, fun, owner, move sub)
  let list = values.join(", ")
  return temp(gen, tree, ty, "F{instance}({list})")
}

fn call_argument(gen: mut Generator, tree: view List<ast.AstNode>,
    node: Int, expected: view String, by_ref: Bool) -> String {
  var operand = expression(gen, tree, node)
  if expected.starts_with("Slice<") && operand.ty != expected {
    operand = slice_value(gen, tree, operand, expected, String.from("0"), sequence_length(operand))
  }
  let arg = coerce(gen, tree, move operand, expected)
  if by_ref {
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "__auto_type t{id} = &({arg.code});")
    return "t{id}"
  }
  let saved = temp(gen, tree, expected, transfer(gen, tree, arg))
  return transfer(gen, tree, saved)
}

fn sequence_length(value: view Value) -> String {
  if value.ty.starts_with("Array<") {
    let args = type_terms.arguments(value.ty)
    return String.from(args.at(1))
  }
  return "({value.code}).len"
}

fn slice_value(gen: mut Generator, tree: view List<ast.AstNode>, seq: view Value,
    ty: view String, lo: view String, hi: view String) -> Value {
  let element = type_terms.element(seq.ty)
  if element == "?" { unsupported("slice of {seq.ty}") }
  prepare_type(gen, tree, ty)
  let c = c_type(gen, tree, ty)
  let length = sequence_length(seq)
  return temp(gen, tree, ty, "sc_slice_{c}(({seq.code}).d, {length}, {lo}, {hi})")
}

fn sequence_method(gen: mut Generator, tree: view List<ast.AstNode>, receiver: view Value,
    name: view String, args: Int, ty: view String) -> Value {
  prepare_type(gen, tree, receiver.ty)
  let c = c_type(gen, tree, receiver.ty)
  let elem = type_terms.element(receiver.ty)
  let list = receiver.ty == "List" || receiver.ty.starts_with("List<")
  let addr = "&({receiver.code})"
  let first = args + 1
  let end = tree.at(args).end
  if first == end {
    if name == "len" { return temp(gen, tree, ty, sequence_length(receiver)) }
    if list && name == "pop" { return temp(gen, tree, ty, "sc_pop_{c}({addr})") }
    if list && name == "clear" { return temp(gen, tree, ty, "sc_clear_{c}({addr})") }
    unsupported("sequence method {name}")
  }
  let arg = expression(gen, tree, first)
  if list && name == "join" && elem == "String" && tree.at(first).end == end {
    return temp(gen, tree, ty, "sc_join_{c}({addr}, {text_view(arg)})")
  }
  if list && (name == "index_of" || name == "contains") && tree.at(first).end == end {
    let found = temp(gen, tree, String.from("Int"), String.from("-1"))
    let id = gen.temp
    gen.temp = id + 1
    var compare = String.new()
    if elem == "String" { compare = "sc_compare(nx_str_view(&({receiver.code}).d[i{id}]), {text_view(arg)}) == 0" }
    else if integer_c(elem).len() != 0 || elem == "Bool" { compare = "({receiver.code}).d[i{id}] == {arg.code}" }
    else { unsupported("list search for {elem}") }
    line(gen, "for (int64_t i{id} = 0; i{id} < ({receiver.code}).len; ++i{id}) {{")
    line(gen, "if ({compare}) {{ {found.code} = i{id}; break; }} }}")
    if name == "contains" { return temp(gen, tree, ty, "{found.code} >= 0") }
    return move found
  }
  if list && name == "push" && tree.at(first).end == end {
    let value = coerce(gen, tree, move arg, elem)
    return temp(gen, tree, ty, "sc_push_{c}({addr}, {transfer(gen, tree, value)})")
  }
  if !type_terms.compatible(arg.ty, String.from("Int")) { unsupported("non-Int sequence index") }
  if list && name == "truncate" && tree.at(first).end == end {
    return temp(gen, tree, ty, "sc_truncate_{c}({addr}, {arg.code})")
  }
  let index = temp(gen, tree, arg.ty, arg.code)
  let dest = "(*sc_at_{c}({addr}, {index.code}))"
  let second = tree.at(first).end
  if second == end {
    if name == "at" { return Value { ty: move elem, code: move dest } }
    if name == "get" && drop_fn(gen, tree, elem).len() == 0 {
      return temp(gen, tree, elem, dest)
    }
    unsupported("sequence method {name} on {receiver.ty}")
  }
  if tree.at(second).end != end { unsupported("sequence method arity") }
  let right = expression(gen, tree, second)
  if name == "set" {
    let value = coerce(gen, tree, move right, elem)
    let drop = drop_fn(gen, tree, elem)
    if drop != "" { line(gen, "{drop}(&{dest});") }
    line(gen, "{dest} = {transfer(gen, tree, value)};")
  } else if name == "swap" && right.ty == "Int" {
    let other = temp(gen, tree, right.ty, right.code)
    let rhs = "(*sc_at_{c}({addr}, {other.code}))"
    let element_c = c_type(gen, tree, elem)
    line(gen, "{{ {element_c} swap = {dest}; {dest} = {rhs}; {rhs} = swap; }}")
  } else { unsupported("sequence method {name}") }
  return Value { ty: String.from("nothing"), code: String.new() }
}

fn array_literal(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let result = temp(gen, tree, ty, String.from("{{0}}"))
  let elem = type_terms.element(ty)
  if tree.at(node).tag == "ArrayFill" {
    let expr = expression(gen, tree, ast.child(tree, node, 0))
    let value = coerce(gen, tree, move expr, elem)
    let count = sequence_length(result)
    line(gen, "for (int64_t i = 0; i < {count}; ++i) {result.code}.d[i] = {value.code};")
  } else {
    let items = ast.child(tree, node, 0)
    var at = items + 1
    var i = 0
    while at < tree.at(items).end {
      let expr = expression(gen, tree, at)
      let value = coerce(gen, tree, move expr, elem)
      line(gen, "{result.code}.d[{i}] = {value.code};")
      i = i + 1
      at = tree.at(at).end
    }
  }
  return move result
}

fn clone_value(gen: mut Generator, tree: view List<ast.AstNode>, source: view Value) -> Value {
  let ty = String.from(source.ty)
  if ty == "String" { return temp(gen, tree, ty, "nx_str_from({text_view(source)})") }
  if integer_c(ty).len() != 0 || ty == "Bool" || ty == "Text" {
    return temp(gen, tree, ty, source.code)
  }
  let base = type_terms.base(ty)
  prepare_type(gen, tree, ty)
  if base == "List" {
    let result = temp(gen, tree, ty, String.from("{{0}}"))
    let c = c_type(gen, tree, ty)
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "for (int64_t i{id} = 0; i{id} < ({source.code}).len; ++i{id}) {{")
    gen.indent = gen.indent + 1
    let entry = Value { ty: type_terms.element(ty), code: "({source.code}).d[i{id}]" }
    let copied = clone_value(gen, tree, entry)
    line(gen, "sc_push_{c}(&{result.code}, {transfer(gen, tree, copied)});")
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return move result
  }
  if !gen.clone_types.contains(base) && base != "Option" && base != "Result" {
    unsupported("Clone for {ty}")
  }
  let result = temp(gen, tree, ty, String.from("{{0}}"))
  let layout = enum_index(gen, ty)
  if layout >= 0 {
    line(gen, "{result.code}.tag = ({source.code}).tag;")
    let count = gen.enum_layouts.at(layout).variants.len()
    for slot in 1..=count {
      let count = gen.enum_layouts.at(layout).variants.at(slot - 1).payload.len()
      if count > 0 {
        line(gen, "if ({result.code}.tag == {slot}) {{")
        gen.indent = gen.indent + 1
        for i in 0..count {
          let payload = enum_payload(gen, source, slot, i)
          let copied = clone_value(gen, tree, payload)
          line(gen, "{result.code}.v{slot}.p{i} = {transfer(gen, tree, copied)};")
        }
        gen.indent = gen.indent - 1
        line(gen, String.from("}}"))
      }
    }
  } else {
    let decl = find_named(tree, gen.structs, base)
    if decl < 0 { unsupported("Clone for {ty}") }
    let sub = nominal_sub(tree, decl, ty)
    let fields = ast.child(tree, decl, 2)
    var at = fields + 1
    while at < tree.at(fields).end {
      let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
      let field = Value {
        ty: declared_for(tree, ast.child(tree, at, 1), sub), code: "({source.code}).m{name}",
      }
      let copied = clone_value(gen, tree, field)
      line(gen, "{result.code}.m{name} = {transfer(gen, tree, copied)};")
      at = tree.at(at).end
    }
    let layout = struct_index(gen, ty)
    if gen.struct_layouts.at(layout).destructor { line(gen, "{result.code}.sc_live = true;") }
  }
  return move result
}

fn string_method(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let recv = ast.child(tree, node, 0)
  let name = ast.name_at(tree, node, 1)
  let args = ast.child(tree, node, 2)
  var owner = String.new()
  if tree.at(recv).tag == "Var" { owner = ast.name_at(tree, recv, 0) }
  var actual = args + 1
  var values = List<String>.new()
  var helper = String.new()
  let is_static = owner != "" && gen.locals.identities.at(recv) < 0
  var receiver_type = type_terms.substitute(gen.checked.expressions.at(recv), gen.sub)
  if is_static { receiver_type = String.from(owner) }
  let method = match_method(gen, tree, receiver_type, name, !is_static)
  if method >= 0 {
    var actual_receiver = recv
    if is_static { actual_receiver = -1 }
    return emit_call(gen, tree, method, receiver_type, args, actual_receiver, ty)
  }
  if !is_static && name == "clone" && tree.at(args).end == args + 1 {
    let value = expression(gen, tree, recv)
    return clone_value(gen, tree, value)
  }
  let result_base = type_terms.base(ty)
  if owner != "" && gen.locals.identities.at(recv) < 0 && result_base == owner &&
      (owner == "Option" || owner == "Result" || find_named(tree, gen.enums, owner) >= 0) {
    return construct_variant(gen, tree, ty, name, args)
  }
  if owner == "List" && gen.locals.identities.at(recv) < 0 && name == "new" {
    return temp(gen, tree, ty, String.from("{{0}}"))
  }
  if tree.at(recv).tag == "Var" && gen.locals.identities.at(recv) < 0 &&
      owner == "String" {
    if name != "new" && name != "from" && name != "concat" { unsupported("String.{name}") }
    helper = "nx_str_{name}"
    while actual < tree.at(args).end {
      let arg = expression(gen, tree, actual)
      values.push(text_view(arg))
      actual = tree.at(actual).end
    }
  } else {
    if receiver_type == "String" {
      return emit_string_method(gen, tree, recv, args, name, ty)
    }
    if receiver_type == "Char" && name == "to_int" {
      let value = expression(gen, tree, recv)
      return Value { ty: String.from(ty), code: String.from(value.code) }
    }
    if receiver_type == "Int" && (name == "max" || name == "min") {
      let left = expression(gen, tree, recv)
      let saved = temp(gen, tree, left.ty, left.code)
      let right = expression(gen, tree, actual)
      var op = String.from(">")
      if name == "min" { op = String.from("<") }
      return temp(gen, tree, ty, "{saved.code} {op} {right.code} ? {saved.code} : {right.code}")
    }
    let receiver = expression(gen, tree, recv)
    let element = type_terms.element(receiver.ty)
    if element != "?" {
      return sequence_method(gen, tree, receiver, name, args, ty)
    }
    let receiver_base = type_terms.base(receiver.ty)
    if receiver_base == "Option" || receiver_base == "Result" {
      return option_result_method(gen, tree, receiver, name, args, ty)
    }
    unsupported("method {name} on {receiver.ty}")
  }
  let list = values.join(", ")
  return temp(gen, tree, ty, "{helper}({list})")
}

fn emit_string_method(gen: mut Generator, tree: view List<ast.AstNode>, recv: Int, args: Int,
    name: view String, ty: view String) -> Value {
  var helper = "nx_str_{name}"
  let text = name == "eq" || name == "push_str" || name == "replace" || name == "find" ||
    name == "starts_with" || name == "ends_with" || name == "contains" || name == "split"
  if name == "split" {
    prepare_type(gen, tree, ty)
    helper = "sc_split_{c_type(gen, tree, ty)}"
  } else if name == "slice" || name == "trim" || name == "replace" || name == "find" ||
      name == "starts_with" || name == "ends_with" || name == "contains" || name == "parse_int" || name == "push_slice" {
    helper = "sc_str_{name}"
  } else if name != "len" && name != "byte" && name != "eq" && name != "clear" &&
      name != "push_int" && name != "push_str" && name != "push_byte" &&
      name != "push_char" && name != "char_at" && name != "char_size" {
    unsupported("String.{name}")
  }
  var values = List<String>.new()
  var deferred = List<Int>.new()
  values.push(String.new())
  var at = args + 1
  while at < tree.at(args).end {
    let index = values.len()
    let argument_type = type_terms.substitute(gen.checked.expressions.at(at), gen.sub)
    let text_arg = text || (name == "push_slice" && index == 1)
    if (text_arg && argument_type == "String" && is_place(tree, at)) || name == "parse_int" {
      values.push(String.new())
      deferred.push(at)
    } else {
      let arg = expression(gen, tree, at)
      if text_arg { values.push(text_view(arg)) }
      else {
        let saved = temp(gen, tree, arg.ty, arg.code)
        values.push(String.from(saved.code))
      }
      deferred.push(-1)
    }
    at = tree.at(at).end
  }
  let receiver = expression(gen, tree, recv)
  values.set(0, "&({receiver.code})")
  for i in 0..deferred.len() {
    let at = deferred.at(i)
    if at >= 0 {
      let arg = expression(gen, tree, at)
      if name == "parse_int" { values.set(i + 1, "&({arg.code})") }
      else { values.set(i + 1, text_view(arg)) }
    }
  }
  let list = values.join(", ")
  return temp(gen, tree, ty, "{helper}({list})")
}

fn struct_literal(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let fields = ast.child(tree, node, 2)
  let value = temp(gen, tree, ty, String.from("{{0}}"))
  let structure = find_named(tree, gen.structs, type_terms.base(ty))
  let layout = struct_index(gen, ty)
  if layout >= 0 && gen.struct_layouts.at(layout).destructor { line(gen, "{value.code}.sc_live = true;") }
  if structure < 0 { unsupported("unknown struct {ty}") }
  let sub = nominal_sub(tree, structure, ty)
  let definitions = ast.child(tree, structure, 2)
  var at = fields + 1
  while at < tree.at(fields).end {
    let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
    var definition = definitions + 1
    while definition < tree.at(definitions).end {
      let id = ast.child(tree, definition, 0)
      if tree.at(id).tag == name { break }
      definition = tree.at(definition).end
    }
    if definition == tree.at(definitions).end { unsupported("unknown field of {ty}") }
    let expected = declared_for(tree, ast.child(tree, definition, 1), sub)
    let init = expression(gen, tree, ast.child(tree, at, 1))
    let field = coerce(gen, tree, move init, expected)
    line(gen, "{value.code}.m{name} = {transfer(gen, tree, field)};")
    at = tree.at(at).end
  }
  return move value
}

fn declared_member_owner(tree: view List<ast.AstNode>, node: Int, sub: view type_terms.Substitution) -> String {
  let name = ast.name_at(tree, node, 0)
  let list = ast.child(tree, node, 1)
  var args = List<String>.new()
  var at = list + 1
  while at < tree.at(list).end {
    args.push(declared_for(tree, at, sub))
    at = tree.at(at).end
  }
  return type_terms.apply(name, args)
}

fn range_conversion(gen: mut Generator, tree: view List<ast.AstNode>, input: Int,
    range: view String, result: view String, otherwise: Int) -> Value {
  let arg = expression(gen, tree, input)
  let saved = temp(gen, tree, arg.ty, arg.code)
  let wide = "((__int128){saved.code})"
  let limits = range.slice(4, range.len() - 1).split("..")
  var lo = String.from("INT64_MIN")
  var hi = String.from("INT64_MAX")
  if limits.at(0) != "" { lo = pattern_bound(limits.at(0)) }
  if limits.at(1) != "" { hi = pattern_bound(limits.at(1)) }
  let outside = "{wide} < {lo} || {wide} > {hi}"
  if result != range {
    prepare_type(gen, tree, result)
    let c = c_type(gen, tree, result)
    return temp(gen, tree, result,
      "{outside} ? ({c}){{ .tag = 2, .v2.p0 = (int64_t){wide} }} : ({c}){{ .tag = 1, .v1.p0 = (int64_t){wide} }}")
  }
  if otherwise < 0 || tree.at(otherwise).tag == "_" {
    return temp(gen, tree, range, "nx_to_range({wide}, {lo}, {hi})")
  }
  line(gen, "if ({outside})")
  statement(gen, tree, otherwise)
  return temp(gen, tree, range, "(int64_t){wide}")
}

fn expression(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) -> Value {
  let tag = String.from(tree.at(node).tag)
  let ty = type_terms.substitute(gen.checked.expressions.at(node), gen.sub)
  if tag == "Var" {
    if gen.locals.identities.at(node) < 0 {
      let name = ast.name_at(tree, node, 0)
      if name == "None" { return construct_variant(gen, tree, ty, name, -1) }
      let fun = find_named(tree, gen.functions, name)
      if fun >= 0 {
        let params = type_parameters(tree, fun)
        if params.len() != 0 { unsupported("generic function value {name}") }
        let instance = schedule(gen, fun, String.new(), type_terms.empty())
        return temp(gen, tree, ty, "(ScFn)F{instance}")
      }
    }
    return local_place(gen, node)
  }
  if tag == "Move" {
    let place = local_place(gen, node)
    if drop_fn(gen, tree, place.ty).len() != 0 {
      let moved = transfer(gen, tree, place)
      return temp(gen, tree, place.ty, moved)
    }
    return move place
  }
  if tag == "Text" { return Value { ty: String.from("Text"), code: quoted_text(tree, node) } }
  if tag == "Int" || tag == "NumT" || tag == "Char" { return number(tree, node, ty, false) }
  if tag == "Bool" { return Value { ty: move ty, code: String.from(tree.at(ast.child(tree, node, 0)).tag) } }
  if tag == "Cast" && ty.starts_with("Int<") {
    return range_conversion(gen, tree, ast.child(tree, node, 0), ty, ty, ast.child(tree, node, 2))
  }
  if tag == "Ascribe" {
    let value = expression(gen, tree, ast.child(tree, node, 1))
    return coerce(gen, tree, move value, ty)
  }
  if tag == "Field" {
    let recv = ast.child(tree, node, 0)
    if tree.at(recv).tag == "Var" && gen.locals.identities.at(recv) < 0 {
      let name = ast.name_at(tree, node, 1)
      return construct_variant(gen, tree, ty, name, -1)
    }
    let base = expression(gen, tree, ast.child(tree, node, 0))
    let field = String.from(tree.at(ast.child(tree, node, 1)).tag)
    return Value { ty: move ty, code: "({base.code}).m{field}" }
  }
  if tag == "StructLit" { return struct_literal(gen, tree, node, ty) }
  if tag == "Array" || tag == "ArrayFill" { return array_literal(gen, tree, node, ty) }
  if tag == "Slice" {
    let seq = expression(gen, tree, ast.child(tree, node, 0))
    var lo = String.from("0")
    var hi = sequence_length(seq)
    let start = ast.child(tree, node, 1)
    let end = ast.child(tree, node, 2)
    if tree.at(start).tag != "_" {
      let value = expression(gen, tree, start)
      let bound = temp(gen, tree, value.ty, value.code)
      lo = String.from(bound.code)
    }
    if tree.at(end).tag != "_" {
      let bound = expression(gen, tree, end)
      hi = String.from(bound.code)
    }
    return slice_value(gen, tree, seq, ty, lo, hi)
  }
  if tag == "GenericMember" {
    let owner = ast.name_at(tree, node, 0)
    let member = ast.name_at(tree, node, 2)
    if owner == "Int" && (member == "from" || member == "try_from") {
      let range = ast.range_type(tree, ast.child(tree, node, 1))
      return range_conversion(gen, tree, ast.child(tree, node, 3) + 1, range, ty, -1)
    }
    if owner == "List" && member == "new" { return temp(gen, tree, ty, String.from("{{0}}")) }
    if owner == "Option" || owner == "Result" || find_named(tree, gen.enums, owner) >= 0 {
      return construct_variant(gen, tree, ty, member, ast.child(tree, node, 3))
    }
    let concrete = declared_member_owner(tree, node, gen.sub)
    let method = match_method(gen, tree, concrete, member, false)
    if method >= 0 {
      return emit_call(gen, tree, method, concrete, ast.child(tree, node, 3), -1, ty)
    }
    unsupported("generic member {owner}.{member}")
  }
  if tag == "Bin" { return binary(gen, tree, node, ty) }
  if tag == "Call" { return call(gen, tree, node, ty) }
  if tag == "CallFn" {
    let callee = expression(gen, tree, ast.child(tree, node, 0))
    return indirect_call(gen, tree, callee, ast.child(tree, node, 1), ty)
  }
  if tag == "Closure" { return closure(gen, tree, node, ty) }
  if tag == "Method" { return string_method(gen, tree, node, ty) }
  if tag == "Un" {
    let op = ast.name_at(tree, node, 0)
    let arg = ast.child(tree, node, 1)
    if op == "-" && (tree.at(arg).tag == "Int" || tree.at(arg).tag == "NumT") {
      return number(tree, arg, ty, true)
    }
    let value = expression(gen, tree, arg)
    if op == "?" { return propagate_result(gen, tree, value) }
    if op == "!" { return temp(gen, tree, ty, "!({value.code})") }
    if op == "-" { return temp(gen, tree, ty, "nx_neg{integer_suffix(ty)}({value.code})") }
    unsupported("unary operator {op}")
  }
  unsupported("expression {tag}")
  return Value { ty: String.new(), code: String.new() }
}

fn loop_label(tree: view List<ast.AstNode>, node: Int) -> String {
  let label = ast.child(tree, node, 0)
  if tree.at(label).tag == "_" { return String.new() }
  return ast.decoded_name(tree, label)
}

fn loop_start(gen: mut Generator, label: view String) {
  let id = gen.temp
  gen.temp = id + 1
  gen.loops.push(Loop { label: String.from(label), id: id, deferred: gen.deferred.len() })
  gen.indent = gen.indent + 1
}

fn loop_end(gen: mut Generator) {
  let target = gen.loops.pop()
  line(gen, "sc_continue_{target.id}: ;")
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  line(gen, "sc_break_{target.id}: ;")
}

fn emit_iterator(gen: mut Generator, tree: view List<ast.AstNode>, id: Int,
    iterator: view Value, body: Int, label: view String) {
  let method = match_method(gen, tree, iterator.ty, String.from("next"), true)
  if method < 0 { unsupported("iteration over {iterator.ty}") }
  let params = ast.child(tree, method, 2)
  let self = params + 1
  if tree.at(self).end != tree.at(params).end || tree.at(ast.child(tree, self, 0)).tag != "Mut" {
    unsupported("iterator requires next(mut self) -> Option<T>")
  }
  let sub = call_substitution(gen, tree, method, iterator.ty)
  let result = declared_for(tree, ast.child(tree, method, 3), sub)
  let base = type_terms.base(result)
  if base != "Option" { unsupported("iterator next must return Option<T>") }
  let next = schedule(gen, method, iterator.ty, move sub)
  line(gen, String.from("for (;;) {{"))
  loop_start(gen, label)
  let option = temp(gen, tree, result, "F{next}(&({iterator.code}))")
  line(gen, "if ({option.code}.tag != 1) break;")
  let value = enum_payload(gen, option, 1, 0)
  let c = c_type(gen, tree, value.ty)
  let drop = drop_fn(gen, tree, value.ty)
  if drop != "" {
    line(gen, "{c} v{id} __attribute__((cleanup({drop}))) = {transfer(gen, tree, value)};")
  } else { line(gen, "{c} v{id} = {value.code};") }
  gen.references.set(id, false)
  statement(gen, tree, body)
  loop_end(gen)
}

fn emit_for(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let label = loop_label(tree, node)
  let id = id_at(gen, node)
  let iter = ast.child(tree, node, 3)
  let mutable = tree.at(ast.child(tree, node, 2)).tag == "true"
  var binding = String.new()
  if tree.at(iter).tag == "IterRange" {
    let lower = expression(gen, tree, ast.child(tree, iter, 0))
    let lo = temp(gen, tree, lower.ty, lower.code)
    let upper = expression(gen, tree, ast.child(tree, iter, 1))
    let hi = temp(gen, tree, upper.ty, upper.code)
    let low_type = integer_c(lo.ty)
    let high_type = integer_c(hi.ty)
    if low_type != "int64_t" || high_type != "int64_t" { unsupported("non-Int range loop") }
    var compare = String.from("<")
    if tree.at(ast.child(tree, iter, 2)).tag == "true" { compare = String.from("<=") }
    var stride = String.from("1")
    let step = ast.child(tree, node, 4)
    if tree.at(step).tag != "_" {
      let value = expression(gen, tree, step)
      let saved = temp(gen, tree, value.ty, value.code)
      stride = String.from(saved.code)
      line(gen, "if ({stride} <= 0) nx_panic(\"assertion failed\");")
    }
    // A widened iterator can step past INT64_MAX in an inclusive range.
    line(gen, "for (__int128 i{id} = {lo.code}; i{id} {compare} {hi.code}; i{id} += {stride}) {{")
    binding = "int64_t v{id} = (int64_t)i{id};"
  } else {
    let seq = expression(gen, tree, iter)
    let element = type_terms.element(seq.ty)
    if element == "?" {
      emit_iterator(gen, tree, id, seq, ast.child(tree, node, 5), label)
      return
    }
    prepare_type(gen, tree, seq.ty)
    let c = c_type(gen, tree, element)
    let count = temp(gen, tree, String.from("Int"), sequence_length(seq))
    let ref = mutable || drop_fn(gen, tree, element).len() != 0
    gen.references.set(id, ref)
    line(gen, "for (int64_t i{id} = 0; i{id} < {count.code}; ++i{id}) {{")
    if ref { binding = "{c} *v{id} = &({seq.code}).d[i{id}];" }
    else { binding = "{c} v{id} = ({seq.code}).d[i{id}];" }
  }
  loop_start(gen, label)
  line(gen, binding)
  statement(gen, tree, ast.child(tree, node, 5))
  loop_end(gen)
}

fn pattern_bound(digits: view String) -> String {
  if digits == "-9223372036854775808" { return String.from("INT64_MIN") }
  return "INT64_C({digits})"
}

fn pattern_test(gen: view Generator, tree: view List<ast.AstNode>, node: Int, value: view Value) -> String {
  let tag = String.from(tree.at(node).tag)
  if tag == "_" || tag == "Wild" { return String.from("true") }
  if tag == "Bind" { return pattern_test(gen, tree, ast.child(tree, node, 1), value) }
  if tag == "Bool" || tag == "Int" || tag == "Char" {
    let literal = String.from(tree.at(ast.child(tree, node, 0)).tag)
    if tag == "Int" { return "({value.code} == {pattern_bound(literal)})" }
    return "({value.code} == {literal})"
  }
  if tag == "PatRange" {
    let lo = String.from(tree.at(ast.child(tree, node, 1)).tag)
    let hi = String.from(tree.at(ast.child(tree, node, 2)).tag)
    if lo == "_" && hi == "_" { return String.from("true") }
    if lo == "_" { return "({value.code} <= {pattern_bound(hi)})" }
    if hi == "_" { return "({value.code} >= {pattern_bound(lo)})" }
    return "({value.code} >= {pattern_bound(lo)} && {value.code} <= {pattern_bound(hi)})"
  }
  if tag == "Text" {
    let text = quoted_text(tree, node)
    return "(sc_compare({text_view(value)}, nx_str_text({text})) == 0)"
  }
  var tests = List<String>.new()
  if tag == "Or" {
    let items = ast.child(tree, node, 0)
    var at = items + 1
    while at < tree.at(items).end {
      tests.push(pattern_test(gen, tree, at, value))
      at = tree.at(at).end
    }
    let joined = tests.join(" || ")
    return "({joined})"
  }
  if tag == "Variant" {
    let layout = enum_index(gen, value.ty)
    if layout < 0 { unsupported("variant pattern on {value.ty}") }
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let slot = variant_index(gen.enum_layouts.at(layout), name)
    let fields = ast.child(tree, node, 1)
    var at = fields + 1
    var i = 0
    tests.push("({value.code}).tag == {slot}")
    while at < tree.at(fields).end {
      let field = enum_payload(gen, value, slot, i)
      tests.push(pattern_test(gen, tree, at, field))
      i = i + 1
      at = tree.at(at).end
    }
    let joined = tests.join(" && ")
    return "({joined})"
  }
  unsupported("pattern {tag}")
  return String.new()
}

fn bind_pattern(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, value: view Value,
    mode: view String, guarded: Bool) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Bind" {
    let id = id_at(gen, node)
    let c = c_type(gen, tree, value.ty)
    let drop = drop_fn(gen, tree, value.ty)
    let ref = mode == "Mut" || (mode == "View" && drop != "")
    gen.references.set(id, ref)
    if ref { line(gen, "{c} *v{id} = &({value.code});") }
    else if drop != "" {
      if guarded { unsupported("guard on a consuming pattern binding") }
      line(gen, "{c} v{id} __attribute__((cleanup({drop}))) = {transfer(gen, tree, value)};")
    } else { line(gen, "{c} v{id} = {value.code};") }
    bind_pattern(gen, tree, ast.child(tree, node, 1), value, mode, guarded)
  } else if tag == "Variant" {
    let layout = enum_index(gen, value.ty)
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let slot = variant_index(gen.enum_layouts.at(layout), name)
    let fields = ast.child(tree, node, 1)
    var at = fields + 1
    var i = 0
    while at < tree.at(fields).end {
      let field = enum_payload(gen, value, slot, i)
      bind_pattern(gen, tree, at, field, mode, guarded)
      i = i + 1
      at = tree.at(at).end
    }
  } else if tag == "Or" {
    for at in node + 1..tree.at(node).end {
      if tree.at(at).tag == "Bind" { unsupported("bindings in alternative patterns") }
    }
  }
}

fn emit_match(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let scrutinee = ast.child(tree, node, 0)
  var at = scrutinee
  var mode = String.from("Own")
  if tree.at(at).tag == "Un" && tree.at(ast.child(tree, at, 0)).tag == "6d7574" {
    at = ast.child(tree, at, 1)
    mode = String.from("Mut")
  } else if is_place(tree, at) { mode = String.from("View") }
  let operand = expression(gen, tree, at)
  prepare_type(gen, tree, operand.ty)
  var value = Value { ty: String.from(operand.ty), code: String.from(operand.code) }
  if mode == "Own" && drop_fn(gen, tree, value.ty).len() == 0 {
    value = temp(gen, tree, operand.ty, operand.code)
  }
  let matched = temp(gen, tree, String.from("Bool"), String.from("false"))
  let arms = ast.child(tree, node, 1)
  at = arms + 1
  while at < tree.at(arms).end {
    let pattern = ast.child(tree, at, 0)
    let guard = ast.child(tree, at, 1)
    let guarded = tree.at(guard).tag != "_"
    let test = pattern_test(gen, tree, pattern, value)
    line(gen, "if (!{matched.code} && {test}) {{")
    gen.indent = gen.indent + 1
    bind_pattern(gen, tree, pattern, value, mode, guarded)
    if guarded {
      let condition = expression(gen, tree, guard)
      line(gen, "if ({condition.code}) {{")
      gen.indent = gen.indent + 1
    }
    line(gen, "{matched.code} = true;")
    statement(gen, tree, ast.child(tree, at, 2))
    if guarded { gen.indent = gen.indent - 1; line(gen, String.from("}}")) }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    at = tree.at(at).end
  }
  line(gen, "if (!{matched.code}) nx_panic(\"non-exhaustive match\");")
}

fn statement(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Block" || tag == "[" || tag == "Scope" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    let deferred = gen.deferred.len()
    var at = node + 1
    while at < tree.at(node).end {
      statement(gen, tree, at)
      at = tree.at(at).end
    }
    emit_defers(gen, tree, deferred)
    while gen.deferred.len() > deferred { let unused = gen.deferred.pop() }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "Defer" {
    let inner = ast.child(tree, node, 0)
    for at in inner..tree.at(inner).end {
      let nested = String.from(tree.at(at).tag)
      if nested == "Return" || nested == "Break" || nested == "Continue" || nested == "Defer" ||
          (nested == "Un" && tree.at(ast.child(tree, at, 0)).tag == "3f") {
        unsupported("control flow inside defer")
      }
    }
    gen.deferred.push(inner)
  } else if tag == "Let" {
    let place = local_place(gen, node)
    if place.ty.starts_with("Slice<") { unsupported("slice binding") }
    let value = expression(gen, tree, ast.child(tree, node, 2))
    let init = coerce(gen, tree, move value, place.ty)
    let c = c_type(gen, tree, place.ty)
    let drop = drop_fn(gen, tree, place.ty)
    if drop != "" {
      line(gen, "{c} {place.code} __attribute__((cleanup({drop}))) = {transfer(gen, tree, init)};")
    } else { line(gen, "{c_type(gen, tree, place.ty)} {place.code} = {init.code};") }
  } else if tag == "Assign" {
    let target = ast.child(tree, node, 0)
    if !is_place(tree, target) { unsupported("assignment target") }
    let place = expression(gen, tree, target)
    if place.ty.starts_with("Slice<") { unsupported("slice assignment") }
    let value = expression(gen, tree, ast.child(tree, node, 1))
    let rhs = coerce(gen, tree, move value, place.ty)
    let drop = drop_fn(gen, tree, place.ty)
    if drop != "" {
      let moved = transfer(gen, tree, rhs)
      let saved = temp(gen, tree, place.ty, moved)
      line(gen, "{drop}(&({place.code}));")
      line(gen, "{place.code} = {transfer(gen, tree, saved)};")
    } else { line(gen, "{place.code} = {rhs.code};") }
  } else if tag == "Expr" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    let value = expression(gen, tree, ast.child(tree, node, 0))
    if value.ty != "nothing" { line(gen, "(void)({value.code});") }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "Return" {
    let arg = ast.child(tree, node, 0)
    if tree.at(arg).tag == "_" { emit_return(gen, tree, String.from("nothing"), String.new()) }
    else {
      let expected = String.from(gen.result)
      if expected == "nothing" { unsupported("return value in a function without a result type") }
      let value = expression(gen, tree, arg)
      let result = coerce(gen, tree, move value, expected)
      emit_return(gen, tree, expected, transfer(gen, tree, result))
    }
  } else if tag == "If" {
    let condition = expression(gen, tree, ast.child(tree, node, 0))
    if condition.ty != "Bool" { unsupported("if condition type") }
    line(gen, "if ({condition.code})")
    statement(gen, tree, ast.child(tree, node, 1))
    let alternative = ast.child(tree, node, 2)
    if tree.at(alternative).tag != "_" {
      line(gen, String.from("else {{"))
      gen.indent = gen.indent + 1
      statement(gen, tree, alternative)
      gen.indent = gen.indent - 1
      line(gen, String.from("}}"))
    }
  } else if tag == "Match" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    emit_match(gen, tree, node)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "For" {
    emit_for(gen, tree, node)
  } else if tag == "While" {
    let label = loop_label(tree, node)
    line(gen, String.from("for (;;) {{"))
    loop_start(gen, label)
    let condition = expression(gen, tree, ast.child(tree, node, 1))
    if condition.ty != "Bool" { unsupported("while condition type") }
    line(gen, "if (!({condition.code})) break;")
    statement(gen, tree, ast.child(tree, node, 2))
    loop_end(gen)
  } else if tag == "Break" || tag == "Continue" {
    let label = loop_label(tree, node)
    var index = gen.loops.len()
    while index > 0 {
      index = index - 1
      if label == "" || gen.loops.at(index).label == label {
        let id = gen.loops.at(index).id
        let start = gen.loops.at(index).deferred
        emit_defers(gen, tree, start)
        if tag == "Break" { line(gen, "goto sc_break_{id};") }
        else { line(gen, "goto sc_continue_{id};") }
        return
      }
    }
    unsupported("loop exit with invalid target")
  } else if tag != "_" { unsupported("statement {tag}") }
}

fn emit_struct(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) {
  if struct_index(gen, ty) >= 0 { return }
  let id = gen.struct_layouts.len()
  var destructor = -1
  for method in gen.methods {
    if method.destructor && method.owner == ty { destructor = method.node }
  }
  gen.struct_layouts.push(StructLayout {
    ty: String.from(ty), owned: false, ready: false, destructor: destructor >= 0,
  })
  let sub = nominal_sub(tree, node, ty)
  let fields = ast.child(tree, node, 2)
  var drops = List<String>.new()
  var at = fields + 1
  while at < tree.at(fields).end {
    let ty = declared_for(tree, ast.child(tree, at, 1), sub)
    if ty.starts_with("Slice<") { unsupported("slice stored in a struct") }
    prepare_type(gen, tree, ty)
    let drop = drop_fn(gen, tree, ty)
    if drop != "" {
      let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
      drops.push("{drop}(&value->m{name});")
    }
    at = tree.at(at).end
  }
  global(gen, "typedef struct {{")
  if destructor >= 0 { global(gen, String.from("bool sc_live;")) }
  at = fields + 1
  if at == tree.at(fields).end { global(gen, String.from("char empty;")) }
  while at < tree.at(fields).end {
    let ty = declared_for(tree, ast.child(tree, at, 1), sub)
    let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
    global(gen, "{c_type(gen, tree, ty)} m{name};")
    at = tree.at(at).end
  }
  global(gen, "}} S{id};")
  if drops.len() != 0 || destructor >= 0 {
    gen.struct_layouts.at(id).owned = true
    var method = -1
    if destructor >= 0 {
      method = schedule(gen, destructor, ty, type_terms.empty())
      global(gen, "static void F{method}(S{id} *value);")
    }
    global(gen, "static inline void sc_drop_S{id}(S{id} *value) {{")
    if method >= 0 {
      global(gen, "if (value->sc_live) {{")
      global(gen, "bool saved = nx_in_destructor; nx_in_destructor = true;")
      global(gen, "value->sc_live = false; F{method}(value); nx_in_destructor = saved; }}")
    }
      var field = drops.len()
    while field > 0 {
      field = field - 1
      global(gen, drops.at(field))
    }
      global(gen, String.from("}}"))
    global(gen, "static inline S{id} sc_take_S{id}(S{id} *value) {{")
    global(gen, "  S{id} result = *value; *value = (S{id}){{0}}; return result;")
    global(gen, String.from("}}"))
  }
  gen.struct_layouts.at(id).ready = true
}

fn returns_value(tree: view List<ast.AstNode>, node: Int) -> Bool {
  let tag = String.from(tree.at(node).tag)
  if tag == "Return" { return tree.at(ast.child(tree, node, 0)).tag != "_" }
  if tag == "If" {
    return returns_value(tree, ast.child(tree, node, 1)) && returns_value(tree, ast.child(tree, node, 2))
  }
  if tag == "Match" {
    let arms = ast.child(tree, node, 1)
    var at = arms + 1
    while at < tree.at(arms).end {
      if !returns_value(tree, ast.child(tree, at, 2)) { return false }
      at = tree.at(at).end
    }
    return true
  }
  if tag == "Block" || tag == "[" || tag == "Scope" {
    var at = node + 1
    while at < tree.at(node).end {
      if returns_value(tree, at) { return true }
      at = tree.at(at).end
    }
  }
  return false
}

fn emit_function(gen: mut Generator, tree: view List<ast.AstNode>, instance: Int) {
  let node = gen.instances.at(instance).node
  let owner = String.from(gen.instances.at(instance).owner)
  gen.sub = type_terms.with_names(gen.instances.at(instance).sub.names)
  for i in 0..gen.sub.names.len() {
    gen.sub.values.set(i, String.from(gen.instances.at(instance).sub.values.at(i)))
  }
  let is_closure = tree.at(node).tag == "Closure"
  var params = ast.child(tree, node, 2)
  var result = String.new()
  var closure_sig = -1
  if is_closure {
    params = ast.child(tree, node, 4)
    closure_sig = function_signature(gen, owner)
    result = String.from(gen.checked.signatures.at(closure_sig).result)
  } else { result = declared_for(tree, ast.child(tree, node, 3), gen.sub) }
  if result.starts_with("Slice<") { unsupported("slice return type") }
  prepare_type(gen, tree, result)
  let c = c_type(gen, tree, result)
  var entries = List<String>.new()
  var owned = List<Int>.new()
  var at = params + 1
  var ordinal = 0
  while at < tree.at(params).end {
    let id = id_at(gen, at)
    var ty = String.from(owner)
    var mode = String.new()
    if tree.at(at).tag == "Self" { mode = String.from(tree.at(ast.child(tree, at, 0)).tag) }
    else {
      ty = declared_for(tree, ast.child(tree, at, 2), gen.sub)
      mode = String.from(tree.at(ast.child(tree, at, 1)).tag)
      if is_closure {
        ty = String.from(gen.checked.signatures.at(closure_sig).args.at(ordinal).ty)
        mode = String.from(gen.checked.signatures.at(closure_sig).args.at(ordinal).mode)
      }
    }
    if ty.starts_with("Slice<") && mode == "Own" { unsupported("owned slice parameter") }
    prepare_type(gen, tree, ty)
    let drop = drop_fn(gen, tree, ty)
    let ref = by_reference(gen, tree, ty, mode)
    gen.references.set(id, ref)
    let param = c_type(gen, tree, ty)
    if ref { entries.push("{param} *v{id}") }
    else if drop != "" { entries.push("{param} p{id}"); owned.push(id) }
    else { entries.push("{param} v{id}") }
    at = tree.at(at).end
    ordinal = ordinal + 1
  }
  if entries.len() == 0 { entries.push(String.from("void")) }
  let parameters = entries.join(", ")
  let signature = "static {c} F{instance}({parameters})"
  let prototype = "{signature};\n"
  gen.prototypes.push_str(prototype)
  var block = ast.child(tree, node, 4)
  var expression_body = -1
  if is_closure {
    block = ast.child(tree, node, 6)
    let first = ast.child(tree, block, 0) + 1
    if tree.at(ast.child(tree, node, 1)).tag == "true" && tree.at(first).tag == "Expr" {
      expression_body = ast.child(tree, first, 0)
    }
  }
  if result != "nothing" && expression_body < 0 && !returns_value(tree, block) {
    unsupported("function missing a return value")
  }
  line(gen, "{signature} {{")
  gen.indent = gen.indent + 1
  gen.result = String.from(result)
  for id in owned {
    let ty = type_terms.substitute(gen.checked.bindings.at(id), gen.sub)
    line(gen, "{c_type(gen, tree, ty)} v{id} __attribute__((cleanup({drop_fn(gen, tree, ty)}))) = p{id};")
  }
  if expression_body >= 0 && result != "nothing" {
    let value = expression(gen, tree, expression_body)
    let value = coerce(gen, tree, move value, result)
    line(gen, "return {transfer(gen, tree, value)};")
  } else { statement(gen, tree, block) }
  if result != "nothing" { line(gen, String.from("nx_panic(\"function missing a return value\");")) }
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
}

fn generate(gen: mut Generator, tree: view List<ast.AstNode>) {
  let items = ast.child(tree, 0, 0)
  var at = items + 1
  while at < tree.at(items).end {
    let item = ast.child(tree, at, 2)
    let tag = String.from(tree.at(item).tag)
    if tag == "Fn" || tag == "Struct" {
      let name = ast.name_at(tree, item, 0)
      if tag == "Fn" {
        if find_named(tree, gen.functions, name) >= 0 { unsupported("duplicate function {name}") }
        gen.functions.push(item)
      } else {
        if find_named(tree, gen.structs, name) >= 0 { unsupported("duplicate struct {name}") }
        gen.structs.push(item)
      }
    } else if tag == "Derive" {
      let target = ast.name_at(tree, item, 0)
      let traits = ast.child(tree, item, 1)
      var trait_at = traits + 1
      while trait_at < tree.at(traits).end {
        let name = ast.decoded_name(tree, trait_at)
        if name != "Clone" { unsupported("derive {name}") }
        if gen.clone_types.contains(target) { unsupported("duplicate Clone derive for {target}") }
        gen.clone_types.push(String.from(target))
        trait_at = tree.at(trait_at).end
      }
    } else if tag == "Enum" { gen.enums.push(item) }
    else if tag == "Impl" {
      let generics = ast.child(tree, item, 0)
      var params = -1
      if tree.at(generics).end > generics + 1 {
        params = generics
        var g = generics + 1
        while g < tree.at(generics).end {
          if tree.at(g).tag != "Generic" { unsupported("non-type generic impl parameters") }
          let bounds = ast.child(tree, g, 1)
          if tree.at(bounds).end != bounds + 1 { unsupported("bounded generic impl") }
          g = tree.at(g).end
        }
      }
      let trait_node = ast.child(tree, item, 1)
      var destructor = false
      var equality = false
      if tree.at(trait_node).tag != "_" {
        if params >= 0 { unsupported("generic trait impl") }
        let name = declared_type(tree, trait_node)
        if name == "Drop" { destructor = true }
        else if name == "Equal" { equality = true }
        else { unsupported("trait impl {name}") }
      }
      let owner = declared_type(tree, ast.child(tree, item, 2))
      let methods = ast.child(tree, item, 3)
      var m = methods + 1
      while m < tree.at(methods).end {
        if destructor {
          let params = ast.child(tree, m, 2)
          if tree.at(params).end == params + 1 || tree.at(params + 1).tag != "Self" ||
              tree.at(ast.child(tree, params + 1, 0)).tag != "Mut" ||
              tree.at(params + 1).end != tree.at(params).end || tree.at(ast.child(tree, m, 3)).tag != "_" {
            unsupported("Drop method signature")
          }
        }
        gen.methods.push(Method { owner: String.from(owner), node: m, params: params, destructor: destructor, equality: equality })
        m = tree.at(m).end
      }
    }
    else if tag != "Alias" { unsupported("declaration {tag}") }
    at = tree.at(at).end
  }
  for target in gen.clone_types {
    if find_named(tree, gen.structs, target) < 0 && find_named(tree, gen.enums, target) < 0 {
      unsupported("derive Clone for unknown type {target}")
    }
  }
  let entry = find_named(tree, gen.functions, String.from("main"))
  if entry < 0 { unsupported("no main function") }
  let params = ast.child(tree, entry, 2)
  if tree.at(params).end != params + 1 || tree.at(ast.child(tree, entry, 3)).tag != "_" {
    unsupported("main must take no arguments and return nothing")
  }
  global(gen, String.from("#include \"c_runtime.h\""))
  global(gen, String.from("#include \"c_selfhost_text.h\""))
  global(gen, String.from("#include \"c_selfhost_sequences.h\""))
  global(gen, String.from("#include \"c_selfhost_process.h\""))
  global(gen, String.from("typedef void (*ScFn)(void);"))
  global(gen, String.from("static inline String sc_take_String(String *value) {{"))
  global(gen, String.from("  String result = *value; *value = (String){{0}}; return result;"))
  global(gen, String.from("}}"))
  let start = schedule(gen, entry, String.new(), type_terms.empty())
  var instance = 0
  while instance < gen.instances.len() {
    emit_function(gen, tree, instance)
    instance = instance + 1
  }
  line(gen, "int main(int argc, char **argv) {{ sc_argc = argc; sc_argv = argv; F{start}(); return 0; }}")
}

fn main() {
  let args = env.args()
  if args.len() != 2 {
    io.eprintln("usage: codegen FILE.ast")
    env.exit(2)
    return
  }
  match fs.read_to_string(args.at(1)) {
    Err(e) => { io.eprintln(e.message); env.exit(2) }
    Ok(source) => {
      let file = ast.decode(move source)
      let bindings = locals.resolve(file.nodes)
      let checked = types.check_file(file.nodes, bindings, true, false)
      if checked.errors > 0 {
        for row in checked.messages { io.eprintln(row) }
        env.exit(1)
        return
      }
      var gen = Generator {
        checked: move checked, locals: move bindings, structs: List<Int>.new(), functions: List<Int>.new(),
        collections: List<String>.new(), globals: String.new(),
        enums: List<Int>.new(), enum_layouts: List<EnumLayout>.new(),
        struct_layouts: List<StructLayout>.new(), methods: List<Method>.new(), clone_types: List<String>.new(),
        instances: List<Instance>.new(), sub: type_terms.empty(), prototypes: String.new(),
        references: List<Bool>.new(), out: String.new(),
        indent: 0, temp: 0, loops: List<Loop>.new(), deferred: List<Int>.new(), result: String.new(),
      }
      for i in 0..gen.locals.bindings.len() { gen.references.push(false) }
      generate(gen, file.nodes)
      print(gen.globals)
      print(gen.prototypes)
      print(gen.out)
    }
  }
}
