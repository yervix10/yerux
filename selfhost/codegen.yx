// Lower the checked source AST to C using the production C runtime.
import std.env
import std.fs
import std.io
import ast
import locals
import types
import type_terms

struct Value { ty: String, code: String }
struct Variant { name: String, payload: List<String> }
struct EnumLayout { ty: String, variants: List<Variant>, owned: Bool }
struct StructLayout { ty: String, owned: Bool, ready: Bool, destructor: Bool }
struct Method { owner: String, node: Int, params: Int, trait_name: String }
struct Instance { node: Int, owner: String, sub: type_terms.Substitution, key: String }
struct Loop { label: String, id: Int, deferred: Int }
struct Generator {
  checked: types.Checked,
  locals: locals.Locals,
  structs: List<Int>,
  enums: List<Int>,
  traits: List<Int>,
  enum_layouts: List<EnumLayout>,
  struct_layouts: List<StructLayout>,
  methods: List<Method>,
  clone_types: List<String>,
  constants: List<Int>,
  externs: List<Int>,
  instances: List<Instance>,
  sub: type_terms.Substitution,
  prototypes: String,
  function_values: List<Int>,
  closure_envs: List<Int>,
  heap_drops: List<String>,
  dyn_tables: List<String>,
  wrappers: String,
  functions: List<Int>,
  collections: List<String>,
  sorted_elements: List<String>,
  globals: String,
  references: List<Bool>,
  out: String,
  indent: Int,
  temp: Int,
  loops: List<Loop>,
  deferred: List<Int>,
  result: String,
  worker_cleanup: Bool,
  user_box: Bool,
  override_node: Int,
  at_file: String,
  user_lines: Int,
  locs: List<Int>,
  last_line: Int,
  slice_node: Int,
  site: Int,
  override_ty: String,
  override_code: String,
  no_args: Bool,
  value_target: String,
  value_type: String,
}

fn unsupported(message: view String) {
  io.eprintln("codegen: {message}")
  env.exit(3)
}

fn line(gen: mut Generator, text: view String) {
  gen.last_line = gen.out.len()
  for i in 0..gen.indent { gen.out.push_str("  ") }
  gen.out.push_str(text)
  gen.out.push_str("\n")
}

fn global(gen: mut Generator, text: view String) {
  gen.globals.push_str(text)
  gen.globals.push_str("\n")
}

fn collection_name(gen: view Generator, ty: view String) -> String {
  let id = gen.collections.index_of(ty)
  if id >= 0 { return "A{id}" }
  return String.new()
}

fn prepare_type(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String) {
  let item = type_terms.element(ty)
  if item != "?" && !gen.collections.contains(ty) {
    if item.starts_with("Slice<") { unsupported("slice stored inside a sequence") }
    prepare_type(gen, tree, item)
    let c = c_type(gen, tree, item)
    let id = gen.collections.len()
    let name = type_terms.base(ty)
    gen.collections.push(String.from(ty))
    if name == "Array" {
      let args = type_terms.arguments(ty)
      let element_drop = drop_fn(gen, tree, item)
      if element_drop.len() != 0 { global(gen, "SC_ARRAY_OWNED(A{id}, {c}, {args.at(1)}, {element_drop})") }
      else { global(gen, "SC_ARRAY(A{id}, {c}, {args.at(1)})") }
    } else if name == "Slice" {
      global(gen, "SC_SLICE(A{id}, {c})")
    } else {
      var drop = drop_fn(gen, tree, item)
      if drop == "" { drop = String.from("SC_COPY_ELEMENT") }
      global(gen, "SC_LIST(A{id}, {c}, {drop})")
      if item == "String" { global(gen, "SC_STRING_LIST(A{id})") }
    }
  }
  let base = type_terms.base(ty)
  if base == "Option" || base == "Result" || find_named(tree, gen.enums, base) >= 0 {
    prepare_enum(gen, tree, ty, base)
  }
  let structure = find_named(tree, gen.structs, base)
  if structure >= 0 { emit_struct(gen, tree, structure, ty) }
}

fn enum_index(gen: view Generator, ty: view String) -> Int {
  for i in 0..gen.enum_layouts.len() {
    if gen.enum_layouts.at(i).ty == ty { return i }
  }
  return -1
}

fn variant_index(layout: view EnumLayout, name: view String) -> Int {
  for i in 0..layout.variants.len() {
    if layout.variants.at(i).name == name { return i + 1 }
  }
  unsupported("unknown variant {name} of {layout.ty}")
  return -1
}

fn parameter_names(tree: view List<ast.AstNode>, params: Int) -> List<String> {
  var names = List<String>.new()
  var at = params + 1
  while at < tree.at(params).end {
    if tree.at(at).tag != "Generic" && tree.at(at).tag != "ConstParam" { unsupported("non-type generic parameters") }
    names.push(ast.name_at(tree, at, 0))
    at = tree.at(at).end
  }
  return move names
}

fn type_parameters(tree: view List<ast.AstNode>, decl: Int) -> List<String> {
  return parameter_names(tree, ast.child(tree, decl, 1))
}

fn enum_variants(gen: view Generator, tree: view List<ast.AstNode>, ty: view String,
    base: view String) -> List<Variant> {
  var cases = List<Variant>.new()
  let args = type_terms.arguments(ty)
  if base == "Option" || base == "Result" {
    var first = List<String>.new()
    var second = List<String>.new()
    if base == "Option" && args.len() == 1 {
      first.push(String.from(args.at(0)))
      cases.push(Variant { name: String.from("Some"), payload: move first })
      cases.push(Variant { name: String.from("None"), payload: move second })
    } else if base == "Result" && args.len() == 2 {
      first.push(String.from(args.at(0)))
      second.push(String.from(args.at(1)))
      cases.push(Variant { name: String.from("Ok"), payload: move first })
      cases.push(Variant { name: String.from("Err"), payload: move second })
    } else { unsupported("missing type parameters for {ty}") }
    return move cases
  }
  let decl = find_named(tree, gen.enums, base)
  let names = type_parameters(tree, decl)
  if names.len() != args.len() { unsupported("type parameters of {base}") }
  let sub = type_terms.Substitution { names: move names, values: move args }
  let variants = ast.child(tree, decl, 2)
  var at = variants + 1
  while at < tree.at(variants).end {
    let name = ast.name_at(tree, at, 0)
    let args = ast.child(tree, at, 1)
    var field = args + 1
    var payload = List<String>.new()
    while field < tree.at(args).end {
      payload.push(type_terms.substitute(declared_type(tree, field), sub))
      field = tree.at(field).end
    }
    cases.push(Variant { name: move name, payload: move payload })
    at = tree.at(at).end
  }
  return move cases
}

fn prepare_enum(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, base: view String) {
  if enum_index(gen, ty) >= 0 { return }
  let cases = enum_variants(gen, tree, ty, base)
  let id = gen.enum_layouts.len()
  // Reserve the identity before visiting payload types.
  gen.enum_layouts.push(EnumLayout { ty: String.from(ty), variants: List<Variant>.new(), owned: false })
  var fields = List<String>.new()
  var discard = List<String>.new()
  for i in 0..cases.len() {
    let slot = i + 1
    if cases.at(i).payload.len() > 0 { fields.push(String.from("struct {{")) }
    for j in 0..cases.at(i).payload.len() {
      let inner = String.from(cases.at(i).payload.at(j))
      prepare_type(gen, tree, inner)
      let c = c_type(gen, tree, inner)
      fields.push("{c} p{j};")
      let drop = drop_fn(gen, tree, inner)
      if drop != "" { discard.push("if (value->tag == {slot}) {drop}(&value->v{slot}.p{j});") }
    }
    if cases.at(i).payload.len() > 0 { fields.push("}} v{slot};") }
  }
  global(gen, "typedef struct {{ unsigned tag;")
  for field in fields { global(gen, field) }
  global(gen, "}} E{id};")
  if discard.len() > 0 {
    global(gen, "static inline void sc_drop_E{id}(E{id} *value) {{")
    for drop in discard { global(gen, drop) }
    global(gen, String.from("value->tag = 0; }}"))
    global(gen, "static inline E{id} sc_take_E{id}(E{id} *value) {{")
    global(gen, "E{id} result = *value; *value = (E{id}){{0}}; return result; }}")
    gen.enum_layouts.at(id).owned = true
  }
  gen.enum_layouts.at(id).variants = move cases
}

fn floating_c(ty: view String) -> String {
  if ty == "Float" { return String.from("double") }
  if ty == "Float32" { return String.from("float") }
  return String.new()
}

fn integer_c(ty: view String) -> String {
  if ty == "Int" || ty.starts_with("Int<") || ty == "Char" { return String.from("int64_t") }
  if ty == "Int8" { return String.from("int8_t") }
  if ty == "Int16" { return String.from("int16_t") }
  if ty == "Int32" { return String.from("int32_t") }
  if ty == "UInt8" { return String.from("uint8_t") }
  if ty == "UInt16" { return String.from("uint16_t") }
  if ty == "UInt32" { return String.from("uint32_t") }
  if ty == "UInt64" { return String.from("uint64_t") }
  return String.new()
}

fn integer_suffix(ty: view String) -> String {
  if ty == "Int" || ty.starts_with("Int<") { return String.new() }
  if ty == "Int8" { return String.from("_i8") }
  if ty == "Int16" { return String.from("_i16") }
  if ty == "Int32" { return String.from("_i32") }
  if ty == "UInt8" { return String.from("_u8") }
  if ty == "UInt16" { return String.from("_u16") }
  if ty == "UInt32" { return String.from("_u32") }
  if ty == "UInt64" { return String.from("_u64") }
  unsupported("arithmetic on {ty}")
  return String.new()
}

fn find_named(tree: view List<ast.AstNode>, nodes: view List<Int>, name: view String) -> Int {
  for node in nodes {
    let candidate = ast.name_at(tree, node, 0)
    if candidate == name { return node }
  }
  return -1
}

fn struct_index(gen: view Generator, ty: view String) -> Int {
  for i in 0..gen.struct_layouts.len() {
    if gen.struct_layouts.at(i).ty == ty { return i }
  }
  return -1
}

fn nominal_sub(tree: view List<ast.AstNode>, decl: Int, ty: view String) -> type_terms.Substitution {
  let names = type_parameters(tree, decl)
  let args = type_terms.arguments(ty)
  if names.len() != args.len() { unsupported("wrong type argument count for {ty}") }
  return type_terms.Substitution { names: move names, values: move args }
}

fn declared_for(tree: view List<ast.AstNode>, at: Int, sub: view type_terms.Substitution) -> String {
  return type_terms.substitute(declared_type(tree, at), sub)
}

fn c_type(gen: view Generator, tree: view List<ast.AstNode>, ty: view String) -> String {
  let int_type = integer_c(ty)
  if int_type != "" { return int_type }
  let float_type = floating_c(ty)
  if float_type != "" { return float_type }
  if ty == "Bool" { return String.from("bool") }
  if ty.starts_with("fn(") { return String.from("NxFn") }
  if ty == "Text" { return String.from("const char *") }
  if ty.starts_with("Ptr<") {
    let pointee = type_terms.arguments(ty)
    return "{c_type(gen, tree, pointee.at(0))} *"
  }
  if ty == "String" { return String.from("String") }
  if ty == "nothing" { return String.from("void") }
  if ty == "ThreadDone" { return String.from("ScThreadDone") }
  if ty == "ThreadPanic" { return String.from("ScThreadPanic") }
  if ty.starts_with("JoinHandle<") { return String.from("ScJoin") }
  if ty.starts_with("$dyn<") { return String.from("ScDyn") }
  if !gen.user_box && ty.starts_with("Box<") {
    let inner = type_terms.box_payload(ty)
    if inner == "?" || inner == "nothing" { unsupported("type {ty}") }
    if inner.starts_with("$dyn<") { return String.from("ScDyn") }
    return String.from("ScBox")
  }
  let collection = collection_name(gen, ty)
  if collection != "" { return collection }
  let layout = enum_index(gen, ty)
  if layout >= 0 {
    if gen.enum_layouts.at(layout).variants.len() == 0 { unsupported("recursive or empty enum {ty}") }
    return "E{layout}"
  }
  let structure = struct_index(gen, ty)
  if structure >= 0 {
    if !gen.struct_layouts.at(structure).ready { unsupported("recursive by-value struct {ty}") }
    return "S{structure}"
  }
  unsupported("type {ty}")
  return String.new()
}

fn drop_fn(gen: view Generator, tree: view List<ast.AstNode>, ty: view String) -> String {
  if ty == "String" { return String.from("nx_str_free") }
  if ty.starts_with("fn(") { return String.from("nx_drop_fn") }
  if !gen.user_box && ty.starts_with("Box<") { return "sc_drop_{c_type(gen, tree, ty)}" }
  if ty.starts_with("JoinHandle<") { return String.from("sc_drop_ScJoin") }
  let layout = enum_index(gen, ty)
  if layout >= 0 && gen.enum_layouts.at(layout).owned { return "sc_drop_E{layout}" }
  let collection = collection_name(gen, ty)
  if collection != "" && (ty == "List" || ty.starts_with("List<")) { return "sc_drop_{collection}" }
  if collection != "" && ty.starts_with("Array<") && drop_fn(gen, tree, type_terms.element(ty)).len() != 0 {
    return "sc_drop_{collection}"
  }
  let structure = struct_index(gen, ty)
  if structure >= 0 && gen.struct_layouts.at(structure).owned { return "sc_drop_S{structure}" }
  return String.new()
}

fn declared_type(tree: view List<ast.AstNode>, node: Int) -> String {
  var aliases = List<String>.new()
  return declared_type_inner(tree, node, aliases)
}

fn declared_type_inner(tree: view List<ast.AstNode>, node: Int, aliases: mut List<String>) -> String {
  if tree.at(node).tag == "_" { return String.from("nothing") }
  if tree.at(node).tag == "DynType" {
    let name = ast.name_at(tree, node, 0)
    return "$dyn<{name}>"
  }
  if tree.at(node).tag == "BracketType" {
    let elem = declared_type_inner(tree, ast.child(tree, node, 0), aliases)
    let size = ast.child(tree, node, 1)
    if tree.at(size).tag == "_" { return type_terms.bracket(elem, String.from("_")) }
    let length = ast.fold_const(tree, size, 0)
    if length.len() == 0 && tree.at(size).tag == "Var" { return type_terms.bracket(elem, ast.name_at(tree, size, 0)) }
    if length.len() == 0 { unsupported("nonliteral array length") }
    return type_terms.bracket(elem, length)
  }
  if tree.at(node).tag == "FnType" {
    let params = ast.child(tree, node, 0)
    var parts = List<String>.new()
    var at = params + 1
    while at < tree.at(params).end {
      let mode = String.from(tree.at(ast.child(tree, at, 0)).tag)
      let ty = declared_type_inner(tree, ast.child(tree, at, 1), aliases)
      if mode == "View" { parts.push("view {ty}") }
      else if mode == "Mut" { parts.push("mut {ty}") }
      else { parts.push(String.from(ty)) }
      at = tree.at(at).end
    }
    let args = parts.join(", ")
    let ret = declared_type_inner(tree, ast.child(tree, node, 1), aliases)
    if ret == "nothing" { return "fn({args})" }
    return "fn({args}) -> {ret}"
  }
  if tree.at(node).tag != "Type" { unsupported("type {tree.at(node).tag}") }
  let args = ast.child(tree, node, 1)
  let name = ast.name_at(tree, node, 0)
  if name == "Int" { return ast.range_type(tree, args) }
  if name == "Int64" { return String.from("Int") }
  if name == "Float64" { return String.from("Float") }
  if tree.at(args).end == args + 1 {
    let target = ast.alias_target(tree, name)
    if target >= 0 {
      if aliases.contains(name) { unsupported("cyclic type alias {name}") }
      aliases.push(String.from(name))
      let ty = declared_type_inner(tree, target, aliases)
      let unused = aliases.pop()
      return ty
    }
  }
  var parameters = List<String>.new()
  var at = args + 1
  while at < tree.at(args).end {
    parameters.push(declared_type_inner(tree, at, aliases))
    at = tree.at(at).end
  }
  return type_terms.apply(name, parameters)
}

fn id_at(gen: view Generator, node: Int) -> Int {
  let id = gen.locals.identities.at(node)
  if id < 0 { unsupported("unresolved local binding") }
  return id
}

fn local_place(gen: view Generator, node: Int) -> Value {
  return binding_place(gen, id_at(gen, node))
}

fn binding_place(gen: view Generator, id: Int) -> Value {
  let ty = type_terms.substitute(gen.checked.bindings.at(id), gen.sub)
  if gen.references.at(id) { return Value { ty: move ty, code: "(*v{id})" } }
  return Value { ty: move ty, code: "v{id}" }
}

fn is_place(gen: view Generator, tree: view List<ast.AstNode>, node: Int) -> Bool {
  if tree.at(node).tag == "Var" { return true }
  if tree.at(node).tag == "Field" { return is_place(gen, tree, ast.child(tree, node, 0)) }
  if tree.at(node).tag == "Method" {
    let recv = ast.child(tree, node, 0)
    let name = String.from(tree.at(ast.child(tree, node, 1)).tag)
    if name == "6174" || (name == "676574" && !gen.user_box &&
        type_terms.substitute(gen.checked.expressions.at(recv), gen.sub).starts_with("Box<")) {
      return is_place(gen, tree, recv)
    }
  }
  return false
}

fn heap_drop(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String) -> String {
  let drop = drop_fn(gen, tree, ty)
  if drop == "" { return String.from("NULL") }
  let c = c_type(gen, tree, ty)
  let adapter = "sc_heap_drop_{c}"
  if !gen.heap_drops.contains(c) {
    gen.heap_drops.push(String.from(c))
    global(gen, "static void {adapter}(void *p) {{ {drop}(p); }}")
  }
  return adapter
}

fn declare_local(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String,
    name: view String, init: view String) {
  let c = c_type(gen, tree, ty)
  let drop = drop_fn(gen, tree, ty)
  if drop == "" { line(gen, "{c} {name} = {init};"); return }
  line(gen, "{c} {name} __attribute__((cleanup({drop}))) = {init};")
  if gen.worker_cleanup {
    let adapter = heap_drop(gen, tree, ty)
    line(gen, "SC_WORKER_REGISTER({name}, {adapter});")
  }
}

fn temp(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, code: view String) -> Value {
  if ty == "nothing" {
    line(gen, "{code};")
    return Value { ty: String.from(ty), code: String.new() }
  }
  prepare_type(gen, tree, ty)
  let id = gen.temp
  gen.temp = id + 1
  let name = "t{id}"
  declare_local(gen, tree, ty, name, code)
  return Value { ty: String.from(ty), code: move name }
}

fn text_view(value: view Value) -> String {
  if value.ty == "String" { return "nx_str_view(&({value.code}))" }
  if value.ty == "Text" { return "nx_str_text({value.code})" }
  unsupported("expected Text or String")
  return String.new()
}

fn coerce(gen: mut Generator, tree: view List<ast.AstNode>, value: Value, expected: view String) -> Value {
  if expected == "String" && value.ty == "Text" {
    return temp(gen, tree, expected, "nx_str_from({text_view(value)})")
  }
  if (value.ty == "Int" || value.ty.starts_with("Int<")) &&
      (expected == "Int" || expected.starts_with("Int<")) {
    return Value { ty: String.from(expected), code: String.from(value.code) }
  }
  if value.ty != expected { unsupported("expected {expected}, got {value.ty}") }
  return move value
}

fn transfer(gen: view Generator, tree: view List<ast.AstNode>, value: view Value) -> String {
  // The take helpers leave a zero value for the source slot's scope cleanup.
  if drop_fn(gen, tree, value.ty).len() != 0 { return "sc_take_{c_type(gen, tree, value.ty)}(&({value.code}))" }
  return String.from(value.code)
}

fn quoted_text(tree: view List<ast.AstNode>, node: Int) -> String {
  if tree.at(node).end == node + 1 { return String.from("\"\"") }
  let bytes = ast.decoded_name(tree, ast.child(tree, node, 0))
  var result = String.from("\"")
  // Three octal digits per byte keep C escape boundaries and UTF-8 deterministic.
  for i in 0..bytes.len() {
    let b = bytes.byte(i)
    result.push_byte(92)
    result.push_byte(48 + b / 64)
    result.push_byte(48 + (b / 8) % 8)
    result.push_byte(48 + b % 8)
  }
  result.push_byte(34)
  return result
}

fn number(tree: view List<ast.AstNode>, node: Int, ty: view String, negative: Bool) -> Value {
  let digits = String.from(tree.at(ast.child(tree, node, 0)).tag)
  let float = floating_c(ty)
  if float != "" {
    var sign = String.new()
    if negative { sign = String.from("-") }
    var suffix = String.new()
    if ty == "Float32" { suffix = String.from("f") }
    var literal = String.from(digits)
    if tree.at(node).tag == "Float" { literal = ast.decoded_name(tree, ast.child(tree, node, 0)) }
    if tree.at(node).tag != "Float" { literal = "{digits}.0" }
    else if !literal.contains(".") && !literal.contains("e") && !literal.contains("E") { literal = "{literal}.0" }
    return Value { ty: String.from(ty), code: "({sign}{literal}{suffix})" }
  }
  let c = integer_c(ty)
  if c == "" { unsupported("numeric literal of type {ty}") }
  var code = "(({c})UINT64_C({digits}))"
  if negative {
    if ty == "Int" && digits == "9223372036854775808" { code = String.from("INT64_MIN") }
    else { code = "(({c})(-INT64_C({digits})))" }
  }
  return Value { ty: String.from(ty), code: move code }
}

fn equals(gen: mut Generator, tree: view List<ast.AstNode>, left: view Value, right: view Value) -> String {
  if left.ty == "String" || left.ty == "Text" {
    return "sc_compare({text_view(left)}, {text_view(right)}) == 0"
  }
  if left.ty.starts_with("Option<") {
    let a = enum_payload(gen, left, 1, 0)
    let b = enum_payload(gen, right, 1, 0)
    let same = equals(gen, tree, a, b)
    return "(({left.code}).tag == ({right.code}).tag && (({left.code}).tag != 1 || ({same})))"
  }
  let method = trait_method(gen, tree, left.ty, String.from("Equal"), String.from("eq"))
  if method >= 0 {
    return comparison_call(gen, tree, method, left, right)
  }
  if integer_c(left.ty).len() != 0 || floating_c(left.ty).len() != 0 || left.ty == "Bool" {
    return "({left.code}) == ({right.code})"
  }
  unsupported("Equal for {left.ty}")
  return String.new()
}

// Lexicographic comparison of two sequences whose elements are numbers, booleans or strings.
fn sequence_compare(gen: mut Generator, tree: view List<ast.AstNode>, op: view String, left: view Value,
    right: view Value, item: view String, ty: view String) -> Value {
  let id = gen.temp
  gen.temp = id + 1
  let a = temp(gen, tree, String.from("Int"), sequence_length(left))
  let b = temp(gen, tree, String.from("Int"), sequence_length(right))
  let order = temp(gen, tree, String.from("Int"), String.from("0"))
  var less = String.new()
  var greater = String.new()
  if item == "String" || item == "Text" {
    let x = Value { ty: String.from(item), code: "({left.code}).d[i{id}]" }
    let y = Value { ty: String.from(item), code: "({right.code}).d[i{id}]" }
    less = "sc_compare({text_view(x)}, {text_view(y)}) < 0"
    greater = "sc_compare({text_view(x)}, {text_view(y)}) > 0"
  } else if integer_c(item).len() != 0 || floating_c(item).len() != 0 || item == "Bool" {
    less = "({left.code}).d[i{id}] < ({right.code}).d[i{id}]"
    greater = "({left.code}).d[i{id}] > ({right.code}).d[i{id}]"
  } else if item.starts_with("Array<") && (simple_elements(item) || floating_c(type_terms.element(item)).len() != 0) {
    // fixed arrays as elements: lexicographic over their cells
    let dims = type_terms.arguments(item)
    let cells = String.from(dims.at(1))
    let x = "({left.code}).d[i{id}]"
    let y = "({right.code}).d[i{id}]"
    let order_code = "({{ int64_t c_ = 0; for (int64_t k_ = 0; k_ < {cells} && c_ == 0; ++k_) {{ c_ = ({x}.d[k_] < {y}.d[k_]) ? -1 : ({x}.d[k_] > {y}.d[k_]) ? 1 : 0; }} c_; }})"
    less = "{order_code} < 0"
    greater = "{order_code} > 0"
  } else { unsupported("comparison of sequences of {item}") }
  line(gen, "for (int64_t i{id} = 0; i{id} < {a.code} && i{id} < {b.code}; ++i{id}) {{")
  line(gen, "if ({less}) {{ {order.code} = -1; break; }}")
  line(gen, "if ({greater}) {{ {order.code} = 1; break; }} }}")
  line(gen, "if ({order.code} == 0) {order.code} = ({a.code} > {b.code}) - ({a.code} < {b.code});")
  if op == "cmp" { return temp(gen, tree, ty, "{order.code}") }
  return temp(gen, tree, ty, "({order.code} {op} 0)")
}

fn binary(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let op = ast.name_at(tree, node, 0)
  let left = expression(gen, tree, ast.child(tree, node, 1))
  if left.ty == "String" || left.ty == "Text" {
    if op == "+" {
      let joined = expression(gen, tree, ast.child(tree, node, 2))
      return temp(gen, tree, String.from("String"), "nx_str_concat({text_view(left)}, {text_view(joined)})")
    }
    if op != "==" && op != "!=" && op != "<" && op != "<=" && op != ">" && op != ">=" {
      unsupported("operator {op} on {left.ty}")
    }
    let right = expression(gen, tree, ast.child(tree, node, 2))
    return temp(gen, tree, ty, "(sc_compare({text_view(left)}, {text_view(right)}) {op} 0)")
  }
  if op == "==" || op == "!=" {
    if left.ty.starts_with("Option<") {
      let right = expression(gen, tree, ast.child(tree, node, 2))
      let test = equals(gen, tree, left, right)
      if op == "!=" { return temp(gen, tree, ty, "!({test})") }
      return temp(gen, tree, ty, test)
    }
    let method = trait_method(gen, tree, left.ty, String.from("Equal"), String.from("eq"))
    if method >= 0 {
      let right = expression(gen, tree, ast.child(tree, node, 2))
      let call = comparison_call(gen, tree, method, left, right)
      if op == "!=" { return temp(gen, tree, ty, "!({call})") }
      return temp(gen, tree, ty, call)
    }
  } else if op == "<" || op == "<=" || op == ">" || op == ">=" {
    let method = trait_method(gen, tree, left.ty, String.from("Ordered"), String.from("cmp"))
    if method >= 0 {
      let right = expression(gen, tree, ast.child(tree, node, 2))
      let call = comparison_call(gen, tree, method, left, right)
      return temp(gen, tree, ty, "({call} {op} 0)")
    }
  }
  let item = type_terms.element(left.ty)
  if item != "?" && (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=") {
    let right = expression(gen, tree, ast.child(tree, node, 2))
    return sequence_compare(gen, tree, op, left, right, item, ty)
  }
  if drop_fn(gen, tree, left.ty).len() != 0 { unsupported("operator {op} on {left.ty}") }
  let saved = temp(gen, tree, left.ty, left.code)
  let right_node = ast.child(tree, node, 2)
  if op == "&&" || op == "||" {
    if saved.ty != "Bool" { unsupported("non-Bool logical operand") }
    var test = String.from(saved.code)
    if op == "||" { test = "!{test}" }
    line(gen, "if ({test}) {{")
    gen.indent = gen.indent + 1
    let right = expression(gen, tree, right_node)
    if right.ty != "Bool" { unsupported("non-Bool logical operand") }
    line(gen, "{saved.code} = {right.code};")
    gen.indent = gen.indent - 1
    line(gen, "}}")
    return move saved
  }
  let right = expression(gen, tree, right_node)
  let float = floating_c(left.ty)
  if float != "" { return temp(gen, tree, ty, "({saved.code} {op} {right.code})") }
  if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
    if !type_terms.compatible(left.ty, right.ty) || (integer_c(left.ty).len() == 0 && left.ty != "Bool") {
      unsupported("comparison {op} on {left.ty} and {right.ty}")
    }
    return temp(gen, tree, ty, "({saved.code} {op} {right.code})")
  }
  var helper = String.new()
  if op == "+" { helper = String.from("add") }
  else if op == "-" { helper = String.from("sub") }
  else if op == "*" { helper = String.from("mul") }
  else if op == "/" { helper = String.from("div") }
  else if op == "%" { helper = String.from("mod") }
  else { unsupported("operator {op}") }
  let suffix = integer_suffix(ty)
  return temp(gen, tree, ty, "nx_{helper}{suffix}({saved.code}, {right.code})")
}

fn emit_print(gen: mut Generator, tree: view List<ast.AstNode>, value: view Value) {
  if value.ty == "Bool" { line(gen, "puts({value.code} ? \"true\" : \"false\");") }
  else if value.ty == "Text" { line(gen, "printf(\"%s\\n\", {value.code});") }
  else if value.ty == "String" { line(gen, "nx_print_str({text_view(value)});") }
  else if value.ty == "Char" { line(gen, "nx_print_char({value.code});") }
  else if value.ty == "Float" || value.ty == "Float32" {
    let single = value.ty == "Float32"
    line(gen, "sc_print_float({value.code}, {single});")
  }
  else if value.ty == "UInt64" { line(gen, "printf(\"%llu\\n\", (unsigned long long)({value.code}));") }
  else if integer_c(value.ty).len() != 0 { line(gen, "printf(\"%lld\\n\", (long long)({value.code}));") }
  else if integer_c(value.ty).len() == 0 {
    // lists, arrays, options, tuples and types with a Show impl print through their text form
    let shown = temp(gen, tree, String.from("String"), "nx_str_new()")
    append_show(gen, tree, shown, value)
    line(gen, "nx_print_str({text_view(shown)});")
  }
  else { unsupported("print of {value.ty}") }
}

fn construct_variant(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String,
    name: view String, args: Int) -> Value {
  prepare_type(gen, tree, ty)
  let layout = enum_index(gen, ty)
  if layout < 0 { unsupported("enum constructor {ty}.{name}") }
  let slot = variant_index(gen.enum_layouts.at(layout), name)
  let value = temp(gen, tree, ty, "{{ .tag = {slot} }}")
  var at = args + 1
  for i in 0..gen.enum_layouts.at(layout).variants.at(slot - 1).payload.len() {
    if args < 0 || at >= tree.at(args).end { unsupported("missing enum payload") }
    let expected = String.from(gen.enum_layouts.at(layout).variants.at(slot - 1).payload.at(i))
    let arg = expression(gen, tree, at)
    let field = coerce(gen, tree, move arg, expected)
    line(gen, "{value.code}.v{slot}.p{i} = {transfer(gen, tree, field)};")
    at = tree.at(at).end
  }
  if args >= 0 && at != tree.at(args).end { unsupported("extra enum payload") }
  return move value
}

fn enum_payload(gen: view Generator, value: view Value, slot: Int, field: Int) -> Value {
  let layout = enum_index(gen, value.ty)
  return Value {
    ty: String.from(gen.enum_layouts.at(layout).variants.at(slot - 1).payload.at(field)),
    code: "({value.code}).v{slot}.p{field}",
  }
}

fn append_show(gen: mut Generator, tree: view List<ast.AstNode>, dst: view Value, value: view Value) {
  let base = type_terms.base(value.ty)
  let method = match_method(gen, tree, value.ty, String.from("show"), true)
  if method >= 0 {
    let sub = call_substitution(gen, tree, method, value.ty)
    let instance = schedule(gen, method, value.ty, move sub)
    var arg = String.from(value.code)
    if drop_fn(gen, tree, value.ty).len() != 0 { arg = "&({arg})" }
    let shown = temp(gen, tree, String.from("String"), "F{instance}({arg})")
    line(gen, "nx_str_push_str(&{dst.code}, {text_view(shown)});")
  } else if base == "Option" || base == "Result" {
    var first = String.from("Some")
    var second = String.from("None")
    if base == "Result" {
      first = String.from("Ok")
      second = String.from("Err")
    }
    line(gen, "if (({value.code}).tag == 1) {{")
    gen.indent = gen.indent + 1
    line(gen, "nx_str_push_str(&{dst.code}, nx_str_text(\"{first}(\"));")
    let payload = enum_payload(gen, value, 1, 0)
    append_show(gen, tree, dst, payload)
    line(gen, "nx_str_push_byte(&{dst.code}, ')');")
    gen.indent = gen.indent - 1
    line(gen, String.from("}} else {{"))
    gen.indent = gen.indent + 1
    if base == "Result" {
      line(gen, "nx_str_push_str(&{dst.code}, nx_str_text(\"{second}(\"));")
      let error = enum_payload(gen, value, 2, 0)
      append_show(gen, tree, dst, error)
      line(gen, "nx_str_push_byte(&{dst.code}, ')');")
    } else { line(gen, "nx_str_push_str(&{dst.code}, nx_str_text(\"{second}\"));") }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if base == "List" || base == "Array" || base == "Slice" {
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "nx_str_push_byte(&{dst.code}, '[');")
    line(gen, "for (int64_t i{id} = 0; i{id} < {sequence_length(value)}; ++i{id}) {{")
    gen.indent = gen.indent + 1
    line(gen, "if (i{id}) nx_str_push_str(&{dst.code}, nx_str_text(\", \"));")
    let item = Value { ty: type_terms.element(value.ty), code: "({value.code}).d[i{id}]" }
    append_show(gen, tree, dst, item)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    line(gen, "nx_str_push_byte(&{dst.code}, ']');")
  } else if value.ty == "Text" || value.ty == "String" {
    line(gen, "nx_str_push_str(&{dst.code}, {text_view(value)});")
  } else if value.ty == "Bool" {
    line(gen, "nx_str_push_str(&{dst.code}, nx_str_text({value.code} ? \"true\" : \"false\"));")
  } else if value.ty == "Char" {
    line(gen, "nx_str_push_char(&{dst.code}, {value.code});")
  } else if value.ty == "UInt64" {
    line(gen, "{dst.code} = sc_fmt_uint({dst.code}, {value.code});")
  } else if integer_c(value.ty).len() != 0 {
    line(gen, "nx_str_push_int(&{dst.code}, {value.code});")
  } else if value.ty == "Float" || value.ty == "Float32" {
    let single = value.ty == "Float32"
    let shown = temp(gen, tree, String.from("String"), "sc_format_float({value.code}, {single})")
    line(gen, "nx_str_push_str(&{dst.code}, {text_view(shown)});")
  } else if value.ty == "std__io__IoError" {
    line(gen, "nx_str_push_str(&{dst.code}, nx_str_view(&({value.code}).m6d657373616765));")
  } else { unsupported("Show for {value.ty}") }
}

fn option_result_method(gen: mut Generator, tree: view List<ast.AstNode>, receiver: view Value,
    name: view String, args: Int, ty: view String) -> Value {
  prepare_type(gen, tree, receiver.ty)
  let base = type_terms.base(receiver.ty)
  if name == "is_some" || name == "is_ok" { return temp(gen, tree, ty, "({receiver.code}).tag == 1") }
  if name == "is_none" || name == "is_err" { return temp(gen, tree, ty, "({receiver.code}).tag == 2") }
  let owned = temp(gen, tree, receiver.ty, transfer(gen, tree, receiver))
  if name == "ok" || name == "err" {
    let result = temp(gen, tree, ty, String.from("{{ .tag = 2 }}"))
    var slot = 1
    if name == "err" { slot = 2 }
    let payload = enum_payload(gen, owned, slot, 0)
    line(gen, "if ({owned.code}.tag == {slot}) {{")
    gen.indent = gen.indent + 1
    line(gen, "{result.code}.tag = 1;")
    line(gen, "{result.code}.v1.p0 = {transfer(gen, tree, payload)};")
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return move result
  }
  let payload = enum_payload(gen, owned, 1, 0)
  if name == "unwrap_or" {
    let arg = expression(gen, tree, args + 1)
    let fallback = coerce(gen, tree, move arg, ty)
    let default = temp(gen, tree, ty, transfer(gen, tree, fallback))
    return temp(gen, tree, ty, "{owned.code}.tag == 1 ? {transfer(gen, tree, payload)} : {transfer(gen, tree, default)}")
  }
  if name == "or" && base == "Option" {
    let arg = expression(gen, tree, args + 1)
    return temp(gen, tree, ty, "{owned.code}.tag == 1 ? {transfer(gen, tree, owned)} : {transfer(gen, tree, arg)}")
  }
  if name == "unwrap" || name == "expect" {
    var message = Value { ty: String.from("Text"), code: String.from("\"called `Option.unwrap()` on a `None` value\"") }
    if name == "expect" { message = expression(gen, tree, args + 1) }
    line(gen, "if ({owned.code}.tag != 1) {{")
    gen.indent = gen.indent + 1
    if base == "Result" {
      let text = temp(gen, tree, String.from("String"), String.from("nx_str_new()"))
      if name == "expect" {
        append_show(gen, tree, text, message)
        line(gen, "nx_str_push_str(&{text.code}, nx_str_text(\": \"));")
      } else {
        line(gen, "nx_str_push_str(&{text.code}, nx_str_text(\"called `Result.unwrap()` on an `Err` value: \"));")
      }
      let error = enum_payload(gen, owned, 2, 0)
      append_show(gen, tree, text, error)
      line(gen, "nx_panic_str({text_view(text)});")
    } else { line(gen, "nx_panic_str({text_view(message)});") }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return temp(gen, tree, ty, transfer(gen, tree, payload))
  }
  unsupported("{base}.{name}")
  return move owned
}

fn emit_defers(gen: mut Generator, tree: view List<ast.AstNode>, start: Int) {
  var at = gen.deferred.len()
  while at > start {
    at = at - 1
    let node = gen.deferred.at(at)
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    statement(gen, tree, node)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  }
}

fn emit_return(gen: mut Generator, tree: view List<ast.AstNode>, ty: view String, code: view String) {
  if ty == "nothing" {
    emit_defers(gen, tree, 0)
    line(gen, String.from("return;"))
  } else if gen.deferred.len() == 0 {
    line(gen, "return {code};")
  } else {
    let saved = temp(gen, tree, ty, code)
    emit_defers(gen, tree, 0)
    line(gen, "return {transfer(gen, tree, saved)};")
  }
}

fn propagate_result(gen: mut Generator, tree: view List<ast.AstNode>, operand: view Value) -> Value {
  let owned = temp(gen, tree, operand.ty, transfer(gen, tree, operand))
  let result = String.from(gen.result)
  prepare_type(gen, tree, result)
  let dest = c_type(gen, tree, result)
  let base = type_terms.base(operand.ty)
  line(gen, "if ({owned.code}.tag == 2) {{")
  gen.indent = gen.indent + 1
  if base == "Option" {
    emit_return(gen, tree, result, "({dest}){{ .tag = 2 }}")
  } else if base == "Result" {
    let error = enum_payload(gen, owned, 2, 0)
    let wanted = type_terms.arguments(result)
    var converted = transfer(gen, tree, error)
    if wanted.len() == 2 && wanted.at(1) != error.ty {
      let name = "{type_terms.snake(wanted.at(1))}_from_{type_terms.snake(error.ty)}"
      let fun = find_named(tree, gen.functions, name)
      if fun >= 0 {
        let instance = schedule(gen, fun, String.new(), type_terms.empty())
        converted = "F{instance}({transfer(gen, tree, error)})"
      } else if wanted.at(1) == "String" {
        let shown = temp(gen, tree, String.from("String"), "nx_str_new()")
        append_show(gen, tree, shown, error)
        converted = transfer(gen, tree, shown)
      } else { unsupported("error conversion to {wanted.at(1)}") }
    }
    emit_return(gen, tree, result, "({dest}){{ .tag = 2, .v2.p0 = {converted} }}")
  } else { unsupported("try operator on {base}") }
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  let payload = enum_payload(gen, owned, 1, 0)
  return temp(gen, tree, payload.ty, transfer(gen, tree, payload))
}

fn parameter_c(gen: mut Generator, tree: view List<ast.AstNode>, param: view types.Parameter) -> String {
  prepare_type(gen, tree, param.ty)
  let c = c_type(gen, tree, param.ty)
  if by_reference(gen, tree, param.ty, param.mode) { return "{c} *" }
  return c
}

fn indirect_call(gen: mut Generator, tree: view List<ast.AstNode>, callee: view Value, args: Int,
    result: view String) -> Value {
  var parts = type_terms.function_parts(callee.ty)
  if parts.len() == 0 { unsupported("function value with signature {callee.ty}") }
  let ret = parts.pop()
  let saved = gen.temp
  gen.temp = gen.temp + 1
  // Snapshot the callee before evaluating arguments. Its original slot owns the environment.
  line(gen, "NxFn t{saved} = {callee.code};")
  var c_types = List<String>.new()
  c_types.push(String.from("void *"))
  var values = List<String>.new()
  values.push("t{saved}.env")
  var deferred = List<Int>.new()
  var arg = args + 1
  for part in parts {
    if arg >= tree.at(args).end { unsupported("function value arity") }
    let param = types.function_parameter(part)
    c_types.push(parameter_c(gen, tree, param))
    let ref = by_reference(gen, tree, param.ty, param.mode)
    if (ref || param.ty.starts_with("Slice<")) && is_place(gen, tree, arg) {
      values.push(String.new())
      deferred.push(arg)
    } else {
      values.push(call_argument(gen, tree, arg, param.ty, ref))
      deferred.push(-1)
    }
    arg = tree.at(arg).end
  }
  if arg != tree.at(args).end { unsupported("function value arity") }
  for i in 0..deferred.len() {
    let arg = deferred.at(i)
    if arg >= 0 {
      let param = types.function_parameter(parts.at(i))
      let ref = by_reference(gen, tree, param.ty, param.mode)
      values.set(i + 1, call_argument(gen, tree, arg, param.ty, ref))
    }
  }
  prepare_type(gen, tree, ret)
  let c = c_type(gen, tree, ret)
  let types = c_types.join(", ")
  let actual = values.join(", ")
  return temp(gen, tree, result, "(({c} (*)({types}))t{saved}.code)({actual})")
}

fn function_value(gen: mut Generator, tree: view List<ast.AstNode>, fun: Int, ty: view String) -> Value {
  let instance = schedule(gen, fun, String.new(), type_terms.empty())
  if !gen.function_values.contains(instance) {
    var parts = type_terms.function_parts(ty)
    if parts.len() == 0 { unsupported("function value with signature {ty}") }
    let result = parts.pop()
    prepare_type(gen, tree, result)
    let ret = c_type(gen, tree, result)
    var params = String.from("void *env")
    var args = List<String>.new()
    for i in 0..parts.len() {
      let param = types.function_parameter(parts.at(i))
      let c = parameter_c(gen, tree, param)
      params.push_str(", {c} a{i}")
      args.push("a{i}")
    }
    let actual = args.join(", ")
    gen.wrappers.push_str("static {ret} W{instance}({params}) {{ return F{instance}({actual}); }}\n")
    gen.function_values.push(instance)
  }
  return temp(gen, tree, ty, "(NxFn){{ (void *)W{instance}, NULL }}")
}

fn closure(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  if tree.at(ast.child(tree, node, 2)).tag == "true" { unsupported("parallel Closure") }
  let worker = tree.at(ast.child(tree, node, 3)).tag == "true"
  let instance = schedule(gen, node, ty, type_terms.copy(gen.sub))
  var entry = "F{instance}"
  if worker { entry = "P{instance}" }
  let captures = locals.environment_captures(gen.locals, tree, node)
  if captures.len() == 0 { return temp(gen, tree, ty, "(NxFn){{ (void *){entry}, NULL }}") }
  let borrow = gen.checked.borrowed_closures.at(node)
  // nx_drop_fn reads the environment's drop function from its first word.
  var fields = String.from("int64_t drop;")
  var cleanup = String.new()
  for id in captures {
    let place = binding_place(gen, id)
    if place.ty.starts_with("Slice<") { unsupported("slice captured by a Closure") }
    prepare_type(gen, tree, place.ty)
    let c = c_type(gen, tree, place.ty)
    if borrow { fields.push_str(" {c} *v{id};") }
    else {
      fields.push_str(" {c} v{id};")
      let drop = drop_fn(gen, tree, place.ty)
      if place.ty.starts_with("fn(") { cleanup.push_str(" nx_envpush(wl, env->v{id}.env);") }
      else if drop != "" { cleanup.push_str(" {drop}(&env->v{id});") }
    }
  }
  let name = gen.temp
  gen.temp = gen.temp + 1
  if !gen.closure_envs.contains(instance) {
    global(gen, "typedef struct {{ {fields} }} C{instance};")
    global(gen, "static void sc_drop_C{instance}(void *p, NxEnvWL *wl) {{ C{instance} *env = p;{cleanup} free(env); }}")
    gen.closure_envs.push(instance)
  }
  line(gen, "C{instance} *e{name} = malloc(sizeof(*e{name}));")
  line(gen, "if (!e{name}) nx_panic(\"out of memory\");")
  line(gen, "e{name}->drop = (int64_t)(intptr_t)sc_drop_C{instance};")
  for id in captures {
    let place = binding_place(gen, id)
    if borrow { line(gen, "e{name}->v{id} = &({place.code});") }
    else { line(gen, "e{name}->v{id} = {transfer(gen, tree, place)};") }
  }
  return temp(gen, tree, ty, "(NxFn){{ (void *){entry}, e{name} }}")
}

fn conversion(gen: mut Generator, tree: view List<ast.AstNode>, value: view Value, ty: view String,
    trunc: Bool) -> Value {
  let float = floating_c(ty)
  if float != "" { return temp(gen, tree, ty, "({float})({value.code})") }
  let c = integer_c(ty)
  if trunc { return temp(gen, tree, ty, "({c})({value.code})") }
  var suffix = integer_suffix(ty)
  if suffix == "" { suffix = String.from("_i64") }
  let input = floating_c(value.ty)
  if input != "" { return temp(gen, tree, ty, "nx_f2i{suffix}({value.code})") }
  return temp(gen, tree, ty, "nx_to{suffix}((__int128)({value.code}))")
}

fn emit_math(gen: mut Generator, tree: view List<ast.AstNode>, name: view String, args: Int,
    receiver: Int, ty: view String) -> Value {
  var first = receiver
  var next = args + 1
  if first < 0 {
    first = next
    next = tree.at(next).end
  }
  let value = expression(gen, tree, first)
  let left = temp(gen, tree, value.ty, value.code)
  let float = floating_c(left.ty)
  if float == "" {
    if name == "abs" {
      return temp(gen, tree, ty, "{left.code} < 0 ? nx_neg{integer_suffix(ty)}({left.code}) : {left.code}")
    }
    let right = expression(gen, tree, next)
    var op = String.from(">")
    if name == "min" { op = String.from("<") }
    return temp(gen, tree, ty, "{left.code} {op} {right.code} ? {left.code} : {right.code}")
  }
  if name == "to_bits" {
    var size = 64
    if left.ty == "Float32" { size = 32 }
    return temp(gen, tree, ty, "nx_bits{size}({left.code})")
  }
  var helper = String.from(name)
  if name == "ln" || name == "exp" || name == "pow" || name == "sin" || name == "cos" ||
      name == "tan" || name == "asin" || name == "acos" || name == "atan" || name == "atan2" {
    helper = "sc_math_{name}"
  }
  else if name == "abs" { helper = String.from("fabs") }
  else if name == "min" || name == "max" { helper = "sc_float_{name}" }
  else if name == "is_nan" || name == "is_inf" || name == "is_finite" { helper = name.replace("_", "") }
  else if name.ends_with("_int") {
    helper = name.slice(0, name.len() - 4)
    return temp(gen, tree, ty, "nx_f2i_i64({helper}({left.code}))")
  }
  if types.math_arity(name) == 2 {
    let right = expression(gen, tree, next)
    return temp(gen, tree, ty, "{helper}({left.code}, {right.code})")
  }
  return temp(gen, tree, ty, "{helper}({left.code})")
}

fn call(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let name = ast.name_at(tree, node, 0)
  let args = ast.child(tree, node, 1)
  if gen.locals.identities.at(node) >= 0 {
    let callee = local_place(gen, node)
    return indirect_call(gen, tree, callee, args, ty)
  }
  let fun = find_named(tree, gen.functions, name)
  if fun < 0 {
    if name == "__spawn_owned" && ty.starts_with("JoinHandle<") {
      let entry = expression(gen, tree, args + 1)
      return temp(gen, tree, ty, "nx_thread_start({transfer(gen, tree, entry)}, true)")
    }
    if (name == "__thread_start" || name == "__thread_start_recover") && tree.at(args).end > args + 1 && tree.at(args + 1).end == tree.at(args).end {
      let entry = expression(gen, tree, args + 1)
      var recover = String.from("false")
      if name == "__thread_start_recover" { recover = String.from("true") }
      return temp(gen, tree, ty, "nx_thread_start({transfer(gen, tree, entry)}, {recover})")
    }
    if types.raw_arity(name) > 0 {
      var values = List<String>.new()
      var at = args + 1
      while at < tree.at(args).end {
        let arg = expression(gen, tree, at)
        let saved = temp(gen, tree, arg.ty, arg.code)
        values.push(String.from(saved.code))
        at = tree.at(at).end
      }
      let operands = values.join(", ")
      if name == "__global" { return temp(gen, tree, ty, "((int64_t)(intptr_t)&nx_globals[{operands}])") }
      let helper = name.slice(2, name.len())
      return temp(gen, tree, ty, "nx_{helper}({operands})")
    }
    if name == "Some" || name == "Ok" || name == "Err" {
      return construct_variant(gen, tree, ty, name, args)
    }
    if types.math_arity(name) != 0 { return emit_math(gen, tree, name, args, -1, ty) }
    if name == "float_from_bits" || name == "float32_from_bits" {
      let value = expression(gen, tree, args + 1)
      var size = 64
      if ty == "Float32" { size = 32 }
      return temp(gen, tree, ty, "nx_from_bits{size}({value.code})")
    }
    if name.starts_with("std__") {
      return bootstrap_call(gen, tree, name, args, ty)
    }
    if name == "assert_eq" {
      let left = expression(gen, tree, args + 1)
      let saved = temp(gen, tree, left.ty, left.code)
      let right = expression(gen, tree, tree.at(args + 1).end)
      return temp(gen, tree, ty, "nx_assert({saved.code} == {right.code})")
    }
    if name == "ok_or" {
      let left = expression(gen, tree, args + 1)
      let source = temp(gen, tree, left.ty, transfer(gen, tree, left))
      let right = expression(gen, tree, tree.at(args + 1).end)
      let error = temp(gen, tree, right.ty, transfer(gen, tree, right))
      prepare_type(gen, tree, ty)
      let c = c_type(gen, tree, ty)
      let payload = enum_payload(gen, source, 1, 0)
      return temp(gen, tree, ty,
        "{source.code}.tag == 1 ? ({c}){{ .tag = 1, .v1.p0 = {transfer(gen, tree, payload)} }} : ({c}){{ .tag = 2, .v2.p0 = {transfer(gen, tree, error)} }}")
    }
    if name == "__comptime" && tree.at(args).end > args + 1 && tree.at(args + 1).end == tree.at(args).end {
      return expression(gen, tree, args + 1)
    }
    if name == "unchecked" && tree.at(args).end > args + 1 && tree.at(args + 1).end == tree.at(args).end {
      // `unchecked(x)` only tells the type stage to trust the range; range types are plain Int here
      return expression(gen, tree, args + 1)
    }
    if name != "print" && name != "assert" && name != "panic" { unsupported("call to {name}") }
    if tree.at(args).end == args + 1 || tree.at(args + 1).end != tree.at(args).end {
      unsupported("{name} arity")
    }
    let value = expression(gen, tree, args + 1)
    if name == "print" { emit_print(gen, tree, value) }
    else if name == "panic" {
      if gen.site != 0 { line(gen, "nxl_panic_str({text_view(value)}, {gen.site});") }
      else { line(gen, "nx_panic_str({text_view(value)});") }
    }
    else {
      if value.ty != "Bool" { unsupported("assert argument type") }
      line(gen, "nx_assert({value.code});")
    }
    return Value { ty: String.from("nothing"), code: String.new() }
  }
  return emit_call(gen, tree, fun, String.new(), args, -1, ty)
}

fn bootstrap_call(gen: mut Generator, tree: view List<ast.AstNode>, name: view String, args: Int,
    ty: view String) -> Value {
  let first = args + 1
  let end = tree.at(args).end
  if first == end {
    if name == "std__io__read_line" || name == "std__io__read_all" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      let data = temp(gen, tree, String.from("String"), String.from("{{0}}"))
      var line_mode = String.from("false")
      if name == "std__io__read_line" { line_mode = String.from("true") }
      let state = temp(gen, tree, String.from("Int"), "sc_read_stdin({line_mode}, &{data.code}, &{result.code}.v2.p0.m6d657373616765)")
      line(gen, "if ({state.code} < 0) {{ {result.code}.tag = 2; }} else {{")
      line(gen, "{result.code}.tag = 1;")
      if name == "std__io__read_line" {
        line(gen, "{result.code}.v1.p0.tag = {state.code} == 0 ? 2 : 1;")
        line(gen, "{result.code}.v1.p0.v1.p0 = {transfer(gen, tree, data)};")
      } else {
        line(gen, "{result.code}.v1.p0 = {transfer(gen, tree, data)};")
      }
      line(gen, String.from("}}"))
      return move result
    }
    if name == "std__env__pid" || name == "std__io__process_id" {
      return temp(gen, tree, ty, "(int64_t)getpid()")
    }
    if name == "std__env__arg_count" { return temp(gen, tree, ty, String.from("sc_argc")) }
    if name == "std__env__current_exe" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      line(gen, "{result.code}.tag = sc_current_exe(&{result.code}.v1.p0, &{result.code}.v2.p0.m6d657373616765) ? 1 : 2;")
      return move result
    }
    if name == "std__env__args" || name == "std__io__args" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      let c = c_type(gen, tree, ty)
      line(gen, "for (int i = 0; i < sc_argc; ++i) sc_push_{c}(&{result.code}, sc_cstr(sc_argv[i]));")
      return move result
    }
    unsupported("bootstrap call {name}")
  }
  let left = expression(gen, tree, first)
  let second = tree.at(first).end
  if second == end {
    if name == "std__print_owned" {
      emit_print(gen, tree, left)
      return Value { ty: String.from("nothing"), code: String.new() }
    }
    if name == "std__io__write_stdout" || name == "std__io__write_stderr" {
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      var fd = 1
      if name == "std__io__write_stderr" { fd = 2 }
      let written = temp(gen, tree, String.from("Int"), "sc_write_fd({fd}, {text_view(left)}, &{result.code}.v2.p0.m6d657373616765)")
      line(gen, "if ({written.code} < 0) {{ {result.code}.tag = 2; }}")
      line(gen, "else {{ {result.code}.tag = 1; {result.code}.v1.p0 = {written.code}; }}")
      return move result
    }
    if name == "std__io__eprintln" { return temp(gen, tree, ty, "sc_eprintln({text_view(left)})") }
    if name == "std__io__eprint" { return temp(gen, tree, ty, "sc_eprint({text_view(left)})") }
    if name == "std__env__exit" || name == "std__io__exit" || name == "std__io__exit_clean" { return temp(gen, tree, ty, "exit((int)({left.code}))") }
    if name == "std__fs__is_file" || name == "std__fs__read_to_string" {
      let path = coerce(gen, tree, move left, String.from("String"))
      if name == "std__fs__is_file" { return temp(gen, tree, ty, "sc_is_file(&({path.code}))") }
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      line(gen, "if (sc_read_file(&({path.code}), &{result.code}.v1.p0, &{result.code}.v2.p0.m6d657373616765)) {{")
      line(gen, "{result.code}.tag = 1;")
      line(gen, "}} else {{ {result.code}.tag = 2; }}")
      return move result
    }
    if name == "std__env__arg" {
      let index = temp(gen, tree, String.from("Int"), left.code)
      let result = temp(gen, tree, ty, String.from("{{ .tag = 2 }}"))
      line(gen, "if ({index.code} >= 0 && {index.code} < sc_argc) {{")
      line(gen, "{result.code}.tag = 1; {result.code}.v1.p0 = sc_cstr(sc_argv[{index.code}]);")
      line(gen, String.from("}}"))
      return move result
    }
  } else if tree.at(second).end == end {
    if name == "std__fs__write" || name == "std__process__run" {
      let right = expression(gen, tree, second)
      let result = temp(gen, tree, ty, String.from("{{0}}"))
      if name == "std__fs__write" {
        line(gen, "if (sc_write_file({text_view(left)}, {text_view(right)}, &{result.code}.v2.p0.m6d657373616765)) {{")
        line(gen, "{result.code}.tag = 1; {result.code}.v1.p0 = {text_view(right)}.n;")
      } else {
        let args = "({right.code})"
        let output = "{result.code}.v1.p0"
        line(gen, "if (sc_run_process({text_view(left)}, {args}.d, {args}.len, &{output}.m737461747573.m636f6465, &{output}.m737461747573.m7369676e616c, &{output}.m7374646f7574, &{output}.m737464657272, &{result.code}.v2.p0.m6d657373616765)) {{")
        line(gen, "{result.code}.tag = 1;")
      }
      line(gen, "}} else {{ {result.code}.tag = 2; }}")
      return move result
    }
    if name == "std__fmt_lit" || name == "std__fmt_val" {
      let saved = temp(gen, tree, left.ty, transfer(gen, tree, left))
      let right = expression(gen, tree, second)
      append_show(gen, tree, saved, right)
      return move saved
    }
  }
  unsupported("bootstrap call {name}")
  return Value { ty: String.new(), code: String.new() }
}

fn schedule(gen: mut Generator, node: Int, owner: view String, sub: type_terms.Substitution) -> Int {
  let params = sub.values.join(", ")
  let key = "{node}:{owner}:{params}"
  for i in 0..gen.instances.len() {
    if gen.instances.at(i).key == key { return i }
  }
  if gen.instances.len() == 1024 { unsupported("too many function specializations") }
  let id = gen.instances.len()
  gen.instances.push(Instance { node: node, owner: String.from(owner), sub: move sub, key: move key })
  return id
}

fn method_matches(tree: view List<ast.AstNode>, method: view Method, owner: view String) -> Bool {
  if method.owner == owner { return true }
  if method.params < 0 { return false }
  let names = parameter_names(tree, method.params)
  var sub = type_terms.with_names(names)
  type_terms.bind(sub, method.owner, owner)
  let concrete = type_terms.substitute(method.owner, sub)
  return concrete == owner
}

fn trait_method(gen: view Generator, tree: view List<ast.AstNode>, owner: view String,
    trait_name: view String, name: view String) -> Int {
  for method in gen.methods {
    if method.trait_name == trait_name && method_matches(tree, method, owner) {
      let candidate = ast.name_at(tree, method.node, 0)
      if candidate == name { return method.node }
    }
  }
  return -1
}

fn match_method(gen: view Generator, tree: view List<ast.AstNode>, owner: view String,
    name: view String, has_receiver: Bool) -> Int {
  for method in gen.methods {
    if method.trait_name != "Drop" && (method.trait_name != "Equal" || name == "eq") && method_matches(tree, method, owner) {
      let candidate = ast.name_at(tree, method.node, 0)
      let params = ast.child(tree, method.node, 2)
      let has_self = tree.at(params).end > params + 1 && tree.at(params + 1).tag == "Self"
      if candidate == name && has_self == has_receiver { return method.node }
    }
  }
  return -1
}

fn by_reference(gen: view Generator, tree: view List<ast.AstNode>, ty: view String, mode: view String) -> Bool {
  return !ty.starts_with("Slice<") && (mode == "Mut" ||
    (mode == "View" && (drop_fn(gen, tree, ty).len() != 0 || ty.starts_with("$dyn<"))))
}

fn call_substitution(gen: view Generator, tree: view List<ast.AstNode>, fun: Int,
    owner: view String) -> type_terms.Substitution {
  var names = type_parameters(tree, fun)
  var pattern = String.new()
  for method in gen.methods {
    if method.node == fun && method.params >= 0 {
      for name in parameter_names(tree, method.params) { names.push(String.from(name)) }
      pattern = String.from(method.owner)
    }
  }
  var sub = type_terms.with_names(names)
  if pattern != "" { type_terms.bind(sub, pattern, owner) }
  return move sub
}

fn comparison_call(gen: mut Generator, tree: view List<ast.AstNode>, method: Int,
    left: view Value, right: view Value) -> String {
  let sub = call_substitution(gen, tree, method, left.ty)
  let instance = schedule(gen, method, left.ty, move sub)
  if by_reference(gen, tree, left.ty, String.from("View")) {
    return "F{instance}(&({left.code}), &({right.code}))"
  }
  return "F{instance}({left.code}, {right.code})"
}

// `xs.split_at(k, |left, right| body)` with a closure literal: the halves become slice locals and the
// body runs in place (it must not `return`).
fn emit_split_at(gen: mut Generator, tree: view List<ast.AstNode>, recv: Int, args: Int) -> Value {
  let source = expression(gen, tree, recv)
  let cut = expression(gen, tree, args + 1)
  let split = temp(gen, tree, String.from("Int"), cut.code)
  let node = tree.at(args + 1).end
  let params = ast.child(tree, node, 4)
  let block = ast.child(tree, node, 6)
  if tree.at(ast.child(tree, node, 1)).tag != "true" {
    for at in block..tree.at(block).end {
      if tree.at(at).tag == "Return" { unsupported("return inside a split_at closure") }
    }
  }
  let first_param = params + 1
  if first_param >= tree.at(params).end || tree.at(first_param).end >= tree.at(params).end ||
      tree.at(tree.at(first_param).end).end != tree.at(params).end { unsupported("split_at closure parameters") }
  let second_param = tree.at(first_param).end
  let element = type_terms.element(source.ty)
  let slice_type = type_terms.bracket(element, String.from("_"))
  prepare_type(gen, tree, source.ty)
  prepare_type(gen, tree, slice_type)
  let c = c_type(gen, tree, slice_type)
  let length = temp(gen, tree, String.from("Int"), sequence_length(source))
  line(gen, "if ({split.code} < 0 || {split.code} > {length.code}) nx_panic(\"index out of range\");")
  line(gen, "{{")
  gen.indent = gen.indent + 1
  let left = id_at(gen, first_param)
  let right = id_at(gen, second_param)
  gen.references.set(left, false)
  gen.references.set(right, false)
  line(gen, "{c} v{left} = sc_slice_{c}(({source.code}).d, {length.code}, 0, {split.code});")
  line(gen, "{c} v{right} = sc_slice_{c}(({source.code}).d, {length.code}, {split.code}, {length.code});")
  if tree.at(ast.child(tree, node, 1)).tag == "true" {
    let first = ast.child(tree, block, 0) + 1
    let value = expression(gen, tree, ast.child(tree, first, 0))
  } else { statement(gen, tree, block) }
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  return Value { ty: String.from("nothing"), code: String.new() }
}

fn extern_call(gen: mut Generator, tree: view List<ast.AstNode>, fun: Int, args: Int, ty: view String) -> Value {
  let name = ast.name_at(tree, fun, 0)
  var values = List<String>.new()
  var at = args + 1
  while at < tree.at(args).end {
    let value = expression(gen, tree, at)
    if value.ty == "Text" { values.push(String.from(value.code)) }
    else if integer_c(value.ty).len() != 0 || floating_c(value.ty).len() != 0 || value.ty == "Bool" || value.ty == "Char" ||
        value.ty.starts_with("Ptr<") {
      values.push("({value.code})")
    } else { unsupported("extern argument of type {value.ty}") }
    at = tree.at(at).end
  }
  let joined = values.join(", ")
  return temp(gen, tree, ty, "(({c_type(gen, tree, ty)}){name}({joined}))")
}

fn emit_call(gen: mut Generator, tree: view List<ast.AstNode>, fun: Int, owner: view String,
    args: Int, receiver: Int, ty: view String) -> Value {
  let skip_args = gen.no_args
  gen.no_args = false
  if gen.externs.contains(fun) { return extern_call(gen, tree, fun, args, ty) }
  let params = ast.child(tree, fun, 2)
  var sub = call_substitution(gen, tree, fun, owner)
  var nodes = List<Int>.new()
  var forms = List<String>.new()
  var modes = List<String>.new()
  var formal = params + 1
  if receiver >= 0 && tree.at(formal).tag == "Self" {
    nodes.push(receiver)
    forms.push(String.from(owner))
    modes.push(String.from(tree.at(ast.child(tree, formal, 0)).tag))
    formal = tree.at(formal).end
  } else if receiver >= 0 {
    // a free function called with method syntax: the receiver is its first argument
    let expected = declared_type(tree, ast.child(tree, formal, 2))
    let inferred = type_terms.substitute(gen.checked.expressions.at(receiver), gen.sub)
    type_terms.bind(sub, expected, inferred)
    forms.push(move expected)
    modes.push(String.from(tree.at(ast.child(tree, formal, 1)).tag))
    nodes.push(receiver)
    formal = tree.at(formal).end
  }
  var actual = args + 1
  var stop = tree.at(args).end
  if skip_args { stop = actual }
  while actual < stop && formal < tree.at(params).end {
    let expected = declared_type(tree, ast.child(tree, formal, 2))
    var inferred = type_terms.substitute(gen.checked.expressions.at(actual), gen.sub)
    if expected.starts_with("Slice<") {
      inferred = type_terms.bracket(type_terms.element(inferred), String.from("_"))
    }
    type_terms.bind(sub, expected, inferred)
    forms.push(move expected)
    modes.push(String.from(tree.at(ast.child(tree, formal, 1)).tag))
    nodes.push(actual)
    actual = tree.at(actual).end
    formal = tree.at(formal).end
  }
  if actual != stop || formal != tree.at(params).end { unsupported("function arity") }
  type_terms.bind(sub, declared_type(tree, ast.child(tree, fun, 3)), ty)
  for value in sub.values { if value == "?" { unsupported("generic argument inference") } }

  var values = List<String>.new()
  var borrows = List<Bool>.new()
  for i in 0..nodes.len() {
    let expected = type_terms.substitute(forms.at(i), sub)
    prepare_type(gen, tree, expected)
    let by_ref = by_reference(gen, tree, expected, modes.at(i))
    let deferred = (by_ref || expected.starts_with("Slice<")) && is_place(gen, tree, nodes.at(i))
    values.push(String.new())
    borrows.push(deferred)
    if !deferred {
      let arg = call_argument(gen, tree, nodes.at(i), expected, by_ref)
      values.set(i, move arg)
    }
  }
  for i in 0..nodes.len() {
    if borrows.at(i) {
      let expected = type_terms.substitute(forms.at(i), sub)
      let by_ref = by_reference(gen, tree, expected, modes.at(i))
      let arg = call_argument(gen, tree, nodes.at(i), expected, by_ref)
      values.set(i, move arg)
    }
  }
  let instance = schedule(gen, fun, owner, move sub)
  let list = values.join(", ")
  return temp(gen, tree, ty, "F{instance}({list})")
}

fn call_argument(gen: mut Generator, tree: view List<ast.AstNode>,
    node: Int, expected: view String, by_ref: Bool) -> String {
  var operand = expression(gen, tree, node)
  if expected.starts_with("Slice<") && operand.ty != expected {
    operand = slice_value(gen, tree, operand, expected, String.from("0"), sequence_length(operand))
  }
  let arg = coerce(gen, tree, move operand, expected)
  if by_ref {
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "__auto_type t{id} = &({arg.code});")
    return "t{id}"
  }
  let saved = temp(gen, tree, expected, transfer(gen, tree, arg))
  return transfer(gen, tree, saved)
}

fn sequence_length(value: view Value) -> String {
  if value.ty.starts_with("Array<") {
    let args = type_terms.arguments(value.ty)
    return String.from(args.at(1))
  }
  return "({value.code}).len"
}

fn slice_value(gen: mut Generator, tree: view List<ast.AstNode>, seq: view Value,
    ty: view String, lo: view String, hi: view String) -> Value {
  let element = type_terms.element(seq.ty)
  if element == "?" { unsupported("slice of {seq.ty}") }
  prepare_type(gen, tree, ty)
  let c = c_type(gen, tree, ty)
  let length = sequence_length(seq)
  return temp(gen, tree, ty, "sc_slice_{c}(({seq.code}).d, {length}, {lo}, {hi})")
}

fn sort_comparator(gen: mut Generator, tree: view List<ast.AstNode>, elem: view String) -> Int {
  let existing = gen.sorted_elements.index_of(elem)
  if existing >= 0 { return existing }
  let id = gen.sorted_elements.len()
  gen.sorted_elements.push(String.from(elem))
  let c = c_type(gen, tree, elem)
  let method = trait_method(gen, tree, elem, String.from("Ordered"), String.from("cmp"))
  var comparison = String.new()
  if method >= 0 {
    let instance = schedule(gen, method, elem, call_substitution(gen, tree, method, elem))
    var param = String.from(c)
    if by_reference(gen, tree, elem, String.from("View")) {
      param = "{c} *"
      comparison = "F{instance}(a, b)"
    } else { comparison = "F{instance}(*a, *b)" }
    global(gen, "static int64_t F{instance}({param}, {param});")
  } else if elem == "String" {
    comparison = String.from("sc_compare(nx_str_view(a), nx_str_view(b))")
  } else if elem == "Text" {
    comparison = String.from("sc_compare(nx_str_text(*a), nx_str_text(*b))")
  } else if floating_c(elem).len() != 0 {
    comparison = String.from("isnan(*a) || isnan(*b) ? (isnan(*a) != 0) - (isnan(*b) != 0) : (*a > *b) - (*a < *b)")
  } else if integer_c(elem).len() != 0 || elem == "Bool" {
    comparison = String.from("(*a > *b) - (*a < *b)")
  } else { unsupported("Ordered for {elem}") }
  global(gen, "static int sc_compare_sort_{id}(const void *left, const void *right) {{")
  global(gen, "  {c} *a = ({c} *)left;")
  global(gen, "  {c} *b = ({c} *)right;")
  global(gen, "  int64_t order = {comparison}; return (order > 0) - (order < 0); }}")
  return id
}

fn sequence_method(gen: mut Generator, tree: view List<ast.AstNode>, receiver: view Value,
    name: view String, args: Int, ty: view String) -> Value {
  prepare_type(gen, tree, receiver.ty)
  let c = c_type(gen, tree, receiver.ty)
  let elem = type_terms.element(receiver.ty)
  let list = receiver.ty == "List" || receiver.ty.starts_with("List<")
  let addr = "&({receiver.code})"
  let first = args + 1
  let end = tree.at(args).end
  if first == end {
    if name == "len" { return temp(gen, tree, ty, sequence_length(receiver)) }
    if name == "is_empty" { return temp(gen, tree, ty, "{sequence_length(receiver)} == 0") }
    if list && name == "sort" {
      let comparator = sort_comparator(gen, tree, elem)
      let data = "({receiver.code}).d"
      let length = sequence_length(receiver)
      return temp(gen, tree, ty, "if ({length} > 1) qsort({data}, {length}, sizeof(*{data}), sc_compare_sort_{comparator})")
    }
    if name == "is_sorted" {
      let ok = temp(gen, tree, String.from("Bool"), String.from("true"))
      let id = gen.temp
      gen.temp = id + 1
      let length = temp(gen, tree, String.from("Int"), sequence_length(receiver))
      var inversion = String.new()
      if elem == "String" {
        inversion = "sc_compare(nx_str_view(&({receiver.code}).d[i{id}]), nx_str_view(&({receiver.code}).d[i{id} - 1])) < 0"
      } else if integer_c(elem).len() != 0 || floating_c(elem).len() != 0 {
        inversion = "({receiver.code}).d[i{id}] < ({receiver.code}).d[i{id} - 1]"
      } else { unsupported("is_sorted for {elem}") }
      line(gen, "for (int64_t i{id} = 1; i{id} < {length.code}; ++i{id}) {{")
      line(gen, "if ({inversion}) {{ {ok.code} = false; break; }} }}")
      return move ok
    }
    if list && name == "reverse" { return temp(gen, tree, ty, "sc_reverse_{c}({addr})") }
    if list && name == "copy" && drop_fn(gen, tree, elem).len() == 0 {
      return temp(gen, tree, ty, "sc_copy_range_{c}({addr}, 0, ({receiver.code}).len)")
    }
    if list && name == "pop" { return temp(gen, tree, ty, "sc_pop_{c}({addr})") }
    if list && name == "clear" { return temp(gen, tree, ty, "sc_clear_{c}({addr})") }
    unsupported("sequence method {name}")
  }
  let arg = expression(gen, tree, first)
  if list && name == "extend" && tree.at(first).end == end {
    let value = coerce(gen, tree, move arg, receiver.ty)
    return temp(gen, tree, ty, "sc_extend_{c}({addr}, {transfer(gen, tree, value)})")
  }
  if list && (name == "remove" || name == "swap_remove") && tree.at(first).end == end {
    let swap = name == "swap_remove"
    return temp(gen, tree, ty, "sc_remove_{c}({addr}, {arg.code}, {swap})")
  }
  if list && name == "join" && elem == "String" && tree.at(first).end == end {
    return temp(gen, tree, ty, "sc_join_{c}({addr}, {text_view(arg)})")
  }
  if list && (name == "index_of" || name == "contains") && tree.at(first).end == end {
    let found = temp(gen, tree, String.from("Int"), String.from("-1"))
    let id = gen.temp
    gen.temp = id + 1
    var compare = String.new()
    if elem == "String" { compare = "sc_compare(nx_str_view(&({receiver.code}).d[i{id}]), {text_view(arg)}) == 0" }
    else if integer_c(elem).len() != 0 || elem == "Bool" { compare = "({receiver.code}).d[i{id}] == {arg.code}" }
    else if elem.starts_with("Array<") && simple_elements(elem) {
      // fixed arrays of integers have no padding: compare the bytes
      let wanted = temp(gen, tree, arg.ty, arg.code)
      compare = "memcmp(&({receiver.code}).d[i{id}], &{wanted.code}, sizeof({wanted.code})) == 0"
    }
    else { unsupported("list search for {elem}") }
    line(gen, "for (int64_t i{id} = 0; i{id} < ({receiver.code}).len; ++i{id}) {{")
    line(gen, "if ({compare}) {{ {found.code} = i{id}; break; }} }}")
    if name == "contains" { return temp(gen, tree, ty, "{found.code} >= 0") }
    return move found
  }
  if list && name == "push" && tree.at(first).end == end {
    let value = coerce(gen, tree, move arg, elem)
    return temp(gen, tree, ty, "sc_push_{c}({addr}, {transfer(gen, tree, value)})")
  }
  let arg_element = type_terms.element(arg.ty)
  if (name == "eq" || name == "cmp") && arg_element != "?" {
    var op = String.from("==")
    if name == "cmp" { op = String.from("cmp") }
    return sequence_compare(gen, tree, op, receiver, arg, elem, ty)
  }
  if !type_terms.compatible(arg.ty, String.from("Int")) { unsupported("non-Int sequence index") }
  if list && name == "truncate" && tree.at(first).end == end {
    return temp(gen, tree, ty, "sc_truncate_{c}({addr}, {arg.code})")
  }
  let index = temp(gen, tree, arg.ty, arg.code)
  var stamped = String.from(index.code)
  if gen.site != 0 { stamped = "(nx_cur_loc = {gen.site}, {index.code})" }
  let dest = "(*sc_at_{c}({addr}, {stamped}))"
  let second = tree.at(first).end
  if second == end {
    if name == "at" { return Value { ty: move elem, code: move dest } }
    if name == "get" && drop_fn(gen, tree, elem).len() == 0 {
      return temp(gen, tree, elem, dest)
    }
    unsupported("sequence method {name} on {receiver.ty}")
  }
  if tree.at(second).end != end { unsupported("sequence method arity") }
  let right = expression(gen, tree, second)
  if list && name == "slice" && drop_fn(gen, tree, elem).len() == 0 {
    return temp(gen, tree, ty, "sc_copy_range_{c}({addr}, {index.code}, {right.code})")
  }
  if list && name == "insert" {
    let value = coerce(gen, tree, move right, elem)
    return temp(gen, tree, ty, "sc_insert_{c}({addr}, {index.code}, {transfer(gen, tree, value)})")
  }
  if name == "set" {
    let value = coerce(gen, tree, move right, elem)
    let drop = drop_fn(gen, tree, elem)
    if drop != "" { line(gen, "{drop}(&{dest});") }
    line(gen, "{dest} = {transfer(gen, tree, value)};")
  } else if name == "swap" && right.ty == "Int" {
    let other = temp(gen, tree, right.ty, right.code)
    let rhs = "(*sc_at_{c}({addr}, {other.code}))"
    let element_c = c_type(gen, tree, elem)
    line(gen, "{{ {element_c} swap = {dest}; {dest} = {rhs}; {rhs} = swap; }}")
  } else { unsupported("sequence method {name}") }
  return Value { ty: String.from("nothing"), code: String.new() }
}

fn array_literal(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let result = temp(gen, tree, ty, String.from("{{0}}"))
  let elem = type_terms.element(ty)
  if tree.at(node).tag == "ArrayFill" {
    let expr = expression(gen, tree, ast.child(tree, node, 0))
    let value = coerce(gen, tree, move expr, elem)
    let count = sequence_length(result)
    line(gen, "for (int64_t i = 0; i < {count}; ++i) {result.code}.d[i] = {value.code};")
  } else {
    let items = ast.child(tree, node, 0)
    var at = items + 1
    var i = 0
    while at < tree.at(items).end {
      let expr = expression(gen, tree, at)
      let value = coerce(gen, tree, move expr, elem)
      line(gen, "{result.code}.d[{i}] = {transfer(gen, tree, value)};")
      i = i + 1
      at = tree.at(at).end
    }
  }
  return move result
}

fn clone_value(gen: mut Generator, tree: view List<ast.AstNode>, source: view Value) -> Value {
  let ty = String.from(source.ty)
  if ty == "String" { return temp(gen, tree, ty, "nx_str_from({text_view(source)})") }
  if integer_c(ty).len() != 0 || ty == "Bool" || ty == "Text" {
    return temp(gen, tree, ty, source.code)
  }
  let base = type_terms.base(ty)
  prepare_type(gen, tree, ty)
  if base == "List" {
    let result = temp(gen, tree, ty, String.from("{{0}}"))
    let c = c_type(gen, tree, ty)
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "for (int64_t i{id} = 0; i{id} < ({source.code}).len; ++i{id}) {{")
    gen.indent = gen.indent + 1
    let entry = Value { ty: type_terms.element(ty), code: "({source.code}).d[i{id}]" }
    let copied = clone_value(gen, tree, entry)
    line(gen, "sc_push_{c}(&{result.code}, {transfer(gen, tree, copied)});")
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return move result
  }
  if base == "Array" {
    let result = temp(gen, tree, ty, String.from("{{0}}"))
    let id = gen.temp
    gen.temp = id + 1
    line(gen, "for (int64_t i{id} = 0; i{id} < {sequence_length(source)}; ++i{id}) {{")
    gen.indent = gen.indent + 1
    let entry = Value { ty: type_terms.element(ty), code: "({source.code}).d[i{id}]" }
    let copied = clone_value(gen, tree, entry)
    line(gen, "{result.code}.d[i{id}] = {transfer(gen, tree, copied)};")
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    return move result
  }
  let user_clone = match_method(gen, tree, ty, String.from("clone"), true)
  if user_clone >= 0 {
    let sub = call_substitution(gen, tree, user_clone, ty)
    let instance = schedule(gen, user_clone, ty, move sub)
    var arg = String.from(source.code)
    if drop_fn(gen, tree, ty).len() != 0 { arg = "&({arg})" }
    return temp(gen, tree, ty, "F{instance}({arg})")
  }
  if !gen.clone_types.contains(base) && base != "Option" && base != "Result" && !base.starts_with("$tuple") {
    unsupported("Clone for {ty}")
  }
  let result = temp(gen, tree, ty, String.from("{{0}}"))
  let layout = enum_index(gen, ty)
  if layout >= 0 {
    line(gen, "{result.code}.tag = ({source.code}).tag;")
    let count = gen.enum_layouts.at(layout).variants.len()
    for slot in 1..=count {
      let count = gen.enum_layouts.at(layout).variants.at(slot - 1).payload.len()
      if count > 0 {
        line(gen, "if ({result.code}.tag == {slot}) {{")
        gen.indent = gen.indent + 1
        for i in 0..count {
          let payload = enum_payload(gen, source, slot, i)
          let copied = clone_value(gen, tree, payload)
          line(gen, "{result.code}.v{slot}.p{i} = {transfer(gen, tree, copied)};")
        }
        gen.indent = gen.indent - 1
        line(gen, String.from("}}"))
      }
    }
  } else {
    let decl = find_named(tree, gen.structs, base)
    if decl < 0 { unsupported("Clone for {ty}") }
    let sub = nominal_sub(tree, decl, ty)
    let fields = ast.child(tree, decl, 2)
    var at = fields + 1
    while at < tree.at(fields).end {
      let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
      let field = Value {
        ty: declared_for(tree, ast.child(tree, at, 1), sub), code: "({source.code}).m{name}",
      }
      let copied = clone_value(gen, tree, field)
      line(gen, "{result.code}.m{name} = {transfer(gen, tree, copied)};")
      at = tree.at(at).end
    }
    let layout = struct_index(gen, ty)
    if gen.struct_layouts.at(layout).destructor { line(gen, "{result.code}.sc_live = true;") }
  }
  return move result
}

fn dyn_methods(gen: view Generator, tree: view List<ast.AstNode>, trait_name: view String) -> Int {
  let decl = find_named(tree, gen.traits, trait_name)
  if decl < 0 { unsupported("unknown dyn trait {trait_name}") }
  return ast.child(tree, decl, 1)
}

fn dyn_table(gen: mut Generator, tree: view List<ast.AstNode>, trait_name: view String,
    owner: view String) -> Int {
  let key = "{trait_name}:{owner}"
  let found = gen.dyn_tables.index_of(key)
  if found >= 0 { return found }
  let id = gen.dyn_tables.len()
  gen.dyn_tables.push(move key)
  let methods = dyn_methods(gen, tree, trait_name)
  let concrete = c_type(gen, tree, owner)
  var slots = List<String>.new()
  var self_type = List<String>.new()
  self_type.push(String.from("Self"))
  var at = methods + 1
  while at < tree.at(methods).end {
    let name = ast.name_at(tree, at, 0)
    let generics = ast.child(tree, at, 1)
    let params = ast.child(tree, at, 2)
    let receiver = params + 1
    if tree.at(generics).end != generics + 1 || receiver >= tree.at(params).end ||
        tree.at(receiver).tag != "Self" { unsupported("dyn method {name} signature") }
    let mode = String.from(tree.at(ast.child(tree, receiver, 0)).tag)
    if mode != "View" && mode != "Mut" { unsupported("dyn method {name} receiver") }
    let result = declared_type(tree, ast.child(tree, at, 3))
    if type_terms.mentions(result, self_type) { unsupported("dyn method {name} result") }
    prepare_type(gen, tree, result)
    let ret = c_type(gen, tree, result)
    var signature = String.from("void *receiver")
    var values = List<String>.new()
    if by_reference(gen, tree, owner, mode) { values.push("({concrete} *)receiver") }
    else { values.push("*({concrete} *)receiver") }
    var param = tree.at(receiver).end
    while param < tree.at(params).end {
      let argument = types.Parameter {
        mode: String.from(tree.at(ast.child(tree, param, 1)).tag),
        ty: declared_type(tree, ast.child(tree, param, 2)),
      }
      if type_terms.mentions(argument.ty, self_type) { unsupported("dyn method {name} parameter") }
      let c = parameter_c(gen, tree, argument)
      let ordinal = values.len()
      signature.push_str(", {c} a{ordinal}")
      values.push("a{ordinal}")
      param = tree.at(param).end
    }
    let implementation = trait_method(gen, tree, owner, trait_name, name)
    if implementation < 0 { unsupported("{owner} does not implement {trait_name}.{name}") }
    let instance = schedule(gen, implementation, owner, call_substitution(gen, tree, implementation, owner))
    let slot = slots.len()
    let values = values.join(", ")
    gen.wrappers.push_str("static {ret} D{id}_{slot}({signature}) {{ return F{instance}({values}); }}\n")
    slots.push("(NxDynSlot)D{id}_{slot}")
    at = tree.at(at).end
  }
  let entries = slots.join(", ")
  gen.wrappers.push_str("static const NxDynSlot sc_vtable_{id}[] = {{ {entries} }};\n")
  return id
}

fn box_new(gen: mut Generator, tree: view List<ast.AstNode>, args: Int, ty: view String) -> Value {
  let value = expression(gen, tree, args + 1)
  let inner = type_terms.box_payload(ty)
  let trait_name = type_terms.dyn_trait(inner)
  var concrete = String.from(inner)
  if trait_name != "" { concrete = String.from(value.ty) }
  let value = coerce(gen, tree, move value, concrete)
  if concrete.starts_with("Slice<") || concrete == "nothing" { unsupported("Box payload {concrete}") }
  prepare_type(gen, tree, concrete)
  let c = c_type(gen, tree, concrete)
  let cleanup = heap_drop(gen, tree, concrete)
  let id = gen.temp
  gen.temp = gen.temp + 1
  line(gen, "ScBox b{id} = sc_box_new(sizeof({c}), {cleanup});")
  line(gen, "*({c} *)b{id}->data = {transfer(gen, tree, value)};")
  if trait_name != "" {
    let table = dyn_table(gen, tree, trait_name, concrete)
    return temp(gen, tree, ty, "(ScDyn){{ b{id}, sc_vtable_{table} }}")
  }
  return temp(gen, tree, ty, "b{id}")
}

fn dyn_call(gen: mut Generator, tree: view List<ast.AstNode>, receiver: Int, trait_name: view String,
    name: view String, args: Int, ty: view String) -> Value {
  let methods = dyn_methods(gen, tree, trait_name)
  var at = methods + 1
  var slot = 0
  while at < tree.at(methods).end {
    let method = ast.name_at(tree, at, 0)
    if method == name { break }
    slot = slot + 1
    at = tree.at(at).end
  }
  if at >= tree.at(methods).end { unsupported("dyn method {trait_name}.{name}") }
  let params = ast.child(tree, at, 2)
  var arg = args + 1
  var param = tree.at(params + 1).end
  var values = List<String>.new()
  var c_types = List<String>.new()
  var deferred = List<Int>.new()
  c_types.push(String.from("void *"))
  let id = gen.temp
  gen.temp = gen.temp + 1
  values.push("d{id}->box->data")
  while param < tree.at(params).end && arg < tree.at(args).end {
    let argument = types.Parameter {
      mode: String.from(tree.at(ast.child(tree, param, 1)).tag),
      ty: declared_type(tree, ast.child(tree, param, 2)),
    }
    c_types.push(parameter_c(gen, tree, argument))
    let ref = by_reference(gen, tree, argument.ty, argument.mode)
    if is_place(gen, tree, arg) && (ref || argument.ty.starts_with("Slice<")) {
      deferred.push(arg)
      values.push(String.new())
    } else {
      deferred.push(-1)
      values.push(call_argument(gen, tree, arg, argument.ty, ref))
    }
    arg = tree.at(arg).end
    param = tree.at(param).end
  }
  if param != tree.at(params).end || arg != tree.at(args).end { unsupported("dyn method arity") }
  // By-value arguments are evaluated before a receiver projection borrows its storage.
  let object = expression(gen, tree, receiver)
  param = tree.at(params + 1).end
  for index in 0..deferred.len() {
    let at = deferred.at(index)
    if at >= 0 {
      let expected = declared_type(tree, ast.child(tree, param, 2))
      let mode = String.from(tree.at(ast.child(tree, param, 1)).tag)
      values.set(index + 1, call_argument(gen, tree, at, expected, by_reference(gen, tree, expected, mode)))
    }
    param = tree.at(param).end
  }
  line(gen, "ScDyn *d{id} = &({object.code});")
  prepare_type(gen, tree, ty)
  let c = c_type(gen, tree, ty)
  return temp(gen, tree, ty, "(({c} (*)({c_types.join(", ")}))d{id}->table[{slot}])({values.join(", ")})")
}

fn string_method(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let recv = ast.child(tree, node, 0)
  let name = ast.name_at(tree, node, 1)
  let args = ast.child(tree, node, 2)
  var owner = String.new()
  if tree.at(recv).tag == "Var" { owner = ast.name_at(tree, recv, 0) }
  var actual = args + 1
  var values = List<String>.new()
  var helper = String.new()
  let is_static = owner != "" && gen.locals.identities.at(recv) < 0
  var receiver_type = type_terms.substitute(gen.checked.expressions.at(recv), gen.sub)
  if is_static { receiver_type = String.from(owner) }
  if !is_static && receiver_type.starts_with("JoinHandle<") && name == "join" {
    let handle = expression(gen, tree, recv)
    let payload = receiver_type.slice(11, receiver_type.len() - 1)
    prepare_type(gen, tree, ty)
    let result = temp(gen, tree, ty, String.from("{{0}}"))
    let id = gen.temp
    gen.temp = gen.temp + 1
    let c = c_type(gen, tree, payload)
    line(gen, "ScBox b{id} = (ScBox)(intptr_t)nx_thread_wait({transfer(gen, tree, handle)});")
    line(gen, "if (b{id}) {{ {result.code}.tag = 1; {result.code}.v1.p0 = *({c} *)b{id}->data; free(b{id}); }}")
    line(gen, "else {{ {result.code}.tag = 2; }}")
    return move result
  }
  if is_static && owner == "Box" && name == "new" && !gen.user_box { return box_new(gen, tree, args, ty) }
  var inner = String.from("?")
  if !gen.user_box { inner = type_terms.box_payload(receiver_type) }
  if !is_static && inner != "?" && (name == "get" || name == "take") {
    let box = expression(gen, tree, recv)
    if inner.starts_with("$dyn<") {
      if name == "take" { unsupported("taking a dyn Box payload") }
      return Value { ty: String.from(ty), code: String.from(box.code) }
    }
    prepare_type(gen, tree, inner)
    let c = c_type(gen, tree, inner)
    if name == "get" { return Value { ty: String.from(ty), code: "(*({c} *)({box.code})->data)" } }
    let id = gen.temp
    gen.temp = gen.temp + 1
    line(gen, "ScBox b{id} = {transfer(gen, tree, box)};")
    let taken = temp(gen, tree, ty, "*({c} *)b{id}->data")
    line(gen, "free(b{id});")
    return move taken
  }
  var trait_name = type_terms.dyn_trait(receiver_type)
  if inner != "?" { trait_name = type_terms.dyn_trait(inner) }
  if !is_static && trait_name != "" { return dyn_call(gen, tree, recv, trait_name, name, args, ty) }
  if !is_static && is_place(gen, tree, recv) && name != "at" {
    let structure = find_named(tree, gen.structs, type_terms.base(receiver_type))
    if structure >= 0 {
      let name_token = String.from(tree.at(ast.child(tree, node, 1)).tag)
      let fields = ast.child(tree, structure, 2)
      var field = fields + 1
      while field < tree.at(fields).end {
        let field_name = String.from(tree.at(ast.child(tree, field, 0)).tag)
        if field_name == name_token {
          let sub = nominal_sub(tree, structure, receiver_type)
          let signature = declared_for(tree, ast.child(tree, field, 1), sub)
          if signature.starts_with("fn(") {
            let receiver = expression(gen, tree, recv)
            let callee = Value { ty: String.from(signature), code: "({receiver.code}).m{field_name}" }
            return indirect_call(gen, tree, callee, args, ty)
          }
          break
        }
        field = tree.at(field).end
      }
    }
  }
  if is_static && owner == "Char" && (name == "from_int" || name == "is_valid") {
    let value = expression(gen, tree, actual)
    var helper = String.from("nx_char_valid")
    if name == "from_int" { helper = String.from("nx_char_from_int") }
    return temp(gen, tree, ty, "{helper}({value.code})")
  }
  if is_static && (name == "from" || name == "try_from") {
    let target = ast.alias_target(tree, owner)
    if target >= 0 {
      let range = declared_type(tree, target)
      if range.starts_with("Int<") { return range_conversion(gen, tree, actual, range, ty, -1) }
    }
  }
  var method = match_method(gen, tree, receiver_type, name, !is_static)
  if method < 0 && !is_static && name != "into_iter" && name != "next" {
    // a user iterator uses the Iter adapters through its `into_iter`: `it.map(f)` is `it.into_iter().map(f)`
    let into = match_method(gen, tree, receiver_type, "into_iter", true)
    if into >= 0 && match_method(gen, tree, receiver_type, "next", true) >= 0 {
      let into_sub = call_substitution(gen, tree, into, receiver_type)
      let iter_type = type_terms.substitute(declared_type(tree, ast.child(tree, into, 3)), into_sub)
      gen.no_args = true
      let converted = emit_call(gen, tree, into, receiver_type, args, recv, iter_type)
      gen.override_node = recv
      gen.override_ty = String.from(iter_type)
      gen.override_code = String.from(converted.code)
      let before = String.from(gen.checked.expressions.at(recv))
      gen.checked.expressions.set(recv, String.from(iter_type))
      let own = match_method(gen, tree, iter_type, name, true)
      let adapter = find_named(tree, gen.functions, "std__iter_{name}")
      var adapted = Value { ty: String.new(), code: String.new() }
      if own >= 0 { adapted = emit_call(gen, tree, own, iter_type, args, recv, ty) }
      else if adapter >= 0 { adapted = emit_call(gen, tree, adapter, String.new(), args, recv, ty) }
      else { unsupported("iterator method {name} on {receiver_type}") }
      gen.checked.expressions.set(recv, move before)
      return move adapted
    }
  }
  if method < 0 && !is_static {
    let free = find_named(tree, gen.functions, "std__iter_{name}")
    if free >= 0 { return emit_call(gen, tree, free, String.new(), args, recv, ty) }
  }
  if method >= 0 {
    var actual_receiver = recv
    if is_static { actual_receiver = -1 }
    return emit_call(gen, tree, method, receiver_type, args, actual_receiver, ty)
  }
  if !is_static && name == "show" && tree.at(args).end == args + 1 {
    let value = expression(gen, tree, recv)
    let shown = temp(gen, tree, ty, String.from("nx_str_new()"))
    append_show(gen, tree, shown, value)
    return move shown
  }
  if !is_static && name == "clone" && tree.at(args).end == args + 1 {
    let value = expression(gen, tree, recv)
    return clone_value(gen, tree, value)
  }
  let result_base = type_terms.base(ty)
  if owner != "" && gen.locals.identities.at(recv) < 0 && result_base == owner &&
      (owner == "Option" || owner == "Result" || find_named(tree, gen.enums, owner) >= 0) {
    return construct_variant(gen, tree, ty, name, args)
  }
  if owner == "List" && gen.locals.identities.at(recv) < 0 && name == "new" {
    return temp(gen, tree, ty, String.from("{{0}}"))
  }
  if tree.at(recv).tag == "Var" && gen.locals.identities.at(recv) < 0 &&
      owner == "String" {
    if name != "new" && name != "from" && name != "concat" { unsupported("String.{name}") }
    helper = "nx_str_{name}"
    while actual < tree.at(args).end {
      let arg = expression(gen, tree, actual)
      values.push(text_view(arg))
      actual = tree.at(actual).end
    }
  } else {
    if (receiver_type == "String" || receiver_type == "Text") && (name == "cmp" || name == "eq") &&
        tree.at(args).end == args + 1 + (tree.at(args + 1).end - (args + 1)) && tree.at(args).end > args + 1 {
      let left = expression(gen, tree, recv)
      let right = expression(gen, tree, args + 1)
      let order = temp(gen, tree, String.from("Int"), "sc_compare({text_view(left)}, {text_view(right)})")
      if name == "eq" { return temp(gen, tree, ty, "({order.code} == 0)") }
      return temp(gen, tree, ty, "({order.code} < 0 ? -1 : {order.code} > 0 ? 1 : 0)")
    }
    if receiver_type == "String" {
      return emit_string_method(gen, tree, recv, args, name, ty)
    }
    if receiver_type == "Char" && name == "utf8_len" {
      let value = expression(gen, tree, recv)
      return temp(gen, tree, ty, "nx_char_utf8_len({value.code})")
    }
    if receiver_type == "Char" && name == "to_int" {
      let value = expression(gen, tree, recv)
      return Value { ty: String.from(ty), code: String.from(value.code) }
    }
    if (name == "split_at" || name == "split_at_mut") && tree.at(args).end > args + 1 &&
        tree.at(tree.at(args + 1).end).tag == "Closure" {
      return emit_split_at(gen, tree, recv, args)
    }
    if receiver_type.starts_with("Ptr<") && (name == "is_null" || name == "free") {
      let pointer = expression(gen, tree, recv)
      if name == "is_null" { return temp(gen, tree, ty, "(({pointer.code}) == 0)") }
      return temp(gen, tree, ty, "free((void *)({pointer.code}))")
    }
    let integer = integer_c(receiver_type)
    let float = floating_c(receiver_type)
    if integer != "" || float != "" {
      let target = types.numeric_conversion(name)
      if target != "?" {
        let value = expression(gen, tree, recv)
        return conversion(gen, tree, value, target, name.starts_with("truncate_"))
      }
      if types.math_arity(name) != 0 { return emit_math(gen, tree, name, args, recv, ty) }
      if name == "eq" {
        let left = expression(gen, tree, recv)
        let saved = temp(gen, tree, left.ty, left.code)
        let right = expression(gen, tree, actual)
        return temp(gen, tree, ty, "({saved.code} == {right.code})")
      }
      if name == "cmp" {
        let left = expression(gen, tree, recv)
        let saved = temp(gen, tree, left.ty, left.code)
        let right = expression(gen, tree, actual)
        let other = temp(gen, tree, right.ty, right.code)
        let a = String.from(saved.code)
        let b = String.from(other.code)
        if float != "" {
          return temp(gen, tree, ty, "({a} < {b} ? -1 : {a} > {b} ? 1 : {a} == {b} ? 0 : ({a} != {a} ? ({b} != {b} ? 0 : 1) : -1))")
        }
        return temp(gen, tree, ty, "({a} < {b} ? -1 : {a} > {b} ? 1 : 0)")
      }
      if name == "wrapping_add" || name == "wrapping_sub" || name == "wrapping_mul" {
        let left = expression(gen, tree, recv)
        let saved = temp(gen, tree, left.ty, left.code)
        let right = expression(gen, tree, actual)
        let op = name.slice(9, name.len())
        return temp(gen, tree, ty, "nx_w{op}{integer_suffix(ty)}({saved.code}, {right.code})")
      }
    }
    let receiver = expression(gen, tree, recv)
    let element = type_terms.element(receiver.ty)
    if element != "?" {
      return sequence_method(gen, tree, receiver, name, args, ty)
    }
    let receiver_base = type_terms.base(receiver.ty)
    if receiver_base == "Option" || receiver_base == "Result" {
      return option_result_method(gen, tree, receiver, name, args, ty)
    }
    unsupported("method {name} on {receiver.ty}")
  }
  let list = values.join(", ")
  return temp(gen, tree, ty, "{helper}({list})")
}

fn emit_string_method(gen: mut Generator, tree: view List<ast.AstNode>, recv: Int, args: Int,
    name: view String, ty: view String) -> Value {
  var helper = "nx_str_{name}"
  let text = name == "eq" || name == "push_str" || name == "replace" || name == "find" ||
    name == "starts_with" || name == "ends_with" || name == "contains" || name == "split"
  if name == "split" || name == "lines" {
    prepare_type(gen, tree, ty)
    helper = "sc_{name}_{c_type(gen, tree, ty)}"
  } else if name == "slice" || name == "trim" || name == "replace" || name == "find" ||
      name == "starts_with" || name == "ends_with" || name == "contains" || name == "parse_int" || name == "push_slice" || name == "find_from" ||
      name == "trim_start" || name == "trim_end" || name == "repeat" || name == "to_upper" ||
      name == "to_lower" || name == "char_count" || name == "is_boundary" || name == "is_empty" {
    helper = "sc_str_{name}"
  } else if name != "len" && name != "byte" && name != "eq" && name != "clear" &&
      name != "push_int" && name != "push_str" && name != "push_byte" &&
      name != "push_char" && name != "char_at" && name != "char_size" &&
      name != "raw_addr" && name != "push_raw" && name != "reserve" {
    unsupported("String.{name}")
  }
  var values = List<String>.new()
  var deferred = List<Int>.new()
  values.push(String.new())
  var at = args + 1
  while at < tree.at(args).end {
    let index = values.len()
    let argument_type = type_terms.substitute(gen.checked.expressions.at(at), gen.sub)
    let text_arg = text || ((name == "push_slice" || name == "find_from") && index == 1)
    if (text_arg && argument_type == "String" && is_place(gen, tree, at)) || name == "parse_int" {
      values.push(String.new())
      deferred.push(at)
    } else {
      let arg = expression(gen, tree, at)
      if text_arg { values.push(text_view(arg)) }
      else {
        let saved = temp(gen, tree, arg.ty, arg.code)
        values.push(String.from(saved.code))
      }
      deferred.push(-1)
    }
    at = tree.at(at).end
  }
  let receiver = expression(gen, tree, recv)
  values.set(0, "&({receiver.code})")
  for i in 0..deferred.len() {
    let at = deferred.at(i)
    if at >= 0 {
      let arg = expression(gen, tree, at)
      if name == "parse_int" { values.set(i + 1, "&({arg.code})") }
      else { values.set(i + 1, text_view(arg)) }
    }
  }
  let list = values.join(", ")
  return temp(gen, tree, ty, "{helper}({list})")
}

fn struct_literal(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) -> Value {
  let fields = ast.child(tree, node, 2)
  let value = temp(gen, tree, ty, String.from("{{0}}"))
  let structure = find_named(tree, gen.structs, type_terms.base(ty))
  let layout = struct_index(gen, ty)
  if layout >= 0 && gen.struct_layouts.at(layout).destructor { line(gen, "{value.code}.sc_live = true;") }
  if structure < 0 { unsupported("unknown struct {ty}") }
  let sub = nominal_sub(tree, structure, ty)
  let definitions = ast.child(tree, structure, 2)
  var at = fields + 1
  while at < tree.at(fields).end {
    let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
    var definition = definitions + 1
    while definition < tree.at(definitions).end {
      let id = ast.child(tree, definition, 0)
      if tree.at(id).tag == name { break }
      definition = tree.at(definition).end
    }
    if definition == tree.at(definitions).end { unsupported("unknown field of {ty}") }
    let expected = declared_for(tree, ast.child(tree, definition, 1), sub)
    let init = expression(gen, tree, ast.child(tree, at, 1))
    let field = coerce(gen, tree, move init, expected)
    line(gen, "{value.code}.m{name} = {transfer(gen, tree, field)};")
    at = tree.at(at).end
  }
  return move value
}

fn declared_member_owner(tree: view List<ast.AstNode>, node: Int, sub: view type_terms.Substitution) -> String {
  let name = ast.name_at(tree, node, 0)
  let list = ast.child(tree, node, 1)
  var args = List<String>.new()
  var at = list + 1
  while at < tree.at(list).end {
    args.push(declared_for(tree, at, sub))
    at = tree.at(at).end
  }
  return type_terms.apply(name, args)
}

fn range_conversion(gen: mut Generator, tree: view List<ast.AstNode>, input: Int,
    range: view String, result: view String, otherwise: Int) -> Value {
  if !range.starts_with("Int<") { unsupported("invalid range conversion") }
  let arg = expression(gen, tree, input)
  let saved = temp(gen, tree, arg.ty, arg.code)
  let wide = "((__int128){saved.code})"
  let limits = range.slice(4, range.len() - 1).split("..")
  var lo = String.from("INT64_MIN")
  var hi = String.from("INT64_MAX")
  if limits.at(0) != "" { lo = pattern_bound(limits.at(0)) }
  if limits.at(1) != "" { hi = pattern_bound(limits.at(1)) }
  let outside = "{wide} < {lo} || {wide} > {hi}"
  if result != range {
    prepare_type(gen, tree, result)
    let c = c_type(gen, tree, result)
    return temp(gen, tree, result,
      "{outside} ? ({c}){{ .tag = 2, .v2.p0 = (int64_t){wide} }} : ({c}){{ .tag = 1, .v1.p0 = (int64_t){wide} }}")
  }
  if otherwise < 0 || tree.at(otherwise).tag == "_" {
    return temp(gen, tree, range, "nx_to_range({wide}, {lo}, {hi})")
  }
  line(gen, "if ({outside})")
  statement(gen, tree, otherwise)
  return temp(gen, tree, range, "(int64_t){wide}")
}

// The `Pos(line,col)` the parser put as child `index` of a Method, Slice or Call (columns mode), as a location
// id of the program's table (0 = none). Sites in the prelude, past the user's lines, are skipped: a panic there
// reports the caller's site.
fn site_loc(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, index: Int) -> Int {
  if gen.at_file.len() == 0 { return 0 }
  var at = node + 1
  for k in 0..index {
    if at >= tree.at(node).end { return 0 }
    at = tree.at(at).end
  }
  if at >= tree.at(node).end || tree.at(at).tag != "Pos" { return 0 }
  var line = 0
  var col = 0
  let l = String.from(tree.at(at + 1).tag)
  let c = String.from(tree.at(at + 2).tag)
  if !l.parse_int(line) || !c.parse_int(col) { return 0 }
  if line > gen.user_lines { return 0 }
  let key = line * 65536 + col
  let existing = gen.locs.index_of(key)
  if existing >= 0 { return existing + 1 }
  gen.locs.push(key)
  return gen.locs.len()
}

// Which sites print `at file:line:col`, as in the Rust C backend's plain build: element access and mutation
// (at, get, set, swap, pop), unwrap/expect of an Option, explicit panic (unless its message is a built temporary)
// and assert; slices and chunks are handled where they are lowered.
fn reports_site(gen: view Generator, tree: view List<ast.AstNode>, node: Int) -> Bool {
  let name = ast.name_at(tree, node, 1)
  let receiver = type_terms.substitute(gen.checked.expressions.at(ast.child(tree, node, 0)), gen.sub)
  if name == "at" || name == "get" || name == "set" || name == "swap" || name == "pop" {
    let base = type_terms.base(receiver)
    return base == "List" || base == "Array" || base == "Slice"
  }
  if name == "unwrap" || name == "expect" { return receiver.starts_with("Option<") }
  return false
}

fn reports_call(gen: view Generator, tree: view List<ast.AstNode>, node: Int) -> Bool {
  let name = ast.name_at(tree, node, 0)
  if name == "assert" || name == "assert_eq" || name == "assert_ne" { return true }
  if name != "panic" { return false }
  let args = ast.child(tree, node, 1)
  return args + 1 < tree.at(args).end && tree.at(args + 1).tag != "Call"
}

// Run the C emitted since `mark` with `nx_cur_loc` set at the failing statements: every line that calls
// `nx_panic*` (not already preceded by a nested site's own stamp) and the last line (the operation itself, cleared
// afterwards). A value that emitted no line carries the stamp in its expression.
fn located(gen: mut Generator, value: Value, mark: Int, loc: Int) -> Value {
  if loc == 0 { return move value }
  if gen.out.len() == mark {
    return Value { ty: String.from(value.ty), code: "(nx_cur_loc = {loc}, {value.code})" }
  }
  let head = gen.out.slice(0, mark)
  let span = gen.out.slice(mark, gen.out.len())
  let rows = span.split("\n")
  var text = String.new()
  var previous_stamped = false
  var index = 0
  let last = rows.len() - 2
  for row in rows {
    if row.len() == 0 && index == rows.len() - 1 { break }
    var pad = String.new()
    var k = 0
    while k < row.len() && row.byte(k) == 32 { pad.push_str(" "); k = k + 1 }
    let trimmed = row.trim()
    let stamp = trimmed.starts_with("nx_cur_loc = ") && !trimmed.starts_with("nx_cur_loc = 0;")
    // a stamp never goes before `else` or a closing brace (it would split an if/else)
    let joins = trimmed.starts_with("else") || trimmed.starts_with("}}")
    let stamped_here = !stamp && !previous_stamped && !joins && (row.contains("nx_panic") || index == last)
    if stamped_here { text.push_str("{pad}nx_cur_loc = {loc};\n") }
    text.push_str(row)
    text.push_str("\n")
    if stamped_here && index == last { text.push_str("{pad}nx_cur_loc = 0;\n") }
    previous_stamped = stamp
    index = index + 1
  }
  gen.out = "{head}{text}"
  return move value
}

// A fixed array whose elements are integers or Bool (no padding, so bytes compare like values).
fn simple_elements(array: view String) -> Bool {
  let inner = type_terms.element(array)
  return integer_c(inner).len() != 0 || inner == "Bool"
}

fn expression(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) -> Value {
  if node == gen.override_node {
    // the receiver of an adapted user iterator was already converted by `into_iter`
    gen.override_node = -1
    return Value { ty: String.from(gen.override_ty), code: String.from(gen.override_code) }
  }
  let tag = String.from(tree.at(node).tag)
  let ty = type_terms.substitute(gen.checked.expressions.at(node), gen.sub)
  if tag == "IfExpr" || tag == "MatchExpr" {
    if ty == "?" || ty == "nothing" { unsupported("value of {tag}") }
    prepare_type(gen, tree, ty)
    let id = gen.temp
    gen.temp = id + 1
    let name = "t{id}"
    declare_local(gen, tree, ty, name, "({c_type(gen, tree, ty)}){{0}}")
    let saved_target = String.from(gen.value_target)
    let saved_type = String.from(gen.value_type)
    gen.value_target = String.from(name)
    gen.value_type = String.from(ty)
    statement(gen, tree, node)
    gen.value_target = move saved_target
    gen.value_type = move saved_type
    return Value { ty: String.from(ty), code: move name }
  }
  if tag == "Var" {
    if gen.locals.identities.at(node) < 0 {
      let name = ast.name_at(tree, node, 0)
      if name == "None" { return construct_variant(gen, tree, ty, name, -1) }
      let bound = gen.sub.names.index_of(name)
      // a `const K: Int` generic parameter used as a value: the length it was bound to
      if bound >= 0 && ty == "Int" { return Value { ty: String.from("Int"), code: String.from(gen.sub.values.at(bound)) } }
      let fun = find_named(tree, gen.functions, name)
      if fun >= 0 {
        let params = type_parameters(tree, fun)
        if params.len() != 0 { unsupported("generic function value {name}") }
        return function_value(gen, tree, fun, ty)
      }
      // a constant is its initializer, lowered where it is used
      for index in 0..gen.constants.len() {
        let item = gen.constants.at(index)
        let declared = ast.name_at(tree, item, 0)
        if declared == name {
          let init = expression(gen, tree, ast.child(tree, item, 2))
          let kind = ast.child(tree, item, 1)
          if tree.at(kind).tag == "_" { return init }
          return coerce(gen, tree, move init, declared_type(tree, kind))
        }
      }
    }
    return local_place(gen, node)
  }
  if tag == "Move" {
    let place = local_place(gen, node)
    if drop_fn(gen, tree, place.ty).len() != 0 {
      let moved = transfer(gen, tree, place)
      return temp(gen, tree, place.ty, moved)
    }
    return move place
  }
  if tag == "Text" { return Value { ty: String.from("Text"), code: quoted_text(tree, node) } }
  if tag == "Int" || tag == "NumT" || tag == "Char" || tag == "Float" { return number(tree, node, ty, false) }
  if tag == "Bool" { return Value { ty: move ty, code: String.from(tree.at(ast.child(tree, node, 0)).tag) } }
  if tag == "Cast" && ty.starts_with("Int<") {
    return range_conversion(gen, tree, ast.child(tree, node, 0), ty, ty, ast.child(tree, node, 2))
  }
  if tag == "Ascribe" {
    let value = expression(gen, tree, ast.child(tree, node, 1))
    return coerce(gen, tree, move value, ty)
  }
  if tag == "Field" {
    let recv = ast.child(tree, node, 0)
    if tree.at(recv).tag == "Var" && gen.locals.identities.at(recv) < 0 {
      let name = ast.name_at(tree, node, 1)
      return construct_variant(gen, tree, ty, name, -1)
    }
    let base = expression(gen, tree, ast.child(tree, node, 0))
    let field = String.from(tree.at(ast.child(tree, node, 1)).tag)
    return Value { ty: move ty, code: "({base.code}).m{field}" }
  }
  if tag == "StructLit" { return struct_literal(gen, tree, node, ty) }
  if tag == "Array" || tag == "ArrayFill" { return array_literal(gen, tree, node, ty) }
  if tag == "Slice" && gen.slice_node != node {
    let loc = site_loc(gen, tree, node, 3)
    if loc != 0 {
      let mark = gen.out.len()
      gen.slice_node = node
      let value = expression(gen, tree, node)
      gen.slice_node = -1
      return located(gen, move value, mark, loc)
    }
  }
  if tag == "Slice" {
    let seq = expression(gen, tree, ast.child(tree, node, 0))
    var lo = String.from("0")
    var hi = sequence_length(seq)
    let start = ast.child(tree, node, 1)
    let end = ast.child(tree, node, 2)
    if tree.at(start).tag != "_" {
      let value = expression(gen, tree, start)
      let bound = temp(gen, tree, value.ty, value.code)
      lo = String.from(bound.code)
    }
    if tree.at(end).tag != "_" {
      let bound = expression(gen, tree, end)
      hi = String.from(bound.code)
    }
    return slice_value(gen, tree, seq, ty, lo, hi)
  }
  if tag == "GenericMember" {
    let owner = ast.name_at(tree, node, 0)
    let member = ast.name_at(tree, node, 2)
    if owner == "Box" && member == "new" && !gen.user_box {
      return box_new(gen, tree, ast.child(tree, node, 3), ty)
    }
    if owner == "Int" && (member == "from" || member == "try_from") {
      let range = ast.range_type(tree, ast.child(tree, node, 1))
      return range_conversion(gen, tree, ast.child(tree, node, 3) + 1, range, ty, -1)
    }
    if owner == "Ptr" && member == "null" { return temp(gen, tree, ty, "(({c_type(gen, tree, ty)})0)") }
    if owner == "Ptr" && member == "alloc" {
      let count = expression(gen, tree, ast.child(tree, node, 3) + 1)
      let pointee = type_terms.arguments(ty)
      let element = c_type(gen, tree, pointee.at(0))
      return temp(gen, tree, ty, "(({c_type(gen, tree, ty)})nx_alloc(({count.code}) * sizeof({element})))")
    }
    if owner == "List" && member == "new" { return temp(gen, tree, ty, String.from("{{0}}")) }
    if owner == "Option" || owner == "Result" || find_named(tree, gen.enums, owner) >= 0 {
      return construct_variant(gen, tree, ty, member, ast.child(tree, node, 3))
    }
    let concrete = declared_member_owner(tree, node, gen.sub)
    let method = match_method(gen, tree, concrete, member, false)
    if method >= 0 {
      return emit_call(gen, tree, method, concrete, ast.child(tree, node, 3), -1, ty)
    }
    unsupported("generic member {owner}.{member}")
  }
  if tag == "Bin" { return binary(gen, tree, node, ty) }
  if tag == "Call" {
    var loc = 0
    if reports_call(gen, tree, node) { loc = site_loc(gen, tree, node, 2) }
    let mark = gen.out.len()
    let outer_site = gen.site
    if loc != 0 { gen.site = loc }
    let value = call(gen, tree, node, ty)
    gen.site = outer_site
    return located(gen, move value, mark, loc)
  }
  if tag == "CallFn" {
    let callee = expression(gen, tree, ast.child(tree, node, 0))
    return indirect_call(gen, tree, callee, ast.child(tree, node, 1), ty)
  }
  if tag == "Closure" { return closure(gen, tree, node, ty) }
  if tag == "Method" {
    var loc = 0
    if reports_site(gen, tree, node) { loc = site_loc(gen, tree, node, 3) }
    let mark = gen.out.len()
    let outer_site = gen.site
    if loc != 0 { gen.site = loc }
    let value = string_method(gen, tree, node, ty)
    gen.site = outer_site
    return located(gen, move value, mark, loc)
  }
  if tag == "Un" {
    let op = ast.name_at(tree, node, 0)
    let arg = ast.child(tree, node, 1)
    if op == "-" && (tree.at(arg).tag == "Int" || tree.at(arg).tag == "NumT") {
      return number(tree, arg, ty, true)
    }
    let value = expression(gen, tree, arg)
    if op == "?" { return propagate_result(gen, tree, value) }
    if op == "!" { return temp(gen, tree, ty, "!({value.code})") }
    if op == "-" {
      let float = floating_c(ty)
      if float != "" { return temp(gen, tree, ty, "-({value.code})") }
      return temp(gen, tree, ty, "nx_neg{integer_suffix(ty)}({value.code})")
    }
    unsupported("unary operator {op}")
  }
  unsupported("expression {tag}")
  return Value { ty: String.new(), code: String.new() }
}

fn loop_label(tree: view List<ast.AstNode>, node: Int) -> String {
  let label = ast.child(tree, node, 0)
  if tree.at(label).tag == "_" { return String.new() }
  return ast.decoded_name(tree, label)
}

fn loop_start(gen: mut Generator, label: view String) {
  let id = gen.temp
  gen.temp = id + 1
  gen.loops.push(Loop { label: String.from(label), id: id, deferred: gen.deferred.len() })
  gen.indent = gen.indent + 1
}

fn loop_end(gen: mut Generator) {
  let target = gen.loops.pop()
  line(gen, "sc_continue_{target.id}: ;")
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  line(gen, "sc_break_{target.id}: ;")
}

fn emit_iterator(gen: mut Generator, tree: view List<ast.AstNode>, id: Int,
    iterator: view Value, body: Int, label: view String) {
  let method = match_method(gen, tree, iterator.ty, String.from("next"), true)
  if method < 0 { unsupported("iteration over {iterator.ty}") }
  let params = ast.child(tree, method, 2)
  let self = params + 1
  if tree.at(self).end != tree.at(params).end || tree.at(ast.child(tree, self, 0)).tag != "Mut" {
    unsupported("iterator requires next(mut self) -> Option<T>")
  }
  let sub = call_substitution(gen, tree, method, iterator.ty)
  let result = declared_for(tree, ast.child(tree, method, 3), sub)
  let base = type_terms.base(result)
  if base != "Option" { unsupported("iterator next must return Option<T>") }
  let next = schedule(gen, method, iterator.ty, move sub)
  line(gen, String.from("for (;;) {{"))
  loop_start(gen, label)
  let option = temp(gen, tree, result, "F{next}(&({iterator.code}))")
  line(gen, "if ({option.code}.tag != 1) break;")
  let value = enum_payload(gen, option, 1, 0)
  let init = transfer(gen, tree, value)
  declare_local(gen, tree, value.ty, "v{id}", init)
  gen.references.set(id, false)
  statement(gen, tree, body)
  loop_end(gen)
}

fn emit_for(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let label = loop_label(tree, node)
  let id = id_at(gen, node)
  let iter = ast.child(tree, node, 3)
  let mutable = tree.at(ast.child(tree, node, 2)).tag == "true"
  if gen.checked.expressions.at(iter) == "Chars" && tree.at(iter).tag == "Method" {
    let receiver = expression(gen, tree, ast.child(tree, iter, 0))
    let length = temp(gen, tree, String.from("Int"), "({receiver.code}).len")
    line(gen, "for (int64_t i{id} = 0; i{id} < {length.code}; i{id} += nx_str_char_size(&({receiver.code}), i{id})) {{")
    loop_start(gen, label)
    gen.references.set(id, false)
    line(gen, "int64_t v{id} = nx_str_char_at(&({receiver.code}), i{id});")
    statement(gen, tree, ast.child(tree, node, 5))
    loop_end(gen)
    return
  }
  var binding = String.new()
  let pieces = type_terms.substitute(gen.checked.expressions.at(iter), gen.sub)
  let pieces_base = type_terms.base(pieces)
  if tree.at(iter).tag == "Method" && pieces_base == "Pieces" {
    let name = ast.decoded_name(tree, ast.child(tree, iter, 1))
    let source = expression(gen, tree, ast.child(tree, iter, 0))
    let args = ast.child(tree, iter, 2)
    let width = expression(gen, tree, args + 1)
    let k = temp(gen, tree, String.from("Int"), width.code)
    let piece_args = type_terms.arguments(pieces)
    let element = String.from(piece_args.at(0))
    let slice_type = type_terms.bracket(element, String.from("_"))
    prepare_type(gen, tree, slice_type)
    prepare_type(gen, tree, source.ty)
    let c = c_type(gen, tree, slice_type)
    let length = temp(gen, tree, String.from("Int"), sequence_length(source))
    var noun = String.from("chunk")
    if name == "windows" { noun = String.from("window") }
    let at_loc = site_loc(gen, tree, iter, 3)
    var guard = "if ({k.code} <= 0) nx_panic(\"{noun} size must be positive\");"
    if at_loc != 0 { guard = "if ({k.code} <= 0) {{ nx_cur_loc = {at_loc}; nx_panic(\"{noun} size must be positive\"); }}" }
    line(gen, guard)
    gen.references.set(id, false)
    if name == "chunks" {
      line(gen, "for (int64_t i{id} = 0; i{id} < {length.code}; i{id} += {k.code}) {{")
      binding = "{c} v{id} = sc_slice_{c}(({source.code}).d, {length.code}, i{id}, i{id} + {k.code} < {length.code} ? i{id} + {k.code} : {length.code});"
    } else {
      line(gen, "for (int64_t i{id} = 0; i{id} + {k.code} <= {length.code}; ++i{id}) {{")
      binding = "{c} v{id} = sc_slice_{c}(({source.code}).d, {length.code}, i{id}, i{id} + {k.code});"
    }
  } else if tree.at(iter).tag == "IterRange" {
    let lower = expression(gen, tree, ast.child(tree, iter, 0))
    let lo = temp(gen, tree, lower.ty, lower.code)
    let upper = expression(gen, tree, ast.child(tree, iter, 1))
    let hi = temp(gen, tree, upper.ty, upper.code)
    let low_type = integer_c(lo.ty)
    let high_type = integer_c(hi.ty)
    if low_type != "int64_t" || high_type != "int64_t" { unsupported("non-Int range loop") }
    var compare = String.from("<")
    if tree.at(ast.child(tree, iter, 2)).tag == "true" { compare = String.from("<=") }
    var stride = String.from("1")
    let step = ast.child(tree, node, 4)
    if tree.at(step).tag != "_" {
      let value = expression(gen, tree, step)
      let saved = temp(gen, tree, value.ty, value.code)
      stride = String.from(saved.code)
      line(gen, "if ({stride} <= 0) nx_panic(\"assertion failed\");")
    }
    // A widened iterator can step past INT64_MAX in an inclusive range.
    line(gen, "for (__int128 i{id} = {lo.code}; i{id} {compare} {hi.code}; i{id} += {stride}) {{")
    binding = "int64_t v{id} = (int64_t)i{id};"
  } else {
    let seq = expression(gen, tree, iter)
    let element = type_terms.element(seq.ty)
    if element == "?" {
      emit_iterator(gen, tree, id, seq, ast.child(tree, node, 5), label)
      return
    }
    prepare_type(gen, tree, seq.ty)
    let c = c_type(gen, tree, element)
    let count = temp(gen, tree, String.from("Int"), sequence_length(seq))
    let drop = drop_fn(gen, tree, element)
    let list = seq.ty == "List" || seq.ty.starts_with("List<")
    let consuming = list && (tree.at(iter).tag == "Move" || !is_place(gen, tree, iter))
    let owned = consuming && drop != ""
    let ref = mutable || (!consuming && drop != "")
    gen.references.set(id, ref)
    line(gen, "for (int64_t i{id} = 0; i{id} < {count.code}; ++i{id}) {{")
    if ref { binding = "{c} *v{id} = &({seq.code}).d[i{id}];" }
    else if owned {
      let item = Value { ty: String.from(element), code: "({seq.code}).d[i{id}]" }
      let init = transfer(gen, tree, item)
      declare_local(gen, tree, element, "v{id}", init)
    } else { binding = "{c} v{id} = ({seq.code}).d[i{id}];" }
  }
  loop_start(gen, label)
  if binding != "" { line(gen, binding) }
  statement(gen, tree, ast.child(tree, node, 5))
  loop_end(gen)
}

fn pattern_bound(digits: view String) -> String {
  if digits == "-9223372036854775808" { return String.from("INT64_MIN") }
  return "INT64_C({digits})"
}

fn tuple_parts(gen: view Generator, tree: view List<ast.AstNode>, value: view Value) -> List<Value> {
  var parts = List<Value>.new()
  let args = type_terms.arguments(value.ty)
  let shape = find_named(tree, gen.structs, type_terms.base(value.ty))
  if shape < 0 || !value.ty.starts_with("$tuple") { unsupported("tuple pattern on {value.ty}") }
  var field = ast.child(tree, shape, 2) + 1
  for ty in args {
    let name = String.from(tree.at(ast.child(tree, field, 0)).tag)
    parts.push(Value { ty: String.from(ty), code: "({value.code}).m{name}" })
    field = tree.at(field).end
  }
  return parts
}

fn pattern_test(gen: view Generator, tree: view List<ast.AstNode>, node: Int, value: view Value) -> String {
  let tag = String.from(tree.at(node).tag)
  if tag == "_" || tag == "Wild" { return String.from("true") }
  if tag == "Bind" { return pattern_test(gen, tree, ast.child(tree, node, 1), value) }
  if tag == "Bool" || tag == "Int" || tag == "Char" {
    let literal = String.from(tree.at(ast.child(tree, node, 0)).tag)
    if tag == "Int" { return "({value.code} == {pattern_bound(literal)})" }
    return "({value.code} == {literal})"
  }
  if tag == "PatRange" {
    let lo = String.from(tree.at(ast.child(tree, node, 1)).tag)
    let hi = String.from(tree.at(ast.child(tree, node, 2)).tag)
    if lo == "_" && hi == "_" { return String.from("true") }
    if lo == "_" { return "({value.code} <= {pattern_bound(hi)})" }
    if hi == "_" { return "({value.code} >= {pattern_bound(lo)})" }
    return "({value.code} >= {pattern_bound(lo)} && {value.code} <= {pattern_bound(hi)})"
  }
  if tag == "Text" {
    let text = quoted_text(tree, node)
    return "(sc_compare({text_view(value)}, nx_str_text({text})) == 0)"
  }
  var tests = List<String>.new()
  if tag == "Or" {
    let items = ast.child(tree, node, 0)
    var at = items + 1
    while at < tree.at(items).end {
      tests.push(pattern_test(gen, tree, at, value))
      at = tree.at(at).end
    }
    let joined = tests.join(" || ")
    return "({joined})"
  }
  if tag == "Variant" {
    let layout = enum_index(gen, value.ty)
    if layout < 0 { unsupported("variant pattern on {value.ty}") }
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let slot = variant_index(gen.enum_layouts.at(layout), name)
    let fields = ast.child(tree, node, 1)
    var at = fields + 1
    var i = 0
    tests.push("({value.code}).tag == {slot}")
    while at < tree.at(fields).end {
      let field = enum_payload(gen, value, slot, i)
      tests.push(pattern_test(gen, tree, at, field))
      i = i + 1
      at = tree.at(at).end
    }
    let joined = tests.join(" && ")
    return "({joined})"
  }
  if tag == "TuplePat" {
    let parts = tuple_parts(gen, tree, value)
    let items = ast.child(tree, node, 0)
    var at = items + 1
    var i = 0
    while at < tree.at(items).end {
      if i >= parts.len() { unsupported("tuple pattern arity") }
      tests.push(pattern_test(gen, tree, at, parts.at(i)))
      i = i + 1
      at = tree.at(at).end
    }
    let joined = tests.join(" && ")
    return "({joined})"
  }
  unsupported("pattern {tag}")
  return String.new()
}

fn bind_pattern(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, value: view Value,
    mode: view String, guarded: Bool) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Bind" {
    let id = id_at(gen, node)
    let c = c_type(gen, tree, value.ty)
    let drop = drop_fn(gen, tree, value.ty)
    let ref = mode == "Mut" || (mode == "View" && drop != "")
    gen.references.set(id, ref)
    if ref { line(gen, "{c} *v{id} = &({value.code});") }
    else if drop != "" {
      if guarded { unsupported("guard on a consuming pattern binding") }
      let init = transfer(gen, tree, value)
      declare_local(gen, tree, value.ty, "v{id}", init)
    } else { line(gen, "{c} v{id} = {value.code};") }
    bind_pattern(gen, tree, ast.child(tree, node, 1), value, mode, guarded)
  } else if tag == "Variant" {
    let layout = enum_index(gen, value.ty)
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let slot = variant_index(gen.enum_layouts.at(layout), name)
    let fields = ast.child(tree, node, 1)
    var at = fields + 1
    var i = 0
    while at < tree.at(fields).end {
      let field = enum_payload(gen, value, slot, i)
      bind_pattern(gen, tree, at, field, mode, guarded)
      i = i + 1
      at = tree.at(at).end
    }
  } else if tag == "TuplePat" {
    let parts = tuple_parts(gen, tree, value)
    let items = ast.child(tree, node, 0)
    var at = items + 1
    var i = 0
    while at < tree.at(items).end {
      bind_pattern(gen, tree, at, parts.at(i), mode, guarded)
      i = i + 1
      at = tree.at(at).end
    }
  } else if tag == "Or" {
    var binds = false
    for at in node + 1..tree.at(node).end {
      if tree.at(at).tag == "Bind" { binds = true }
    }
    if !binds { return }
    // Every alternative binds the same names; the body sees the first alternative's bindings, so declare
    // those and assign them from whichever alternative matched.
    let items = ast.child(tree, node, 0)
    var first_nodes = List<Int>.new()
    var first_values = List<Value>.new()
    collect_binds(gen, tree, items + 1, value, first_nodes, first_values)
    for i in 0..first_nodes.len() {
      let id = id_at(gen, first_nodes.at(i))
      let ty = String.from(first_values.at(i).ty)
      if drop_fn(gen, tree, ty).len() != 0 || mode != "Own" && mode != "View" { unsupported("owned or borrowed bindings in alternative patterns") }
      gen.references.set(id, false)
      line(gen, "{c_type(gen, tree, ty)} v{id};")
    }
    var at = items + 1
    var keyword = String.from("if")
    while at < tree.at(items).end {
      var nodes = List<Int>.new()
      var values = List<Value>.new()
      collect_binds(gen, tree, at, value, nodes, values)
      let test = pattern_test(gen, tree, at, value)
      line(gen, "{keyword} ({test}) {{")
      for i in 0..nodes.len() {
        let name = ast.name_at(tree, nodes.at(i), 0)
        for j in 0..first_nodes.len() {
          let other = ast.name_at(tree, first_nodes.at(j), 0)
          if other == name {
            line(gen, "v{id_at(gen, first_nodes.at(j))} = {values.at(i).code};")
          }
        }
      }
      line(gen, String.from("}}"))
      keyword = String.from("else if")
      at = tree.at(at).end
    }
  }
}

fn collect_binds(gen: view Generator, tree: view List<ast.AstNode>, node: Int, value: view Value,
    nodes: mut List<Int>, values: mut List<Value>) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Bind" {
    nodes.push(node)
    values.push(Value { ty: String.from(value.ty), code: String.from(value.code) })
    collect_binds(gen, tree, ast.child(tree, node, 1), value, nodes, values)
  } else if tag == "Variant" {
    let layout = enum_index(gen, value.ty)
    let name = type_terms.last_name(ast.name_at(tree, node, 0))
    let slot = variant_index(gen.enum_layouts.at(layout), name)
    let fields = ast.child(tree, node, 1)
    var at = fields + 1
    var i = 0
    while at < tree.at(fields).end {
      collect_binds(gen, tree, at, enum_payload(gen, value, slot, i), nodes, values)
      i = i + 1
      at = tree.at(at).end
    }
  } else if tag == "TuplePat" {
    let parts = tuple_parts(gen, tree, value)
    let items = ast.child(tree, node, 0)
    var at = items + 1
    var i = 0
    while at < tree.at(items).end {
      collect_binds(gen, tree, at, parts.at(i), nodes, values)
      i = i + 1
      at = tree.at(at).end
    }
  }
}

fn emit_match(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let scrutinee = ast.child(tree, node, 0)
  var at = scrutinee
  var mode = String.from("Own")
  if tree.at(at).tag == "Un" && tree.at(ast.child(tree, at, 0)).tag == "6d7574" {
    at = ast.child(tree, at, 1)
    mode = String.from("Mut")
  } else if is_place(gen, tree, at) { mode = String.from("View") }
  let operand = expression(gen, tree, at)
  prepare_type(gen, tree, operand.ty)
  var value = Value { ty: String.from(operand.ty), code: String.from(operand.code) }
  if mode == "Own" && drop_fn(gen, tree, value.ty).len() == 0 {
    value = temp(gen, tree, operand.ty, operand.code)
  }
  let matched = temp(gen, tree, String.from("Bool"), String.from("false"))
  let arms = ast.child(tree, node, 1)
  at = arms + 1
  while at < tree.at(arms).end {
    let pattern = ast.child(tree, at, 0)
    let guard = ast.child(tree, at, 1)
    let guarded = tree.at(guard).tag != "_"
    let test = pattern_test(gen, tree, pattern, value)
    line(gen, "if (!{matched.code} && {test}) {{")
    gen.indent = gen.indent + 1
    bind_pattern(gen, tree, pattern, value, mode, guarded)
    if guarded {
      let condition = expression(gen, tree, guard)
      line(gen, "if ({condition.code}) {{")
      gen.indent = gen.indent + 1
    }
    line(gen, "{matched.code} = true;")
    statement(gen, tree, ast.child(tree, at, 2))
    if guarded { gen.indent = gen.indent - 1; line(gen, String.from("}}")) }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
    at = tree.at(at).end
  }
  line(gen, "if (!{matched.code}) nx_panic(\"non-exhaustive match\");")
}

fn bind_unpack(gen: mut Generator, tree: view List<ast.AstNode>, pattern: Int, value: view Value) {
  if tree.at(pattern).tag == "UnpackBind" {
    let id = gen.locals.identities.at(pattern)
    if id >= 0 {
      let init = transfer(gen, tree, value)
      gen.references.set(id, false)
      declare_local(gen, tree, value.ty, "v{id}", init)
    }
    return
  }
  let fields = ast.child(tree, pattern, 0)
  let args = type_terms.arguments(value.ty)
  let shape = find_named(tree, gen.structs, type_terms.base(value.ty))
  if shape < 0 || !value.ty.starts_with("$tuple") { unsupported("tuple unpacking of {value.ty}") }
  var field = ast.child(tree, shape, 2) + 1
  var at = fields + 1
  for ty in args {
    if at >= tree.at(fields).end { unsupported("tuple unpack arity") }
    let name = String.from(tree.at(ast.child(tree, field, 0)).tag)
    let inner = Value { ty: String.from(ty), code: "({value.code}).m{name}" }
    bind_unpack(gen, tree, at, inner)
    at = tree.at(at).end
    field = tree.at(field).end
  }
  if at != tree.at(fields).end { unsupported("tuple unpack arity") }
}

fn tuple_target(tree: view List<ast.AstNode>, node: Int) -> Bool {
  return tree.at(node).tag == "StructLit" && ast.name_at(tree, node, 0).starts_with("$tuple")
}

fn assign_place(gen: mut Generator, tree: view List<ast.AstNode>, target: Int, value: Value) {
  let place = expression(gen, tree, target)
  if place.ty.starts_with("Slice<") { unsupported("slice assignment") }
  let rhs = coerce(gen, tree, move value, place.ty)
  let drop = drop_fn(gen, tree, place.ty)
  if drop != "" {
    let moved = transfer(gen, tree, rhs)
    let saved = temp(gen, tree, place.ty, moved)
    line(gen, "{drop}(&({place.code}));")
    line(gen, "{place.code} = {transfer(gen, tree, saved)};")
  } else { line(gen, "{place.code} = {rhs.code};") }
}

fn assign_tuple(gen: mut Generator, tree: view List<ast.AstNode>, target: Int, whole: view Value) {
  let parts = tuple_parts(gen, tree, whole)
  let fields = ast.child(tree, target, 2)
  var at = fields + 1
  var i = 0
  while at < tree.at(fields).end {
    if i >= parts.len() { unsupported("tuple assignment arity") }
    let inner = ast.child(tree, at, 1)
    let part = Value { ty: String.from(parts.at(i).ty), code: String.from(parts.at(i).code) }
    if tuple_target(tree, inner) { assign_tuple(gen, tree, inner, part) }
    else {
      if !is_place(gen, tree, inner) { unsupported("assignment target") }
      assign_place(gen, tree, inner, move part)
    }
    i = i + 1
    at = tree.at(at).end
  }
}

// While `gen.value_target` is set, the last line of a branch is assigned to it (an `if`/`match` used as a value).
fn statement(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let target = String.from(gen.value_target)
  if target != "" {
    let tag = String.from(tree.at(node).tag)
    if tag != "Block" && tag != "[" && tag != "If" && tag != "IfExpr" && tag != "Match" && tag != "MatchExpr" && tag != "Expr" {
      gen.value_target = String.new()
    }
  }
  lower_statement(gen, tree, node)
  gen.value_target = move target
}

fn lower_statement(gen: mut Generator, tree: view List<ast.AstNode>, node: Int) {
  let tag = String.from(tree.at(node).tag)
  if tag == "Block" || tag == "[" || tag == "Scope" || tag == "Unsafe" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    let deferred = gen.deferred.len()
    let tail = String.from(gen.value_target)
    var at = node + 1
    while at < tree.at(node).end {
      if tree.at(at).end == tree.at(node).end { gen.value_target = String.from(tail) }
      else { gen.value_target = String.new() }
      statement(gen, tree, at)
      // the type stage does not look at code after a statement that always exits
      let tag = String.from(tree.at(at).tag)
      if tag == "Return" || tag == "Break" || tag == "Continue" || returns_value(tree, at) { break }
      at = tree.at(at).end
    }
    gen.value_target = String.from(tail)
    emit_defers(gen, tree, deferred)
    while gen.deferred.len() > deferred { let unused = gen.deferred.pop() }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "Defer" {
    let inner = ast.child(tree, node, 0)
    for at in inner..tree.at(inner).end {
      let nested = String.from(tree.at(at).tag)
      if nested == "Return" || nested == "Break" || nested == "Continue" || nested == "Defer" ||
          (nested == "Un" && tree.at(ast.child(tree, at, 0)).tag == "3f") {
        unsupported("control flow inside defer")
      }
    }
    gen.deferred.push(inner)
  } else if tag == "Let" {
    let place = local_place(gen, node)
    if place.ty.starts_with("Slice<") { unsupported("slice binding") }
    let value = expression(gen, tree, ast.child(tree, node, 2))
    let init = coerce(gen, tree, move value, place.ty)
    let initial = transfer(gen, tree, init)
    declare_local(gen, tree, place.ty, place.code, initial)
  } else if tag == "Unpack" {
    let source = expression(gen, tree, ast.child(tree, node, 1))
    let value = temp(gen, tree, source.ty, transfer(gen, tree, source))
    bind_unpack(gen, tree, ast.child(tree, node, 0), value)
    let drop = drop_fn(gen, tree, value.ty)
    if drop != "" { line(gen, "{drop}(&({value.code}));") }
  } else if tag == "Assign" {
    let target = ast.child(tree, node, 0)
    if tuple_target(tree, target) {
      let source = expression(gen, tree, ast.child(tree, node, 1))
      let whole = temp(gen, tree, source.ty, transfer(gen, tree, source))
      assign_tuple(gen, tree, target, whole)
      return
    }
    if !is_place(gen, tree, target) { unsupported("assignment target") }
    let value = expression(gen, tree, ast.child(tree, node, 1))
    var saved_value = Value { ty: String.from(value.ty), code: String.from(value.code) }
    if tree.at(target).tag != "Var" {
      saved_value = temp(gen, tree, value.ty, transfer(gen, tree, value))
    }
    assign_place(gen, tree, target, move saved_value)
  } else if tag == "Expr" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    let value = expression(gen, tree, ast.child(tree, node, 0))
    if value.ty != "nothing" && gen.value_target != "" {
      let wanted = String.from(gen.value_type)
      let assigned = coerce(gen, tree, move value, wanted)
      let moved = transfer(gen, tree, assigned)
      line(gen, "{gen.value_target} = {moved};")
    } else if value.ty != "nothing" { line(gen, "(void)({value.code});") }
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "Return" {
    let arg = ast.child(tree, node, 0)
    if tree.at(arg).tag == "_" { emit_return(gen, tree, String.from("nothing"), String.new()) }
    else {
      let expected = String.from(gen.result)
      if expected == "nothing" { unsupported("return value in a function without a result type") }
      let value = expression(gen, tree, arg)
      let result = coerce(gen, tree, move value, expected)
      emit_return(gen, tree, expected, transfer(gen, tree, result))
    }
  } else if tag == "If" || tag == "IfExpr" {
    let condition = expression(gen, tree, ast.child(tree, node, 0))
    if condition.ty != "Bool" { unsupported("if condition type") }
    line(gen, "if ({condition.code})")
    statement(gen, tree, ast.child(tree, node, 1))
    let alternative = ast.child(tree, node, 2)
    if tree.at(alternative).tag != "_" {
      line(gen, String.from("else {{"))
      gen.indent = gen.indent + 1
      statement(gen, tree, alternative)
      gen.indent = gen.indent - 1
      line(gen, String.from("}}"))
    }
  } else if tag == "Match" || tag == "MatchExpr" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    emit_match(gen, tree, node)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "For" {
    line(gen, String.from("{{"))
    gen.indent = gen.indent + 1
    emit_for(gen, tree, node)
    gen.indent = gen.indent - 1
    line(gen, String.from("}}"))
  } else if tag == "While" {
    let label = loop_label(tree, node)
    line(gen, String.from("for (;;) {{"))
    loop_start(gen, label)
    let condition = expression(gen, tree, ast.child(tree, node, 1))
    if condition.ty != "Bool" { unsupported("while condition type") }
    line(gen, "if (!({condition.code})) break;")
    statement(gen, tree, ast.child(tree, node, 2))
    loop_end(gen)
  } else if tag == "Break" || tag == "Continue" {
    let label = loop_label(tree, node)
    var index = gen.loops.len()
    while index > 0 {
      index = index - 1
      if label == "" || gen.loops.at(index).label == label {
        let id = gen.loops.at(index).id
        let start = gen.loops.at(index).deferred
        emit_defers(gen, tree, start)
        if tag == "Break" { line(gen, "goto sc_break_{id};") }
        else { line(gen, "goto sc_continue_{id};") }
        return
      }
    }
    unsupported("loop exit with invalid target")
  } else if tag != "_" { unsupported("statement {tag}") }
}

fn emit_struct(gen: mut Generator, tree: view List<ast.AstNode>, node: Int, ty: view String) {
  if struct_index(gen, ty) >= 0 { return }
  let id = gen.struct_layouts.len()
  let destructor = trait_method(gen, tree, ty, String.from("Drop"), String.from("drop"))
  gen.struct_layouts.push(StructLayout {
    ty: String.from(ty), owned: false, ready: false, destructor: destructor >= 0,
  })
  let sub = nominal_sub(tree, node, ty)
  let fields = ast.child(tree, node, 2)
  var drops = List<String>.new()
  var at = fields + 1
  while at < tree.at(fields).end {
    let ty = declared_for(tree, ast.child(tree, at, 1), sub)
    if ty.starts_with("Slice<") { unsupported("slice stored in a struct") }
    prepare_type(gen, tree, ty)
    let drop = drop_fn(gen, tree, ty)
    if drop != "" {
      let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
      drops.push("{drop}(&value->m{name});")
    }
    at = tree.at(at).end
  }
  global(gen, "typedef struct {{")
  if destructor >= 0 { global(gen, String.from("bool sc_live;")) }
  at = fields + 1
  if at == tree.at(fields).end { global(gen, String.from("char empty;")) }
  while at < tree.at(fields).end {
    let ty = declared_for(tree, ast.child(tree, at, 1), sub)
    let name = String.from(tree.at(ast.child(tree, at, 0)).tag)
    global(gen, "{c_type(gen, tree, ty)} m{name};")
    at = tree.at(at).end
  }
  global(gen, "}} S{id};")
  if drops.len() != 0 || destructor >= 0 {
    gen.struct_layouts.at(id).owned = true
    var method = -1
    if destructor >= 0 {
      method = schedule(gen, destructor, ty, call_substitution(gen, tree, destructor, ty))
      global(gen, "static void F{method}(S{id} *value);")
    }
    global(gen, "static inline void sc_drop_S{id}(S{id} *value) {{")
    if method >= 0 {
      global(gen, "if (value->sc_live) {{")
      global(gen, "bool saved = nx_in_destructor; nx_in_destructor = true;")
      global(gen, "value->sc_live = false; F{method}(value); nx_in_destructor = saved; }}")
    }
      var field = drops.len()
    while field > 0 {
      field = field - 1
      global(gen, drops.at(field))
    }
      global(gen, String.from("}}"))
    global(gen, "static inline S{id} sc_take_S{id}(S{id} *value) {{")
    global(gen, "  S{id} result = *value; *value = (S{id}){{0}}; return result;")
    global(gen, String.from("}}"))
  }
  gen.struct_layouts.at(id).ready = true
}

// Does the loop body contain a `break` that leaves this loop? Unlabeled breaks inside nested loops do not.
fn breaks_out(tree: view List<ast.AstNode>, node: Int, nested: Bool) -> Bool {
  let tag = String.from(tree.at(node).tag)
  if tag == "Break" {
    return !nested || tree.at(ast.child(tree, node, 0)).tag != "_"
  }
  var inside = nested
  if tag == "While" || tag == "For" { inside = true }
  var at = node + 1
  while at < tree.at(node).end {
    if breaks_out(tree, at, inside) { return true }
    at = tree.at(at).end
  }
  return false
}

fn returns_value(tree: view List<ast.AstNode>, node: Int) -> Bool {
  let tag = String.from(tree.at(node).tag)
  if tag == "Return" { return tree.at(ast.child(tree, node, 0)).tag != "_" }
  if tag == "While" {
    let condition = ast.child(tree, node, 1)
    if tree.at(condition).tag != "Bool" || tree.at(ast.child(tree, condition, 0)).tag != "true" {
      return false
    }
    return !breaks_out(tree, ast.child(tree, node, 2), false)
  }
  if tag == "If" {
    return returns_value(tree, ast.child(tree, node, 1)) && returns_value(tree, ast.child(tree, node, 2))
  }
  if tag == "Match" {
    let arms = ast.child(tree, node, 1)
    var at = arms + 1
    while at < tree.at(arms).end {
      if !returns_value(tree, ast.child(tree, at, 2)) { return false }
      at = tree.at(at).end
    }
    return true
  }
  if tag == "Block" || tag == "[" || tag == "Scope" || tag == "Unsafe" {
    var at = node + 1
    while at < tree.at(node).end {
      if returns_value(tree, at) { return true }
      at = tree.at(at).end
    }
  }
  return false
}

fn emit_function(gen: mut Generator, tree: view List<ast.AstNode>, instance: Int) {
  let node = gen.instances.at(instance).node
  let owner = String.from(gen.instances.at(instance).owner)
  gen.sub = type_terms.copy(gen.instances.at(instance).sub)
  let is_closure = tree.at(node).tag == "Closure"
  let worker = is_closure && tree.at(ast.child(tree, node, 3)).tag == "true"
  var params = ast.child(tree, node, 2)
  var result = String.new()
  var closure_parts = List<String>.new()
  if is_closure {
    params = ast.child(tree, node, 4)
    closure_parts = type_terms.function_parts(owner)
    if closure_parts.len() == 0 { unsupported("Closure signature {owner}") }
    result = closure_parts.pop()
  } else { result = declared_for(tree, ast.child(tree, node, 3), gen.sub) }
  if result.starts_with("Slice<") { unsupported("slice return type") }
  prepare_type(gen, tree, result)
  let c = c_type(gen, tree, result)
  var entries = List<String>.new()
  if is_closure { entries.push(String.from("void *raw_env")) }
  var owned = List<Int>.new()
  var at = params + 1
  var ordinal = 0
  while at < tree.at(params).end {
    let id = id_at(gen, at)
    var ty = String.from(owner)
    var mode = String.new()
    if tree.at(at).tag == "Self" { mode = String.from(tree.at(ast.child(tree, at, 0)).tag) }
    else {
      ty = declared_for(tree, ast.child(tree, at, 2), gen.sub)
      mode = String.from(tree.at(ast.child(tree, at, 1)).tag)
      if is_closure {
        let param = types.function_parameter(closure_parts.at(ordinal))
        ty = String.from(param.ty)
        mode = String.from(param.mode)
      }
    }
    if ty.starts_with("Slice<") && mode == "Own" { unsupported("owned slice parameter") }
    prepare_type(gen, tree, ty)
    let drop = drop_fn(gen, tree, ty)
    let ref = by_reference(gen, tree, ty, mode)
    gen.references.set(id, ref)
    let param = c_type(gen, tree, ty)
    if ref { entries.push("{param} *v{id}") }
    else if drop != "" { entries.push("{param} p{id}"); owned.push(id) }
    else { entries.push("{param} v{id}") }
    at = tree.at(at).end
    ordinal = ordinal + 1
  }
  if entries.len() == 0 { entries.push(String.from("void")) }
  let parameters = entries.join(", ")
  let signature = "static {c} F{instance}({parameters})"
  let prototype = "{signature};\n"
  gen.prototypes.push_str(prototype)
  var block = ast.child(tree, node, 4)
  var expression_body = -1
  if is_closure {
    block = ast.child(tree, node, 6)
    let first = ast.child(tree, block, 0) + 1
    if tree.at(ast.child(tree, node, 1)).tag == "true" && tree.at(first).tag == "Return" {
      expression_body = ast.child(tree, first, 0)
    }
  }
  if result != "nothing" && expression_body < 0 && !returns_value(tree, block) {
    unsupported("function missing a return value")
  }
  line(gen, "{signature} {{")
  gen.indent = gen.indent + 1
  gen.result = String.from(result)
  var captures = List<Int>.new()
  var prior_references = List<Bool>.new()
  if is_closure {
    if worker { captures = locals.environment_captures(gen.locals, tree, node) }
    else { captures = locals.capture_ids(gen.locals.captures, node) }
  }
  if captures.len() > 0 {
    let borrow = gen.checked.borrowed_closures.at(node)
    line(gen, "C{instance} *env = raw_env;")
    for id in captures {
      let place = binding_place(gen, id)
      let c = c_type(gen, tree, place.ty)
      prior_references.push(gen.references.at(id))
      gen.references.set(id, !worker)
      if worker {
        let capture = Value { ty: String.from(place.ty), code: "env->v{id}" }
        let init = transfer(gen, tree, capture)
        declare_local(gen, tree, place.ty, "v{id}", init)
      } else if borrow { line(gen, "{c} *v{id} = env->v{id};") }
      else { line(gen, "{c} *v{id} = &env->v{id};") }
    }
  }
  for id in owned {
    let ty = type_terms.substitute(gen.checked.bindings.at(id), gen.sub)
    declare_local(gen, tree, ty, "v{id}", "p{id}")
  }
  if expression_body >= 0 {
    let value = expression(gen, tree, expression_body)
    if result != "nothing" {
      let value = coerce(gen, tree, move value, result)
      line(gen, "return {transfer(gen, tree, value)};")
    }
  } else { statement(gen, tree, block) }
  for i in 0..captures.len() { gen.references.set(captures.at(i), prior_references.at(i)) }
  if result != "nothing" { line(gen, String.from("nx_panic(\"function missing a return value\");")) }
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
  if worker { emit_worker_entry(gen, tree, instance, result) }
}

fn emit_worker_entry(gen: mut Generator, tree: view List<ast.AstNode>, instance: Int, result: view String) {
  let signature = "static int64_t P{instance}(void *env)"
  gen.prototypes.push_str("{signature};\n")
  line(gen, "{signature} {{")
  gen.indent = gen.indent + 1
  var payload = String.from(result)
  var call = "F{instance}(env)"
  if result == "nothing" {
    line(gen, "{call};")
    payload = String.from("ThreadDone")
    call = String.from("{{0}}")
  }
  let value = temp(gen, tree, payload, call)
  let c = c_type(gen, tree, payload)
  let drop = heap_drop(gen, tree, payload)
  line(gen, "ScBox result = sc_box_new(sizeof({c}), {drop});")
  line(gen, "*({c} *)result->data = {transfer(gen, tree, value)};")
  line(gen, String.from("return (int64_t)(intptr_t)result;"))
  gen.indent = gen.indent - 1
  line(gen, String.from("}}"))
}

fn generate(gen: mut Generator, tree: view List<ast.AstNode>) {
  for node in 0..tree.len() {
    if tree.at(node).tag == "Closure" && tree.at(ast.child(tree, node, 3)).tag == "true" {
      gen.worker_cleanup = true
      break
    }
  }
  let items = ast.child(tree, 0, 0)
  var at = items + 1
  while at < tree.at(items).end {
    let item = ast.child(tree, at, 2)
    let tag = String.from(tree.at(item).tag)
    if tag == "Fn" || tag == "Struct" {
      let name = ast.name_at(tree, item, 0)
      if tag == "Fn" {
        if find_named(tree, gen.functions, name) >= 0 { unsupported("duplicate function {name}") }
        gen.functions.push(item)
      } else {
        if find_named(tree, gen.structs, name) >= 0 { unsupported("duplicate struct {name}") }
        gen.structs.push(item)
        if name == "Box" { gen.user_box = true }
      }
    } else if tag == "Derive" {
      let target = ast.name_at(tree, item, 0)
      let traits = ast.child(tree, item, 1)
      var trait_at = traits + 1
      while trait_at < tree.at(traits).end {
        let name = ast.decoded_name(tree, trait_at)
        if name == "Equal" || name == "Show" { trait_at = tree.at(trait_at).end; continue }
        if name != "Clone" { unsupported("derive {name}") }
        if gen.clone_types.contains(target) { unsupported("duplicate Clone derive for {target}") }
        gen.clone_types.push(String.from(target))
        trait_at = tree.at(trait_at).end
      }
    } else if tag == "Enum" {
      gen.enums.push(item)
      let name = ast.name_at(tree, item, 0)
      if name == "Box" { gen.user_box = true }
    }
    else if tag == "Trait" { gen.traits.push(item) }
    else if tag == "Const" { gen.constants.push(item) }
    else if tag == "Link" {}
    else if tag == "Extern" {
      // `extern "C" { fn name(..) -> T }`: the symbols come from libc/libm, called directly
      let list = ast.child(tree, item, 1)
      var at_fn = list + 1
      while at_fn < tree.at(list).end {
        gen.externs.push(at_fn)
        gen.functions.push(at_fn)
        at_fn = tree.at(at_fn).end
      }
    }
    else if tag == "Impl" {
      let generics = ast.child(tree, item, 0)
      var params = -1
      if tree.at(generics).end > generics + 1 {
        params = generics
        var g = generics + 1
        while g < tree.at(generics).end {
          if tree.at(g).tag != "Generic" { unsupported("non-type generic impl parameters") }
          g = tree.at(g).end
        }
      }
      let trait_node = ast.child(tree, item, 1)
      var trait_name = String.new()
      if tree.at(trait_node).tag != "_" {
        trait_name = declared_type(tree, trait_node)
      }
      let owner = declared_type(tree, ast.child(tree, item, 2))
      let methods = ast.child(tree, item, 3)
      var m = methods + 1
      while m < tree.at(methods).end {
        if trait_name == "Drop" {
          let params = ast.child(tree, m, 2)
          if tree.at(params).end == params + 1 || tree.at(params + 1).tag != "Self" ||
              tree.at(ast.child(tree, params + 1, 0)).tag != "Mut" ||
              tree.at(params + 1).end != tree.at(params).end || tree.at(ast.child(tree, m, 3)).tag != "_" {
            unsupported("Drop method signature")
          }
        }
        gen.methods.push(Method { owner: String.from(owner), node: m, params: params, trait_name: String.from(trait_name) })
        m = tree.at(m).end
      }
    }
    else if tag != "Alias" && tag != "Const" { unsupported("declaration {tag}") }
    at = tree.at(at).end
  }
  for target in gen.clone_types {
    if find_named(tree, gen.structs, target) < 0 && find_named(tree, gen.enums, target) < 0 {
      unsupported("derive Clone for unknown type {target}")
    }
  }
  let entry = find_named(tree, gen.functions, String.from("main"))
  if entry < 0 { unsupported("no main function") }
  let params = ast.child(tree, entry, 2)
  if tree.at(params).end != params + 1 || tree.at(ast.child(tree, entry, 3)).tag != "_" {
    unsupported("main must take no arguments and return nothing")
  }
  if gen.at_file.len() > 0 { global(gen, String.from("#define NX_SELFHOST_LOCS 1")) }
  global(gen, String.from("#include \"c_runtime.h\""))
  global(gen, String.from("#include \"c_selfhost_text.h\""))
  global(gen, String.from("#include \"c_selfhost_numeric.h\""))
  global(gen, String.from("#include \"c_selfhost_sequences.h\""))
  global(gen, String.from("#include \"c_selfhost_process.h\""))
  global(gen, String.from("#include \"c_selfhost_heap.h\""))
  global(gen, String.from("static inline String sc_take_String(String *value) {{"))
  global(gen, String.from("  String result = *value; *value = (String){{0}}; return result;"))
  global(gen, String.from("}}"))
  global(gen, String.from("static inline NxFn sc_take_NxFn(NxFn *value) {{"))
  global(gen, String.from("  NxFn result = *value; *value = (NxFn){{0}}; return result;"))
  global(gen, String.from("}}"))
  let start = schedule(gen, entry, String.new(), type_terms.empty())
  var instance = 0
  while instance < gen.instances.len() {
    emit_function(gen, tree, instance)
    instance = instance + 1
  }
  line(gen, "int main(int argc, char **argv) {{")
  line(gen, "  sc_argc = argc; sc_argv = argv;")
  line(gen, "  int ne = 0; while (environ && environ[ne]) ne++;")
  line(gen, "  int64_t stack[argc + ne + 3]; int k = 0;")
  line(gen, "  stack[k++] = argc;")
  line(gen, "  for (int i = 0; i < argc; i++) stack[k++] = (int64_t)(intptr_t)argv[i];")
  line(gen, "  stack[k++] = 0;")
  line(gen, "  for (int i = 0; i < ne; i++) stack[k++] = (int64_t)(intptr_t)environ[i];")
  line(gen, "  stack[k] = 0; nx_globals[0] = (int64_t)(intptr_t)stack;")
  line(gen, "  F{start}(); return 0;")
  line(gen, "}}")
}

fn main() {
  let args = env.args()
  if args.len() < 2 || args.len() > 4 {
    io.eprintln("usage: codegen FILE.ast [SOURCE-NAME USER-LINES]")
    env.exit(2)
    return
  }
  match fs.read_to_string(args.at(1)) {
    Err(e) => { io.eprintln(e.message); env.exit(2) }
    Ok(source) => {
      let file = ast.decode_linked(move source)
      let bindings = locals.resolve(file.nodes)
      let checked = types.check_file(file.nodes, bindings, true, false)
      if checked.errors > 0 {
        for row in checked.messages { io.eprintln(row) }
        env.exit(1)
        return
      }
      var gen = Generator {
        checked: move checked, locals: move bindings, structs: List<Int>.new(), functions: List<Int>.new(),
        collections: List<String>.new(), sorted_elements: List<String>.new(), globals: String.new(),
        enums: List<Int>.new(), enum_layouts: List<EnumLayout>.new(),
        traits: List<Int>.new(), heap_drops: List<String>.new(), dyn_tables: List<String>.new(),
        struct_layouts: List<StructLayout>.new(), methods: List<Method>.new(), clone_types: List<String>.new(), constants: List<Int>.new(), externs: List<Int>.new(),
        instances: List<Instance>.new(), sub: type_terms.empty(), prototypes: String.new(),
        function_values: List<Int>.new(), closure_envs: List<Int>.new(), wrappers: String.new(),
        references: List<Bool>.new(), out: String.new(),
        indent: 0, temp: 0, loops: List<Loop>.new(), deferred: List<Int>.new(), result: String.new(),
        worker_cleanup: false, user_box: false, at_file: String.new(), user_lines: 0, locs: List<Int>.new(), last_line: 0, slice_node: -1, site: 0, override_node: -1, override_ty: String.new(), override_code: String.new(), no_args: false, value_target: String.new(), value_type: String.new(),
      }
      for i in 0..gen.locals.bindings.len() { gen.references.push(false) }
      if args.len() == 4 {
        gen.at_file = String.from(args.at(2))
        if !args.at(3).parse_int(gen.user_lines) { gen.user_lines = 0 }
      }
      generate(gen, file.nodes)
      print(gen.globals)
      print(gen.prototypes)
      print(gen.wrappers)
      print(gen.out)
      if gen.at_file.len() > 0 {
        // the location table the runtime's `nx_dbg` reads (id 0 = unknown)
        var table = String.from("static const NxLoc nx_locs_tbl[] = {{ {{0,0,0}}")
        for key in gen.locs { table.push_str(", {{0,{key / 65536},{key % 65536}}}") }
        table.push_str(" }};")
        print(table)
        let quoted = gen.at_file.replace("\\", "\\\\").replace("\"", "\\\"")
        print("static const char *const nx_files_tbl[] = {{ \"{quoted}\" }};")
        print("const NxDebug nx_dbg = {{ nx_locs_tbl, {gen.locs.len() + 1}, nx_files_tbl }};")
      }
    }
  }
}
