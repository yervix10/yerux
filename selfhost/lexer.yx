// M7 bootstrap: a small source lexer whose output is compared to `yerux tokens`.
// The token row format is documented in docs/SELFHOST.md.
import std.env
import std.fs

struct Part { expr: Bool, text: String, line: Int, col: Int }

fn hex(s: view String) -> String {
  let digits = String.from("0123456789abcdef")
  var out = String.new()
  for i in 0..s.len() {
    let b = s.byte(i)
    out.push_byte(digits.byte(b / 16))
    out.push_byte(digits.byte(b % 16))
  }
  return out
}

// A zero line keeps the original position-free dump format.
fn emit_row(line: Int, row: view String) {
  if line == 0 { print(row) }
  else if line >= 1000000 { print("{line % 1000000}:{line / 1000000}:{row}") }
  else { print("{line}:{row}") }
}

fn emit(line: Int, kind: Text, value: view String) {
  let row = "{kind}{hex(value)}"
  emit_row(line, row)
}

fn is_digit(b: Int) -> Bool { return b >= 48 && b <= 57 }
fn is_alpha(b: Int) -> Bool { return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 }
fn is_alnum(b: Int) -> Bool { return is_alpha(b) || is_digit(b) }
fn hex_value(b: Int) -> Int {
  if b >= 48 && b <= 57 { return b - 48 }
  if b >= 65 && b <= 70 { return b - 55 }
  if b >= 97 && b <= 102 { return b - 87 }
  return -1
}

fn radix_decimal(src: view String, start: Int, end: Int, radix: Int) -> String {
  let base = 1000000000
  var hi = 0
  var lo = 0
  var j = start
  while j < end {
    let d = hex_value(src.byte(j))
    if d >= 0 {
      let next_lo = lo * radix + d
      lo = next_lo % base
      hi = hi * radix + next_lo / base
    }
    j = j + 1
  }
  if hi == 0 { return "{lo}" }
  let lo_str = "{lo}"
  var zeros = String.new()
  var k = lo_str.len()
  while k < 9 {
    zeros.push_byte(48)
    k = k + 1
  }
  return "{hi}{zeros}{lo_str}"
}

fn emit_interp(parts: view List<Part>, count: Int, line: Int) {
  if count == 0 {
    emit(line, "Id:", String.from("String"))
    emit(line, "Sym:", String.from("."))
    emit(line, "Id:", String.from("new"))
    emit_row(line, String.from("Sym:28"))
    emit_row(line, String.from("Sym:29"))
    return
  }
  if parts.at(count - 1).expr { emit(line, "Id:", String.from("std__fmt_val")) }
  else { emit(line, "Id:", String.from("std__fmt_lit")) }
  emit_row(line, String.from("Sym:28"))
  emit_interp(parts, count - 1, line)
  emit_row(line, String.from("Sym:2c"))
  if parts.at(count - 1).expr { lex(parts.at(count - 1).text, false, line % 1000000, line >= 1000000, parts.at(count - 1).line, parts.at(count - 1).col) }
  else { emit(line, "Str:", parts.at(count - 1).text) }
  emit_row(line, String.from("Sym:29"))
}

fn line_at(src: view String, at: Int) -> Int {
  var line = 1
  var i = 0
  while i < at {
    if src.byte(i) == 10 { line = line + 1 }
    i = i + src.char_size(i)
  }
  return line
}

fn col_at(src: view String, at: Int) -> Int {
  var col = 1
  var i = 0
  while i < at {
    if src.byte(i) == 10 { col = 1 }
    else { col = col + 1 }
    i = i + src.char_size(i)
  }
  return col
}

// `ol`/`oc`: where the first character of `src` is in the file (1, 1 for the file itself; the position of an
// interpolated expression inside its string), so a nested error is reported where the Rust lexer reports it.
fn report_error(src: view String, ol: Int, oc: Int, message: view String, at: Int, len: Int, note1: Text, note2: Text) {
  let m = String.from(message)
  let found_line = line_at(src, at)
  var found_col = col_at(src, at)
  if found_line == 1 { found_col = found_col + oc - 1 }
  print("Error:{hex(m)}:{found_line + ol - 1}:{found_col}:{len}")
  if note1 != "" { print("Note:{hex(String.from(note1))}") }
  if note2 != "" { print("Note:{hex(String.from(note2))}") }
  env.exit(1)
}

fn print_interp_arg(src: view String, end: Int) -> Bool {
  var j = end
  while j < src.len() && src.byte(j) == 32 { j = j + 1 }
  if j >= src.len() || src.byte(j) != 40 { return false }
  j = j + 1
  while j < src.len() && src.byte(j) == 32 { j = j + 1 }
  if j >= src.len() || src.byte(j) != 34 { return false }
  j = j + 1
  var interp = false
  while j < src.len() && src.byte(j) != 34 && src.byte(j) != 10 {
    if src.byte(j) == 92 { j = j + 2 }
    else if src.byte(j) == 123 && j + 1 < src.len() {
      if src.byte(j + 1) == 123 { j = j + 2 }
      else {
        interp = true
        j = j + 1
        var scanning = true
        while scanning && j < src.len() && src.byte(j) != 125 && src.byte(j) != 10 {
          if src.byte(j) == 34 {
            j = j + 1
            while j < src.len() && src.byte(j) != 34 && src.byte(j) != 10 {
              if src.byte(j) == 92 { j = j + 2 } else { j = j + 1 }
            }
            if j >= src.len() || src.byte(j) != 34 { scanning = false }
          }
          if scanning { j = j + 1 }
        }
        if j < src.len() && src.byte(j) == 125 { j = j + 1 }
      }
    }
    else { j = j + 1 }
  }
  if !interp || j >= src.len() || src.byte(j) != 34 { return false }
  j = j + 1
  while j < src.len() && src.byte(j) == 32 { j = j + 1 }
  return j < src.len() && src.byte(j) == 41
}

fn main() {
  let path = env.arg(1)
  match path {
    None => { print("usage: lexer.yx file.yx"); return }
    Some(p) => {
      match fs.read_to_string(p) {
        Err(e) => { print("could not read {p}: {e.message}"); env.exit(2); return }
        Ok(src) => {
          var line = 0
          var columns = false
          match env.arg(2) {
            Some(flag) => { if flag == "--positioned" { line = 1 } }
            None => {}
          }
          match env.arg(3) {
            Some(flag) => { if flag == "--columns" { columns = true } }
            None => {}
          }
          lex(src, true, line, columns, 1, 1)
        }
      }
    }
  }
}

// 1-based column of byte offset `at` in the line that starts at `start`
fn column_of(src: view String, start: Int, at: Int) -> Int {
  var col = 1
  var i = start
  while i < at {
    col = col + 1
    i = i + src.char_size(i)
  }
  return col
}

fn raw_start(src: view String, at: Int) -> Bool {
  var j = at + 1
  while j < src.len() && src.byte(j) == 35 { j = j + 1 }
  return j < src.len() && src.byte(j) == 34
}

fn raw_closes(src: view String, at: Int, hashes: Int) -> Bool {
  if src.byte(at) != 34 { return false }
  var h = 1
  while h <= hashes {
    if at + h >= src.len() || src.byte(at + h) != 35 { return false }
    h = h + 1
  }
  return true
}

// Rust's char::is_whitespace follows Unicode White_Space; only LF starts a new source line.
fn unicode_space(c: Int) -> Bool {
  return c == 133 || c == 160 || c == 5760 || (c >= 8192 && c <= 8202) ||
    c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288
}

fn integer_suffix(s: view String) -> Bool {
  return s == "i8" || s == "i16" || s == "i32" || s == "i64" ||
    s == "u8" || s == "u16" || s == "u32" || s == "u64"
}

fn lex(src: view String, eof: Bool, first_line: Int, columns: Bool, ol: Int, oc: Int) {
  var line = first_line
  var line_start = 0
  let n = src.len()
  var i = 0
  while i < n {
    let b = src.byte(i)
    var tokpos = line
    if columns && line > 0 {
      var column = column_of(src, line_start, i)
      // an interpolated expression starts at column `oc` of its file
      if !eof { column = column + oc - 1 }
      tokpos = line + 1000000 * column
    }
    if (b >= 9 && b <= 13) || b == 32 {
      if b == 10 && line > 0 { line = line + 1; line_start = i + 1 }
      i = i + 1
    }
    else if b >= 128 && unicode_space(src.char_at(i).to_int()) {
      i = i + src.char_size(i)
    }
    else if b == 47 && i + 1 < n && src.byte(i + 1) == 47 {
      while i < n && src.byte(i) != 10 { i = i + 1 }
    }
    else if b == 114 && raw_start(src, i) {
      var hashes = 0
      i = i + 1
      while src.byte(i) == 35 { hashes = hashes + 1; i = i + 1 }
      i = i + 1
      let body = i
      while i < n && src.byte(i) != 10 && !raw_closes(src, i, hashes) { i = i + 1 }
      if i >= n || src.byte(i) == 10 { report_error(src, ol, oc, "this raw string is not closed on its line", body - hashes - 2, 1, "a raw string ends with a quote followed by as many `#` as it started with: r#\"{{\"a\": 1}}\"#; it must fit on one line, so a closing quote on a later line does not count", "help: write the text on one line, or join lines with interpolation or `push_str`") }
      emit(tokpos, "Str:", src.slice(body, i))
      i = i + 1 + hashes
    }
    else if is_alpha(b) {
      let start = i
      i = i + 1
      while i < n && is_alnum(src.byte(i)) { i = i + 1 }
      let ident = src.slice(start, i)
      if ident == "print" && print_interp_arg(src, i) {
        emit(tokpos, "Id:", String.from("std__print_owned"))
      } else { emit(tokpos, "Id:", src.slice(start, i)) }
    }
    else if is_digit(b) {
      let start = i
      var radix = 10
      if b == 48 && i + 1 < n && (src.byte(i + 1) == 120 || src.byte(i + 1) == 88) {
        radix = 16
        i = i + 2
      } else if b == 48 && i + 1 < n && (src.byte(i + 1) == 98 || src.byte(i + 1) == 66) {
        radix = 2
        i = i + 2
      }
      let digits_start = i
      if radix == 10 {
        while i < n && (is_digit(src.byte(i)) || src.byte(i) == 95) { i = i + 1 }
      } else {
        while i < n {
          let byte = src.byte(i)
          let digit = hex_value(byte)
          if byte != 95 && (digit < 0 || digit >= radix) { break }
          i = i + 1
        }
      }
      let integer_end = i
      var is_float = false
      if radix == 10 && i + 1 < n && src.byte(i) == 46 && is_digit(src.byte(i + 1)) {
        is_float = true
        i = i + 1
        while i < n && (is_digit(src.byte(i)) || src.byte(i) == 95) { i = i + 1 }
      }
      if radix == 10 && i + 1 < n && (src.byte(i) == 101 || src.byte(i) == 69) {
        var epos = i + 1
        if src.byte(epos) == 43 || src.byte(epos) == 45 { epos = epos + 1 }
        if epos < n && is_digit(src.byte(epos)) {
          is_float = true
          i = epos + 1
          while i < n && is_digit(src.byte(i)) { i = i + 1 }
        }
      }
      let core_end = i
      while i < n && is_alnum(src.byte(i)) { i = i + 1 }
      let raw = src.slice(start, i)
      let core = src.slice(start, core_end).replace("_", "")
      let suffix = raw.slice(core_end - start, raw.len())
      if radix != 10 {
        if core.len() == 2 {
          var prefix = String.from("0b")
          if radix == 16 { prefix = String.from("0x") }
          report_error(src, ol, oc, "expected digits after `{prefix}`", start, core_end - start, "", "")
        }
        if suffix.len() > 0 && !integer_suffix(suffix) {
          report_error(src, ol, oc, "unexpected letters after a number", start, core_end + 1 - start, "", "")
        }
      }
      if is_float || suffix == "f32" || suffix == "f64" {
        let row = "Float:{hex(core)}:{suffix}"; emit_row(tokpos, row)
      } else if radix != 10 {
        // significant digits (no `_`, no leading zeros): more than 16 hex or 64 binary digits cannot be a UInt64
        var significant = 0
        var first_digit = 0
        var j = digits_start
        while j < integer_end {
          let d = hex_value(src.byte(j))
          if d >= 0 {
            if significant == 0 && d != 0 { first_digit = d }
            if significant > 0 || d != 0 { significant = significant + 1 }
          }
          j = j + 1
        }
        var limit = 16
        if radix == 2 { limit = 64 }
        if significant > limit { report_error(src, ol, oc, "number too large (the largest is 18446744073709551615)", start, i - start, "", "") }
        // up to 63 bits the value fits an Int; values in [2^63, 2^64 - 1] emit NumT as decimal text
        var fits = significant < limit || (radix == 16 && significant == 16 && first_digit < 8)
        if radix == 2 && significant == 64 { fits = false }
        if radix == 16 && significant == 16 && first_digit >= 8 { fits = false }
        if fits {
          var value = 0
          j = digits_start
          while j < integer_end {
            let d = hex_value(src.byte(j))
            if d >= 0 { value = value * radix + d }
            j = j + 1
          }
          if suffix.len() == 0 { let row = "Num:{value}"; emit_row(tokpos, row) }
          else { let row = "NumT:{value}:{suffix}"; emit_row(tokpos, row) }
        } else {
          let dec = radix_decimal(src, digits_start, integer_end, radix)
          let row = "NumT:{dec}:{suffix}"
          emit_row(tokpos, row)
        }
      } else {
        var value = 0
        if core.parse_int(value) {
          if suffix.len() == 0 { let row = "Num:{value}"; emit_row(tokpos, row) }
          else { let row = "NumT:{value}:{suffix}"; emit_row(tokpos, row) }
        } else {
          let unsigned_max = String.from("18446744073709551615")
          if core.len() < unsigned_max.len() || (core.len() == unsigned_max.len() && core <= unsigned_max) {
            let row = "NumT:{core}:{suffix}"; emit_row(tokpos, row)
          } else { report_error(src, ol, oc, "number too large (the largest is 18446744073709551615, written as UInt64)", start, i - start, "", "") }
        }
      }
    }
    else if b == 39 {
      var j = i + 1
      var value = 0
      if src.byte(j) == 92 {
        j = j + 1
        let e = src.byte(j)
        if e == 110 { value = 10; j = j + 1 }
        else if e == 116 { value = 9; j = j + 1 }
        else if e == 114 { value = 13; j = j + 1 }
        else if e == 48 { value = 0; j = j + 1 }
        else if e == 39 || e == 34 || e == 92 { value = e; j = j + 1 }
        else if e == 117 && j + 1 < n && src.byte(j + 1) == 123 {
          j = j + 2
          var invalid_hex = false
          while j < n && src.byte(j) != 125 {
            let d = hex_value(src.byte(j))
            if d >= 0 { value = value * 16 + d }
            else { invalid_hex = true }
            j = j + 1
          }
          if j < n { j = j + 1 }
          if invalid_hex || value == 0 { report_error(src, ol, oc, "expected hexadecimal digits in \\u{{..}} escape", i, j - i, "a Char literal holds exactly one Unicode character: 'a', 'é', '\\n', '\\u{{1F600}}'; use \"..\" for text", "") }
          if value > 1114111 || (value >= 55296 && value <= 57343) { report_error(src, ol, oc, "this is not a valid Unicode scalar value", i, j - i, "a Char literal holds exactly one Unicode character: 'a', 'é', '\\n', '\\u{{1F600}}'; use \"..\" for text", "") }
        } else if e == 10 || e == 0 {
          report_error(src, ol, oc, "unterminated character literal", i, 1, "", "")
        } else {
          report_error(src, ol, oc, "unknown escape in a character literal", i, (j + 1 - i).max(2), "a Char literal holds exactly one Unicode character: 'a', 'é', '\\n', '\\u{{1F600}}'; use \"..\" for text", "")
        }
      } else {
        if src.byte(j) == 39 { report_error(src, ol, oc, "empty character literal", i, 2, "a Char literal holds exactly one Unicode character: 'a', 'é', '\\n', '\\u{{1F600}}'; use \"..\" for text", "") }
        if src.byte(j) == 10 || src.byte(j) == 0 { report_error(src, ol, oc, "unterminated character literal", i, 1, "", "") }
        value = src.char_at(j).to_int()
        j = j + src.char_size(j)
      }
      if j < n && src.byte(j) == 39 { j = j + 1 }
      else { report_error(src, ol, oc, "a character literal must contain exactly one character", i, (j - i).max(1), "a Char literal holds exactly one Unicode character: 'a', 'é', '\\n', '\\u{{1F600}}'; use \"..\" for text", "") }
      let row = "Char:{value}"; emit_row(tokpos, row)
      i = j
    }
    else if b == 34 {
      let quote = i
      i = i + 1
      var value = String.new()
      var parts = List<Part>.new()
      var interpolated = false
      while i < n && src.byte(i) != 34 && src.byte(i) != 10 {
        if src.byte(i) == 92 && i + 1 < n {
          let e = src.byte(i + 1)
          if e == 110 { value.push_byte(10) }
          else if e == 116 { value.push_byte(9) }
          else if e == 114 { value.push_byte(13) }
          else if e == 34 || e == 92 { value.push_byte(e) }
          else {
            let escaped = src.slice(i, i + 2)
            let prefix = String.from("unknown escape sequence ")
            let first = String.concat(prefix, escaped)
            let message = String.concat(first, " in a string")
            report_error(src, ol, oc, message, i, 2, "escapes: \\n (newline), \\t (tab), \\r, \\\" (quote), \\\\ (backslash); write {{{{ and }}}} for literal braces", "")
          }
          i = i + 2
        } else if (src.byte(i) == 123 || src.byte(i) == 125) && i + 1 < n && src.byte(i + 1) == src.byte(i) {
          value.push_byte(src.byte(i))
          i = i + 2
        } else if src.byte(i) == 125 {
          report_error(src, ol, oc, "a lone `}}` in a string", i, 1, "write `}}}}` for a literal brace, or `{{name}}` to insert a value", "")
        } else if src.byte(i) == 123 {
          var j = i + 1
          var scanning = true
          while scanning && j < n && src.byte(j) != 125 && src.byte(j) != 10 {
            if src.byte(j) == 34 {
              j = j + 1
              while j < n && src.byte(j) != 34 && src.byte(j) != 10 {
                if src.byte(j) == 92 { j = j + 2 } else { j = j + 1 }
              }
              if j >= n || src.byte(j) != 34 { scanning = false }
            }
            if scanning { j = j + 1 }
          }
          if j < n && src.byte(j) == 125 {
            let expression = src.slice(i + 1, j)
            if expression.trim().len() == 0 { report_error(src, ol, oc, "empty `{{}}` in a string", i, 1, "write `{{}}` for literal braces, or put a value inside: \\\"x = {{x}}\\\"", "") }
            if value.len() > 0 {
              parts.push(Part { expr: false, text: move value, line: 0, col: 0 })
              value = String.new()
            }
            var expr_col = col_at(src, i + 1)
            if line_at(src, i + 1) == 1 { expr_col = expr_col + oc - 1 }
            parts.push(Part { expr: true, text: move expression, line: line_at(src, i + 1) + ol - 1, col: expr_col })
            interpolated = true
            i = j + 1
          } else {
            report_error(src, ol, oc, "this `{{` in a string is never closed", i, 1, "string interpolation looks like \"x = {{x}}\"; the expression may contain string literals but must end with `}}` on the same line", "write `{{{{` for a literal brace")
          }
        } else {
          value.push_byte(src.byte(i))
          i = i + 1
        }
      }
      if i >= n || src.byte(i) != 34 { report_error(src, ol, oc, "unterminated string", quote, 1, "", "") }
      i = i + 1
      if interpolated {
        if value.len() > 0 { parts.push(Part { expr: false, text: move value, line: 0, col: 0 }) }
        emit_interp(parts, parts.len(), tokpos)
      } else { emit(tokpos, "Str:", value) }
    }
    else {
      if b >= 128 {
        report_error(src, ol, oc, String.concat("unexpected character '", String.concat(src.slice(i, i + src.char_size(i)), "'")), i, 1, "", "")
      } else {
      var three = String.new()
      var two = String.new()
      if i + 2 < n && src.byte(i + 1) < 128 && src.byte(i + 2) < 128 { three = src.slice(i, i + 3) }
      if i + 1 < n && src.byte(i + 1) < 128 { two = src.slice(i, i + 2) }
      if three == "..=" { emit(tokpos, "Sym:", three); i = i + 3 }
      else if two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "->" || two == "=>" || two == ".." {
        emit(tokpos, "Sym:", two); i = i + 2
      }
      else {
        let one = src.slice(i, i + 1)
        if one == "(" || one == ")" || one == "{{" || one == "}}" || one == "[" || one == "]" || one == "," || one == ":" || one == ";" || one == "=" || one == "<" || one == ">" || one == "+" || one == "-" || one == "*" || one == "/" || one == "%" || one == "!" || one == "." || one == "|" || one == "@" || one == "?" {
          emit(tokpos, "Sym:", one); i = i + 1
        } else {
          report_error(src, ol, oc, String.concat("unexpected character '", String.concat(one, "'")), i, 1, "", "")
        }
      }
      }
    }
  }
  if eof { emit_row(line, String.from("Eof")) }
}
