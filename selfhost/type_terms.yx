// Canonical type spellings and substitutions for nominal generic types.
pub struct Substitution { names: List<String>, values: List<String> }

pub fn empty() -> Substitution {
  return Substitution { names: List<String>.new(), values: List<String>.new() }
}

pub fn copy(sub: view Substitution) -> Substitution {
  var result = with_names(sub.names)
  for i in 0..sub.values.len() { result.values.set(i, String.from(sub.values.at(i))) }
  return move result
}

pub fn base(ty: view String) -> String {
  if ty.starts_with("fn(") { return String.from(ty) }
  for i in 0..ty.len() {
    if ty.byte(i) == 60 { return ty.slice(0, i) }
  }
  return String.from(ty)
}

fn split_types(ty: view String, first: Int, end: Int) -> List<String> {
  var args = List<String>.new()
  if first == end { return move args }
  var start = first
  var depth = 0
  for i in first..end {
    let b = ty.byte(i)
    if b == 60 || b == 40 { depth = depth + 1 }
    if b == 41 || (b == 62 && ty.byte(i - 1) != 45) { depth = depth - 1 }
    if b == 44 && depth == 0 {
      args.push(ty.slice(start, i))
      start = i + 2
    }
  }
  args.push(ty.slice(start, end))
  return move args
}

pub fn arguments(ty: view String) -> List<String> {
  let name = base(ty)
  if name.len() == ty.len() { return List<String>.new() }
  return split_types(ty, name.len() + 1, ty.len() - 1)
}

pub fn box_payload(ty: view String) -> String {
  if !ty.starts_with("Box<") { return String.from("?") }
  return ty.slice(4, ty.len() - 1)
}

pub fn dyn_trait(ty: view String) -> String {
  if !ty.starts_with("$dyn<") { return String.new() }
  return ty.slice(5, ty.len() - 1)
}

// The last component is the result. The other components preserve parameter modes.
pub fn function_parts(ty: view String) -> List<String> {
  var depth = 1
  for i in 3..ty.len() {
    let b = ty.byte(i)
    if b == 40 { depth = depth + 1 }
    if b == 41 { depth = depth - 1 }
    if depth == 0 {
      var parts = split_types(ty, 3, i)
      if i + 1 == ty.len() { parts.push(String.from("nothing")) }
      else { parts.push(ty.slice(i + 5, ty.len())) }
      return move parts
    }
  }
  return List<String>.new()
}

pub fn parameter_prefix(ty: view String) -> Int {
  if ty.starts_with("view ") { return 5 }
  if ty.starts_with("mut ") { return 4 }
  return 0
}

pub fn apply(name: view String, args: view List<String>) -> String {
  if args.len() == 0 { return String.from(name) }
  if name == "List" && args.len() == 1 && args.at(0) == "Int" { return String.from(name) }
  let values = args.join(", ")
  return "{name}<{values}>"
}

pub fn bind(sub: mut Substitution, pattern: view String, actual: view String) {
  if actual == "?" { return }
  if sub.names.contains(pattern) {
    let index = sub.names.index_of(pattern)
    if sub.values.at(index) == "?" { sub.values.set(index, String.from(actual)) }
    return
  }
  let mode = parameter_prefix(pattern)
  if mode != 0 || parameter_prefix(actual) != 0 {
    if mode == parameter_prefix(actual) {
      bind(sub, pattern.slice(mode, pattern.len()), actual.slice(mode, actual.len()))
    }
    return
  }
  if pattern.starts_with("fn(") && actual.starts_with("fn(") {
    let formal = function_parts(pattern)
    let concrete = function_parts(actual)
    if formal.len() == concrete.len() {
      for i in 0..formal.len() { bind(sub, formal.at(i), concrete.at(i)) }
    }
    return
  }
  let name = base(pattern)
  if name != base(actual) { return }
  let formal = arguments(pattern)
  var concrete = arguments(actual)
  if actual == "List" && formal.len() == 1 { concrete.push(String.from("Int")) }
  if formal.len() == concrete.len() {
    for i in 0..formal.len() { bind(sub, formal.at(i), concrete.at(i)) }
  }
}

pub fn substitute(ty: view String, sub: view Substitution) -> String {
  let index = sub.names.index_of(ty)
  if index >= 0 { return String.from(sub.values.at(index)) }
  let mode = parameter_prefix(ty)
  if mode != 0 {
    let prefix = ty.slice(0, mode)
    let value = substitute(ty.slice(mode, ty.len()), sub)
    return "{prefix}{value}"
  }
  if ty.starts_with("fn(") {
    var parts = function_parts(ty)
    let result = substitute(parts.pop(), sub)
    var params = List<String>.new()
    for part in parts { params.push(substitute(part, sub)) }
    let text = params.join(", ")
    if result == "nothing" { return "fn({text})" }
    return "fn({text}) -> {result}"
  }
  let args = arguments(ty)
  if args.len() == 0 { return String.from(ty) }
  var values = List<String>.new()
  for arg in args { values.push(substitute(arg, sub)) }
  return apply(base(ty), values)
}

pub fn with_names(names: view List<String>) -> Substitution {
  var sub = empty()
  for name in names {
    sub.names.push(String.from(name))
    sub.values.push(String.from("?"))
  }
  return move sub
}

pub fn mentions(ty: view String, names: view List<String>) -> Bool {
  if names.contains(ty) { return true }
  let mode = parameter_prefix(ty)
  if mode != 0 { return mentions(ty.slice(mode, ty.len()), names) }
  var args = arguments(ty)
  if ty.starts_with("fn(") { args = function_parts(ty) }
  for arg in args { if mentions(arg, names) { return true } }
  return false
}

pub fn compatible(expected: view String, actual: view String) -> Bool {
  return compatible_type(expected, actual, false)
}

fn compatible_type(expected: view String, actual: view String, exact_ranges: Bool) -> Bool {
  if expected == actual || expected == "?" || actual == "?" { return true }
  let mode = parameter_prefix(expected)
  if mode != 0 || parameter_prefix(actual) != 0 {
    return mode == parameter_prefix(actual) &&
      compatible_type(expected.slice(mode, expected.len()), actual.slice(mode, actual.len()), exact_ranges)
  }
  var a = List<String>.new()
  var b = List<String>.new()
  var strict = exact_ranges
  if expected.starts_with("fn(") && actual.starts_with("fn(") {
    strict = true
    a = function_parts(expected)
    b = function_parts(actual)
  } else {
    let name = base(expected)
    if name != base(actual) { return false }
    if name == "Int" { return !strict }
    a = arguments(expected)
    b = arguments(actual)
    if name == "List" {
      if expected == "List" { a.push(String.from("Int")) }
      if actual == "List" { b.push(String.from("Int")) }
    }
  }
  if a.len() != b.len() || a.len() == 0 { return false }
  for i in 0..a.len() {
    if !compatible_type(a.at(i), b.at(i), strict) { return false }
  }
  return true
}

pub fn element(ty: view String) -> String {
  let name = base(ty)
  if name != "List" && name != "Array" && name != "Slice" { return String.from("?") }
  let args = arguments(ty)
  if ty == "List" { return String.from("Int") }
  if args.len() == 0 { return String.from("?") }
  return String.from(args.at(0))
}

pub fn bracket(item: view String, size: view String) -> String {
  if size == "_" { return "Slice<{item}>" }
  return "Array<{item}, {size}>"
}

pub fn last_name(name: view String) -> String {
  let components = name.split(".")
  return String.from(components.at(components.len() - 1))
}
