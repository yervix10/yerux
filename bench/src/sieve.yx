fn main() {
  let n = 10000000
  var flags = List<Bool>.new()
  var i = 0
  while i <= n {
    flags.push(true)
    i = i + 1
  }
  flags.set(0, false)
  flags.set(1, false)
  i = 2
  while i * i <= n {
    if flags.get(i) {
      var j = i * i
      while j <= n {
        flags.set(j, false)
        j = j + i
      }
    }
    i = i + 1
  }
  var count = 0
  var last = 0
  i = 0
  while i <= n {
    if flags.get(i) {
      count = count + 1
      last = i
    }
    i = i + 1
  }
  print(count)
  print(last)
}
