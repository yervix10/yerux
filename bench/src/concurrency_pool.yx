fn work(item: Int) -> Int {
  var value = item + 1
  for _ in 0..12000 { value = (value * 1103515245 + 12345) % 2147483647 }
  return value
}

fn main() {
  var pool = thread_pool_new(4)
  var total = 0
  for _ in 0..4 {
    let values = thread_pool_map(pool, 0, 5000, |i| work(i))
    for value in values { total = total + value }
  }
  pool.close()
  print(total)
}
