enum Tree {
  Leaf,
  Branch(Box<Tree>, Box<Tree>),
}

fn make(depth: Int) -> Box<Tree> {
  if depth == 0 { return Box.new(Tree.Leaf) }
  return Box.new(Tree.Branch(make(depth - 1), make(depth - 1)))
}

fn check(tree: view Tree) -> Int {
  match tree {
    Leaf => { return 1 }
    Branch(left, right) => { return 1 + check(left.get()) + check(right.get()) }
  }
}

fn main() {
  let stretch = make(18)
  print(check(stretch.get()))
  let long_lived = make(17)
  var count = 0
  var depth = 4
  var iterations = 8192
  while depth <= 16 {
    var i = 0
    while i < iterations {
      let tree = make(depth)
      count = count + check(tree.get())
      i = i + 1
    }
    depth = depth + 2
    iterations = iterations / 4
  }
  print(count)
  print(check(long_lived.get()))
}
