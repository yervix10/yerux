// Blend two images stored in List<Byte> (Byte = Int<0..255>): values loaded from the lists carry their range,
// so `a * (255 - t) + b * t` needs no overflow checks and the division result is proven to be a Byte.
type Byte = Int<0..255>

fn blend(a: view List<Byte>, b: view List<Byte>, out: mut List<Byte>, t: Byte) {
  let n = a.len()
  if b.len() < n || out.len() < n { return }
  for i in 0..n {
    // intervals are not relational (a*(255-t) + b*t <= 130050 gives <= 510), so cap the result: free, no runtime test
    let v: Byte = min((a.get(i) * (255 - t) + b.get(i) * t) / 255, 255)
    out.set(i, v)
  }
}

fn main() {
  var a = List<Byte>.new()
  var b = List<Byte>.new()
  var out = List<Byte>.new()
  for i in 0..1000000 {
    a.push(i % 256)
    b.push((i * 7) % 256)
    out.push(0)
  }
  var sum = 0
  for r in 0..200 {
    blend(a, b, out, r % 256)
    sum = (sum + out.get(r * 997 % 1000000)) % 1000003
  }
  print(sum)
}
