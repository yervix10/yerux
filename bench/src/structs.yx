struct Particle { x: Int, y: Int, vx: Int, vy: Int }

fn step(p: Particle) -> Particle {
  var q = p
  q.x = q.x + q.vx
  q.y = q.y + q.vy
  q.vy = q.vy + 1
  if q.x > 1000000 { q.vx = 0 - q.vx }
  if q.x < 0 { q.vx = 0 - q.vx }
  if q.y > 1000000 { q.vy = 0 - q.vy }
  if q.y < 0 { q.vy = 0 - q.vy }
  return q
}

fn main() {
  let n = 1000
  var ps = List<Particle>.new()
  var i = 0
  while i < n {
    ps.push(Particle { x: i * 997 % 1000000, y: i * 331 % 1000000, vx: i % 17 + 1, vy: i % 13 + 1 })
    i = i + 1
  }
  var t = 0
  while t < 100000 {
    i = 0
    while i < n {
      ps.set(i, step(ps.get(i)))
      i = i + 1
    }
    t = t + 1
  }
  var sum = 0
  i = 0
  while i < n {
    let p = ps.get(i)
    sum = sum + p.x + p.y * 3 + p.vx * 5 + p.vy * 7
    i = i + 1
  }
  print(sum)
}
