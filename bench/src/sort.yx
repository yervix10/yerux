// bottom-up merge sort on List<Int>, 200k elements, ping-pong buffers
fn pass(src: view List<Int>, dst: mut List<Int>, n: Int, w: Int) {
  var lo = 0
  while lo < n {
    var mid = lo + w
    if mid > n { mid = n }
    var hi = mid + w
    if hi > n { hi = n }
    var i = lo
    var j = mid
    var k = lo
    while i < mid && j < hi {
      let a = src.get(i)
      let b = src.get(j)
      if a <= b {
        dst.set(k, a)
        i = i + 1
      } else {
        dst.set(k, b)
        j = j + 1
      }
      k = k + 1
    }
    while i < mid {
      dst.set(k, src.get(i))
      i = i + 1
      k = k + 1
    }
    while j < hi {
      dst.set(k, src.get(j))
      j = j + 1
      k = k + 1
    }
    lo = lo + w + w
  }
}

fn checksum(l: view List<Int>) -> Int {
  var s = 0
  var i = 0
  while i < l.len() {
    s = s + l.get(i) * (i % 10)
    i = i + 1
  }
  return s
}

fn main() {
  let n = 200000
  var a = List<Int>.new()
  var b = List<Int>.new()
  var x = 12345
  var grand = 0
  var round = 0
  while round < 10 {
    a.clear()
    b.clear()
    var i = 0
    while i < n {
      x = (x * 1103515245 + 12345) % 2147483648
      a.push(x)
      b.push(0)
      i = i + 1
    }
    var w = 1
    var flip = 0
    while w < n {
      if flip == 0 {
        pass(a, b, n, w)
        flip = 1
      } else {
        pass(b, a, n, w)
        flip = 0
      }
      w = w * 2
    }
    if flip == 0 {
      grand = (grand + a.get(0) + a.get(n - 1) + checksum(a)) % 1000000007
    } else {
      grand = (grand + b.get(0) + b.get(n - 1) + checksum(b)) % 1000000007
    }
    round = round + 1
  }
  print(grand)
}
