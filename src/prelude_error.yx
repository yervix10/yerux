// error context: `r.context("reading config")?` fails with "reading config: <cause>"
impl<T, E: Show> Result<T, E> {
    fn context(self, msg: view String) -> Result<T, String> {
        match move self {
            Ok(v) => { return Ok(move v) }
            Err(e) => {
                let cause = e.show()
                return Err("{msg}: {cause}")
            }
        }
    }

    // same, building the message only on failure
    fn with_context(self, f: fn() -> String) -> Result<T, String> {
        match move self {
            Ok(v) => { return Ok(move v) }
            Err(e) => {
                let cause = e.show()
                let msg = f()
                return Err("{msg}: {cause}")
            }
        }
    }

    fn wrap(self, msg: view String) -> Result<T, String> {
        return self.context(msg)
    }
}

impl<T> Option<T> {
    // a missing value becomes an error with a message
    fn context(self, msg: view String) -> Result<T, String> {
        match move self {
            Some(v) => { return Ok(move v) }
            None => { return Err(String.from(msg)) }
        }
    }
}
