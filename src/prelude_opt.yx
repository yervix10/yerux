// Option<T> and Result<T, E>: ordinary generic enums with a few helper methods (no closures needed).
//
//   fn find(l: view List<Int>, x: Int) -> Option<Int>      Some(i) / None
//   fn parse(s: view String) -> Result<Int, String>        Ok(n) / Err("message")
//   let n = parse(s)?            early-returns the error from a function that returns a Result

enum Option<T> {
    Some(T),
    None,
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T> Option<T> {
    fn is_some(view self) -> Bool {
        match self {
            Some(_) => {
                return true
            }
            None => {
                return false
            }
        }
    }

    fn is_none(view self) -> Bool {
        match self {
            Some(_) => {
                return false
            }
            None => {
                return true
            }
        }
    }

    // The value inside; panics when there is none.
    fn unwrap(self) -> T {
        match move self {
            Some(v) => {
                return v
            }
            None => {
                panic("called `Option.unwrap()` on a `None` value")
            }
        }
    }

    // Like unwrap, with your own message.
    fn expect(self, msg: view String) -> T {
        match move self {
            Some(v) => {
                return v
            }
            None => {
                panic(msg)
            }
        }
    }

    fn unwrap_or(self, d: T) -> T {
        match move self {
            Some(v) => {
                return v
            }
            None => {
                return d
            }
        }
    }

    // Some(v) becomes Ok(v), None becomes Err(msg). Methods cannot be generic yet, so the error is a
    // String (like `context`); for another error type use the free function `ok_or(opt, e)`.
    fn ok_or(self, msg: view String) -> Result<T, String> {
        match move self {
            Some(v) => {
                return Result.Ok(move v)
            }
            None => {
                return Result.Err(String.from(msg))
            }
        }
    }

    // Methods with type parameters of their own (`map<U>`): the closure's result type is inferred.
    // The value inside, transformed; None stays None.
    fn map<U>(self, f: view fn(T) -> U) -> Option<U> {
        match move self {
            Some(v) => {
                return Option.Some(f(move v))
            }
            None => {
                return Option.None
            }
        }
    }

    // `f` applied to the value; the result is itself an Option (None stays None).
    fn and_then<U>(self, f: view fn(T) -> Option<U>) -> Option<U> {
        match move self {
            Some(v) => {
                return f(move v)
            }
            None => {
                return Option.None
            }
        }
    }

    // The value, or what `f` makes when there is none.
    fn unwrap_or_else(self, f: view fn() -> T) -> T {
        match move self {
            Some(v) => {
                return v
            }
            None => {
                return f()
            }
        }
    }

    // `self` when it has a value that `f` accepts, else None.
    fn filter(self, f: view fn(view T) -> Bool) -> Option<T> {
        match move self {
            Some(v) => {
                if f(v) {
                    return Option.Some(move v)
                }
                return Option.None
            }
            None => {
                return Option.None
            }
        }
    }

    // True when there is a value and `f` accepts it.
    fn is_some_and(view self, f: view fn(view T) -> Bool) -> Bool {
        match self {
            Some(v) => {
                return f(v)
            }
            None => {
                return false
            }
        }
    }

    // Some(v) becomes Ok(v), None becomes Err(f()).
    fn ok_or_else<E>(self, f: view fn() -> E) -> Result<T, E> {
        match move self {
            Some(v) => {
                return Result.Ok(move v)
            }
            None => {
                return Result.Err(f())
            }
        }
    }

    // `self` if it has a value, else `other`.
    fn or(self, other: Option<T>) -> Option<T> {
        match move self {
            Some(v) => {
                return Option.Some(move v)
            }
            None => {
                return other
            }
        }
    }
}

// ok_or(opt, err): Some(v) becomes Ok(v), None becomes Err(err)
fn ok_or<T, E>(o: Option<T>, e: E) -> Result<T, E> {
    match move o {
        Some(v) => {
            return Result.Ok(move v)
        }
        None => {
            return Result.Err(move e)
        }
    }
}

impl<T, E> Result<T, E> {
    fn is_ok(view self) -> Bool {
        match self {
            Ok(_) => {
                return true
            }
            Err(_) => {
                return false
            }
        }
    }

    fn is_err(view self) -> Bool {
        match self {
            Ok(_) => {
                return false
            }
            Err(_) => {
                return true
            }
        }
    }

    // The success value as an Option (the error is dropped).
    fn ok(self) -> Option<T> {
        match move self {
            Ok(v) => {
                return Option.Some(move v)
            }
            Err(_) => {
                return Option.None
            }
        }
    }

    // The error as an Option (the success value is dropped).
    fn err(self) -> Option<E> {
        match move self {
            Ok(_) => {
                return Option.None
            }
            Err(e) => {
                return Option.Some(move e)
            }
        }
    }

    fn unwrap_or(self, d: T) -> T {
        match move self {
            Ok(v) => {
                return v
            }
            Err(_) => {
                return d
            }
        }
    }

    // The success value, transformed; an error stays as it is.
    fn map<U>(self, f: view fn(T) -> U) -> Result<U, E> {
        match move self {
            Ok(v) => {
                return Result.Ok(f(move v))
            }
            Err(e) => {
                return Result.Err(move e)
            }
        }
    }

    // The error, transformed; a success stays as it is.
    fn map_err<F>(self, f: view fn(E) -> F) -> Result<T, F> {
        match move self {
            Ok(v) => {
                return Result.Ok(move v)
            }
            Err(e) => {
                return Result.Err(f(move e))
            }
        }
    }

    // `f` applied to the success value; the result is itself a Result with the same error type.
    fn and_then<U>(self, f: view fn(T) -> Result<U, E>) -> Result<U, E> {
        match move self {
            Ok(v) => {
                return f(move v)
            }
            Err(e) => {
                return Result.Err(move e)
            }
        }
    }

    // The success value, or what `f` makes from the error.
    fn unwrap_or_else(self, f: view fn(E) -> T) -> T {
        match move self {
            Ok(v) => {
                return v
            }
            Err(e) => {
                return f(move e)
            }
        }
    }

    // True when it is a success that `f` accepts.
    fn is_ok_and(view self, f: view fn(view T) -> Bool) -> Bool {
        match self {
            Ok(v) => {
                return f(v)
            }
            Err(_) => {
                return false
            }
        }
    }

    // True when it is an error that `f` accepts.
    fn is_err_and(view self, f: view fn(view E) -> Bool) -> Bool {
        match self {
            Ok(_) => {
                return false
            }
            Err(e) => {
                return f(e)
            }
        }
    }
}

// unwrap / expect show the error, so E must implement Show
impl<T, E: Show> Result<T, E> {
    fn unwrap(self) -> T {
        match move self {
            Ok(v) => {
                return v
            }
            Err(e) => {
                panic("called `Result.unwrap()` on an `Err` value: {e}")
            }
        }
    }

    fn expect(self, msg: view String) -> T {
        match move self {
            Ok(v) => {
                return v
            }
            Err(e) => {
                panic("{msg}: {e}")
            }
        }
    }
}

impl<T: Show> Show for Option<T> {
    fn show(view self) -> String {
        match self {
            Some(v) => {
                return "Some({v})"
            }
            None => {
                return String.from("None")
            }
        }
    }
}

impl<T: Show, E: Show> Show for Result<T, E> {
    fn show(view self) -> String {
        match self {
            Ok(v) => {
                return "Ok({v})"
            }
            Err(e) => {
                return "Err({e})"
            }
        }
    }
}

impl<T: Equal> Equal for Option<T> {
    fn eq(view self, other: view Option<T>) -> Bool {
        match self {
            Some(a) => {
                match other {
                    Some(b) => {
                        return a.eq(b)
                    }
                    None => {
                        return false
                    }
                }
            }
            None => {
                return other.is_none()
            }
        }
    }
}

impl<T: Clone> Clone for Option<T> {
    fn clone(view self) -> Option<T> {
        match self {
            Some(v) => {
                return Some(v.clone())
            }
            None => {
                return None
            }
        }
    }
}

impl<T: Clone, E: Clone> Clone for Result<T, E> {
    fn clone(view self) -> Result<T, E> {
        match self {
            Ok(v) => {
                return Ok(v.clone())
            }
            Err(e) => {
                return Err(e.clone())
            }
        }
    }
}

impl<A: Clone, B: Clone> Clone for Tuple2<A, B> {
    fn clone(view self) -> Tuple2<A, B> {
        return Tuple2 { _0: self._0.clone(), _1: self._1.clone() }
    }
}

impl<A: Clone, B: Clone, C: Clone> Clone for Tuple3<A, B, C> {
    fn clone(view self) -> Tuple3<A, B, C> {
        return Tuple3 { _0: self._0.clone(), _1: self._1.clone(), _2: self._2.clone() }
    }
}

impl<A: Clone, B: Clone, C: Clone, D: Clone> Clone for Tuple4<A, B, C, D> {
    fn clone(view self) -> Tuple4<A, B, C, D> {
        return Tuple4 { _0: self._0.clone(), _1: self._1.clone(), _2: self._2.clone(), _3: self._3.clone() }
    }
}

impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone> Clone for Tuple5<A, B, C, D, E> {
    fn clone(view self) -> Tuple5<A, B, C, D, E> {
        return Tuple5 { _0: self._0.clone(), _1: self._1.clone(), _2: self._2.clone(), _3: self._3.clone(), _4: self._4.clone() }
    }
}

impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone> Clone for Tuple6<A, B, C, D, E, F> {
    fn clone(view self) -> Tuple6<A, B, C, D, E, F> {
        return Tuple6 { _0: self._0.clone(), _1: self._1.clone(), _2: self._2.clone(), _3: self._3.clone(), _4: self._4.clone(), _5: self._5.clone() }
    }
}

// `?` turns any Show-able error into a String error through this
fn std__show_err<E: Show>(e: E) -> String {
    return e.show()
}
