// Hash functions, Map<K, V> and Set<T>, written in Yerux on top of generics and traits.
//
// Arithmetic in Yerux is checked (it never wraps), so the hash functions only use values below 2^31
// and multipliers that keep every product below 2^62: multiplicative hashing modulo the prime 2^31 - 1.

fn std__hash_int(x: Int) -> Int {
    if x >= 0 && x < 2147483647 {
        return (x + 1) * 1103515245 % 2147483647
    }
    var r = x % 2147483647
    if r < 0 {
        r = r + 2147483647
    }
    let q = x / 2147483647
    var r2 = q % 2147483647
    if r2 < 0 {
        r2 = r2 + 2147483647
    }
    let q2 = q / 2147483647
    var r3 = q2 % 2147483647
    if r3 < 0 {
        r3 = r3 + 2147483647
    }
    let h1 = (r + 1) * 1103515245 % 2147483647
    let h2 = (h1 + r2 + 1) * 1664525 % 2147483647
    return (h2 + r3 + 1) * 1103515245 % 2147483647
}

impl Hash for Int {
    fn hash(view self) -> Int {
        return std__hash_int(self)
    }
}
impl Hash for Bool {
    fn hash(view self) -> Int {
        if self {
            return std__hash_int(1)
        }
        return std__hash_int(0)
    }
}
impl Hash for Char {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for Int8 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for Int16 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for Int32 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for UInt8 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for UInt16 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for UInt32 {
    fn hash(view self) -> Int {
        return std__hash_int(self.to_int())
    }
}
impl Hash for UInt64 {
    fn hash(view self) -> Int {
        return std__hash_int(self.truncate_int())
    }
}
impl Hash for String {
    fn hash(view self) -> Int {
        var h = 5381
        var i = 0
        let n = self.len()
        while i < n {
            h = (h * 16777619 + self.byte(i) + 1) % 2147483647
            i = i + 1
        }
        return h
    }
}
impl Hash for Text {
    fn hash(view self) -> Int {
        let s = String.from(self)
        return s.hash()
    }
}

// Entries live in three parallel lists in insertion order; `slots` is an open-addressing table (linear
// probing, power-of-two size, load factor at most 3/5) holding entry numbers, -1 for an empty slot.
// Removal moves the last entry into the hole (so order changes after a removal) and shifts the probe
// chain back: there are no tombstones.
struct Map<K, V> {
    keys: List<K>,
    vals: List<V>,
    hashes: List<Int>,
    slots: List<Int>,
}

impl<K: Hash + Equal, V> Map<K, V> {
    fn new() -> Map<K, V> {
        var slots = List<Int>.new()
        var i = 0
        while i < 8 {
            slots.push(-1)
            i = i + 1
        }
        return Map { keys: List<K>.new(), vals: List<V>.new(), hashes: List<Int>.new(), slots: move slots }
    }

    fn len(view self) -> Int {
        return self.keys.len()
    }

    fn is_empty(view self) -> Bool {
        return self.keys.len() == 0
    }

    // Entry number of key `k` whose hash is `h`, or -1.
    fn find_hashed(view self, h: Int, k: view K) -> Int {
        let cap = self.slots.len()
        var i = h % cap
        while true {
            let e = self.slots.get(i)
            if e < 0 {
                return -1
            }
            if self.hashes.get(e) == h && self.keys.at(e).eq(k) {
                return e
            }
            i = i + 1
            if i == cap {
                i = 0
            }
        }
        return -1
    }

    // Entry number of key `k` (use it with `m.vals.at(e)`), or -1.
    fn find(view self, k: view K) -> Int {
        return self.find_hashed(k.hash(), k)
    }

    fn contains(view self, k: view K) -> Bool {
        return self.find(k) >= 0
    }

    fn grow(mut self) {
        let ncap = self.slots.len() * 2
        var ns = List<Int>.new()
        var i = 0
        while i < ncap {
            ns.push(-1)
            i = i + 1
        }
        var e = 0
        while e < self.hashes.len() {
            var j = self.hashes.get(e) % ncap
            while ns.get(j) >= 0 {
                j = j + 1
                if j == ncap {
                    j = 0
                }
            }
            ns.set(j, e)
            e = e + 1
        }
        self.slots = move ns
    }

    // Adds the entry, or replaces the value of an existing key (the old value is dropped).
    fn insert(mut self, k: K, v: V) {
        let h = k.hash()
        let e = self.find_hashed(h, k)
        if e >= 0 {
            self.vals.set(e, move v)
            return
        }
        if (self.keys.len() + 1) * 5 > self.slots.len() * 3 {
            self.grow()
        }
        let n = self.keys.len()
        let cap = self.slots.len()
        var i = h % cap
        while self.slots.get(i) >= 0 {
            i = i + 1
            if i == cap {
                i = 0
            }
        }
        self.slots.set(i, n)
        self.keys.push(move k)
        self.vals.push(move v)
        self.hashes.push(h)
    }

    // Removes the slot of entry `e` from the probe table (backward-shift deletion).
    fn del_slot(mut self, e: Int) {
        let cap = self.slots.len()
        var s = self.hashes.get(e) % cap
        while self.slots.get(s) != e {
            s = s + 1
            if s == cap {
                s = 0
            }
        }
        var j = s
        var go = true
        while go {
            j = j + 1
            if j == cap {
                j = 0
            }
            let f = self.slots.get(j)
            if f < 0 {
                go = false
            } else {
                let ideal = self.hashes.get(f) % cap
                if (j - ideal + cap) % cap >= (j - s + cap) % cap {
                    self.slots.set(s, f)
                    s = j
                }
            }
        }
        self.slots.set(s, -1)
    }

    // The slot that holds entry number `from` now holds `to`.
    fn relabel(mut self, from: Int, to: Int) {
        let cap = self.slots.len()
        var s = self.hashes.get(from) % cap
        while self.slots.get(s) != from {
            s = s + 1
            if s == cap {
                s = 0
            }
        }
        self.slots.set(s, to)
    }

    // Removes the entry of key `k` and moves its value out. Panics if the key is missing.
    fn take(mut self, k: view K) -> V {
        let e = self.find(k)
        if e < 0 { panic("Map.take key not found") }
        self.del_slot(e)
        let last = self.keys.len() - 1
        if e != last {
            self.relabel(last, e)
            self.keys.swap(e, last)
            self.vals.swap(e, last)
            self.hashes.swap(e, last)
        }
        self.hashes.pop()
        let old = self.keys.pop()
        return self.vals.pop()
    }

    // Removes the entry of key `k` (key and value are dropped); false if it was missing.
    fn remove(mut self, k: view K) -> Bool {
        if self.find(k) < 0 {
            return false
        }
        let old = self.take(k)
        return true
    }

    fn clear(mut self) {
        self.keys.clear()
        self.vals.clear()
        self.hashes.clear()
        var i = 0
        while i < self.slots.len() {
            self.slots.set(i, -1)
            i = i + 1
        }
    }
}

impl<K: Hash + Equal, V: Copy> Map<K, V> {
    // Value of key `k` (a copy: V must be Copy; otherwise use `find` and `m.vals.at(e)`). Panics if missing.
    fn get(view self, k: view K) -> V {
        let e = self.find(k)
        if e < 0 { panic("Map.get key not found") }
        return self.vals.get(e)
    }

    fn get_or(view self, k: view K, d: V) -> V {
        let e = self.find(k)
        if e < 0 {
            return d
        }
        return self.vals.get(e)
    }
}

impl<K: Show, V: Show> Show for Map<K, V> {
    fn show(view self) -> String {
        var s = String.from("{{")
        var i = 0
        while i < self.keys.len() {
            if i > 0 {
                s.push_str(", ")
            }
            let a = self.keys.at(i).show()
            s.push_str(a)
            s.push_str(": ")
            let b = self.vals.at(i).show()
            s.push_str(b)
            i = i + 1
        }
        s.push_str("}}")
        return s
    }
}

// A set is a map whose values are unused. Iterate with `s.items.keys.at(i)`.
struct Set<T> {
    items: Map<T, Bool>,
}

impl<T: Hash + Equal> Set<T> {
    fn new() -> Set<T> {
        return Set { items: Map<T, Bool>.new() }
    }

    fn len(view self) -> Int {
        return self.items.keys.len()
    }

    fn is_empty(view self) -> Bool {
        return self.items.keys.len() == 0
    }

    fn contains(view self, x: view T) -> Bool {
        return self.items.contains(x)
    }

    // true if `x` was not in the set yet
    fn insert(mut self, x: T) -> Bool {
        if self.items.contains(x) {
            return false
        }
        self.items.insert(move x, true)
        return true
    }

    fn remove(mut self, x: view T) -> Bool {
        return self.items.remove(x)
    }

    fn clear(mut self) {
        self.items.clear()
    }
}

impl<T: Show> Show for Set<T> {
    fn show(view self) -> String {
        var s = String.from("{{")
        var i = 0
        while i < self.items.keys.len() {
            if i > 0 {
                s.push_str(", ")
            }
            let a = self.items.keys.at(i).show()
            s.push_str(a)
            i = i + 1
        }
        s.push_str("}}")
        return s
    }
}
