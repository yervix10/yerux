// std.args: small schema-free command-line parser. `io.args()` supplies argv including argv[0].
import std.io
import std.text

pub struct Parsed {
  flags: List<String>,
  options: List<(String, String)>,
  positionals: List<String>,
  subcommand: String,
  help: Bool,
  // problems found by `parse_with`: a valued option at the end of argv has no value (`option --prefix needs a value`)
  errors: List<String>,
}

pub fn parse(argv: view List<String>) -> Parsed {
  var out = Parsed { flags: List<String>.new(), options: List<(String, String)>.new(), positionals: List<String>.new(), subcommand: String.new(), help: false, errors: List<String>.new() }
  var i = 1
  var positional_only = false
  while i < argv.len() {
    let a = String.from(argv.at(i))
    if !positional_only && a == "--" {
      positional_only = true
    } else if !positional_only && a == "--help" {
      out.help = true
      out.flags.push(String.from("help"))
    } else if !positional_only && a.starts_with("--") {
      let eq = a.find("=")
      if eq >= 0 {
        let k = a.slice(2, eq)
        let v = a.slice(eq + 1, a.len())
        out.options.push((move k, move v))
      } else {
        let k = a.slice(2, a.len())
        out.flags.push(move k)
      }
    } else if !positional_only && a.starts_with("-") && a.len() > 1 {
      var j = 1
      while j < a.len() {
        let f = a.slice(j, j + 1)
        out.flags.push(move f)
        j = j + 1
      }
    } else {
      let v = String.from(a)
      if out.subcommand.is_empty() { out.subcommand = move v }
      else { out.positionals.push(move v) }
    }
    i = i + 1
  }
  return out
}

/// Like `parse`, but with a schema: the names in `valued` are options that take the next word as their value
/// (`--title TEXT`, or `-o FILE` for a one-letter name; `--title=TEXT` still works), and with
/// `with_subcommand` false the first positional stays a positional (`subcommand` is left empty). A valued option that is
/// the last word of argv has no value to take: it is reported in `errors` (and still recorded as a flag), never silently.
pub fn parse_with(argv: view List<String>, valued: view List<String>, with_subcommand: Bool) -> Parsed {
  var out = Parsed { flags: List<String>.new(), options: List<(String, String)>.new(), positionals: List<String>.new(), subcommand: String.new(), help: false, errors: List<String>.new() }
  var i = 1
  var positional_only = false
  while i < argv.len() {
    let a = String.from(argv.at(i))
    if !positional_only && a == "--" {
      positional_only = true
    } else if !positional_only && a == "--help" {
      out.help = true
      out.flags.push(String.from("help"))
    } else if !positional_only && a.starts_with("--") {
      let eq = a.find("=")
      if eq >= 0 {
        let k = a.slice(2, eq)
        let v = a.slice(eq + 1, a.len())
        out.options.push((move k, move v))
      } else {
        let k = a.slice(2, a.len())
        if is_valued(valued, k) && i + 1 < argv.len() {
          i = i + 1
          out.options.push((move k, String.from(argv.at(i))))
        } else {
          if is_valued(valued, k) { out.errors.push("option --{k} needs a value") }
          out.flags.push(move k)
        }
      }
    } else if !positional_only && a.starts_with("-") && a.len() > 1 {
      var j = 1
      while j < a.len() {
        let f = a.slice(j, j + 1)
        if is_valued(valued, f) && j + 1 == a.len() && i + 1 < argv.len() {
          i = i + 1
          out.options.push((move f, String.from(argv.at(i))))
        } else {
          if is_valued(valued, f) && j + 1 == a.len() { out.errors.push("option -{f} needs a value") }
          out.flags.push(move f)
        }
        j = j + 1
      }
    } else {
      let v = String.from(a)
      if with_subcommand && out.subcommand.is_empty() { out.subcommand = move v }
      else { out.positionals.push(move v) }
    }
    i = i + 1
  }
  return out
}

fn is_valued(valued: view List<String>, name: view String) -> Bool {
  var i = 0
  while i < valued.len() {
    if valued.at(i) == name { return true }
    i = i + 1
  }
  return false
}

pub fn parse_process() -> Parsed {
  let argv = io.args()
  return parse(argv)
}

pub fn has_flag(p: view Parsed, name: view String) -> Bool {
  var clean = String.from(name)
  if clean.starts_with("--") {
    clean = clean.slice(2, clean.len())
  } else if clean.starts_with("-") {
    clean = clean.slice(1, clean.len())
  }
  var i = 0
  while i < p.flags.len() {
    if p.flags.at(i) == clean { return true }
    i = i + 1
  }
  return false
}

pub fn flag(p: view Parsed, name: view String) -> Bool {
  return has_flag(p, name)
}

pub fn positionals(p: view Parsed) -> List<String> {
  return p.positionals.clone()
}

pub fn positional(p: view Parsed, index: Int) -> Option<String> {
  if index >= 0 && index < p.positionals.len() {
    return Some(String.from(p.positionals.at(index)))
  }
  return None
}

pub fn option(p: view Parsed, name: view String) -> Option<String> {
  var clean = String.from(name)
  if clean.starts_with("--") {
    clean = clean.slice(2, clean.len())
  } else if clean.starts_with("-") {
    clean = clean.slice(1, clean.len())
  }
  var i = p.options.len() - 1
  while i >= 0 {
    if p.options.at(i).0.eq(clean) { return Some(String.from(p.options.at(i).1)) }
    i = i - 1
  }
  return None
}

/// Render the conventional one-line help hint.
pub fn help_line(program: view String, usage: view String) -> String {
  var s = String.from("Usage: ")
  s.push_str(program)
  if !usage.is_empty() { s.push_byte(32); s.push_str(usage) }
  return s
}

/// The option as an Int: `None` when it is missing; `Some(Err(text))` is not representable, so an option that is
/// present but not a number is also `None` (use `option_int_checked` to tell them apart).
pub fn option_int(p: view Parsed, name: view String) -> Option<Int> {
  match option(p, name) {
    Some(v) => {
      match text.parse_int(v) {
        Ok(n) => { return Some(n) }
        Err(e) => { return None }
      }
    }
    None => { return None }
  }
}

pub fn option_int_or(p: view Parsed, name: view String, default: Int) -> Int {
  match option_int(p, name) {
    Some(n) => { return n }
    None => { return default }
  }
}

/// `Ok(None)` when the option is missing, `Err(message)` when it is present but not an integer.
pub fn option_int_checked(p: view Parsed, name: view String) -> Result<Option<Int>, String> {
  match option(p, name) {
    Some(v) => {
      match text.parse_int(v) {
        Ok(n) => { return Ok(Some(n)) }
        Err(e) => {
          var m = String.from("--")
          m.push_str(name)
          m.push_str(": ")
          m.push_str(e)
          return Err(move m)
        }
      }
    }
    None => { return Ok(None) }
  }
}

pub fn option_float(p: view Parsed, name: view String) -> Option<Float> {
  match option(p, name) {
    Some(v) => {
      match text.parse_float(v) {
        Ok(x) => { return Some(x) }
        Err(e) => { return None }
      }
    }
    None => { return None }
  }
}

pub fn option_or(p: view Parsed, name: view String, default: view String) -> String {
  match option(p, name) {
    Some(v) => { return v }
    None => { return String.from(default) }
  }
}

/// `--flag`, `--flag=true|false|yes|no|1|0`; missing is `default`.
pub fn option_bool(p: view Parsed, name: view String, default: Bool) -> Bool {
  match option(p, name) {
    Some(v) => { return v == "true" || v == "yes" || v == "1" }
    None => { return default || has_flag(p, name) }
  }
}
