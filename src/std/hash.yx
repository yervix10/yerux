// std.hash: byte-oriented FNV-1a, CRC-32/ISO-HDLC and SHA-256.
import std.hex

fn xor32(a0: Int, b0: Int) -> Int {
  var a = a0
  var b = b0
  var p = 1
  var r = 0
  for _ in 0..32 {
    if a % 2 != b % 2 { r = r + p }
    a = a / 2
    b = b / 2
    p = p * 2
  }
  return r
}

fn and32(a0: Int, b0: Int) -> Int {
  var a = a0
  var b = b0
  var p = 1
  var r = 0
  for _ in 0..32 {
    if a % 2 == 1 && b % 2 == 1 { r = r + p }
    a = a / 2
    b = b / 2
    p = p * 2
  }
  return r
}

fn not32(a: Int) -> Int { return 4294967295 - a }

fn pow2(n: Int) -> Int {
  var r = 1
  for _ in 0..n { r = r * 2 }
  return r
}

fn shr(a: Int, n: Int) -> Int { return a / pow2(n) }

fn rotr(a: Int, n: Int) -> Int {
  let p = pow2(n)
  return a / p + (a % p) * pow2(32 - n)
}

fn add2(a: Int, b: Int) -> Int { return (a + b) % 4294967296 }

fn add4(a: Int, b: Int, c: Int, d: Int) -> Int { return (a + b + c + d) % 4294967296 }

fn add5(a: Int, b: Int, c: Int, d: Int, e: Int) -> Int { return (a + b + c + d + e) % 4294967296 }

fn fnv1a32_step(h: Int, b: Int) -> Int {
  return (xor32(h, b) * 16777619) % 4294967296
}

/// FNV-1a 32-bit hash of the UTF-8 bytes, returned as an unsigned value in Int.
pub fn fnv1a32(s: view String) -> Int {
  var h = 2166136261
  for i in 0..s.len() { h = fnv1a32_step(h, s.byte(i)) }
  return h
}

/// FNV-1a 32-bit hash of raw bytes.
pub fn fnv1a32_bytes(data: view [UInt8]) -> Int {
  var h = 2166136261
  for i in 0..data.len() { h = fnv1a32_step(h, data[i].to_int()) }
  return h
}

fn xor8(a0: Int, b0: Int) -> Int {
  var a = a0
  var b = b0
  var p = 1
  var r = 0
  for _ in 0..8 {
    if a % 2 != b % 2 { r = r + p }
    a = a / 2
    b = b / 2
    p = p * 2
  }
  return r
}

// the 256 entries of the reflected CRC-32 table (polynomial 0xEDB88320)
