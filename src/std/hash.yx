}

fn crc32_step(t: view [Int; 256], c: Int, b: Int) -> Int {
  return xor32(c / 256, t[xor8(c % 256, b)])
}

/// CRC-32/ISO-HDLC (the standard ZIP/Ethernet CRC), returned as an unsigned value in Int.
pub fn crc32(s: view String) -> Int {
  let t = crc_table()
  var c = 4294967295
  for i in 0..s.len() { c = crc32_step(t, c, s.byte(i)) }
  return xor32(c, 4294967295)
}

/// CRC-32/ISO-HDLC of raw bytes.
pub fn crc32_bytes(data: view [UInt8]) -> Int {
  let t = crc_table()
  var c = 4294967295
  for i in 0..data.len() { c = crc32_step(t, c, data[i].to_int()) }
  return xor32(c, 4294967295)
}

fn k_at(k: [Int; 64], i: Int) -> Int { return k[i] }

/// SHA-256 digest of the UTF-8 bytes, returned as 64 lower-case hexadecimal digits.
pub fn sha256(s: view String) -> String {
  var data = List<Int>.new()
  for i in 0..s.len() { data.push(s.byte(i)) }
  return sha256_digest(data)
}

/// SHA-256 digest of raw bytes, returned as 64 lower-case hexadecimal digits.
pub fn sha256_bytes(bytes: view [UInt8]) -> String {
  var data = List<Int>.new()
  for i in 0..bytes.len() { data.push(bytes[i].to_int()) }
  return sha256_digest(data)
}

fn sha256_digest(data: mut List<Int>) -> String {
  let k = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
  let bits = data.len() * 8
  data.push(128)
  while data.len() % 64 != 56 { data.push(0) }
  for i in 0..8 {
    let shift = (7 - i) * 8
    data.push((bits / pow2(shift)) % 256)
  }
  var h0 = 1779033703
  var h1 = 3144134277
  var h2 = 1013904242
  var h3 = 2773480762
  var h4 = 1359893119
  var h5 = 2600822924
  var h6 = 528734635
  var h7 = 1541459225
  var block = 0
  while block < data.len() {
    var w = List<Int>.new()
    for i in 0..16 {
      let at = block + i * 4
      w.push(data.get(at) * 16777216 + data.get(at + 1) * 65536 + data.get(at + 2) * 256 + data.get(at + 3))
    }
    for i in 16..64 {
      let x = w.get(i - 15)
      let y = w.get(i - 2)
      let s0 = xor32(xor32(rotr(x, 7), rotr(x, 18)), shr(x, 3))
      let s1 = xor32(xor32(rotr(y, 17), rotr(y, 19)), shr(y, 10))
      w.push(add4(w.get(i - 16), s0, w.get(i - 7), s1))
    }
    var a = h0
    var b = h1
    var c = h2
    var d = h3
    var e = h4
    var f = h5
    var g = h6
    var h = h7
    for i in 0..64 {
      let s1 = xor32(xor32(rotr(e, 6), rotr(e, 11)), rotr(e, 25))
      let ch = xor32(and32(e, f), and32(not32(e), g))
      let t1 = add5(h, s1, ch, k_at(k, i), w.get(i))
      let s0 = xor32(xor32(rotr(a, 2), rotr(a, 13)), rotr(a, 22))
      let maj = xor32(xor32(and32(a, b), and32(a, c)), and32(b, c))
      let t2 = add2(s0, maj)
      h = g
      g = f
      f = e
      e = add2(d, t1)
      d = c
      c = b
      b = a
      a = add2(t1, t2)
    }
    h0 = add2(h0, a)
    h1 = add2(h1, b)
    h2 = add2(h2, c)
    h3 = add2(h3, d)
    h4 = add2(h4, e)
    h5 = add2(h5, f)
    h6 = add2(h6, g)
    h7 = add2(h7, h)
    block = block + 64
  }
  var bytes = String.new()
  for v in [h0, h1, h2, h3, h4, h5, h6, h7] {
    bytes.push_byte(v / 16777216)
    bytes.push_byte((v / 65536) % 256)
    bytes.push_byte((v / 256) % 256)
    bytes.push_byte(v % 256)
  }
  return hex.encode(bytes)
}
