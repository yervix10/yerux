// Minimal TOML reader for project manifests: tables, scalar strings, integers,
// booleans, and flat arrays. Values are queried by dotted key.
import std.text
import std.io

// Count brackets outside quoted strings as each line is appended.
fn scan_brackets(v: view String, depth: mut Int, quoted: mut Bool) {
  var i = 0
  while i < v.len() {
    let c = v.byte(i)
    if quoted {
      if c == 92 { i = i + 1 } else if c == 34 { quoted = false }
    } else if c == 34 {
      quoted = true
    } else if c == 91 {
      depth = depth + 1
    } else if c == 93 {
      depth = depth - 1
    }
    i = i + 1
  }
}

// the string literal that starts at the quote at `at`: escapes \" \\ \n \t resolved; stops at the closing quote
fn unquote(v: view String, at: Int, end: mut Int) -> String {
  var out = String.new()
  var i = at + 1
  while i < v.len() && v.byte(i) != 34 {
    var c = v.byte(i)
    if c == 92 && i + 1 < v.len() {
      i = i + 1
      c = v.byte(i)
      if c == 110 { c = 10 } else if c == 116 { c = 9 } else if c == 114 { c = 13 }
      else if (c == 117 || c == 85) && i + (if c == 117 { 4 } else { 8 }) < v.len() {
        // \uXXXX and \UXXXXXXXX: a Unicode scalar value, kept as its UTF-8 bytes
        let width = if c == 117 { 4 } else { 8 }
        var cp = 0
        var ok = true
        for k in 1..width + 1 {
          let h = v.byte(i + k)
          var d = -1
          if h >= 48 && h <= 57 { d = h - 48 } else if h >= 97 && h <= 102 { d = h - 87 } else if h >= 65 && h <= 70 { d = h - 55 }
          if d < 0 { ok = false } else { cp = cp * 16 + d }
        }
        if ok && Char.is_valid(cp) {
          out.push_char(Char.from_int(cp))
          i = i + width + 1
          continue
        }
      }
    }
    out.push_byte(c)
    i = i + 1
  }
  end = i + 1
  return out
}

// the literal string ('...', no escapes) that starts at the quote at `at`
fn unquote_literal(v: view String, at: Int, end: mut Int) -> String {
  var j = at + 1
  while j < v.len() && v.byte(j) != 39 { j = j + 1 }
  end = j + 1
  return v.slice(at + 1, j)
}

// an integer in TOML syntax: optional sign, `_` between digits, 0x / 0o / 0b prefixes; None when it is not one
fn toml_int(raw: view String) -> Option<Int> {
  var t = String.new()
  var i = 0
  var prev_digit = false
  while i < raw.len() {
    let c = raw.byte(i)
    if c == 95 {
      if !prev_digit || i + 1 >= raw.len() { return None }
      prev_digit = false
    } else {
      t.push_byte(c)
      prev_digit = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
    }
    i = i + 1
  }
  var base = 10
  var body = String.from(t)
  if t.starts_with("0x") { base = 16 } else if t.starts_with("0o") { base = 8 } else if t.starts_with("0b") { base = 2 }
  if base != 10 { body = t.slice(2, t.len()) }
  match text.parse_int_radix(body, base) {
    Ok(v) => { return Some(v) }
    Err(_) => { return None }
  }
}

// The line without its comment: everything from a '#' that is outside a
// basic (double-quoted) string. Backslash escapes inside strings are skipped.
fn strip_comment(line: view String) -> String {
  var quoted = false
  var literal = false
  var i = 0
  while i < line.len() {
    let b = line.byte(i)
    if literal {
      if b == 39 { literal = false }
    } else if quoted {
      if b == 92 {
        i = i + 2
        continue
      }
      if b == 34 { quoted = false }
    } else if b == 34 {
      quoted = true
    } else if b == 39 {
      literal = true
    } else if b == 35 {
      return line.slice(0, i)
    }
    i = i + 1
  }
  return String.from(line)
}

fn raw_value(input: view String, wanted: view String) -> String {
  // A hostile manifest should not allocate a String for every blank line.
  if input.len() > 16777216 { return String.new() }
  if !io.valid_utf8(input) { return String.new() }
  var line_count = 0
  var scan = 0
  while scan < input.len() {
    if input.byte(scan) == 10 {
      line_count = line_count + 1
      if line_count > 100000 { return String.new() }
    }
    scan = scan + 1
  }
  let lines = input.split(String.from("\n"))
  var table = String.new()
  var i = 0
  while i < lines.len() {
    let line = strip_comment(lines.at(i)).trim()
    if line.starts_with("[") {
      if line.len() < 3 || !line.ends_with("]") { return String.new() }
      table = line.slice(1, line.len() - 1)
    } else {
      let eq = line.find(String.from("="))
      if eq >= 0 {
        var key = line.slice(0, eq).trim()
        if key.len() >= 2 && key.byte(0) == 34 && key.byte(key.len() - 1) == 34 {
          var key_end = 0
          key = unquote(key, 0, key_end)
        }
        var full = String.from(key)
        if table.len() > 0 {
          full = String.new()
          full.push_slice(table, 0, table.len())
          full.push_char(Char.from_int(46))
          full.push_slice(key, 0, key.len())
        }
        if full.eq(wanted) {
          var value = line.slice(eq + 1, line.len()).trim()
          // a multi-line array: keep reading lines until its brackets balance
          if value.starts_with("[") {
            var depth = 0
            var quoted = false
            scan_brackets(value, depth, quoted)
            var j = i + 1
            while depth > 0 && j < lines.len() {
              let more = strip_comment(lines.at(j)).trim()
              scan_brackets(more, depth, quoted)
              value.push_str(" ")
              value.push_str(more)
              j = j + 1
            }
          }
          return value
        }
      }
    }
    i = i + 1
  }
  return String.new()
}

pub fn get_string(input: view String, key: view String) -> String {
  let raw = raw_value(input, key)
  if raw.len() >= 2 && raw.char_at(0).to_int() == 34 {
    var end = 0
    return unquote(raw, 0, end)
  }
  if raw.len() >= 2 && raw.byte(0) == 39 {
    var end = 0
    return unquote_literal(raw, 0, end)
  }
  return String.new()
}

pub fn get_int(input: view String, key: view String) -> Int {
  match toml_int(raw_value(input, key)) {
    Some(value) => { return value }
    None => { return 0 }
  }
}

pub fn get_bool(input: view String, key: view String) -> Bool {
  return raw_value(input, key).eq("true")
}

pub fn get_array(input: view String, key: view String) -> List<String> {
  let raw = raw_value(input, key).trim()
  var out = List<String>.new()
  if raw.len() < 2 || raw.char_at(0).to_int() != 91 { return out }
  var i = 1
  while i < raw.len() {
    let c = raw.byte(i)
    if c == 34 {
      var end = 0
      out.push(unquote(raw, i, end))
      i = end
    } else if c == 39 {
      var end = 0
      out.push(unquote_literal(raw, i, end))
      i = end
    } else if c == 44 || c == 32 || c == 9 || c == 93 {
      i = i + 1
    } else {
      var j = i
      while j < raw.len() && raw.byte(j) != 44 && raw.byte(j) != 93 { j = j + 1 }
      let item = raw.slice(i, j).trim()
      if item.len() > 0 { out.push(move item) }
      i = j
    }
  }
  return out
}
