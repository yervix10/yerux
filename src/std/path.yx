// std.path: path strings, with "/" as the separator (docs/STDLIB.md).
//
//   import std.path        then      path.join("a", "b.txt")   path.extension("a/b.txt")
//
// Purely textual: nothing touches the file system. Repeated and trailing slashes are ignored by `parent`,
// `file_name`, `stem` and `extension`; `join` and `normalize` produce a single slash between components.

fn trimmed_end(p: view String) -> Int {
  // length of p without trailing slashes (a lone "/" stays "/")
  var e = p.len()
  while e > 1 && p.byte(e - 1) == 47 {
    e = e - 1
  }
  return e
}

fn name_start(p: view String, e: Int) -> Int {
  // offset of the file name inside p[0..e]
  var i = e
  while i > 0 && p.byte(i - 1) != 47 {
    i = i - 1
  }
  return i
}

pub fn is_absolute(p: view String) -> Bool {
  return p.len() > 0 && p.byte(0) == 47
}

/// `b` appended to `a` with exactly one slash between them; an absolute `b` replaces `a`; an empty side is ignored.
pub fn join(a: view String, b: view String) -> String {
  var r = String.new()
  if is_absolute(b) || a.len() == 0 {
    r.push_str(b)
    return r
  }
  r.push_str(a)
  if b.len() == 0 {
    return r
  }
  if a.byte(a.len() - 1) != 47 {
    r.push_byte(47)
  }
  r.push_str(b)
  return r
}

/// Everything but the last component: `parent("a/b/c.txt")` is `a/b`, `parent("c.txt")` is ``, `parent("/c")` is
/// `/`, `parent("/")` is `/`.
pub fn parent(p: view String) -> String {
  let e = trimmed_end(p)
  if e == 1 && p.byte(0) == 47 {
    return String.from("/")
  }
  var i = name_start(p, e)
  // drop the slashes before the name
  while i > 1 && p.byte(i - 1) == 47 {
    i = i - 1
  }
  if i == 1 && p.byte(0) == 47 {
    return String.from("/")
  }
  if i > 0 && p.byte(i - 1) == 47 {
    i = i - 1
  }
  return p.slice(0, i)
}

/// The last component: `file_name("a/b/c.txt")` is `c.txt`; empty for `/` and for an empty path.
pub fn file_name(p: view String) -> String {
  let e = trimmed_end(p)
  if e == 1 && p.byte(0) == 47 {
    return String.new()
  }
  return p.slice(name_start(p, e), e)
}

/// Offset of the dot that starts the extension of the file name, or -1 (a leading dot is not an extension).
fn dot_index(name: view String) -> Int {
  var i = name.len() - 1
  while i > 0 {
    if name.byte(i) == 46 {
      return i
    }
    i = i - 1
  }
  return -1
}

/// The file name without its extension: `stem("a/b.tar.gz")` is `b.tar`, `stem(".bashrc")` is `.bashrc`.
pub fn stem(p: view String) -> String {
  let name = file_name(p)
  let d = dot_index(name)
  if d < 0 {
    return name
  }
  return name.slice(0, d)
}

/// The extension without the dot, or an empty string: `extension("a/b.tar.gz")` is `gz`.
pub fn extension(p: view String) -> String {
  let name = file_name(p)
  let d = dot_index(name)
  if d < 0 {
    return String.new()
  }
  return name.slice(d + 1, name.len())
}

/// `p` with its extension replaced by `ext` (without dot; an empty `ext` removes it).
pub fn with_extension(p: view String, ext: view String) -> String {
  let e = trimmed_end(p)
  let ns = name_start(p, e)
  let name = p.slice(ns, e)
  var cut = e
  let d = dot_index(name)
  if d >= 0 {
    cut = ns + d
  }
  var r = String.new()
  r.push_slice(p, 0, cut)
  if ext.len() > 0 {
    r.push_byte(46)
    r.push_str(ext)
  }
  return r
}

/// The components of `p` (no empty ones); a leading `/` is the first component `/`.
pub fn components(p: view String) -> List<String> {
  var out = List<String>.new()
  if is_absolute(p) {
    out.push(String.from("/"))
  }
  var start = -1
  var i = 0
  while i < p.len() {
    if p.byte(i) == 47 {
      if start >= 0 {
        out.push(p.slice(start, i))
        start = -1
      }
    } else if start < 0 {
      start = i
    }
    i = i + 1
  }
  if start >= 0 {
    out.push(p.slice(start, p.len()))
  }
  return out
}

/// Removes `.` components, resolves `..` against the previous component (kept at the start of a relative
/// path, dropped at the root) and collapses repeated slashes. An empty result is `.`.
pub fn normalize(p: view String) -> String {
  let abs = is_absolute(p)
  var parts = List<String>.new()
  let comps = components(p)
  var i = 0
  while i < comps.len() {
    if comps.at(i).eq("/") || comps.at(i).eq(".") {
      // skip
    } else if comps.at(i).eq("..") {
      if parts.len() > 0 && !parts.at(parts.len() - 1).eq("..") {
        let dropped = parts.pop()
      } else if !abs {
        parts.push(String.from(".."))
      }
    } else {
      parts.push(String.from(comps.at(i)))
    }
    i = i + 1
  }
  var r = String.new()
  if abs {
    r.push_byte(47)
  }
  let joined = parts.join("/")
  r.push_str(joined)
  if r.len() == 0 {
    return String.from(".")
  }
  return r
}
