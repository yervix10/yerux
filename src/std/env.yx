// std.env: the process environment (docs/STDLIB_IO.md, section "std.env").
//
//   import std.env         then      env.get("HOME")   env.args()   env.current_dir()?   env.set_current_dir("/tmp")?
//
// Arguments and variables come from the initial process stack (`set`/`remove` switch to a private heap copy), the working
// directory from getcwd/chdir. Failures are `io.IoError` values.
import std.io

/// The command line, program name first.
pub fn args() -> List<String> {
    return io.args()
}

/// Number of command-line entries, program name included.
pub fn arg_count() -> Int {
    return __load64(__load64(__global(0)))
}

/// The `i`-th command-line entry (0 is the program name); None out of range.
pub fn arg(i: Int) -> Option<String> {
    let sp = __load64(__global(0))
    if i < 0 || i >= __load64(sp) {
        return None
    }
    let s = io.cstr(__load64(sp + 8 + 8 * i))
    return Some(move s)
}

/// The value of environment variable `name`; None when it is not set.
pub fn get(name: view String) -> Option<String> {
    return io.env_var(name)
}

/// The value of `name`, or `default` when it is not set.
pub fn get_or(name: view String, default: view String) -> String {
    match io.env_var(name) {
        Some(v) => {
            return move v
        }
        None => {
            return String.from(default)
        }
    }
}

/// Is environment variable `name` set (possibly to "")?
pub fn has(name: view String) -> Bool {
    match io.env_var(name) {
        Some(v) => {
            return true
        }
        None => {
            return false
        }
    }
}

/// The value of `name`, or a `NotFound` error naming the variable (handy with `?`).
pub fn require(name: view String) -> Result<String, io.IoError> {
    match io.env_var(name) {
        Some(v) => {
            return Ok(move v)
        }
        None => {
            var m = String.from("environment variable '")
            m.push_str(name)
            m.push_str("' is not set")
            return Err(io.IoError { kind: io.IoErrorKind.NotFound, code: 0, message: move m })
        }
    }
}

/// Every variable as a `(name, value)` pair, in environment order.
pub fn vars() -> List<(String, String)> {
    let all = io.env_vars()
    var out = List<(String, String)>.new()
    for kv in all {
        let eq = kv.find("=")
        if eq < 0 {
            out.push((String.from(kv), String.new()))
        } else {
            out.push((kv.slice(0, eq), kv.slice(eq + 1, kv.len())))
        }
    }
    return out
}

/// Set `name` to `value` for the rest of this process (seen by `get`, `vars`, ..., not by other processes;
/// there is no process-spawning API yet). `InvalidInput` for an empty name, `=` or NUL in the name, NUL in
/// the value. Not thread-safe.
pub fn set(name: view String, value: view String) -> Result<Int, io.IoError> {
    return io.set_env_var(name, value)
}

/// Remove `name`; Ok(1) when it was set, Ok(0) when it was not.
pub fn remove(name: view String) -> Result<Int, io.IoError> {
    return io.remove_env_var(name)
}

/// `$HOME`, when set.
pub fn home_dir() -> Option<String> {
    return io.env_var("HOME")
}

/// `$TMPDIR` when set and not empty, `/tmp` otherwise.
pub fn temp_dir() -> String {
    match io.env_var("TMPDIR") {
        Some(v) => {
            if v.len() > 0 {
                return move v
            }
            return String.from("/tmp")
        }
        None => {
            return String.from("/tmp")
        }
    }
}

/// The working directory (absolute).
pub fn current_dir() -> Result<String, io.IoError> {
    var size = 4096
    while true {
        let buf = __alloc(size)
        let r = __syscall(79, buf, size, 0, 0, 0, 0)
        if r == -34 && size < 1048576 {
            __free(buf)
            size = size * 4
            continue
        }
        if r < 0 {
            __free(buf)
            return Err(io.os_error("current directory", "", 0 - r))
        }
        let s = io.cstr(buf)
        __free(buf)
        return Ok(move s)
    }
    return Err(io.custom_error(io.IoErrorKind.Other, "current directory: unreachable"))
}

/// Change the working directory (relative paths of every later call resolve from it).
pub fn set_current_dir(path: view String) -> Result<Int, io.IoError> {
    let cp = io.cpath(path)?
    let r = __syscall(80, cp.raw_addr(), 0, 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("change directory", path, 0 - r))
    }
    return Ok(0)
}

/// Absolute path of the running executable (`/proc/self/exe`).
pub fn current_exe() -> Result<String, io.IoError> {
    let buf = __alloc(4096)
    let link = "/proc/self/exe"
    let cp = io.cpath(link)?
    let r = __syscall(89, cp.raw_addr(), buf, 4096, 0, 0, 0)
    if r < 0 {
        __free(buf)
        return Err(io.os_error("read link", link, 0 - r))
    }
    var s = String.new()
    s.push_raw(buf, r)
    __free(buf)
    return io.checked_text(move s)
}

/// The process id.
pub fn pid() -> Int {
    return io.process_id()
}

/// Ends the process at once with `code` (0..255): deferred statements and drops do not run.
pub fn exit(code: Int) {
    io.exit(code)
}
