// std.fs: the file system (docs/STDLIB_IO.md, section "std.fs").
//
//   import std.fs          then      fs.read_to_string("a.txt")?   fs.read_dir(".")?   fs.create_dir_all("out/x")?
//
// Raw Linux x86-64 system calls over the std.io intrinsics, like std.io itself. Every failure is an
// `io.IoError` value (the same error type as std.io), nothing aborts.
import std.io
import std.sort
import std.env
import std.path

// ───────────────────────── metadata ─────────────────────────

pub enum FileKind {
    File,
    Dir,
    Symlink,
    Other,
}

fn file_kind_code(k: FileKind) -> Int {
    match k {
        File => {
            return 1
        }
        Dir => {
            return 2
        }
        Symlink => {
            return 3
        }
        Other => {
            return 4
        }
    }
}

impl Equal for FileKind {
    fn eq(view self, other: view FileKind) -> Bool {
        return file_kind_code(self) == file_kind_code(other)
    }
}

impl Show for FileKind {
    fn show(view self) -> String {
        match self {
            File => {
                return String.from("file")
            }
            Dir => {
                return String.from("dir")
            }
            Symlink => {
                return String.from("symlink")
            }
            Other => {
                return String.from("other")
            }
        }
    }
}

/// What stat(2) says about a path. `mode` is the permission bits (0o777 and the setuid/setgid/sticky bits),
/// `modified_ns` the last modification time in nanoseconds since 1970-01-01 UTC.
pub struct Metadata {
    kind: FileKind,
    size: Int,
    mode: Int,
    modified_ns: Int,
}

fn kind_from_mode(m: Int) -> FileKind {
    let t = (m / 4096) % 16
    if t == 8 {
        return FileKind.File
    }
    if t == 4 {
        return FileKind.Dir
    }
    if t == 10 {
        return FileKind.Symlink
    }
    return FileKind.Other
}

// statx has the same 256-byte layout on x86-64 and AArch64 Linux.
const STATX_SIZE: Int = 256
const AT_FDCWD: Int = -100
const AT_SYMLINK_NOFOLLOW: Int = 256
const AT_EMPTY_PATH: Int = 4096
const STATX_BASIC_STATS: Int = 2047

fn statx(fd: Int, path: Int, flags: Int, st: Int) -> Int {
    return __syscall(332, fd, path, flags, STATX_BASIC_STATS, st, 0)
}

fn stat_metadata(fd: Int, raw_path: Int, flags: Int, op: Text, path: view String) -> Result<Metadata, io.IoError> {
    let st = __alloc(STATX_SIZE)
    let r = statx(fd, raw_path, flags, st)
    if r < 0 {
        __free(st)
        return Err(io.os_error(op, path, 0 - r))
    }
    let m = __load8(st + 28) + 256 * __load8(st + 29)
    let size = __load64(st + 40)
    let nsec = __load8(st + 120) + 256 * __load8(st + 121) + 65536 * __load8(st + 122) + 16777216 * __load8(st + 123)
    let mns = __load64(st + 112) * 1000000000 + nsec
    __free(st)
    return Ok(Metadata { kind: kind_from_mode(m), size: size, mode: m % 4096, modified_ns: mns })
}

/// Metadata of `path`, following symbolic links.
pub fn metadata(path: view String) -> Result<Metadata, io.IoError> {
    let cp = io.cpath(path)?
    return stat_metadata(AT_FDCWD, cp.raw_addr(), 0, "stat", path)
}

/// Metadata of `path` itself (a symbolic link is reported as `FileKind.Symlink`).
pub fn symlink_metadata(path: view String) -> Result<Metadata, io.IoError> {
    let cp = io.cpath(path)?
    return stat_metadata(AT_FDCWD, cp.raw_addr(), AT_SYMLINK_NOFOLLOW, "lstat", path)
}

/// Does `path` exist (following symbolic links)?
pub fn exists(path: view String) -> Bool {
    match metadata(path) {
        Ok(m) => {
            return true
        }
        Err(e) => {
            return false
        }
    }
}

/// Is `path` a regular file (following symbolic links)? false when it does not exist.
pub fn is_file(path: view String) -> Bool {
    match metadata(path) {
        Ok(m) => {
            return m.kind == FileKind.File
        }
        Err(e) => {
            return false
        }
    }
}

/// Is `path` a directory (following symbolic links)? false when it does not exist.
pub fn is_dir(path: view String) -> Bool {
    match metadata(path) {
        Ok(m) => {
            return m.kind == FileKind.Dir
        }
        Err(e) => {
            return false
        }
    }
}

/// Size of the file in bytes.
pub fn file_size(path: view String) -> Result<Int, io.IoError> {
    let m = metadata(path)?
    return Ok(m.size)
}

// ───────────────────────── whole files ─────────────────────────

/// The whole file as a String; `InvalidData` when it is not valid UTF-8.
pub fn read_to_string(path: view String) -> Result<String, io.IoError> {
    return io.read_file(path)
}

/// Read a UTF-8 file up to `limit` bytes. Stops after one byte over the limit,
/// even if the file grows while it is being read.
pub fn read_to_string_limit(path: view String, limit: Int) -> Result<String, io.IoError> {
    if limit < 0 || limit > 16777216 {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "file read limit must be 0..16 MiB"))
    }
    let f = open(path)?
    let p = __alloc(65536)
    var out = String.new()
    while true {
        let want = (limit + 1 - out.len()).min(65536)
        match read_raw(f, p, want) {
            Ok(n) => {
                if n == 0 { break }
                if n > limit - out.len() {
                    __free(p)
                    let closed = close(move f)
                    return Err(io.custom_error(io.IoErrorKind.InvalidData, "file exceeds read limit"))
                }
                out.push_raw(p, n)
            }
            Err(e) => {
                __free(p)
                let closed = close(move f)
                return Err(move e)
            }
        }
    }
    __free(p)
    let closed = close(move f)?
    return io.checked_text(move out)
}

/// The lines of a file without their line endings (`\n` or `\r\n`); a final line ending adds no empty line.
pub fn read_lines(path: view String) -> Result<List<String>, io.IoError> {
    let text = io.read_file(path)?
    return Ok(text.lines())
}

/// Create or truncate `path` (mode 0644) and write `data`. Returns the number of bytes written.
pub fn write(path: view String, data: view String) -> Result<Int, io.IoError> {
    return io.write_file(path, data)
}

/// Append `data` to `path`, creating it when missing. Returns the number of bytes written.
pub fn append(path: view String, data: view String) -> Result<Int, io.IoError> {
    return io.append_file(path, data)
}

/// Copy the bytes of `from` to `to` (created or truncated, with the permission bits of `from`). Works for
/// any content, not only UTF-8. Returns the number of bytes copied.
pub fn copy(from: view String, to: view String) -> Result<Int, io.IoError> {
    let info = metadata(from)?
    if info.kind == FileKind.Dir {
        return Err(io.os_error("copy", from, 21))
    }
    let src_p = io.cpath(from)?
    let dst_p = io.cpath(to)?
    let src = __syscall(2, src_p.raw_addr(), 524288, 0, 0, 0, 0)
    if src < 0 {
        return Err(io.os_error("open", from, 0 - src))
    }
    let dst = __syscall(2, dst_p.raw_addr(), 524865, info.mode, 0, 0, 0)
    if dst < 0 {
        let c = __syscall(3, src, 0, 0, 0, 0, 0)
        return Err(io.os_error("open", to, 0 - dst))
    }
    let buf = __alloc(65536)
    var total = 0
    var err = 0
    var err_on_read = true
    while err == 0 {
        let n = __syscall(0, src, buf, 65536, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            err = 0 - n
            break
        }
        if n == 0 {
            break
        }
        var off = 0
        while off < n {
            let w = __syscall(1, dst, buf + off, n - off, 0, 0, 0)
            if w == -4 {
                continue
            }
            if w < 0 {
                err = 0 - w
                err_on_read = false
                break
            }
            off = off + w
        }
        total = total + off
    }
    __free(buf)
    let c1 = __syscall(3, src, 0, 0, 0, 0, 0)
    let c2 = __syscall(3, dst, 0, 0, 0, 0, 0)
    if err == 0 && c2 < 0 {
        err = 0 - c2
        err_on_read = false
    }
    if err != 0 {
        if err_on_read {
            return Err(io.os_error("read", from, err))
        }
        return Err(io.os_error("write", to, err))
    }
    return Ok(total)
}

// ───────────────────────── names ─────────────────────────

/// Delete a file (not a directory: that is `IsDirectory`, use `remove_dir`).
pub fn remove_file(path: view String) -> Result<Int, io.IoError> {
    return io.remove_file(path)
}

/// Rename (move) `from` to `to`, replacing `to` when it is a file. Both must be on the same file system.
pub fn rename(from: view String, to: view String) -> Result<Int, io.IoError> {
    let a = io.cpath(from)?
    let b = io.cpath(to)?
    let r = __syscall(82, a.raw_addr(), b.raw_addr(), 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("rename", from, 0 - r))
    }
    return Ok(0)
}

// ───────────────────────── directories ─────────────────────────

/// Create one directory (mode 0755). `AlreadyExists` when the name is taken, `NotFound` when the parent is
/// missing.
pub fn create_dir(path: view String) -> Result<Int, io.IoError> {
    let cp = io.cpath(path)?
    let r = __syscall(83, cp.raw_addr(), 493, 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("create directory", path, 0 - r))
    }
    return Ok(0)
}

/// Create a directory and every missing parent. An existing directory is fine (Ok(0)); an existing file on
/// the way is `AlreadyExists` / `NotDirectory`.
pub fn create_dir_all(path: view String) -> Result<Int, io.IoError> {
    if path.len() == 0 {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "create directory: empty path"))
    }
    let cp = io.cpath(path)?
    var i = 1
    let n = path.len()
    while i <= n {
        if i == n || path.byte(i) == 47 {
            if path.byte(i - 1) != 47 {
                let part = path.slice(0, i)
                let cpart = io.cpath(part)?
                let r = __syscall(83, cpart.raw_addr(), 493, 0, 0, 0, 0)
                if r < 0 && r != -17 {
                    return Err(io.os_error("create directory", part, 0 - r))
                }
            }
        }
        i = i + 1
    }
    if !is_dir(path) {
        return Err(io.os_error("create directory", path, 17))
    }
    return Ok(0)
}

/// Remove an empty directory (`NotEmpty` otherwise).
pub fn remove_dir(path: view String) -> Result<Int, io.IoError> {
    let cp = io.cpath(path)?
    let r = __syscall(84, cp.raw_addr(), 0, 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("remove directory", path, 0 - r))
    }
    return Ok(0)
}

/// One entry of a directory listing: its name (not the full path) and its kind (a symbolic link is
/// `Symlink`, it is not followed).
pub struct DirEntry {
    name: String,
    kind: FileKind,
}

fn cmp_bytes(a: view String, b: view String) -> Int {
    let n = a.len()
    let m = b.len()
    var i = 0
    while i < n && i < m {
        let x = a.byte(i)
        let y = b.byte(i)
        if x != y {
            return x - y
        }
        i = i + 1
    }
    return n - m
}

fn join_name(dir: view String, name: view String) -> String {
    var p = String.from(dir)
    if p.len() > 0 && p.byte(p.len() - 1) != 47 {
        p.push_byte(47)
    }
    p.push_str(name)
    return p
}

/// The entries of directory `path` without `.` and `..`, sorted by name (byte order). A name that is not
/// valid UTF-8 is converted lossily (each non-ASCII byte becomes `?`).
pub fn read_dir_entries(path: view String) -> Result<List<DirEntry>, io.IoError> {
    return read_dir_entries_with_names(path, false)
}

/// Like read_dir_entries, but an invalid UTF-8 name returns InvalidData, without substituting bytes.
pub fn read_dir_entries_utf8(path: view String) -> Result<List<DirEntry>, io.IoError> {
    return read_dir_entries_with_names(path, true)
}

fn directory_name(address: Int, strict: Bool) -> Result<String, io.IoError> {
    if strict {
        return io.cstr_utf8(address, "directory entry is not valid UTF-8")
    }
    return Ok(io.cstr(address))
}

fn close_directory(fd: Int) {
    let closed = __syscall(3, fd, 0, 0, 0, 0, 0)
}

fn read_dir_entries_with_names(path: view String, strict: Bool) -> Result<List<DirEntry>, io.IoError> {
    let cp = io.cpath(path)?
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC
    let fd = __syscall(2, cp.raw_addr(), 589824, 0, 0, 0, 0)
    if fd < 0 {
        return Err(io.os_error("open directory", path, 0 - fd))
    }
    var out = List<DirEntry>.new()
    let buf = __alloc(32768)
    defer __free(buf)
    defer close_directory(fd)
    while true {
        let n = __syscall(217, fd, buf, 32768, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            return Err(io.os_error("read directory", path, 0 - n))
        }
        if n == 0 {
            break
        }
        var off = 0
        while off < n {
            let rec = buf + off
            let reclen = __load8(rec + 16) + 256 * __load8(rec + 17)
            let dtype = __load8(rec + 18)
            let name = directory_name(rec + 19, strict)?
            let dot = name.len() == 1 && name.byte(0) == 46
            let dotdot = name.len() == 2 && name.byte(0) == 46 && name.byte(1) == 46
            if !dot && !dotdot {
                var kind = FileKind.Other
                if dtype == 8 {
                    kind = FileKind.File
                } else if dtype == 4 {
                    kind = FileKind.Dir
                } else if dtype == 10 {
                    kind = FileKind.Symlink
                } else if dtype == 0 {
                    // DT_UNKNOWN: some file systems do not fill d_type
                    let full = join_name(path, name)
                    match symlink_metadata(full) {
                        Ok(m) => {
                            kind = m.kind
                        }
                        Err(e) => {
                            kind = FileKind.Other
                        }
                    }
                }
                out.push(DirEntry { name: move name, kind: kind })
            }
            off = off + reclen
        }
    }
    sort.unstable_by(out, |a: view DirEntry, b: view DirEntry| -> Int { return cmp_bytes(a.name, b.name) })
    return Ok(move out)
}

/// The names in directory `path` (without `.` and `..`), sorted.
pub fn read_dir(path: view String) -> Result<List<String>, io.IoError> {
    let entries = read_dir_entries(path)?
    var out = List<String>.new()
    for e in entries {
        out.push(String.from(e.name))
    }
    return Ok(move out)
}

/// Remove a directory and everything in it. Symbolic links are removed, never followed. A path that is not
/// a directory is `NotDirectory`.
struct DirFd {
    fd: Int,
}

impl Drop for DirFd {
    fn drop(mut self) {
        if self.fd >= 0 {
            let r = __syscall(3, self.fd, 0, 0, 0, 0, 0)
            self.fd = -1
        }
    }
}

fn same_directory(a: Int, b: Int) -> Result<Bool, io.IoError> {
    let empty = io.cpath("")?
    let st = __alloc(2 * STATX_SIZE)
    let other = st + STATX_SIZE
    let ra = statx(a, empty.raw_addr(), AT_EMPTY_PATH, st)
    if ra < 0 {
        __free(st)
        return Err(io.os_error("stat directory", "", 0 - ra))
    }
    let rb = statx(b, empty.raw_addr(), AT_EMPTY_PATH, other)
    if rb < 0 {
        __free(st)
        return Err(io.os_error("stat directory", "", 0 - rb))
    }
    // Compare inode and the two adjacent device fields (major and minor).
    let same = __load64(st + 32) == __load64(other + 32) && __load64(st + 136) == __load64(other + 136)
    __free(st)
    return Ok(same)
}

fn remove_contents(fd: Int, display: view String, depth: Int) -> Result<Int, io.IoError> {
    if depth > 128 {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "remove directory: nesting exceeds 128 levels"))
    }
    let buf = __alloc(32768)
    defer __free(buf)
    while true {
        let n = __syscall(217, fd, buf, 32768, 0, 0, 0)
        if n == -4 { continue }
        if n < 0 { return Err(io.os_error("read directory", display, 0 - n)) }
        if n == 0 { break }
        var off = 0
        while off < n {
            let rec = buf + off
            let reclen = __load8(rec + 16) + 256 * __load8(rec + 17)
            if reclen < 20 || reclen > n - off {
                return Err(io.custom_error(io.IoErrorKind.InvalidData, "remove directory: malformed directory entry"))
            }
            let name_ptr = rec + 19
            let first = __load8(name_ptr)
            let second = __load8(name_ptr + 1)
            let dot = first == 46 && second == 0
            let dotdot = first == 46 && second == 46 && __load8(name_ptr + 2) == 0
            if !dot && !dotdot {
                let name = io.cstr(name_ptr)
                let full = join_name(display, name)
                // O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW. Work relative to the open parent
                // descriptor and pass the raw dirent name, so symlink swaps and non-UTF-8 names stay safe.
                let child_fd = __syscall(257, fd, name_ptr, 720896, 0, 0, 0)
                if child_fd >= 0 {
                    let child = DirFd { fd: child_fd }
                    let r = remove_contents(child.fd, full, depth + 1)?
                    let deleted = __syscall(263, fd, name_ptr, 512, 0, 0, 0)
                    if deleted < 0 && deleted != -2 {
                        return Err(io.os_error("remove directory", full, 0 - deleted))
                    }
                } else if child_fd == -20 || child_fd == -40 {
                    let deleted = __syscall(263, fd, name_ptr, 0, 0, 0, 0)
                    if deleted < 0 && deleted != -2 {
                        return Err(io.os_error("remove file", full, 0 - deleted))
                    }
                } else if child_fd != -2 {
                    return Err(io.os_error("open directory", full, 0 - child_fd))
                }
            }
            off = off + reclen
        }
    }
    return Ok(0)
}

pub fn remove_dir_all(target: view String) -> Result<Int, io.IoError> {
    let normalized = path.normalize(target)
    let cwd = env.current_dir()?
    let absolute = path.normalize(path.join(cwd, normalized))
    if absolute.eq("/") || absolute.eq(cwd) {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "remove directory: refusing to remove the filesystem root or current directory"))
    }
    let base = path.file_name(target)
    if base.len() == 0 || base.eq(".") || base.eq("..") {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "remove directory: empty, dot, or parent path"))
    }
    var parent = path.parent(target)
    if parent.len() == 0 { parent = String.from(".") }
    let cparent = io.cpath(parent)?
    let cbase = io.cpath(base)?
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC. Once open, all traversal stays under this descriptor.
    let parent_fd = __syscall(2, cparent.raw_addr(), 589824, 0, 0, 0, 0)
    if parent_fd < 0 { return Err(io.os_error("open parent directory", parent, 0 - parent_fd)) }
    let parent_dir = DirFd { fd: parent_fd }
    // O_NOFOLLOW prevents a final-component symlink from redirecting recursive deletion.
    let root_fd = __syscall(257, parent_dir.fd, cbase.raw_addr(), 720896, 0, 0, 0)
    if root_fd < 0 { return Err(io.os_error("open directory", target, 0 - root_fd)) }
    let root = DirFd { fd: root_fd }
    let croot = io.cpath("/")?
    let root_guard_fd = __syscall(2, croot.raw_addr(), 589824, 0, 0, 0, 0)
    if root_guard_fd < 0 { return Err(io.os_error("open filesystem root", "/", 0 - root_guard_fd)) }
    let root_guard = DirFd { fd: root_guard_fd }
    let ccwd = io.cpath(cwd)?
    let cwd_guard_fd = __syscall(2, ccwd.raw_addr(), 589824, 0, 0, 0, 0)
    if cwd_guard_fd < 0 { return Err(io.os_error("open current directory", cwd, 0 - cwd_guard_fd)) }
    let cwd_guard = DirFd { fd: cwd_guard_fd }
    if same_directory(root.fd, root_guard.fd)? || same_directory(root.fd, cwd_guard.fd)? {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "remove directory: refusing to remove the filesystem root or current directory"))
    }
    let r = remove_contents(root.fd, normalized, 0)?
    let deleted = __syscall(263, parent_dir.fd, cbase.raw_addr(), 512, 0, 0, 0)
    if deleted < 0 { return Err(io.os_error("remove directory", target, 0 - deleted)) }
    return Ok(0)
}

// ───────────────────────── binary files (List<UInt8> / [UInt8] slices) ─────────────────────────

// Write `n` bytes from raw memory to fd (EINTR retried). Returns 0 or a positive errno.
fn write_raw(fd: Int, p: Int, n: Int) -> Int {
    var off = 0
    while off < n {
        let w = __syscall(1, fd, p + off, n - off, 0, 0, 0)
        if w == -4 {
            continue
        }
        if w < 0 {
            return 0 - w
        }
        off = off + w
    }
    return 0
}

// The bytes of a slice copied to a fresh raw block (the caller frees it). List<UInt8> keeps one word per
// element, so the bytes have to be packed before a write(2).
fn pack(data: view [UInt8]) -> Int {
    let n = data.len()
    let p = __alloc(n + 1)
    var i = 0
    while i < n {
        __store8(p + i, data[i].to_int())
        i = i + 1
    }
    return p
}

fn push_bytes(out: mut List<UInt8>, p: Int, n: Int) {
    var i = 0
    while i < n {
        out.push(__load8(p + i).to_uint8())
        i = i + 1
    }
}

fn write_bytes_flags(path: view String, data: view [UInt8], flags: Int) -> Result<Int, io.IoError> {
    let cp = io.cpath(path)?
    let fd = __syscall(2, cp.raw_addr(), flags, 420, 0, 0, 0)
    if fd < 0 {
        return Err(io.os_error("open", path, 0 - fd))
    }
    let n = data.len()
    let p = pack(data)
    var err = write_raw(fd, p, n)
    __free(p)
    let c = __syscall(3, fd, 0, 0, 0, 0, 0)
    if err == 0 && c < 0 {
        err = 0 - c
    }
    if err != 0 {
        return Err(io.os_error("write", path, err))
    }
    return Ok(n)
}

/// The whole file as bytes (any content).
pub fn read_bytes(path: view String) -> Result<List<UInt8>, io.IoError> {
    var f = open(path)?
    let r = f.read_to_end()
    let c = close(move f)
    return r
}

/// Create or truncate `path` (mode 0644) and write the bytes of `data` (a `List<UInt8>`, an array
/// `[UInt8; N]` or a slice `x[a..b]`). Returns the number of bytes written.
pub fn write_bytes(path: view String, data: view [UInt8]) -> Result<Int, io.IoError> {
    return write_bytes_flags(path, data, 524865)
}

/// Append the bytes of `data` to `path`, creating it when missing.
pub fn append_bytes(path: view String, data: view [UInt8]) -> Result<Int, io.IoError> {
    return write_bytes_flags(path, data, 525377)
}

/// The bytes of a String as a List<UInt8> (UTF-8).
pub fn string_bytes(s: view String) -> List<UInt8> {
    var out = List<UInt8>.new()
    var i = 0
    while i < s.len() {
        out.push(s.byte(i).to_uint8())
        i = i + 1
    }
    return out
}

/// A String from bytes; `InvalidData` when they are not valid UTF-8.
pub fn bytes_to_string(b: view [UInt8]) -> Result<String, io.IoError> {
    var s = String.new()
    var i = 0
    while i < b.len() {
        s.push_byte(b[i].to_int())
        i = i + 1
    }
    return io.checked_text(move s)
}

// ───────────────────────── permissions and links ─────────────────────────

/// Set the permission bits of `path` (`chmod`, e.g. `0o644` = 420, `0o755` = 493; 0..4095).
pub fn set_permissions(path: view String, mode: Int) -> Result<Int, io.IoError> {
    if mode < 0 || mode > 4095 {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "set permissions: mode must be in 0..=0o7777"))
    }
    let cp = io.cpath(path)?
    let r = __syscall(90, cp.raw_addr(), mode, 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("set permissions", path, 0 - r))
    }
    return Ok(0)
}

/// Create a symbolic link `link` that points at `target` (the target need not exist; it is stored as text).
pub fn symlink(target: view String, link: view String) -> Result<Int, io.IoError> {
    let a = io.cpath(target)?
    let b = io.cpath(link)?
    let r = __syscall(88, a.raw_addr(), b.raw_addr(), 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("symlink", link, 0 - r))
    }
    return Ok(0)
}

/// The target stored in symbolic link `path` (not resolved). `InvalidInput` when `path` is not a link.
pub fn read_link(path: view String) -> Result<String, io.IoError> {
    let cp = io.cpath(path)?
    var size = 256
    while true {
        let buf = __alloc(size)
        let r = __syscall(89, cp.raw_addr(), buf, size, 0, 0, 0)
        if r < 0 {
            __free(buf)
            return Err(io.os_error("read link", path, 0 - r))
        }
        if r == size && size < 1048576 {
            __free(buf)
            size = size * 4
            continue
        }
        var s = String.new()
        s.push_raw(buf, r)
        __free(buf)
        return io.checked_text(move s)
    }
    return Ok(String.new())
}

/// A second name `link` for the file `target` (hard link, same file system).
pub fn hard_link(target: view String, link: view String) -> Result<Int, io.IoError> {
    let a = io.cpath(target)?
    let b = io.cpath(link)?
    let r = __syscall(86, a.raw_addr(), b.raw_addr(), 0, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("hard link", link, 0 - r))
    }
    return Ok(0)
}

// ───────────────────────── file handles ─────────────────────────

/// An open file. It owns its descriptor and closes it when dropped (end of scope, early return, a list or
/// struct holding it going away). Call `fs.close(move f)` to close early and get the error of close(2).
/// Move-only (it holds a String).
pub struct File {
    fd: Int,
    path: String,
}

impl Drop for File {
    fn drop(mut self) {
        // errors of close(2) cannot be reported from a destructor; use fs.close for that
        if self.fd >= 0 {
            let r = __syscall(3, self.fd, 0, 0, 0, 0, 0)
            self.fd = -1
        }
    }
}

/// How `open_with` opens a file. Start from `fs.options()` (read only) and set the fields.
pub struct OpenOptions {
    read: Bool,
    write: Bool,
    append: Bool,
    create: Bool,
    truncate: Bool,
    create_new: Bool,
    mode: Int,
}

/// Read-only, no creation, mode 0644 for files that get created.
pub fn options() -> OpenOptions {
    return OpenOptions { read: true, write: false, append: false, create: false, truncate: false, create_new: false, mode: 420 }
}

/// Open with explicit options. `InvalidInput` for a combination that makes no sense (nothing to do, or
/// truncate/create without write access).
pub fn open_with(path: view String, o: view OpenOptions) -> Result<File, io.IoError> {
    let writing = o.write || o.append
    if !o.read && !writing {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "open: neither read nor write access requested"))
    }
    if (o.truncate || o.create || o.create_new) && !writing {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "open: create/truncate need write or append access"))
    }
    if o.mode < 0 || o.mode > 4095 {
        return Err(io.custom_error(io.IoErrorKind.InvalidInput, "open: mode must be in 0..=0o7777"))
    }
    // O_CLOEXEC always; O_RDONLY 0, O_WRONLY 1, O_RDWR 2
    var flags = 524288
    if o.read && writing {
        flags = flags + 2
    } else if writing {
        flags = flags + 1
    }
    if o.append {
        flags = flags + 1024
    }
    if o.create_new {
        flags = flags + 64 + 128
    } else if o.create {
        flags = flags + 64
    }
    if o.truncate {
        flags = flags + 512
    }
    let cp = io.cpath(path)?
    let fd = __syscall(2, cp.raw_addr(), flags, o.mode, 0, 0, 0)
    if fd < 0 {
        return Err(io.os_error("open", path, 0 - fd))
    }
    return Ok(File { fd: fd, path: String.from(path) })
}

/// Open an existing file for reading.
pub fn open(path: view String) -> Result<File, io.IoError> {
    var o = options()
    return open_with(path, o)
}

/// Create or truncate a file for writing (mode 0644).
pub fn create(path: view String) -> Result<File, io.IoError> {
    var o = options()
    o.read = false
    o.write = true
    o.create = true
    o.truncate = true
    return open_with(path, o)
}

/// Open for appending, creating the file when missing.
pub fn open_append(path: view String) -> Result<File, io.IoError> {
    var o = options()
    o.read = false
    o.append = true
    o.create = true
    return open_with(path, o)
}

/// Close a file, consuming the handle, and report the error of close(2).
pub fn close(f: File) -> Result<Int, io.IoError> {
    var g = move f
    return close_in_place(g)
}

// close(2) the descriptor of a File that stays owned by its holder; fd becomes -1 (closing twice is Ok)
fn close_in_place(g: mut File) -> Result<Int, io.IoError> {
    if g.fd < 0 {
        return Ok(0)
    }
    let r = __syscall(3, g.fd, 0, 0, 0, 0, 0)
    g.fd = -1
    if r < 0 {
        return Err(io.os_error("close", g.path, 0 - r))
    }
    return Ok(0)
}

fn seek_raw(f: view File, off: Int, whence: Int) -> Result<Int, io.IoError> {
    let r = __syscall(8, f.fd, off, whence, 0, 0, 0)
    if r < 0 {
        return Err(io.os_error("seek", f.path, 0 - r))
    }
    return Ok(r)
}

// read(2) into raw memory, EINTR retried; Ok(0) at end of file
fn read_raw(f: view File, p: Int, n: Int) -> Result<Int, io.IoError> {
    while true {
        let r = __syscall(0, f.fd, p, n, 0, 0, 0)
        if r == -4 {
            continue
        }
        if r < 0 {
            return Err(io.os_error("read", f.path, 0 - r))
        }
        return Ok(r)
    }
    return Ok(0)
}

impl File {
    /// Read up to `buf.len()` bytes into `buf`; returns how many (0 at end of file).
    fn read(mut self, buf: mut [UInt8]) -> Result<Int, io.IoError> {
        let n = buf.len()
        if n == 0 {
            return Ok(0)
        }
        let p = __alloc(n)
        match read_raw(self, p, n) {
            Ok(got) => {
                var i = 0
                while i < got {
                    buf[i] = __load8(p + i).to_uint8()
                    i = i + 1
                }
                __free(p)
                return Ok(got)
            }
            Err(e) => {
                __free(p)
                return Err(move e)
            }
        }
    }

    /// Up to `max` bytes (fewer near the end of the file, empty at the end).
    fn read_bytes(mut self, max: Int) -> Result<List<UInt8>, io.IoError> {
        var out = List<UInt8>.new()
        if max <= 0 {
            return Ok(move out)
        }
        let p = __alloc(max)
        match read_raw(self, p, max) {
            Ok(got) => {
                push_bytes(out, p, got)
                __free(p)
                return Ok(move out)
            }
            Err(e) => {
                __free(p)
                return Err(move e)
            }
        }
    }

    /// Everything from the current position to the end of the file.
    fn read_to_end(mut self) -> Result<List<UInt8>, io.IoError> {
        var out = List<UInt8>.new()
        let p = __alloc(65536)
        while true {
            match read_raw(self, p, 65536) {
                Ok(got) => {
                    if got == 0 {
                        break
                    }
                    push_bytes(out, p, got)
                }
                Err(e) => {
                    __free(p)
                    return Err(move e)
                }
            }
        }
        __free(p)
        return Ok(move out)
    }

    /// The rest of the file as a String; `InvalidData` when it is not valid UTF-8.
    fn read_to_string(mut self) -> Result<String, io.IoError> {
        var s = String.new()
        let p = __alloc(65536)
        while true {
            match read_raw(self, p, 65536) {
                Ok(got) => {
                    if got == 0 {
                        break
                    }
                    s.push_raw(p, got)
                }
                Err(e) => {
                    __free(p)
                    return Err(move e)
                }
            }
        }
        __free(p)
        return io.checked_text(move s)
    }

    /// Write all of `data`; returns its length.
    fn write(mut self, data: view [UInt8]) -> Result<Int, io.IoError> {
        let n = data.len()
        let p = pack(data)
        let err = write_raw(self.fd, p, n)
        __free(p)
        if err != 0 {
            return Err(io.os_error("write", self.path, err))
        }
        return Ok(n)
    }

    /// Write the bytes of `s`; returns its length.
    fn write_str(mut self, s: view String) -> Result<Int, io.IoError> {
        let err = write_raw(self.fd, s.raw_addr(), s.len())
        if err != 0 {
            return Err(io.os_error("write", self.path, err))
        }
        return Ok(s.len())
    }

    /// Move to byte `pos` from the start; returns the new position.
    fn seek(mut self, pos: Int) -> Result<Int, io.IoError> {
        return seek_raw(self, pos, 0)
    }

    /// Move by `delta` bytes from the current position.
    fn seek_relative(mut self, delta: Int) -> Result<Int, io.IoError> {
        return seek_raw(self, delta, 1)
    }

    /// Move to `delta` bytes from the end (`0` = end of file, `-1` = last byte).
    fn seek_from_end(mut self, delta: Int) -> Result<Int, io.IoError> {
        return seek_raw(self, delta, 2)
    }

    /// The current position.
    fn position(mut self) -> Result<Int, io.IoError> {
        return seek_raw(self, 0, 1)
    }

    /// Truncate or extend (with zero bytes) the file to `n` bytes (needs write access).
    fn set_len(mut self, n: Int) -> Result<Int, io.IoError> {
        let r = __syscall(77, self.fd, n, 0, 0, 0, 0)
        if r < 0 {
            return Err(io.os_error("set length", self.path, 0 - r))
        }
        return Ok(0)
    }

    /// Flush the file's data and metadata to the device (fsync).
    fn sync(mut self) -> Result<Int, io.IoError> {
        let r = __syscall(74, self.fd, 0, 0, 0, 0, 0)
        if r < 0 {
            return Err(io.os_error("sync", self.path, 0 - r))
        }
        return Ok(0)
    }

    /// Metadata of the open file.
    fn metadata(view self) -> Result<Metadata, io.IoError> {
        let empty = io.cpath("")?
        return stat_metadata(self.fd, empty.raw_addr(), AT_EMPTY_PATH, "stat", self.path)
    }

    /// The raw descriptor (still owned by the File).
    fn raw_fd(view self) -> Int {
        return self.fd
    }
}

// ───────────────────────── buffered reading and writing ─────────────────────────

/// A File with a read buffer of up to 64 KiB (kept in an owned String, so it needs no release): lines and
/// single bytes without one system call each. Dropping it closes the file; `fs.close_reader(move r)` closes
/// early and reports the error.
pub struct Reader {
    file: File,
    data: String,
    pos: Int,
}

/// Buffered reading of an open file (takes it over).
pub fn reader(f: File) -> Reader {
    return Reader { file: move f, data: String.new(), pos: 0 }
}

/// Open `path` for buffered reading.
pub fn open_reader(path: view String) -> Result<Reader, io.IoError> {
    let f = open(path)?
    return Ok(reader(move f))
}

/// Close the reader's file, consuming it.
pub fn close_reader(r: Reader) -> Result<Int, io.IoError> {
    var x = move r
    return close_in_place(x.file)
}

impl Reader {
    // refill when empty; false at end of file
    fn fill(mut self) -> Result<Bool, io.IoError> {
        if self.pos < self.data.len() {
            return Ok(true)
        }
        let tmp = __alloc(65536)
        match read_raw(self.file, tmp, 65536) {
            Ok(n) => {
                self.data = String.new()
                self.data.push_raw(tmp, n)
                __free(tmp)
                self.pos = 0
                return Ok(n > 0)
            }
            Err(e) => {
                __free(tmp)
                return Err(move e)
            }
        }
    }

    /// The next byte; None at end of file.
    fn read_byte(mut self) -> Result<Option<UInt8>, io.IoError> {
        let more = self.fill()?
        if !more {
            return Ok(None)
        }
        let b = self.data.byte(self.pos)
        self.pos = self.pos + 1
        return Ok(Some(b.to_uint8()))
    }

    /// Up to `buf.len()` bytes (from the buffer first); 0 at end of file.
    fn read(mut self, buf: mut [UInt8]) -> Result<Int, io.IoError> {
        let more = self.fill()?
        if !more {
            return Ok(0)
        }
        var n = self.data.len() - self.pos
        if n > buf.len() {
            n = buf.len()
        }
        var i = 0
        while i < n {
            buf[i] = self.data.byte(self.pos + i).to_uint8()
            i = i + 1
        }
        self.pos = self.pos + n
        return Ok(n)
    }

    /// The next line without `\n` / `\r\n`; None at end of file. `InvalidData` for a line that is not UTF-8.
    fn read_line(mut self) -> Result<Option<String>, io.IoError> {
        var line = String.new()
        var got = false
        var newline = false
        while true {
            let more = self.fill()?
            if !more {
                break
            }
            got = true
            var i = self.pos
            while i < self.data.len() && self.data.byte(i) != 10 {
                i = i + 1
            }
            line.push_raw(self.data.raw_addr() + self.pos, i - self.pos)
            if i < self.data.len() {
                self.pos = i + 1
                newline = true
                break
            }
            self.pos = self.data.len()
        }
        if !got {
            return Ok(None)
        }
        if newline && line.len() > 0 && line.byte(line.len() - 1) == 13 {
            let t = line.slice(0, line.len() - 1)
            let c = io.checked_text(move t)?
            return Ok(Some(move c))
        }
        let c = io.checked_text(move line)?
        return Ok(Some(move c))
    }

    /// All remaining lines.
    fn lines(mut self) -> Result<List<String>, io.IoError> {
        var out = List<String>.new()
        while true {
            match self.read_line()? {
                Some(l) => {
                    out.push(move l)
                }
                None => {
                    break
                }
            }
        }
        return Ok(move out)
    }

    /// The rest of the file as a String.
    fn read_to_string(mut self) -> Result<String, io.IoError> {
        var s = String.new()
        while true {
            let more = self.fill()?
            if !more {
                break
            }
            s.push_raw(self.data.raw_addr() + self.pos, self.data.len() - self.pos)
            self.pos = self.data.len()
        }
        return io.checked_text(move s)
    }
}

/// A File with a write buffer of up to 64 KiB (an owned String). Dropping it writes the pending buffer and
/// closes the file, ignoring errors; call `fs.finish(move w)` (flush + close) to get them.
pub struct Writer {
    file: File,
    data: String,
}

impl Drop for Writer {
    fn drop(mut self) {
        let fd = self.file.fd
        let r = flush_parts(fd, self.data)
    }
}

// write out a pending buffer; returns the errno (0 = ok). Shared by Writer.flush and its destructor.
fn flush_parts(fd: Int, data: mut String) -> Int {
    if data.len() == 0 {
        return 0
    }
    let err = write_raw(fd, data.raw_addr(), data.len())
    data = String.new()
    return err
}

/// Buffered writing to an open file (takes it over).
pub fn writer(f: File) -> Writer {
    return Writer { file: move f, data: String.new() }
}

/// Create or truncate `path` for buffered writing.
pub fn create_writer(path: view String) -> Result<Writer, io.IoError> {
    let f = create(path)?
    return Ok(writer(move f))
}

/// Flush, then close and report every error.
pub fn finish(w: Writer) -> Result<Int, io.IoError> {
    var x = move w
    match x.flush() {
        Ok(n) => {
            return close_in_place(x.file)
        }
        Err(e) => {
            let c = close_in_place(x.file)
            return Err(move e)
        }
    }
}

impl Writer {
    fn put(mut self, p: Int, n: Int) -> Result<Int, io.IoError> {
        if self.data.len() + n > 65536 {
            let r = self.flush()?
        }
        if n >= 65536 {
            let err = write_raw(self.file.fd, p, n)
            if err != 0 {
                return Err(io.os_error("write", self.file.path, err))
            }
            return Ok(n)
        }
        self.data.push_raw(p, n)
        return Ok(n)
    }

    /// Write out everything buffered.
    fn flush(mut self) -> Result<Int, io.IoError> {
        let n = self.data.len()
        let fd = self.file.fd
        let err = flush_parts(fd, self.data)
        if err != 0 {
            return Err(io.os_error("write", self.file.path, err))
        }
        return Ok(n)
    }

    fn write_str(mut self, s: view String) -> Result<Int, io.IoError> {
        return self.put(s.raw_addr(), s.len())
    }

    /// `s` followed by `\n`.
    fn write_line(mut self, s: view String) -> Result<Int, io.IoError> {
        let a = self.put(s.raw_addr(), s.len())?
        let b = self.write_byte(10u8)?
        return Ok(a + b)
    }

    fn write_byte(mut self, b: UInt8) -> Result<Int, io.IoError> {
        if self.data.len() + 1 > 65536 {
            let r = self.flush()?
        }
        self.data.push_byte(b.to_int())
        return Ok(1)
    }

    fn write(mut self, data: view [UInt8]) -> Result<Int, io.IoError> {
        let n = data.len()
        let p = pack(data)
        let r = self.put(p, n)
        __free(p)
        return r
    }
}

/// True when `path` names a symbolic link itself (does not follow the link).
pub fn is_symlink(path: view String) -> Bool {
    match symlink_metadata(path) {
        Ok(info) => { return info.kind == FileKind.Symlink }
        Err(_) => { return false }
    }
}
