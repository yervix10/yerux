// std.io: the first standard-library I/O layer (docs/STDLIB_IO.md).
//
//   import std.io          then      io.read_line()   io.read_file("a.txt")   io.args()   io.exit(2)
//
// Written in Yerux on top of a handful of raw intrinsics (`__syscall`, `__global`, `__alloc`, `__free`,
// `__load8/64`, `__store8/64`, `String.raw_addr`, `String.push_raw`). No libc, no FFI: on the native x86-64
// Linux backend a call is a `syscall` instruction. Every failure is a value (`IoError`), nothing aborts.

// ───────────────────────── errors ─────────────────────────

pub enum IoErrorKind {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    IsDirectory,
    NotDirectory,
    InvalidInput,
    InvalidData,
    BrokenPipe,
    OutOfSpace,
    NotEmpty,
    Other,
}

pub struct IoError {
    kind: IoErrorKind,
    code: Int,
    message: String,
}

fn kind_code(k: IoErrorKind) -> Int {
    match k {
        NotFound => {
            return 1
        }
        PermissionDenied => {
            return 2
        }
        AlreadyExists => {
            return 3
        }
        IsDirectory => {
            return 4
        }
        NotDirectory => {
            return 5
        }
        InvalidInput => {
            return 6
        }
        InvalidData => {
            return 7
        }
        BrokenPipe => {
            return 8
        }
        OutOfSpace => {
            return 9
        }
        NotEmpty => {
            return 11
        }
        Other => {
            return 10
        }
    }
}

impl Equal for IoErrorKind {
    fn eq(view self, other: view IoErrorKind) -> Bool {
        return kind_code(self) == kind_code(other)
    }
}

impl Show for IoError {
    fn show(view self) -> String {
        return String.from(self.message)
    }
}

fn errno_kind(e: Int) -> IoErrorKind {
    if e == 2 {
        return IoErrorKind.NotFound
    }
    if e == 13 || e == 1 || e == 30 {
        return IoErrorKind.PermissionDenied
    }
    if e == 17 {
        return IoErrorKind.AlreadyExists
    }
    if e == 21 {
        return IoErrorKind.IsDirectory
    }
    if e == 20 {
        return IoErrorKind.NotDirectory
    }
    if e == 22 || e == 36 {
        return IoErrorKind.InvalidInput
    }
    if e == 32 {
        return IoErrorKind.BrokenPipe
    }
    if e == 28 || e == 122 {
        return IoErrorKind.OutOfSpace
    }
    if e == 39 {
        return IoErrorKind.NotEmpty
    }
    return IoErrorKind.Other
}

fn errno_text(e: Int) -> Text {
    if e == 1 {
        return "Operation not permitted"
    }
    if e == 2 {
        return "No such file or directory"
    }
    if e == 5 {
        return "Input/output error"
    }
    if e == 9 {
        return "Bad file descriptor"
    }
    if e == 13 {
        return "Permission denied"
    }
    if e == 17 {
        return "File exists"
    }
    if e == 20 {
        return "Not a directory"
    }
    if e == 21 {
        return "Is a directory"
    }
    if e == 22 {
        return "Invalid argument"
    }
    if e == 24 {
        return "Too many open files"
    }
    if e == 28 {
        return "No space left on device"
    }
    if e == 30 {
        return "Read-only file system"
    }
    if e == 32 {
        return "Broken pipe"
    }
    if e == 36 {
        return "File name too long"
    }
    if e == 122 {
        return "Disk quota exceeded"
    }
    if e == 16 {
        return "Device or resource busy"
    }
    if e == 18 {
        return "Invalid cross-device link"
    }
    if e == 34 {
        return "Numerical result out of range"
    }
    if e == 39 {
        return "Directory not empty"
    }
    if e == 40 {
        return "Too many levels of symbolic links"
    }
    return "Unknown error"
}

// An IoError for the failed operation `op` on `what` (a path, or "" when there is none); `e` is a positive errno.
pub fn os_error(op: Text, what: view String, e: Int) -> IoError {
    var m = String.from(op)
    if what.len() > 0 {
        m.push_str(" '")
        m.push_str(what)
        m.push_str("'")
    }
    m.push_str(": ")
    m.push_str(errno_text(e))
    m.push_str(" (os error ")
    m.push_int(e)
    m.push_str(")")
    return IoError { kind: errno_kind(e), code: e, message: move m }
}

pub fn custom_error(kind: IoErrorKind, message: Text) -> IoError {
    return IoError { kind: kind, code: 0, message: String.from(message) }
}

// ───────────────────────── helpers ─────────────────────────

// Is the string well-formed UTF-8 (no overlong forms, no surrogates, nothing above U+10FFFF)?
pub fn valid_utf8(s: view String) -> Bool {
    let n = s.len()
    var i = 0
    while i < n {
        let b = s.byte(i)
        if b < 128 {
            i = i + 1
        } else if b >= 194 && b <= 223 {
            if i + 1 >= n || s.byte(i + 1) < 128 || s.byte(i + 1) > 191 {
                return false
            }
            i = i + 2
        } else if b >= 224 && b <= 239 {
            if i + 2 >= n {
                return false
            }
            let c1 = s.byte(i + 1)
            let c2 = s.byte(i + 2)
            var lo = 128
            var hi = 191
            if b == 224 {
                lo = 160
            }
            if b == 237 {
                hi = 159
            }
            if c1 < lo || c1 > hi || c2 < 128 || c2 > 191 {
                return false
            }
            i = i + 3
        } else if b >= 240 && b <= 244 {
            if i + 3 >= n {
                return false
            }
            let c1 = s.byte(i + 1)
            var lo = 128
            var hi = 191
            if b == 240 {
                lo = 144
            }
            if b == 244 {
                hi = 143
            }
            if c1 < lo || c1 > hi || s.byte(i + 2) < 128 || s.byte(i + 2) > 191 || s.byte(i + 3) < 128 || s.byte(i + 3) > 191 {
                return false
            }
            i = i + 4
        } else {
            return false
        }
    }
    return true
}

// A String from the NUL-terminated bytes at `p`. Input that is not valid UTF-8 (possible in argv and the
// environment) is converted lossily: every non-ASCII byte becomes '?'.
pub fn cstr(p: Int) -> String {
    var n = 0
    while __load8(p + n) != 0 {
        n = n + 1
    }
    var s = String.new()
    s.push_raw(p, n)
    if valid_utf8(s) {
        return s
    }
    var t = String.new()
    var i = 0
    while i < n {
        let b = __load8(p + i)
        if b < 128 {
            t.push_byte(b)
        } else {
            t.push_byte(63)
        }
        i = i + 1
    }
    return t
}

// path + a terminating NUL, ready for the kernel; a path with an embedded NUL byte is an error
pub fn cpath(path: view String) -> Result<String, IoError> {
    var i = 0
    while i < path.len() {
        if path.byte(i) == 0 {
            return Err(custom_error(IoErrorKind.InvalidInput, "path contains a NUL byte"))
        }
        i = i + 1
    }
    var p = String.from(path)
    p.push_byte(0)
    return Ok(move p)
}

// ───────────────────────── standard input ─────────────────────────
// A 64 KiB buffer, allocated when a read finds it empty and freed again as soon as every byte in it has been consumed. Global cells: 1 = buffer, 2 = read
// position, 3 = end of the valid bytes.

// Refill the buffer. false at end of input.
fn fill() -> Result<Bool, IoError> {
    if __load64(__global(1)) == 0 {
        __store64(__global(1), __alloc(65536))
    }
    let buf = __load64(__global(1))
    while true {
        let n = __syscall(0, 0, buf, 65536, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            return Err(os_error("read stdin", "", 0 - n))
        }
        if n == 0 {
            __free(buf)
            __store64(__global(1), 0)
            __store64(__global(2), 0)
            __store64(__global(3), 0)
            return Ok(false)
        }
        __store64(__global(2), 0)
        __store64(__global(3), n)
        return Ok(true)
    }
    return Ok(false)
}

// Release the buffer once every byte in it has been consumed (so a program that stops reading at a line
// boundary leaks nothing); the next read allocates a fresh one.
fn release_if_drained() {
    if __load64(__global(1)) != 0 && __load64(__global(2)) == __load64(__global(3)) {
        __free(__load64(__global(1)))
        __store64(__global(1), 0)
        __store64(__global(2), 0)
        __store64(__global(3), 0)
    }
}

pub fn checked_text(s: String) -> Result<String, IoError> {
    if valid_utf8(s) {
        return Ok(move s)
    }
    return Err(custom_error(IoErrorKind.InvalidData, "stream did not contain valid UTF-8"))
}

// The next line of standard input without its line ending ("\n" or "\r\n"); Ok(None) at end of input. A last
// line without a newline is returned as a line.
pub fn read_line() -> Result<Option<String>, IoError> {
    var line = String.new()
    var got = false
    var newline = false
    while true {
        let pos = __load64(__global(2))
        let end = __load64(__global(3))
        if pos == end {
            let more = fill()?
            if !more {
                break
            }
            continue
        }
        let buf = __load64(__global(1))
        var i = pos
        while i < end && __load8(buf + i) != 10 {
            i = i + 1
        }
        got = true
        line.push_raw(buf + pos, i - pos)
        if i < end {
            __store64(__global(2), i + 1)
            release_if_drained()
            newline = true
            break
        }
        __store64(__global(2), end)
    }
    if !got {
        return Ok(None)
    }
    if newline && line.len() > 0 && line.byte(line.len() - 1) == 13 {
        let t = line.slice(0, line.len() - 1)
        let c = checked_text(move t)?
        return Ok(Some(move c))
    }
    let c = checked_text(move line)?
    return Ok(Some(move c))
}

// Everything left on standard input ("" at end of input).
pub fn read_all() -> Result<String, IoError> {
    var out = String.new()
    while true {
        let pos = __load64(__global(2))
        let end = __load64(__global(3))
        if pos == end {
            let more = fill()?
            if !more {
                break
            }
            continue
        }
        out.push_raw(__load64(__global(1)) + pos, end - pos)
        __store64(__global(2), end)
        release_if_drained()
    }
    return checked_text(move out)
}

// ───────────────────────── writing to the standard streams ─────────────────────────

fn write_raw_fd(fd: Int, base: Int, total: Int, what: Text) -> Result<Int, IoError> {
    var off = 0
    while off < total {
        let n = __syscall(1, fd, base + off, total - off, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            return Err(os_error(what, "", 0 - n))
        }
        if n == 0 {
            return Err(custom_error(IoErrorKind.Other, "write made no progress"))
        }
        off = off + n
    }
    return Ok(total)
}

fn write_fd(fd: Int, s: view String, what: Text) -> Result<Int, IoError> {
    return write_raw_fd(fd, s.raw_addr(), s.len(), what)
}

// Write the bytes of `s` to standard output (no newline added; `print` adds one). Returns the byte count.
pub fn write_stdout(s: view String) -> Result<Int, IoError> {
    return write_fd(1, s, "write stdout")
}

/// Write a List, array or slice of bytes to stdout without UTF-8 conversion.
pub fn write_stdout_bytes(data: view [UInt8]) -> Result<Int, IoError> {
    let total = data.len()
    if total == 0 { return Ok(0) }
    let size = total.min(16384)
    let p = __alloc(size)
    defer __free(p)
    var offset = 0
    while offset < total {
        let n = (total - offset).min(size)
        for i in 0..n { __store8(p + i, data[offset + i].to_int()) }
        let written = write_raw_fd(1, p, n, "write stdout")?
        offset = offset + written
    }
    return Ok(total)
}

pub fn write_stderr(s: view String) -> Result<Int, IoError> {
    return write_fd(2, s, "write stderr")
}

// Diagnostics: standard error, errors ignored.
pub fn eprint(s: view String) {
    let r = write_fd(2, s, "write stderr")
}

pub fn eprintln(s: view String) {
    let r = write_fd(2, s, "write stderr")
    let nl = write_fd(2, "\n", "write stderr")
}

// ───────────────────────── process: arguments, environment, exit ─────────────────────────
// Global cell 0 holds the address of the initial process stack: argc, argv[0..argc], 0, envp[..], 0.

// The command line, program name first.
pub fn args() -> List<String> {
    let sp = __load64(__global(0))
    let argc = __load64(sp)
    var out = List<String>.new()
    var i = 0
    while i < argc {
        out.push(cstr(__load64(sp + 8 + 8 * i)))
        i = i + 1
    }
    return out
}

fn env_base() -> Int {
    let sp = __load64(__global(0))
    return sp + 8 + 8 * (__load64(sp) + 1)
}

// The environment is the NUL-terminated `envp` block on the initial stack until the program changes it
// (set_env_var / remove_env_var); from then on it is a heap table in global cells 8..10: 8 = address of
// 16-byte entries (address of "KEY=VALUE\0", 1 when the bytes are a heap block of ours), 9 = count,
// 10 = capacity.
fn env_count() -> Int {
    if __load64(__global(8)) != 0 {
        return __load64(__global(9))
    }
    let base = env_base()
    var i = 0
    while __load64(base + 8 * i) != 0 {
        i = i + 1
    }
    return i
}

fn env_entry(i: Int) -> Int {
    let t = __load64(__global(8))
    if t != 0 {
        return __load64(t + 16 * i)
    }
    return __load64(env_base() + 8 * i)
}

// Is entry `p` ("KEY=VALUE") the variable `name`? Returns the offset of the value, or -1.
fn env_match(p: Int, name: view String) -> Int {
    var k = 0
    while k < name.len() {
        if __load8(p + k) != name.byte(k) {
            return -1
        }
        k = k + 1
    }
    if __load8(p + k) == 61 {
        return k + 1
    }
    return -1
}

// "KEY=VALUE" entries of the environment.
pub fn env_vars() -> List<String> {
    let n = env_count()
    var out = List<String>.new()
    var i = 0
    while i < n {
        out.push(cstr(env_entry(i)))
        i = i + 1
    }
    return out
}

// The value of environment variable `name`; None when it is not set.
pub fn env_var(name: view String) -> Option<String> {
    let n = env_count()
    var i = 0
    while i < n {
        let p = env_entry(i)
        let v = env_match(p, name)
        if v >= 0 {
            let e = cstr(p + v)
            return Some(move e)
        }
        i = i + 1
    }
    return None
}

// Switch to the heap table (once).
fn env_own() {
    if __load64(__global(8)) != 0 {
        return
    }
    let base = env_base()
    var n = 0
    while __load64(base + 8 * n) != 0 {
        n = n + 1
    }
    let cap = n + 8
    let t = __alloc(16 * cap)
    var i = 0
    while i < n {
        __store64(t + 16 * i, __load64(base + 8 * i))
        __store64(t + 16 * i + 8, 0)
        i = i + 1
    }
    __store64(__global(8), t)
    __store64(__global(9), n)
    __store64(__global(10), cap)
}

fn env_name_ok(name: view String) -> Result<Int, IoError> {
    if name.len() == 0 {
        return Err(custom_error(IoErrorKind.InvalidInput, "environment variable name is empty"))
    }
    var i = 0
    while i < name.len() {
        let b = name.byte(i)
        if b == 61 || b == 0 {
            return Err(custom_error(IoErrorKind.InvalidInput, "environment variable name contains '=' or a NUL byte"))
        }
        i = i + 1
    }
    return Ok(0)
}

// Set `name` to `value` for this process (later env_var/env_vars see it). `InvalidInput` for an empty
// name, a name with '=' or NUL, or a value with NUL. Not thread-safe.
pub fn set_env_var(name: view String, value: view String) -> Result<Int, IoError> {
    let ok = env_name_ok(name)?
    var i = 0
    while i < value.len() {
        if value.byte(i) == 0 {
            return Err(custom_error(IoErrorKind.InvalidInput, "environment variable value contains a NUL byte"))
        }
        i = i + 1
    }
    env_own()
    let size = name.len() + 1 + value.len() + 1
    let p = __alloc(size)
    var k = 0
    while k < name.len() {
        __store8(p + k, name.byte(k))
        k = k + 1
    }
    __store8(p + k, 61)
    var j = 0
    while j < value.len() {
        __store8(p + k + 1 + j, value.byte(j))
        j = j + 1
    }
    __store8(p + size - 1, 0)
    let t = __load64(__global(8))
    let n = __load64(__global(9))
    var e = 0
    while e < n {
        if env_match(__load64(t + 16 * e), name) >= 0 {
            if __load64(t + 16 * e + 8) == 1 {
                __free(__load64(t + 16 * e))
            }
            __store64(t + 16 * e, p)
            __store64(t + 16 * e + 8, 1)
            return Ok(0)
        }
        e = e + 1
    }
    var cap = __load64(__global(10))
    var table = t
    if n == cap {
        cap = cap * 2
        table = __alloc(16 * cap)
        var c = 0
        while c < n {
            __store64(table + 16 * c, __load64(t + 16 * c))
            __store64(table + 16 * c + 8, __load64(t + 16 * c + 8))
            c = c + 1
        }
        __free(t)
        __store64(__global(8), table)
        __store64(__global(10), cap)
    }
    __store64(table + 16 * n, p)
    __store64(table + 16 * n + 8, 1)
    __store64(__global(9), n + 1)
    return Ok(0)
}

// Remove `name` from this process's environment. Ok(1) when it was set, Ok(0) when it was not.
pub fn remove_env_var(name: view String) -> Result<Int, IoError> {
    let ok = env_name_ok(name)?
    env_own()
    let t = __load64(__global(8))
    let n = __load64(__global(9))
    var e = 0
    while e < n {
        if env_match(__load64(t + 16 * e), name) >= 0 {
            if __load64(t + 16 * e + 8) == 1 {
                __free(__load64(t + 16 * e))
            }
            // keep the order: shift the rest down
            var c = e
            while c + 1 < n {
                __store64(t + 16 * c, __load64(t + 16 * (c + 1)))
                __store64(t + 16 * c + 8, __load64(t + 16 * (c + 1) + 8))
                c = c + 1
            }
            __store64(__global(9), n - 1)
            return Ok(1)
        }
        e = e + 1
    }
    return Ok(0)
}

// Ends the process at once with `code` (0..255): deferred statements and drops do not run.
pub fn exit(code: Int) {
    let r = __syscall(231, code, 0, 0, 0, 0, 0)
}

// Like `exit`, for call sites that want to say "everything written so far is delivered": `print`, `write_stdout` and
// `eprint` are unbuffered natively, and the C backend flushes C's `stdout` before every raw syscall, so nothing is
// lost by `exit` either. It still skips `defer` and destructors: use `run_status` to have those run.
pub fn exit_clean(code: Int) {
    let r = __syscall(231, code, 0, 0, 0, 0, 0)
}

// Run `f` (the real `main` of the program) and then end the process with the status it returns, unless it is 0.
// Everything `f` owns is dropped and its `defer`s ran before it returned, which `exit` called from inside cannot do.
//
//   fn real_main() -> Int { ... return 1 }
//   fn main() { io.run_status(real_main) }
pub fn run_status(f: view fn() -> Int) {
    let code = f()
    if code != 0 {
        exit(code)
    }
}

pub fn process_id() -> Int {
    return __syscall(39, 0, 0, 0, 0, 0, 0)
}

// ───────────────────────── files ─────────────────────────

// The whole file as a String; InvalidData when it is not valid UTF-8.
pub fn read_file(path: view String) -> Result<String, IoError> {
    let cp = cpath(path)?
    let fd = __syscall(2, cp.raw_addr(), 524288, 0, 0, 0, 0)
    if fd < 0 {
        return Err(os_error("open", path, 0 - fd))
    }
    var out = String.new()
    let buf = __alloc(65536)
    var err = 0
    while true {
        let n = __syscall(0, fd, buf, 65536, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            err = 0 - n
            break
        }
        if n == 0 {
            break
        }
        out.push_raw(buf, n)
    }
    __free(buf)
    let c = __syscall(3, fd, 0, 0, 0, 0, 0)
    if err != 0 {
        return Err(os_error("read", path, err))
    }
    return checked_text(move out)
}

fn write_to(path: view String, data: view String, flags: Int) -> Result<Int, IoError> {
    let cp = cpath(path)?
    let fd = __syscall(2, cp.raw_addr(), flags, 420, 0, 0, 0)
    if fd < 0 {
        return Err(os_error("open", path, 0 - fd))
    }
    let total = data.len()
    let base = data.raw_addr()
    var off = 0
    var err = 0
    while off < total {
        let n = __syscall(1, fd, base + off, total - off, 0, 0, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            err = 0 - n
            break
        }
        off = off + n
    }
    var c = __syscall(3, fd, 0, 0, 0, 0, 0)
    if err == 0 && c < 0 {
        err = 0 - c
    }
    if err != 0 {
        return Err(os_error("write", path, err))
    }
    return Ok(total)
}

// Create or truncate `path` (mode 0644) and write `data`. Returns the number of bytes written.
pub fn write_file(path: view String, data: view String) -> Result<Int, IoError> {
    return write_to(path, data, 524865)
}

// Append `data` to `path`, creating it when missing. Returns the number of bytes written.
pub fn append_file(path: view String, data: view String) -> Result<Int, IoError> {
    return write_to(path, data, 525377)
}

// Does `path` exist and is it reachable (access(2) with F_OK)?
pub fn file_exists(path: view String) -> Bool {
    match cpath(path) {
        Ok(cp) => {
            return __syscall(21, cp.raw_addr(), 0, 0, 0, 0, 0) == 0
        }
        Err(e) => {
            return false
        }
    }
}

// Delete a file. Ok(0) on success.
pub fn remove_file(path: view String) -> Result<Int, IoError> {
    let cp = cpath(path)?
    let r = __syscall(87, cp.raw_addr(), 0, 0, 0, 0, 0)
    if r < 0 {
        return Err(os_error("remove", path, 0 - r))
    }
    return Ok(0)
}

// ───────────────────────── time ─────────────────────────

fn clock_ns(id: Int) -> Int {
    let ts = __alloc(16)
    let r = __syscall(228, id, ts, 0, 0, 0, 0)
    var ns = 0
    if r == 0 {
        ns = __load64(ts) * 1000000000 + __load64(ts + 8)
    }
    __free(ts)
    return ns
}

// Nanoseconds on a clock that never goes backwards (CLOCK_MONOTONIC); only differences mean something.
pub fn monotonic_ns() -> Int {
    return clock_ns(1)
}

// Wall-clock time: nanoseconds and whole seconds since 1970-01-01 UTC (CLOCK_REALTIME).
pub fn unix_nanos() -> Int {
    return clock_ns(0)
}

pub fn unix_secs() -> Int {
    return clock_ns(0) / 1000000000
}

// Sleep at least `ns` nanoseconds (restarts when interrupted by a signal); returns at once for ns <= 0.
pub fn sleep_ns(ns: Int) {
    if ns <= 0 {
        return
    }
    let ts = __alloc(32)
    __store64(ts, ns / 1000000000)
    __store64(ts + 8, ns % 1000000000)
    while true {
        let r = __syscall(35, ts, ts + 16, 0, 0, 0, 0)
        if r != -4 {
            break
        }
        __store64(ts, __load64(ts + 16))
        __store64(ts + 8, __load64(ts + 24))
    }
    __free(ts)
}

pub fn sleep_ms(ms: Int) {
    if ms <= 0 {
        return
    }
    sleep_ns(ms * 1000000)
}
