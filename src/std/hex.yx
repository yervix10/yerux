// std.hex: hexadecimal encoding for strings and raw bytes (docs/STDLIB.md).
fn digit(n: Int) -> Int {
  if n < 10 { return 48 + n }
  return 87 + n
}

fn encode_byte(out: mut String, b: Int) {
  out.push_byte(digit(b / 16))
  out.push_byte(digit(b % 16))
}

pub fn encode(s: view String) -> String {
  var out = String.new()
  for i in 0..s.len() { encode_byte(out, s.byte(i)) }
  return move out
}

/// Hexadecimal encoding of raw bytes, in lowercase.
pub fn encode_bytes(data: view [UInt8]) -> String {
  var out = String.new()
  for i in 0..data.len() { encode_byte(out, data[i].to_int()) }
  return move out
}

fn value(b: Int) -> Int {
  if b >= 48 && b <= 57 { return b - 48 }
  if b >= 65 && b <= 70 { return b - 65 + 10 }
  if b >= 97 && b <= 102 { return b - 97 + 10 }
  return -1
}

fn decode_pair(s: view String, i: Int) -> Int {
  let hi = value(s.byte(i))
  let lo = value(s.byte(i + 1))
  if hi < 0 || lo < 0 { return -1 }
  return hi * 16 + lo
}

pub fn decode(s: view String) -> Result<String, String> {
  if s.len() % 2 != 0 { return Err(String.from("hex input must have even length")) }
  var out = String.new()
  var i = 0
  while i < s.len() {
    let b = decode_pair(s, i)
    if b < 0 { return Err(String.from("invalid hex digit")) }
    out.push_byte(b)
    i = i + 2
  }
  return Ok(move out)
}

/// Decode hexadecimal text into raw bytes.
pub fn decode_bytes(s: view String) -> Result<List<UInt8>, String> {
  if s.len() % 2 != 0 { return Err(String.from("hex input must have even length")) }
  var out = List<UInt8>.new()
  var i = 0
  while i < s.len() {
    let b = decode_pair(s, i)
    if b < 0 { return Err(String.from("invalid hex digit")) }
    out.push(b.to_uint8())
    i = i + 2
  }
  return Ok(move out)
}
