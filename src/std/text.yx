// std.text: text-processing helpers (docs/STDLIB.md).
//
//   import std.text        then      text.split_ws(s)   text.parse_int(s)   text.is_digit(c)
//
// Free functions over `view String` (methods cannot be added to String from a module). Everything is plain
// Yerux over the String/List prelude. Offsets are byte offsets and always land on character boundaries.

// ───────────────────────── character classification ─────────────────────────

pub fn is_digit(c: Char) -> Bool {
  let n = c.to_int()
  return n >= 48 && n <= 57
}

pub fn is_upper(c: Char) -> Bool {
  let n = c.to_int()
  return n >= 65 && n <= 90
}

pub fn is_lower(c: Char) -> Bool {
  let n = c.to_int()
  return n >= 97 && n <= 122
}

pub fn is_alpha(c: Char) -> Bool {
  return is_upper(c) || is_lower(c)
}

pub fn is_alnum(c: Char) -> Bool {
  return is_alpha(c) || is_digit(c)
}

pub fn is_hex_digit(c: Char) -> Bool {
  let n = c.to_int()
  return (n >= 48 && n <= 57) || (n >= 65 && n <= 70) || (n >= 97 && n <= 102)
}

pub fn is_space(c: Char) -> Bool {
  let n = c.to_int()
  return n == 32 || (n >= 9 && n <= 13)
}

pub fn is_ascii(c: Char) -> Bool {
  return c.to_int() < 128
}

pub fn is_punct(c: Char) -> Bool {
  let n = c.to_int()
  return (n >= 33 && n <= 47) || (n >= 58 && n <= 64) || (n >= 91 && n <= 96) || (n >= 123 && n <= 126)
}

/// Value of `c` as a digit in `base` (2..36), or -1.
pub fn digit_value(c: Char, base: Int) -> Int {
  let n = c.to_int()
  var v = -1
  if n >= 48 && n <= 57 {
    v = n - 48
  } else if n >= 97 && n <= 122 {
    v = n - 97 + 10
  } else if n >= 65 && n <= 90 {
    v = n - 65 + 10
  }
  if v >= base {
    return -1
  }
  return v
}

/// ASCII-only case mapping of one character (others unchanged).
pub fn char_to_upper(c: Char) -> Char {
  if is_lower(c) {
    return Char.from_int(c.to_int() - 32)
  }
  return c
}

pub fn char_to_lower(c: Char) -> Char {
  if is_upper(c) {
    return Char.from_int(c.to_int() + 32)
  }
  return c
}

// ───────────────────────── UTF-8 iteration ─────────────────────────

/// All characters of `s`, in order.
pub fn chars(s: view String) -> List<Char> {
  var out = List<Char>.new()
  var i = 0
  while i < s.len() {
    out.push(s.char_at(i))
    i = i + s.char_size(i)
  }
  return out
}

/// Byte offset of every character of `s` (same length as `chars(s)`).
pub fn char_offsets(s: view String) -> List<Int> {
  var out = List<Int>.new()
  var i = 0
  while i < s.len() {
    out.push(i)
    i = i + s.char_size(i)
  }
  return out
}

/// The string made of `cs`.
pub fn from_chars(cs: view List<Char>) -> String {
  var r = String.new()
  var i = 0
  while i < cs.len() {
    r.push_char(cs.get(i))
    i = i + 1
  }
  return r
}

/// Byte offset of the `n`-th character (0-based); `s.len()` when `n == s.char_count()`; -1 beyond that.
pub fn nth_char_offset(s: view String, n: Int) -> Int {
  if n < 0 {
    return -1
  }
  var i = 0
  var k = 0
  while i < s.len() {
    if k == n {
      return i
    }
    i = i + s.char_size(i)
    k = k + 1
  }
  if k == n {
    return i
  }
  return -1
}

/// `s` with its characters in reverse order.
pub fn reverse(s: view String) -> String {
  var r = String.new()
  var end = s.len()
  while end > 0 {
    var st = end - 1
    while st > 0 && !s.is_boundary(st) {
      st = st - 1
    }
    r.push_slice(s, st, end)
    end = st
  }
  return r
}

// ───────────────────────── queries ─────────────────────────

pub fn starts_with(s: view String, p: view String) -> Bool {
  return s.starts_with(p)
}

pub fn ends_with(s: view String, p: view String) -> Bool {
  return s.ends_with(p)
}

pub fn contains(s: view String, p: view String) -> Bool {
  return s.contains(p)
}

/// First byte offset of `p` in `s`, or -1.
pub fn find(s: view String, p: view String) -> Int {
  return s.find(p)
}

/// Last byte offset of `p` in `s`, or -1 (an empty `p` matches at `s.len()`).
pub fn rfind(s: view String, p: view String) -> Int {
  var i = s.len() - p.len()
  while i >= 0 {
    if s.is_boundary(i) {
      var j = 0
      while j < p.len() && s.byte(i + j) == p.byte(j) {
        j = j + 1
      }
      if j == p.len() {
        return i
      }
    }
    i = i - 1
  }
  return -1
}

/// Number of non-overlapping occurrences of `p` (0 for an empty `p`).
pub fn count(s: view String, p: view String) -> Int {
  if p.len() == 0 {
    return 0
  }
  var n = 0
  var i = s.find_from(p, 0)
  while i >= 0 {
    n = n + 1
    i = s.find_from(p, i + p.len())
  }
  return n
}

/// True when `s` is empty or only whitespace.
pub fn is_blank(s: view String) -> Bool {
  var i = 0
  while i < s.len() {
    if !is_space(s.char_at(i)) {
      return false
    }
    i = i + s.char_size(i)
  }
  return true
}

/// True when every character of `s` is ASCII (and `s` may be empty).
pub fn all_ascii(s: view String) -> Bool {
  var i = 0
  while i < s.len() {
    if s.byte(i) >= 128 {
      return false
    }
    i = i + 1
  }
  return true
}

// ───────────────────────── transformations ─────────────────────────

pub fn replace(s: view String, from: view String, to: view String) -> String {
  return s.replace(from, to)
}

pub fn to_lower(s: view String) -> String {
  return s.to_lower()
}

pub fn to_upper(s: view String) -> String {
  return s.to_upper()
}

pub fn repeat(s: view String, n: Int) -> String {
  return s.repeat(n)
}

pub fn trim(s: view String) -> String {
  return s.trim()
}

pub fn trim_start(s: view String) -> String {
  return s.trim_start()
}

pub fn trim_end(s: view String) -> String {
  return s.trim_end()
}

/// `s` without the prefix `p`, or None when `s` does not start with it.
pub fn strip_prefix(s: view String, p: view String) -> Option<String> {
  if !s.starts_with(p) {
    return None
  }
  return Some(s.slice(p.len(), s.len()))
}

pub fn strip_suffix(s: view String, p: view String) -> Option<String> {
  if !s.ends_with(p) {
    return None
  }
  return Some(s.slice(0, s.len() - p.len()))
}

/// Upper-case the first character (ASCII letters only), leave the rest.
pub fn capitalize(s: view String) -> String {
  var r = String.new()
  if s.len() == 0 {
    return r
  }
  let n = s.char_size(0)
  r.push_char(char_to_upper(s.char_at(0)))
  r.push_slice(s, n, s.len())
  return r
}

// ───────────────────────── splitting and joining ─────────────────────────

/// Pieces of `s` separated by `sep` (non-empty); empty pieces are kept: `split("a,,b", ",")` is `a`, ``, `b`.
pub fn split(s: view String, sep: view String) -> List<String> {
  return s.split(sep)
}

/// Pieces joined with `sep`.
pub fn join(parts: view List<String>, sep: view String) -> String {
  return parts.join(sep)
}

/// Split at the first `sep`: Some((before, after)) or None.
pub fn split_once(s: view String, sep: view String) -> Option<(String, String)> {
  if sep.len() == 0 {
    return None
  }
  let i = s.find(sep)
  if i < 0 {
    return None
  }
  return Some((s.slice(0, i), s.slice(i + sep.len(), s.len())))
}

/// Split at the last `sep`: Some((before, after)) or None.
pub fn rsplit_once(s: view String, sep: view String) -> Option<(String, String)> {
  if sep.len() == 0 {
    return None
  }
  let i = rfind(s, sep)
  if i < 0 {
    return None
  }
  return Some((s.slice(0, i), s.slice(i + sep.len(), s.len())))
}

/// Maximal runs of non-whitespace characters (no empty pieces).
pub fn split_ws(s: view String) -> List<String> {
  var out = List<String>.new()
  var i = 0
  var start = -1
  while i < s.len() {
    let sp = is_space(s.char_at(i))
    if sp && start >= 0 {
      out.push(s.slice(start, i))
      start = -1
    } else if !sp && start < 0 {
      start = i
    }
    i = i + s.char_size(i)
  }
  if start >= 0 {
    out.push(s.slice(start, s.len()))
  }
  return out
}

/// The lines of `s`: separated by "\n", a "\r" before it is removed, and a final empty line after a trailing
/// newline is not reported (`lines("a\nb\n")` is `a`, `b`; `lines("")` is empty).
pub fn lines(s: view String) -> List<String> {
  return s.lines()
}

// ───────────────────────── parsing ─────────────────────────

/// Parses `[+-]digits` in `base` (2..36; letters in either case). Err explains the failure.
pub fn parse_int_radix(s: view String, base: Int) -> Result<Int, String> {
  if base < 2 || base > 36 {
    return Err(String.from("base must be in 2..36"))
  }
  let n = s.len()
  if n == 0 {
    return Err(String.from("empty string"))
  }
  var i = 0
  var neg = false
  if s.byte(0) == 45 || s.byte(0) == 43 {
    neg = s.byte(0) == 45
    i = 1
  }
  if i >= n {
    return Err(String.from("no digits"))
  }
  // accumulate negatively so that Int.min parses too
  var acc = 0
  let lim = -9223372036854775807 - 1
  while i < n {
    let d = digit_value(Char.from_int(s.byte(i)), base)
    if s.byte(i) >= 128 || d < 0 {
      return Err("invalid digit at byte {i}")
    }
    if acc < (lim + d) / base {
      return Err(String.from("number too large"))
    }
    acc = acc * base - d
    i = i + 1
  }
  if neg {
    return Ok(acc)
  }
  if acc == lim {
    return Err(String.from("number too large"))
  }
  return Ok(-acc)
}

pub fn parse_int(s: view String) -> Result<Int, String> {
  return parse_int_radix(s, 10)
}

pub fn parse_bool(s: view String) -> Result<Bool, String> {
  if s.eq("true") {
    return Ok(true)
  }
  if s.eq("false") {
    return Ok(false)
  }
  return Err(String.from("expected true or false"))
}

fn pow10(e: Int) -> Float {
  var r = 1.0
  var i = 0
  while i < e {
    r = r * 10.0
    i = i + 1
  }
  return r
}

// Limbs are little-endian in base 2^30, so products by at most 2^29 fit in Int.
const DECIMAL_LIMB: Int = 1073741824
// Every binary64 rounding midpoint has fewer than 800 significant decimal digits.
const DECIMAL_DIGITS: Int = 800
const FLOAT_IMPLICIT: Int = 4503599627370496

fn decimal_scale(value: mut List<Int>, factor: Int, add: Int) {
  var carry = add
  for i in 0..value.len() {
    let product = value.at(i) * factor + carry
    value.set(i, product % DECIMAL_LIMB)
    carry = product / DECIMAL_LIMB
  }
  if carry != 0 { value.push(carry) }
}

fn decimal_shift(value: mut List<Int>, bits: Int) {
  var left = bits
  while left >= 29 {
    decimal_scale(value, 536870912, 0)
    left = left - 29
  }
  var factor = 1
  for i in 0..left { factor = factor * 2 }
  if factor > 1 { decimal_scale(value, factor, 0) }
}

fn decimal_bit_length(value: view List<Int>) -> Int {
  var bits = 30 * (value.len() - 1)
  var top = value.at(value.len() - 1)
  while top > 0 {
    bits = bits + 1
    top = top / 2
  }
  return bits
}

fn decimal_cmp(a: view List<Int>, b: view List<Int>) -> Int {
  if a.len() != b.len() { return a.len() - b.len() }
  var i = a.len() - 1
  while i >= 0 {
    if a.at(i) != b.at(i) { return a.at(i) - b.at(i) }
    i = i - 1
  }
  return 0
}

fn decimal_subtract(a: mut List<Int>, b: view List<Int>) {
  var borrow = 0
  for i in 0..a.len() {
    var difference = a.at(i) - borrow
    if i < b.len() { difference = difference - b.at(i) }
    borrow = 0
    if difference < 0 {
      difference = difference + DECIMAL_LIMB
      borrow = 1
    }
    a.set(i, difference)
  }
  while a.len() > 1 && a.at(a.len() - 1) == 0 {
    let _ = a.pop()
  }
}

fn decimal_binary(s: view String, first: Int, end: Int, kept: Int, order: Int, sticky: Bool) -> Float {
  var n = List<Int>.new()
  n.push(0)
  var count = 0
  var i = first
  while i < end && count < kept {
    let byte = s.byte(i)
    if byte != 46 {
      decimal_scale(n, 10, byte - 48)
      count = count + 1
    }
    i = i + 1
  }
  var d = List<Int>.new()
  d.push(1)
  let scale = order - kept + 1
  if scale >= 0 {
    for i in 0..scale { decimal_scale(n, 10, 0) }
  } else {
    for i in 0..-scale { decimal_scale(d, 10, 0) }
  }

  // Normalize n/d to [1, 2), then choose the common exponent for subnormals.
  var exponent = decimal_bit_length(n) - decimal_bit_length(d)
  if exponent >= 0 { decimal_shift(d, exponent) }
  else { decimal_shift(n, -exponent) }
  if decimal_cmp(n, d) < 0 {
    exponent = exponent - 1
    decimal_scale(n, 2, 0)
  }
  if exponent < -1022 {
    decimal_shift(d, -1022 - exponent)
    exponent = -1022
  }

  var significand = 0
  for bit in 0..53 {
    significand = significand * 2
    if decimal_cmp(n, d) >= 0 {
      significand = significand + 1
      decimal_subtract(n, d)
    }
    decimal_scale(n, 2, 0)
  }
  let rounding = decimal_cmp(n, d)
  // No midpoint can lie strictly between the retained prefix and its successor.
  // Discarded nonzero digits therefore affect only exact halfway cases.
  if rounding > 0 || (rounding == 0 && (sticky || significand % 2 != 0)) {
    significand = significand + 1
  }
  if significand == 2 * FLOAT_IMPLICIT {
    significand = FLOAT_IMPLICIT
    exponent = exponent + 1
  }
  if exponent > 1023 { return 1.0 / 0.0 }
  if significand < FLOAT_IMPLICIT { return float_from_bits(significand.to_uint64()) }
  let bits = (exponent + 1023) * FLOAT_IMPLICIT + (significand - FLOAT_IMPLICIT)
  return float_from_bits(bits.to_uint64())
}

/// Parses `[+-]digits[.digits][e[+-]digits]` with binary64 round-to-nearest, ties-to-even.
/// Also accepts `inf`, `-inf`, `nan` and the spelling `infinity` for infinity.
pub fn parse_float(s: view String) -> Result<Float, String> {
  let n = s.len()
  if n == 0 {
    return Err(String.from("empty string"))
  }
  var i = 0
  var neg = false
  if s.byte(0) == 45 || s.byte(0) == 43 {
    neg = s.byte(0) == 45
    i = 1
  }
  let rest = s.slice(i, n)
  if rest.eq("inf") || rest.eq("infinity") {
    if neg {
      return Ok(-1.0 / 0.0)
    }
    return Ok(1.0 / 0.0)
  }
  if rest.eq("nan") {
    return Ok(0.0 / 0.0)
  }
  var mant = 0
  var first = -1
  var significant = 0
  var fraction = 0
  var digits = 0
  var sticky = false
  var seen_dot = false
  while i < n {
    let b = s.byte(i)
    if b >= 48 && b <= 57 {
      digits = digits + 1
      if seen_dot { fraction = fraction + 1 }
      if first < 0 && b != 48 { first = i }
      if first >= 0 {
        significant = significant + 1
        if significant <= 15 { mant = mant * 10 + b - 48 }
        if significant > DECIMAL_DIGITS && b != 48 { sticky = true }
      }
    } else if b == 46 && !seen_dot {
      seen_dot = true
    } else {
      break
    }
    i = i + 1
  }
  if digits == 0 {
    return Err(String.from("no digits"))
  }
  let end = i
  var exponent = 0
  if i < n && (s.byte(i) == 101 || s.byte(i) == 69) {
    i = i + 1
    var eneg = false
    if i < n && (s.byte(i) == 45 || s.byte(i) == 43) {
      eneg = s.byte(i) == 45
      i = i + 1
    }
    let exponent_start = i
    // Beyond this bound there are too few mantissa digits to bring the value
    // back into the binary64 range, even if the exponent has more digits.
    let limit = n + 400
    while i < n && s.byte(i) >= 48 && s.byte(i) <= 57 {
      if exponent < limit {
        exponent = (exponent * 10 + (s.byte(i) - 48)).min(limit)
      }
      i = i + 1
    }
    if i == exponent_start {
      return Err(String.from("missing exponent digits"))
    }
    if eneg { exponent = -exponent }
  }
  if i < n {
    return Err("unexpected character at byte {i}")
  }

  var value = 0.0
  if significant != 0 {
    let exp10 = exponent - fraction
    let order = exp10 + significant - 1
    if order > 308 {
      value = 1.0 / 0.0
    } else if order >= -324 {
      // Both operands are exactly representable, so one Float operation suffices.
      if significant <= 15 && exp10 >= 0 && exp10 <= 22 {
        value = mant.to_float() * pow10(exp10)
      } else if significant <= 15 && exp10 < 0 && exp10 >= -22 {
        value = mant.to_float() / pow10(-exp10)
      } else {
        value = decimal_binary(s, first, end, significant.min(DECIMAL_DIGITS), order, sticky)
      }
    }
  }
  if neg { return Ok(-value) }
  return Ok(value)
}
