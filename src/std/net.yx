// std.net: blocking TCP sockets on Linux (IPv4 and IPv6 literal addresses).
import std.io

/// A TCP socket address. `ip` must be an IPv4 or IPv6 numeric literal; no DNS lookup is performed.
pub struct SocketAddr { ip: String, port: Int }

/// An owned TCP connection. Dropping it closes the descriptor.
pub struct TcpStream { fd: Int }

/// An owned listening TCP socket. Dropping it closes the descriptor.
pub struct TcpListener { fd: Int }

impl Drop for TcpStream {
  fn drop(mut self) {
    drop_fd(self.fd)
  }
}

impl Drop for TcpListener {
  fn drop(mut self) {
    drop_fd(self.fd)
  }
}

// Retire the descriptor before close(2). Linux can release it even if close
// reports a failure, so a later cleanup must never retry that descriptor.
fn close_fd(fd: mut Int) -> Int {
  let open_fd = fd
  fd = -1
  return __syscall(3, open_fd, 0, 0, 0, 0, 0)
}

fn drop_fd(fd: mut Int) {
  if fd >= 0 {
    let ignored = close_fd(fd)
  }
}

fn close_result(fd: mut Int) -> Result<Int, io.IoError> {
  let r = close_fd(fd)
  if r < 0 { return Err(io.os_error("close", "socket", 0 - r)) }
  return Ok(0)
}

const DEFAULT_TIMEOUT_MS: Int = 5000

fn set_timeout(fd: Int, option: Int, timeout_ms: Int) -> Result<Int, io.IoError> {
  if timeout_ms < 0 {
    return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: timeout must be nonnegative"))
  }
  let tv = __alloc(16)
  defer __free(tv)
  __store64(tv, timeout_ms / 1000)
  __store64(tv + 8, (timeout_ms % 1000) * 1000)
  let r = __syscall(54, fd, 1, option, tv, 16, 0) // SOL_SOCKET
  if r < 0 { return Err(io.os_error("setsockopt", "socket", 0 - r)) }
  return Ok(0)
}

fn set_default_timeouts(fd: Int) -> Result<Int, io.IoError> {
  let applied = set_timeout(fd, 20, DEFAULT_TIMEOUT_MS)? // SO_RCVTIMEO
  return set_timeout(fd, 21, DEFAULT_TIMEOUT_MS) // SO_SNDTIMEO
}

/// Set the receive timeout in milliseconds. Zero disables it.
pub fn set_read_timeout(s: view TcpStream, timeout_ms: Int) -> Result<Int, io.IoError> {
  return set_timeout(s.fd, 20, timeout_ms)
}

/// Set the send timeout in milliseconds. Zero disables it.
pub fn set_write_timeout(s: view TcpStream, timeout_ms: Int) -> Result<Int, io.IoError> {
  return set_timeout(s.fd, 21, timeout_ms)
}

pub fn address(ip: Text, port: Int) -> Result<SocketAddr, io.IoError> {
  if port < 0 || port > 65535 {
    return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: port out of range"))
  }
  let s = String.from(ip)
  if !valid_literal(s) {
    return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: expected IPv4 or IPv6 literal"))
  }
  return Ok(SocketAddr { ip: move s, port: port })
}

fn valid_literal(s: view String) -> Bool {
  // Full parsing happens when a socket is opened. Reject hostnames early.
  var dots = 0
  var colons = 0
  var digits = 0
  var i = 0
  while i < s.len() {
    let c = s.byte(i)
    if c == 46 { dots = dots + 1 }
    else if c == 58 { colons = colons + 1 }
    else if (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) { digits = digits + 1 }
    else { return false }
    i = i + 1
  }
  return (dots == 3 && colons == 0 && digits > 0) || (colons >= 2 && (digits > 0 || s.eq("::")))
}

fn sockaddr(a: view SocketAddr, out: Int) -> Int {
  if a.port < 0 || a.port > 65535 { return -1 }
  // Clear padding, IPv6 flow info and the scope ID.
  for i in 0..4 { __store64(out + i * 8, 0) }
  if a.ip.find(":") >= 0 {
    __store8(out, 10)
    __store8(out + 1, 0)
    __store8(out + 2, a.port / 256)
    __store8(out + 3, a.port % 256)
    // Parse IPv6 hex groups, including one compressed run of zero groups.
    var i = 0
    var groups = 0
    var compress = -1
    while i < a.ip.len() {
      if a.ip.byte(i) == 58 {
        if i + 1 >= a.ip.len() || a.ip.byte(i + 1) != 58 || compress >= 0 { return -1 }
        compress = groups
        i = i + 2
      } else {
        var v = 0
        var digits = 0
        while i < a.ip.len() && a.ip.byte(i) != 58 {
          // IPv6 groups contain at most four hexadecimal digits. Reject before
          // multiplying so arbitrarily long hostile groups cannot overflow Int.
          if digits >= 4 { return -1 }
          let c = a.ip.byte(i)
          var d = c - 48
          if c >= 65 && c <= 70 { d = c - 55 }
          if c >= 97 && c <= 102 { d = c - 87 }
          if d < 0 || d > 15 { return -1 }
          v = v * 16 + d
          digits = digits + 1
          i = i + 1
        }
        if digits == 0 || digits > 4 || groups >= 8 { return -1 }
        __store8(out + 8 + groups * 2, v / 256)
        __store8(out + 9 + groups * 2, v % 256)
        groups = groups + 1
        if i < a.ip.len() && a.ip.byte(i) == 58 && i + 1 < a.ip.len() && a.ip.byte(i + 1) != 58 { i = i + 1 }
      }
    }
    if compress >= 0 {
      if groups >= 8 { return -1 }
      var shift = 8 - groups
      var k = groups - 1
      while k >= compress {
        __store8(out + 8 + (k + shift) * 2, __load8(out + 8 + k * 2))
        __store8(out + 9 + (k + shift) * 2, __load8(out + 9 + k * 2))
        k = k - 1
      }
      k = compress
      while k < compress + shift { __store8(out + 8 + k * 2, 0); __store8(out + 9 + k * 2, 0); k = k + 1 }
    } else if groups != 8 { return -1 }
    return 28
  }
  __store8(out, 2)
  __store8(out + 1, 0)
  __store8(out + 2, a.port / 256)
  __store8(out + 3, a.port % 256)
  var oct = 0
  var val = 0
  var i = 0
  while i <= a.ip.len() {
    if i == a.ip.len() || a.ip.byte(i) == 46 {
      if val > 255 || oct > 3 { return -1 }
      __store8(out + 4 + oct, val)
      oct = oct + 1
      val = 0
    } else {
      val = val * 10 + a.ip.byte(i) - 48
      if val > 255 { return -1 }
    }
    i = i + 1
  }
  if oct != 4 { return -1 }
  return 16
}

/// Connect to a numeric IPv4 or IPv6 address with the default timeout.
pub fn connect(a: view SocketAddr) -> Result<TcpStream, io.IoError> {
  return connect_timeout(a, DEFAULT_TIMEOUT_MS)
}

/// Connect to a numeric address with a timeout in milliseconds. Zero uses the OS default.
pub fn connect_timeout(a: view SocketAddr, timeout_ms: Int) -> Result<TcpStream, io.IoError> {
  let sa = __alloc(32)
  defer __free(sa)
  let n = sockaddr(a, sa)
  if n < 0 { return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: invalid address literal")) }
  let fd = __syscall(41, __load8(sa), 1, 0, 0, 0, 0)
  if fd < 0 { return Err(io.os_error("socket", a.ip, 0 - fd)) }
  let stream = TcpStream { fd: fd }
  // Linux applies SO_SNDTIMEO to blocking connect and reports expiry as EINPROGRESS.
  let timeout = set_timeout(fd, 21, timeout_ms)?
  let r = __syscall(42, fd, sa, n, 0, 0, 0)
  if r == -115 { return Err(io.os_error("connect", a.ip, 110)) }
  if r < 0 { return Err(io.os_error("connect", a.ip, 0 - r)) }
  let defaults = set_default_timeouts(fd)?
  return Ok(move stream)
}

/// Bind and listen on an IPv4 or `::1` IPv6 literal.
pub fn listen(a: view SocketAddr) -> Result<TcpListener, io.IoError> {
  let sa = __alloc(32)
  defer __free(sa)
  let n = sockaddr(a, sa)
  if n < 0 { return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: invalid address literal")) }
  let fd = __syscall(41, __load8(sa), 1, 0, 0, 0, 0)
  if fd < 0 { return Err(io.os_error("socket", a.ip, 0 - fd)) }
  let listener = TcpListener { fd: fd }
  let timeout = set_timeout(fd, 20, DEFAULT_TIMEOUT_MS)?
  let yes = __alloc(8)
  __store64(yes, 1)
  let so = __syscall(54, fd, 1, 2, yes, 4, 0) // SO_REUSEADDR
  __free(yes)
  if so < 0 { return Err(io.os_error("setsockopt", a.ip, 0 - so)) }
  let b = __syscall(49, fd, sa, n, 0, 0, 0)
  if b < 0 { return Err(io.os_error("bind", a.ip, 0 - b)) }
  let r = __syscall(50, fd, 128, 0, 0, 0, 0)
  if r < 0 { return Err(io.os_error("listen", a.ip, 0 - r)) }
  return Ok(move listener)
}

/// Set how long `accept` waits for a connection, in milliseconds (default 5000); on expiry it fails with a timeout
/// error (code 110). Zero waits forever. A server uses a short timeout to notice a stop request.
pub fn set_accept_timeout(l: view TcpListener, timeout_ms: Int) -> Result<Int, io.IoError> {
  return set_timeout(l.fd, 20, timeout_ms)
}

/// Accept one incoming connection.
pub fn accept(l: view TcpListener) -> Result<TcpStream, io.IoError> {
  let fd = __syscall(43, l.fd, 0, 0, 0, 0, 0)
  if fd < 0 { return Err(io.os_error("accept", "", 0 - fd)) }
  let stream = TcpStream { fd: fd }
  let defaults = set_default_timeouts(fd)?
  return Ok(move stream)
}

fn endpoint(fd: Int, peer: Bool) -> Result<SocketAddr, io.IoError> {
  let buf = __alloc(40)
  defer __free(buf)
  let len = buf + 32
  __store64(len, 32)
  let r = if peer {
    __syscall(52, fd, buf, len, 0, 0, 0) // getpeername
  } else {
    __syscall(51, fd, buf, len, 0, 0, 0) // getsockname
  }
  if r < 0 {
    let op = if peer { "getpeername" } else { "getsockname" }
    return Err(io.os_error(op, "socket", 0 - r))
  }

  let size = __load64(len)
  if size < 4 || size > 32 { return Err(io.custom_error(io.IoErrorKind.InvalidData, "net: invalid socket address length")) }
  let port = __load8(buf + 2) * 256 + __load8(buf + 3)
  let family = __load8(buf) + __load8(buf + 1) * 256
  var ip = String.new()
  if family == 2 && size >= 16 {
    for i in 0..4 {
      if i > 0 { ip.push_str(".") }
      ip.push_int(__load8(buf + 4 + i))
    }
  } else if family == 10 && size >= 28 {
    let hex = "0123456789abcdef"
    for i in 0..8 {
      if i > 0 { ip.push_str(":") }
      for j in 0..2 {
        let b = __load8(buf + 8 + 2 * i + j)
        let hi = b / 16
        let lo = b % 16
        ip.push_slice(hex, hi, hi + 1)
        ip.push_slice(hex, lo, lo + 1)
      }
    }
  } else {
    return Err(io.custom_error(io.IoErrorKind.InvalidData, "net: unsupported socket address"))
  }
  return Ok(SocketAddr { ip: move ip, port: port })
}

/// Query the local address of a connected stream.
pub fn local_addr(s: view TcpStream) -> Result<SocketAddr, io.IoError> {
  return endpoint(s.fd, false)
}

/// Query the remote address of a connected stream.
pub fn peer_addr(s: view TcpStream) -> Result<SocketAddr, io.IoError> {
  return endpoint(s.fd, true)
}

/// Query the bound address of a listener, including the port assigned after a port-zero bind.
pub fn listener_local_addr(l: view TcpListener) -> Result<SocketAddr, io.IoError> {
  return endpoint(l.fd, false)
}

fn socket_io_error(op: Text, n: Int) -> io.IoError {
  if n == -11 { return io.os_error(op, "socket", 110) } // EAGAIN after a blocking socket timeout
  return io.os_error(op, "socket", 0 - n)
}

/// Read up to `limit` bytes; an empty String means orderly EOF.
pub fn read(s: view TcpStream, limit: Int) -> Result<String, io.IoError> {
  if limit < 0 || limit > 1048576 { return Err(io.custom_error(io.IoErrorKind.InvalidInput, "net: read limit must be 0..1048576")) }
  let p = __alloc(limit + 1)
  defer __free(p)
  let n = receive(s, p, limit)
  if n < 0 { return Err(socket_io_error("read", n)) }
  var out = String.new()
  out.push_raw(p, n)
  return Ok(move out)
}

fn receive(s: view TcpStream, p: Int, limit: Int) -> Int {
  while true {
    let n = __syscall(0, s.fd, p, limit, 0, 0, 0)
    if n != -4 { return n }
  }
}

/// Read bytes into a caller-owned slice. Returns the number of bytes read.
pub fn read_into(s: view TcpStream, data: mut [UInt8]) -> Result<Int, io.IoError> {
  let size = data.len().min(1048576)
  if size == 0 { return Ok(0) }
  let p = __alloc(size)
  defer __free(p)
  let n = receive(s, p, size)
  if n < 0 { return Err(socket_io_error("read", n)) }
  for i in 0..n { data[i] = __load8(p + i).to_uint8() }
  return Ok(n)
}

fn send_all(s: view TcpStream, p: Int, total: Int) -> Result<Int, io.IoError> {
  var off = 0
  while off < total {
    // sendto with MSG_NOSIGNAL on a connected socket.
    let n = __syscall(44, s.fd, p + off, total - off, 16384, 0, 0)
    if n == -4 { continue }
    if n < 0 { return Err(socket_io_error("write", n)) }
    if n == 0 { return Err(io.custom_error(io.IoErrorKind.Other, "socket write made no progress")) }
    off = off + n
  }
  return Ok(total)
}

/// Write all bytes from `data` and return the byte count.
pub fn write(s: view TcpStream, data: view String) -> Result<Int, io.IoError> {
  return send_all(s, data.raw_addr(), data.len())
}

/// Write all bytes in a List, array or slice without UTF-8 conversion.
pub fn write_bytes(s: view TcpStream, data: view [UInt8]) -> Result<Int, io.IoError> {
  let total = data.len()
  if total == 0 { return Ok(0) }
  let size = total.min(16384)
  let p = __alloc(size)
  defer __free(p)
  var offset = 0
  while offset < total {
    let n = (total - offset).min(size)
    for i in 0..n { __store8(p + i, data[offset + i].to_int()) }
    let written = send_all(s, p, n)?
    offset = offset + written
  }
  return Ok(total)
}

/// Close a stream, consuming it and reporting the result of close(2).
pub fn close_stream(s: TcpStream) -> Result<Int, io.IoError> {
  return close_result(s.fd)
}

/// Close a listener, consuming it and reporting the result of close(2).
pub fn close_listener(l: TcpListener) -> Result<Int, io.IoError> {
  return close_result(l.fd)
}
