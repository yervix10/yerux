// ───────── numeric types: built-in trait impls (generated) ─────────
impl Equal for Int8 { fn eq(view self, other: view Int8) -> Bool { return self == other } }
impl Ordered for Int8 {
    fn cmp(view self, other: view Int8) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
impl Show for Int8 {
    fn show(view self) -> String {
        var s = String.new()
        s.push_int(self.to_int())
        return s
    }
}
impl Equal for Int16 { fn eq(view self, other: view Int16) -> Bool { return self == other } }
impl Ordered for Int16 {
    fn cmp(view self, other: view Int16) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
impl Show for Int16 {
    fn show(view self) -> String {
        var s = String.new()
        s.push_int(self.to_int())
        return s
    }
}
impl Equal for Int32 { fn eq(view self, other: view Int32) -> Bool { return self == other } }
impl Ordered for Int32 {
    fn cmp(view self, other: view Int32) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
impl Show for Int32 {
    fn show(view self) -> String {
        var s = String.new()
        s.push_int(self.to_int())
        return s
    }
}
impl Equal for UInt8 { fn eq(view self, other: view UInt8) -> Bool { return self == other } }
impl Ordered for UInt8 {
    fn cmp(view self, other: view UInt8) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
impl Show for UInt8 {
    fn show(view self) -> String {
        var s = String.new()
        s.push_int(self.to_int())
        return s
    }
}
impl Equal for UInt16 { fn eq(view self, other: view UInt16) -> Bool { return self == other } }
impl Ordered for UInt16 {
    fn cmp(view self, other: view UInt16) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
impl Show for UInt16 {
    fn show(view self) -> String {
        var s = String.new()
        s.push_int(self.to_int())
        return s
    }
}
impl Equal for UInt32 { fn eq(view self, other: view UInt32) -> Bool { return self == other } }
impl Ordered for UInt32 {
    fn cmp(view self, other: view UInt32) -> Int {
        if self < other { return -1 }
        if self > other { return 1 }
        return 0
    }
}
