// Bad impls: missing method, wrong signature, method that is not in the trait, unknown trait.
trait Area {
    fn area(view self) -> Int
    fn scale(mut self, k: Int)
}
struct Sq { s: Int }
struct Rect { w: Int, h: Int }
struct Dot { }

impl Area for Sq {
    fn area(view self) -> Int { return self.s * self.s }
}
impl Area for Rect {
    fn area(self) -> Int { return self.w * self.h }
    fn scale(mut self, k: Int) { self.w = self.w * k }
}
impl Area for Dot {
    fn area(view self) -> Int { return 0 }
    fn scale(mut self, k: Int) { }
    fn extra(view self) -> Int { return 1 }
}
impl Missing for Dot {
    fn go(view self) { }
}
impl Ordered for Dot { fn cmp(view self, other: view Dot) -> Int { return 0 } }
impl Ordered for Dot { fn cmp(view self, other: view Dot) -> Int { return 1 } }

fn main() { }
