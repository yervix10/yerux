// tasks: a persistent task manager stored in a plain-text file.
//
//   tasks add "Buy milk"           append a new task
//   tasks done <id>                mark a task complete
//   tasks rm <id>                  remove a task
//   tasks list                     show all tasks (default)
//   tasks clear                    remove all completed tasks
//
// Storage: ~/.tasks (one task per line: "0|pending|Buy milk" or "1|done|Buy milk")
// Exit status: 0 ok, 1 error, 2 usage error.
import std.args
import std.env
import std.fs
import std.io
import std.path

struct Task {
  id: Int,
  done: Bool,
  text: String,
}

fn tasks_path() -> String {
  match env.home_dir() {
    Some(h) => { return "{h}/.tasks" }
    None => { return ".tasks" }
  }
}

fn parse_id(s: view String) -> (Bool, Int) {
  var n = 0
  let ok = s.parse_int(n)
  return (ok, n)
}

fn load(file: view String) -> Result<List<Task>, io.IoError> {
  var tasks = List<Task>.new()
  if !fs.exists(file) { return Ok(move tasks) }
  let lines = fs.read_lines(file)?
  for line in lines {
    if line.is_empty() { continue }
    let parts = line.split("|")
    if parts.len() < 3 { continue }
    var n = 0
    if !parts.at(0).parse_int(n) { continue }
    let id = n
    let done = parts.at(1).eq("done")
    var text = String.from(parts.at(2))
    // fields beyond index 2 are part of the text (pipe in task name)
    var fi = 3
    while fi < parts.len() {
      text.push_char('|')
      text.push_str(parts.at(fi))
      fi = fi + 1
    }
    tasks.push(Task { id: id, done: done, text: move text })
  }
  return Ok(move tasks)
}

fn save(file: view String, tasks: view List<Task>) -> Result<Int, io.IoError> {
  var out = String.new()
  for t in tasks {
    var status = "pending"
    if t.done { status = "done" }
    out.push_str("{t.id}|{status}|{t.text}\n")
  }
  return fs.write(file, out)
}

fn next_id(tasks: view List<Task>) -> Int {
  var max = -1
  for t in tasks {
    if t.id > max { max = t.id }
  }
  return max + 1
}

fn cmd_list(tasks: view List<Task>) {
  if tasks.is_empty() {
    print("no tasks")
    return
  }
  for t in tasks {
    var mark = "[ ]"
    if t.done { mark = "[x]" }
    print("{t.id}  {mark}  {t.text}")
  }
}

fn cmd_add(tasks: mut List<Task>, text: view String) {
  let id = next_id(tasks)
  tasks.push(Task { id: id, done: false, text: String.from(text) })
  print("added #{id}")
}

fn cmd_done(tasks: mut List<Task>, id: Int) -> Bool {
  for i in 0..tasks.len() {
    if tasks.at(i).id == id {
      tasks.at(i).done = true
      print("done #{id}")
      return true
    }
  }
  io.eprintln("tasks: no task with id {id}")
  return false
}

fn cmd_rm(tasks: mut List<Task>, id: Int) -> Bool {
  for i in 0..tasks.len() {
    if tasks.at(i).id == id {
      let _ = tasks.remove(i)
      print("removed #{id}")
      return true
    }
  }
  io.eprintln("tasks: no task with id {id}")
  return false
}

fn cmd_clear(tasks: mut List<Task>) {
  var removed = 0
  var i = 0
  while i < tasks.len() {
    if tasks.at(i).done {
      let _ = tasks.remove(i)
      removed = removed + 1
    } else {
      i = i + 1
    }
  }
  print("removed {removed} completed task(s)")
}

fn run() -> Int {
  let argv = io.args()
  let p = args.parse(argv)
  let file = tasks_path()

  var load_ok = true
  var tasks = List<Task>.new()
  match load(file) {
    Ok(t) => { tasks = move t }
    Err(e) => {
      io.eprintln("tasks: could not read task file: {e}")
      load_ok = false
    }
  }
  if !load_ok { return 1 }

  let sub = p.subcommand.clone()

  if sub.eq("add") || sub.eq("a") {
    if p.positionals.is_empty() {
      io.eprintln("tasks add: expected task text")
      return 2
    }
    var text = String.new()
    for i in 0..p.positionals.len() {
      if i > 0 { text.push_char(' ') }
      text.push_str(p.positionals.at(i))
    }
    cmd_add(tasks, text)
  } else if sub.eq("done") || sub.eq("d") {
    if p.positionals.is_empty() {
      io.eprintln("tasks done: expected task id")
      return 2
    }
    let (ok, id) = parse_id(p.positionals.at(0))
    if !ok {
      io.eprintln("tasks done: id must be a number")
      return 2
    }
    if !cmd_done(tasks, id) { return 1 }
  } else if sub.eq("rm") || sub.eq("remove") {
    if p.positionals.is_empty() {
      io.eprintln("tasks rm: expected task id")
      return 2
    }
    let (ok, id) = parse_id(p.positionals.at(0))
    if !ok {
      io.eprintln("tasks rm: id must be a number")
      return 2
    }
    if !cmd_rm(tasks, id) { return 1 }
  } else if sub.eq("clear") {
    cmd_clear(tasks)
  } else if sub.eq("list") || sub.eq("ls") || sub.is_empty() {
    cmd_list(tasks)
    return 0
  } else {
    io.eprintln("tasks: unknown command '{sub}'")
    io.eprintln("usage: tasks [add|done|rm|list|clear]")
    return 2
  }

  var save_ok = true
  match save(file, tasks) {
    Ok(_) => {}
    Err(e) => {
      io.eprintln("tasks: could not save task file: {e}")
      save_ok = false
    }
  }
  if !save_ok { return 1 }
  return 0
}

fn main() {
  let code = run()
  if code != 0 { io.exit(code) }
}
