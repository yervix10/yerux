// A JSON value, a recursive-descent parser written by hand, and a compact writer.
// Numbers are Floats; objects keep their members in order; depth is limited to 64.
import std.text

pub enum Json {
  Null,
  Bool(Bool),
  Number(Float),
  Str(String),
  Arr(List<Json>),
  Obj(List<Member>),
}

pub struct Member { key: String, value: Json }

pub struct ParseError { offset: Int, message: String }

struct Parser { text: String, pos: Int }

fn fail(p: view Parser, message: Text) -> ParseError {
  return ParseError { offset: p.pos, message: String.from(message) }
}

fn peek(p: view Parser) -> Int {
  if p.pos >= p.text.len() { return -1 }
  return p.text.byte(p.pos)
}

fn skip_ws(p: mut Parser) {
  while p.pos < p.text.len() {
    let b = p.text.byte(p.pos)
    if b != 32 && b != 9 && b != 10 && b != 13 { return }
    p.pos = p.pos + 1
  }
}

fn expect_word(p: mut Parser, word: view String) -> Bool {
  if p.text.slice(p.pos, p.text.len()).starts_with(word) {
    p.pos = p.pos + word.len()
    return true
  }
  return false
}

fn hex_value(b: Int) -> Int {
  if b >= 48 && b <= 57 { return b - 48 }
  if b >= 97 && b <= 102 { return b - 87 }
  if b >= 65 && b <= 70 { return b - 55 }
  return -1
}

// Four hex digits at the cursor, or -1 (the cursor then stays where it was).
fn read_hex4(p: mut Parser) -> Int {
  if p.pos + 4 > p.text.len() { return -1 }
  var v = 0
  for i in 0..4 {
    let d = hex_value(p.text.byte(p.pos + i))
    if d < 0 { return -1 }
    v = v * 16 + d
  }
  p.pos = p.pos + 4
  return v
}

// Appends the UTF-8 encoding of a code point (0..0x10FFFF, not a surrogate).
pub fn push_utf8(out: mut String, cp: Int) {
  if cp < 128 {
    out.push_byte(cp)
  } else if cp < 2048 {
    out.push_byte(192 + cp / 64)
    out.push_byte(128 + cp % 64)
  } else if cp < 65536 {
    out.push_byte(224 + cp / 4096)
    out.push_byte(128 + (cp / 64) % 64)
    out.push_byte(128 + cp % 64)
  } else {
    out.push_byte(240 + cp / 262144)
    out.push_byte(128 + (cp / 4096) % 64)
    out.push_byte(128 + (cp / 64) % 64)
    out.push_byte(128 + cp % 64)
  }
}

// The body of a string after the opening quote, through the closing quote.
fn parse_string(p: mut Parser) -> Result<String, ParseError> {
  var out = String.new()
  while true {
    let b = peek(p)
    if b < 0 { return Err(fail(p, "unterminated string")) }
    if b == 34 {
      p.pos = p.pos + 1
      return Ok(move out)
    }
    if b < 32 { return Err(fail(p, "control character in string")) }
    if b != 92 {
      out.push_byte(b)
      p.pos = p.pos + 1
      continue
    }
    p.pos = p.pos + 1
    let e = peek(p)
    p.pos = p.pos + 1
    if e == 34 || e == 92 || e == 47 {
      out.push_byte(e)
    } else if e == 98 {
      out.push_byte(8)
    } else if e == 102 {
      out.push_byte(12)
    } else if e == 110 {
      out.push_byte(10)
    } else if e == 114 {
      out.push_byte(13)
    } else if e == 116 {
      out.push_byte(9)
    } else if e == 117 {
      var cp = read_hex4(p)
      if cp < 0 { return Err(fail(p, "bad \\u escape")) }
      // a high surrogate must be followed by \uDC00..\uDFFF
      if cp >= 55296 && cp < 56320 {
        if !expect_word(p, "\\u") { return Err(fail(p, "unpaired surrogate")) }
        let low = read_hex4(p)
        if low < 56320 || low > 57343 { return Err(fail(p, "unpaired surrogate")) }
        cp = 65536 + (cp - 55296) * 1024 + (low - 56320)
      } else if cp >= 56320 && cp < 57344 {
        return Err(fail(p, "unpaired surrogate"))
      }
      push_utf8(out, cp)
    } else {
      p.pos = p.pos - 1
      return Err(fail(p, "invalid escape"))
    }
  }
  return Err(fail(p, "unterminated string"))
}

// -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
fn parse_number(p: mut Parser) -> Result<Json, ParseError> {
  let start = p.pos
  if peek(p) == 45 { p.pos = p.pos + 1 }
  if peek(p) == 48 {
    p.pos = p.pos + 1
  } else {
    if !is_digit(peek(p)) { return Err(fail(p, "invalid number")) }
    while is_digit(peek(p)) { p.pos = p.pos + 1 }
  }
  if peek(p) == 46 {
    p.pos = p.pos + 1
    if !is_digit(peek(p)) { return Err(fail(p, "digit expected after '.'")) }
    while is_digit(peek(p)) { p.pos = p.pos + 1 }
  }
  if peek(p) == 101 || peek(p) == 69 {
    p.pos = p.pos + 1
    if peek(p) == 43 || peek(p) == 45 { p.pos = p.pos + 1 }
    if !is_digit(peek(p)) { return Err(fail(p, "digit expected in exponent")) }
    while is_digit(peek(p)) { p.pos = p.pos + 1 }
  }
  match text.parse_float(p.text.slice(start, p.pos)) {
    Ok(f) => {
      // parse_float returns infinity for a literal beyond the Float range; JSON has no such number
      if f.is_inf() { return Err(fail(p, "number out of range")) }
      return Ok(Json.Number(f))
    }
    Err(_) => { return Err(fail(p, "number out of range")) }
  }
}

fn is_digit(b: Int) -> Bool {
  return b >= 48 && b <= 57
}

fn parse_value(p: mut Parser, depth: Int) -> Result<Json, ParseError> {
  if depth > 64 { return Err(fail(p, "nesting too deep")) }
  skip_ws(p)
  let b = peek(p)
  if b == 123 {
    p.pos = p.pos + 1
    var members = List<Member>.new()
    skip_ws(p)
    if peek(p) == 125 {
      p.pos = p.pos + 1
      return Ok(Json.Obj(move members))
    }
    while true {
      skip_ws(p)
      if peek(p) != 34 { return Err(fail(p, "object key expected")) }
      p.pos = p.pos + 1
      let key = parse_string(p)?
      skip_ws(p)
      if peek(p) != 58 { return Err(fail(p, "':' expected")) }
      p.pos = p.pos + 1
      let value = parse_value(p, depth + 1)?
      members.push(Member { key: move key, value: move value })
      skip_ws(p)
      if peek(p) == 44 {
        p.pos = p.pos + 1
        continue
      }
      if peek(p) == 125 {
        p.pos = p.pos + 1
        return Ok(Json.Obj(move members))
      }
      return Err(fail(p, "',' or '}}' expected"))
    }
  }
  if b == 91 {
    p.pos = p.pos + 1
    var items = List<Json>.new()
    skip_ws(p)
    if peek(p) == 93 {
      p.pos = p.pos + 1
      return Ok(Json.Arr(move items))
    }
    while true {
      items.push(parse_value(p, depth + 1)?)
      skip_ws(p)
      if peek(p) == 44 {
        p.pos = p.pos + 1
        continue
      }
      if peek(p) == 93 {
        p.pos = p.pos + 1
        return Ok(Json.Arr(move items))
      }
      return Err(fail(p, "',' or ']' expected"))
    }
  }
  if b == 34 {
    p.pos = p.pos + 1
    return Ok(Json.Str(parse_string(p)?))
  }
  if expect_word(p, "true") { return Ok(Json.Bool(true)) }
  if expect_word(p, "false") { return Ok(Json.Bool(false)) }
  if expect_word(p, "null") { return Ok(Json.Null) }
  if b == 45 || is_digit(b) { return parse_number(p) }
  return Err(fail(p, "value expected"))
}

// Parses one complete JSON document; trailing non-space bytes are an error.
pub fn parse(source: view String) -> Result<Json, ParseError> {
  var p = Parser { text: String.from(source), pos: 0 }
  let v = parse_value(p, 0)?
  skip_ws(p)
  if p.pos != p.text.len() { return Err(fail(p, "end of input expected")) }
  return Ok(move v)
}

fn clone_json(v: view Json) -> Json {
  match v {
    Null => { return Json.Null }
    Bool(b) => { return Json.Bool(b) }
    Number(f) => { return Json.Number(f) }
    Str(s) => { return Json.Str(String.from(s)) }
    Arr(items) => {
      var out = List<Json>.new()
      for i in 0..items.len() {
        out.push(clone_json(items.at(i)))
      }
      return Json.Arr(move out)
    }
    Obj(members) => {
      var out = List<Member>.new()
      for i in 0..members.len() {
        out.push(Member { key: String.from(members.at(i).key), value: clone_json(members.at(i).value) })
      }
      return Json.Obj(move out)
    }
  }
}

// The member named `key` of an object, or None.
pub fn field(v: view Json, key: view String) -> Option<Json> {
  match v {
    Obj(members) => {
      for m in members {
        if m.key.eq(key) { return Some(clone_json(m.value)) }
      }
      return None
    }
    _ => { return None }
  }
}

// Compact JSON text (no spaces), strings escaped for JSON.
pub fn write(v: view Json, out: mut String) {
  match v {
    Null => { out.push_str("null") }
    Bool(b) => {
      if b { out.push_str("true") } else { out.push_str("false") }
    }
    Number(f) => { out.push_str(f.show()) }
    Str(s) => {
      out.push_byte(34)
      for i in 0..s.len() {
        let b = s.byte(i)
        if b == 34 || b == 92 {
          out.push_byte(92)
          out.push_byte(b)
        } else if b < 32 {
          out.push_str("\\u00")
          out.push_byte(48 + b / 16)
          out.push_byte(if b % 16 < 10 { 48 + b % 16 } else { 87 + b % 16 })
        } else {
          out.push_byte(b)
        }
      }
      out.push_byte(34)
    }
    Arr(items) => {
      out.push_byte(91)
      for i in 0..items.len() {
        if i > 0 { out.push_byte(44) }
        write(items.at(i), out)
      }
      out.push_byte(93)
    }
    Obj(members) => {
      out.push_byte(123)
      for i in 0..members.len() {
        if i > 0 { out.push_byte(44) }
        write(Json.Str(String.from(members.at(i).key)), out)
        out.push_byte(58)
        write(members.at(i).value, out)
      }
      out.push_byte(125)
    }
  }
}

pub fn to_text(v: view Json) -> String {
  var out = String.new()
  write(v, out)
  return out
}
