let prefix = "¡Hola";
let count = 0;

fn greeting(who) {
  return prefix + ", " + who + "!";
}

fn next() {
  count = count + 1;
  return count;
}

fn pair(a, b) {
  return a * 10 + b;
}

print pair(next(), next());
