// sudoku: generate and solve 9x9 sudoku puzzles.
//
//   sudoku solve FILE       print the solved grid; "no solution" or "multiple solutions" (exit 1)
//   sudoku count FILE       number of solutions, capped: 0, 1 or "2+"
//   sudoku gen SEED HOLES   a puzzle with exactly HOLES empty cells and a unique solution, on standard output
//   sudoku check FILE       "ok" for a legal partial grid, or "conflict at R,C" (1-based) for the first repeated digit
// FILE holds nine lines of nine characters: '.' or '0' for an empty cell, '1'..'9' for a digit (grid.yx).
// SEED is a decimal integer from 0 to 2^63-1; HOLES is an integer from 0 to 64. The generator is in gen.yx.
// Exit status: 0 ok; 1 a result that is not a success (no or several solutions, a conflict, a generator that gave up,
// an I/O error); 2 a usage or input error (the message is on standard error as "sudoku: ...").
import gen
import grid
import solve
import std.env
import std.fs
import std.io

fn fail(msg: view String, code: Int) {
  io.eprintln("sudoku: {msg}")
  io.exit(code)
}

fn usage(msg: view String) {
  fail("usage: {msg}", 2)
}

// The cells of a grid file, or the message for the first failure (exit 2).
fn load(path: view String) -> Result<List<Int>, String> {
  let src = match fs.read_to_string(path) {
    Ok(s) => move s
    Err(e) => { return Err("cannot read {path}: {e}") }
  }
  match grid.parse(src) {
    Ok(cells) => { return Ok(move cells) }
    Err(e) => { return Err("{path}: {e}") }
  }
}

fn solve_cmd(args: view List<String>) {
  if args.len() != 3 {
    usage("sudoku solve FILE")
    return
  }
  let cells = match load(args.at(2)) {
    Ok(c) => move c
    Err(e) => {
      fail(e, 2)
      return
    }
  }
  var first = List<Int>.new()
  let n = solve.count(cells, 2, first)
  if n == 0 {
    print("no solution")
    io.exit(1)
  } else if n == 1 {
    print(grid.format(first))
  } else {
    print("multiple solutions")
    io.exit(1)
  }
}

fn count_cmd(args: view List<String>) {
  if args.len() != 3 {
    usage("sudoku count FILE")
    return
  }
  let cells = match load(args.at(2)) {
    Ok(c) => move c
    Err(e) => {
      fail(e, 2)
      return
    }
  }
  var first = List<Int>.new()
  let n = solve.count(cells, 2, first)
  if n == 2 {
    print("2+")
  } else {
    print("{n}")
  }
}

fn gen_cmd(args: view List<String>) {
  if args.len() != 4 {
    usage("sudoku gen SEED HOLES")
    return
  }
  var seed = 0
  if !args.at(2).parse_int(seed) || seed < 0 {
    fail("SEED must be a decimal integer from 0 to 2^63-1, got '{args.at(2)}'", 2)
    return
  }
  var holes = 0
  if !args.at(3).parse_int(holes) || holes < 0 || holes > 64 {
    fail("HOLES must be an integer from 0 to 64, got '{args.at(3)}'", 2)
    return
  }
  match gen.puzzle(seed.to_uint64(), holes) {
    Ok(cells) => { print(grid.format(cells)) }
    Err(e) => { fail("gen: {e}", 1) }
  }
}

fn check_cmd(args: view List<String>) {
  if args.len() != 3 {
    usage("sudoku check FILE")
    return
  }
  let cells = match load(args.at(2)) {
    Ok(c) => move c
    Err(e) => {
      fail(e, 2)
      return
    }
  }
  match grid.first_conflict(cells) {
    Some(i) => {
      print("conflict at {i / 9 + 1},{i % 9 + 1}")
      io.exit(1)
    }
    None => { print("ok") }
  }
}

fn main() {
  let args = env.args()
  if args.len() < 2 {
    usage("sudoku solve|count|gen|check ...")
    return
  }
  let cmd = String.from(args.at(1))
  if cmd.eq("solve") {
    solve_cmd(args)
  } else if cmd.eq("count") {
    count_cmd(args)
  } else if cmd.eq("gen") {
    gen_cmd(args)
  } else if cmd.eq("check") {
    check_cmd(args)
  } else {
    usage("sudoku solve|count|gen|check ...")
  }
}
