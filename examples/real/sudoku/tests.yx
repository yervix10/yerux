// Unit tests: `yerux test examples/real/sudoku/tests.yx` (and with --native). The grids are written out in the sources.
import gen
import grid
import solve
import std.text

// The classic puzzle and its solution.
fn puzzle_text() -> String {
  return "53..7....\n6..195...\n.98....6.\n8...6...3\n4..8.3..1\n7...2...6\n.6....28.\n...419..5\n....8..79"
}
fn solution_text() -> String {
  return "534678912\n672195348\n198342567\n859761423\n426853791\n713924856\n961537284\n287419635\n345286179"
}

// The cells of a grid text (which must parse).
fn cells_of(src: view String) -> List<Int> {
  match grid.parse(src) {
    Ok(c) => { return c }
    Err(e) => { panic("unexpected grid error: {e}") }
  }
}

// The parse error of a grid text, or "ok".
fn parse_msg(src: view String) -> String {
  match grid.parse(src) {
    Ok(_) => { return "ok" }
    Err(e) => { return e }
  }
}

// The text of first_conflict: "ok", or "row,col" (1-based) of the first conflicting cell.
fn conflict_at(src: view String) -> String {
  let cells = cells_of(src)
  match grid.first_conflict(cells) {
    Some(i) => { return "{i / 9 + 1},{i % 9 + 1}" }
    None => { return "ok" }
  }
}

// Solution count capped at 2, as the command prints it.
fn count_of(src: view String) -> String {
  var first = List<Int>.new()
  let n = solve.count(cells_of(src), 2, first)
  if n == 2 {
    return "2+"
  }
  return "{n}"
}

test "parse and format round trip" {
  let cells = cells_of(puzzle_text())
  assert(cells.len() == 81)
  assert(grid.format(cells).eq(puzzle_text()))
  assert(cells.at(0) == 5 && cells.at(2) == 0 && cells.at(80) == 9)
}

test "parse accepts '0' and '.' as empty and trims blank lines and spaces" {
  let cells = cells_of("\n  0.0000000 \r\n\n........1\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n")
  assert(cells.at(0) == 0 && cells.at(1) == 0 && cells.at(9) == 0 && cells.at(17) == 1)
  assert(cells.len() == 81)
}

test "parse errors name the row and column" {
  assert(parse_msg(".........").eq("expected 9 rows, found 1"))
  assert(parse_msg("{puzzle_text()}\n.........").eq("expected 9 rows, found more"))
  assert(parse_msg("........\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("row 1: expected 9 cells, found 8"))
  assert(parse_msg("x........\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("row 1, column 1: bad character 'x'"))
  assert(parse_msg("........1\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n........a").eq("row 9, column 9: bad character 'a'"))
}

test "conflicts: the first repeated digit in row order" {
  assert(conflict_at(puzzle_text()).eq("ok"))
  // two 5s in row 1
  assert(conflict_at("5.5......\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("1,3"))
  // two 7s in column 9 (rows 1 and 5)
  assert(conflict_at("........7\n.........\n.........\n.........\n.........\n........7\n.........\n.........\n.........").eq("6,9"))
  // two 4s in the top-left box (rows 1 and 3, columns 1 and 2)
  assert(conflict_at("4........\n.4.......\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("2,2"))
}

test "solve: the classic puzzle has its known solution" {
  var first = List<Int>.new()
  assert_eq(solve.count(cells_of(puzzle_text()), 2, first), 1)
  assert(grid.format(first).eq(solution_text()))
}

test "count: 0 for an unsolvable grid and for conflicting givens, 1 for a unique puzzle" {
  // row 1 has no room for its last cell: 1..8 are present and 9 is in the column of the blank
  assert(count_of("12345678.\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n........9").eq("0"))
  assert(count_of("55.......\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("0"))
  assert(count_of(puzzle_text()).eq("1"))
  assert(count_of(solution_text()).eq("1"))
}

test "count: a blank board has more than two solutions, and a pattern with two" {
  assert(count_of(".........\n.........\n.........\n.........\n.........\n.........\n.........\n.........\n.........").eq("2+"))
  // rows 0 and 3, columns 3 and 4 blank: the digits 3,4 (and 6,7 in row 3) can swap
  assert(count_of("534..8912\n672195348\n198342567\n859..1423\n426853791\n713924856\n961537284\n287419635\n345286179").eq("2+"))
}

test "the LCG: first draws from seed 1 (top 32 bits of each state)" {
  var r = gen.new_rng(1u64)
  assert_eq(gen.draw(r), 1817669548)
  assert_eq(gen.draw(r), 2187888307)
  assert_eq(gen.draw(r), 2784682393)
}

test "shuffle keeps the elements and a seed gives the same order" {
  var a = List<Int>.new()
  for i in 0..81 {
    a.push(i)
  }
  var r = gen.new_rng(99u64)
  gen.shuffle(r, a)
  var seen = List<Bool>.new()
  for _ in 0..81 {
    seen.push(false)
  }
  for i in 0..81 {
    seen.set(a.at(i), true)
  }
  for i in 0..81 {
    assert(seen.at(i))
  }
  var b = List<Int>.new()
  for i in 0..81 {
    b.push(i)
  }
  var r2 = gen.new_rng(99u64)
  gen.shuffle(r2, b)
  assert(a.at(0) == b.at(0) && a.at(40) == b.at(40) && a.at(80) == b.at(80))
}

test "gen: exact number of holes, a unique solution, and a repeatable result" {
  match gen.puzzle(7u64, 40) {
    Ok(cells) => {
      var holes = 0
      for i in 0..81 {
        if cells.at(i) == 0 {
          holes = holes + 1
        }
      }
      assert_eq(holes, 40)
      assert(count_of(grid.format(cells)).eq("1"))
      match gen.puzzle(7u64, 40) {
        Ok(again) => { assert(grid.format(again).eq(grid.format(cells))) }
        Err(e) => { panic("second run failed: {e}") }
      }
    }
    Err(e) => { panic("gen failed: {e}") }
  }
}

test "gen: zero holes is the full solved grid, and the puzzle keeps its givens" {
  match gen.puzzle(3u64, 0) {
    Ok(cells) => {
      assert(count_of(grid.format(cells)).eq("1"))
      assert(cells.at(0) != 0 && cells.at(80) != 0)
    }
    Err(e) => { panic("gen failed: {e}") }
  }
}
