// Sudoku grids: parsing, formatting, and the row, column and box digit sets.
//
// A grid is a List<Int> of 81 cells in row-major order: 0 is an empty cell, 1..9 a digit. Rows, columns and boxes are
// numbered 0..8 (boxes row-major, so box(r, c) = (r / 3) * 3 + c / 3). A digit set is a bitmask Int: bit d (1..9) is set
// when digit d is used in that row, column or box. The language has no bitwise operators, so bit d is read as
// (m / 2^d) % 2 and set by adding 2^d (a bit is only ever set once, so addition is exact).
import std.text

// 2^d for 0 <= d <= 62.
pub fn pow2(d: Int) -> Int {
  var p = 1
  for _ in 0..d {
    p = p * 2
  }
  return p
}

// True when digit d is in the set m.
pub fn has(m: Int, d: Int) -> Bool {
  return (m / pow2(d)) % 2 == 1
}

// The box number of cell (r, c), both 0-based.
pub fn box_of(r: Int, c: Int) -> Int {
  return (r / 3) * 3 + c / 3
}

// The grid text: nine lines of nine characters, '.' for an empty cell. No trailing newline.
pub fn format(cells: view List<Int>) -> String {
  var out = String.new()
  for r in 0..9 {
    if r > 0 {
      out.push_str("\n")
    }
    for c in 0..9 {
      let v = cells.at(r * 9 + c)
      if v == 0 {
        out.push_str(".")
      } else {
        out.push_byte(48 + v)
      }
    }
  }
  return out
}

// Parses nine rows of nine cells ('.' or '0' empty, '1'..'9' digits). Blank lines are ignored and surrounding white
// space is trimmed. The error names the row (1-based) and column of the first bad cell.
pub fn parse(src: view String) -> Result<List<Int>, String> {
  var cells = List<Int>.new()
  var rows = 0
  let lines = text.lines(src)
  for line in lines {
    let body = line.trim()
    if body.is_empty() {
      continue
    }
    rows = rows + 1
    if rows > 9 {
      return Err("expected 9 rows, found more")
    }
    if body.len() != 9 {
      return Err("row {rows}: expected 9 cells, found {body.len()}")
    }
    for c in 0..9 {
      let b = body.byte(c)
      if b == 46 || b == 48 {
        cells.push(0)
      } else if b >= 49 && b <= 57 {
        cells.push(b - 48)
      } else if b >= 128 {
        return Err("row {rows}, column {c + 1}: not an ASCII character")
      } else {
        return Err("row {rows}, column {c + 1}: bad character '{body.slice(c, c + 1)}'")
      }
    }
  }
  if rows != 9 {
    return Err("expected 9 rows, found {rows}")
  }
  return Ok(move cells)
}

// The 0-based index (row * 9 + column) of the first cell, in row order, whose digit repeats one already seen in its
// row, column or box; None when the givens are a legal partial grid.
pub fn first_conflict(cells: view List<Int>) -> Option<Int> {
  var rows = List<Int>.new()
  var cols = List<Int>.new()
  var boxes = List<Int>.new()
  for _ in 0..9 {
    rows.push(0)
    cols.push(0)
    boxes.push(0)
  }
  for i in 0..81 {
    let v = cells.at(i)
    if v == 0 {
      continue
    }
    let r = i / 9
    let c = i % 9
    let b = box_of(r, c)
    if has(rows.at(r), v) || has(cols.at(c), v) || has(boxes.at(b), v) {
      return Some(i)
    }
    rows.set(r, rows.at(r) + pow2(v))
    cols.set(c, cols.at(c) + pow2(v))
    boxes.set(b, boxes.at(b) + pow2(v))
  }
  return None
}
