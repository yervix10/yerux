// tmpl: renders a template with JSON data (the language is described in template.yx).
//
//   tmpl TEMPLATE [DATA]     DATA is a JSON file; "-" or no DATA reads standard input (TEMPLATE may then be "-" only
//                            when DATA is a file)
// The output is written only when the whole template renders. Exit status: 0 ok, 1 an unreadable input, a template
// or JSON error, an unknown name in a value tag, 2 a usage error.
import std.env
import std.fs
import std.io
import std.json
import std.text
import template

fn fail(msg: view String, code: Int) {
  io.eprintln("tmpl: {msg}")
  io.exit(code)
}

fn read_input(path: view String) -> Result<String, String> {
  if path.eq("-") {
    match io.read_all() {
      Ok(s) => { return Ok(move s) }
      Err(e) => { return Err("cannot read standard input: {e}") }
    }
  }
  match fs.read_to_string(path) {
    Ok(s) => { return Ok(move s) }
    Err(e) => { return Err("cannot read {path}: {e}") }
  }
}

fn main() {
  let args = env.args()
  if args.len() < 2 || args.len() > 3 {
    fail("usage: tmpl TEMPLATE [DATA]", 2)
    return
  }
  let tpath = String.from(args.at(1))
  var dpath = String.from("-")
  if args.len() == 3 {
    dpath = String.from(args.at(2))
  }
  if tpath.eq("-") && dpath.eq("-") {
    fail("usage: TEMPLATE and DATA cannot both be standard input", 2)
    return
  }
  let src = match read_input(tpath) {
    Ok(s) => move s
    Err(e) => {
      fail(e, 1)
      return
    }
  }
  let nodes = match template.parse(src) {
    Ok(n) => move n
    Err(e) => {
      fail("{tpath}: {e}", 1)
      return
    }
  }
  let text = match read_input(dpath) {
    Ok(s) => move s
    Err(e) => {
      fail(e, 1)
      return
    }
  }
  let data = match json.parse(text) {
    Ok(v) => move v
    Err(e) => {
      let at = json.line_col(text, e.offset)
      fail("{dpath}:{at.0}:{at.1}: {e.message}", 1)
      return
    }
  }
  var out = String.new()
  match template.render(nodes, data, data, out) {
    Ok(_) => {}
    Err(e) => {
      fail("{tpath}: {e}", 1)
      return
    }
  }
  let _ = io.write_stdout(out)
  io.exit(0)
}
