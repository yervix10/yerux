// forth: runs a Forth program from FILE, or from standard input when FILE is omitted or "-" (see compile.yx for the
// words supported).
//
//   forth [FILE]
// Output goes to standard output as the program writes it. Exit status: 0 ok, 1 a compile error (FILE:LINE: message),
// a runtime error (forth: message, after the output so far), or an unreadable input; 2 a usage error.
import compile
import run
import std.env
import std.fs
import std.io

fn fail(msg: view String, code: Int) {
  io.eprintln("forth: {msg}")
  io.exit(code)
}

fn main() {
  let args = env.args()
  if args.len() > 2 {
    fail("usage: forth [FILE]", 2)
    return
  }
  var path = String.from("-")
  if args.len() == 2 {
    path = String.from(args.at(1))
  }
  var src = String.new()
  if path.eq("-") {
    match io.read_all() {
      Ok(s) => { src = move s }
      Err(e) => {
        fail("cannot read standard input: {e}", 1)
        return
      }
    }
  } else {
    match fs.read_to_string(path) {
      Ok(s) => { src = move s }
      Err(e) => {
        fail("cannot read {path}: {e}", 1)
        return
      }
    }
  }
  let prog = match compile.compile(src) {
    Ok(p) => move p
    Err(e) => {
      fail("{path}:{e}", 1)
      return
    }
  }
  var out = String.new()
  let result = run.run(prog, out)
  let _ = io.write_stdout(out)
  match result {
    Ok(_) => { io.exit(0) }
    Err(e) => {
      fail("runtime error: {e}", 1)
      return
    }
  }
}
