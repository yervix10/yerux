// warehouse: 30 days of orders against lots of perishable (Fresh) and by-the-kilo (Bulk) stock.
// Reservations take the lot that expires first; unfilled orders wait in a bounded generic Backlog<T> for up to
// MAX_WAIT days. Each day: expired lots are discarded, restocks arrive weekly, then backlog and new orders run.
// Orders come from a fixed-seed linear congruential generator. Money is in cents, weights in grams.
import std.fmt
trait Priced { fn unit_cents(view self) -> Int }
trait Weighted { fn unit_grams(view self) -> Int }
struct Fresh { sku: String, cents: Int, shelf_days: Int, grams: Int }
struct Bulk { sku: String, cents_per_kg: Int }

impl Priced for Fresh { fn unit_cents(view self) -> Int { return self.cents } }
impl Weighted for Fresh { fn unit_grams(view self) -> Int { return self.grams } }
impl Priced for Bulk { fn unit_cents(view self) -> Int { return self.cents_per_kg } }
impl Weighted for Bulk { fn unit_grams(view self) -> Int { return 1000 } }
fn line_cents<T: Priced>(item: view T, qty: Int) -> Int { return item.unit_cents() * qty }
fn line_grams<T: Weighted>(item: view T, qty: Int) -> Int { return item.unit_grams() * qty }
const NEVER = 1000000
const RESTOCK_EVERY = 7
const FRESH_LOT = 20
const BULK_LOT = 15
const BACKLOG_CAP = 6
const MAX_WAIT = 3
struct Lot { sku: String, last_day: Int, qty: Int }
struct Order { id: Int, sku: String, qty: Int, day: Int }
impl Show for Order { fn show(view self) -> String { return "#{self.id} {self.sku} x{self.qty}" } }

struct Catalog { fresh: List<Fresh>, bulk: List<Bulk> }
struct Backlog<T> { items: List<T>, cap: Int }
impl<T> Backlog<T> {
  fn offer(mut self, x: T) -> Bool {
    if self.items.len() >= self.cap { return false }
    self.items.push(move x)
    return true
  }
  fn pop_front(mut self) -> T { return self.items.remove(0) }
  fn len(view self) -> Int { return self.items.len() }
}
impl<T: Show> Backlog<T> {
  fn render(view self) -> String {
    var s = String.new()
    for i in 0..self.items.len() {
      if i > 0 { s.push_str(", ") }
      s.push_str("{self.items.at(i)}")
    }
    return s
  }
}
struct Rng { state: Int }
impl Rng {
  fn next(mut self, n: Int) -> Int {
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    return self.state / 65536 % n
  }
}
struct Tally {
  orders: Int, filled: Int, waiting: Int, cancelled: Int, revenue: Int, grams: Int,
  wasted: Int, waste_cents: Int, received: Int,
}
impl Tally {
  fn add(mut self, d: view Tally) {
    self.orders = self.orders + d.orders
    self.filled = self.filled + d.filled
    self.waiting = self.waiting + d.waiting
    self.cancelled = self.cancelled + d.cancelled
    self.revenue = self.revenue + d.revenue
    self.grams = self.grams + d.grams
    self.wasted = self.wasted + d.wasted
    self.waste_cents = self.waste_cents + d.waste_cents
    self.received = self.received + d.received
  }
}
// 1234 -> "12.34"
fn money(c: Int) -> String { return "{c / 100}.{fmt.zero_pad(c % 100, 2)}" }
// Cents and grams for qty units of sku (0 for an unknown sku).

fn value_of(cat: view Catalog, sku: view String, qty: Int) -> Int {
  for i in 0..cat.fresh.len() {
    if cat.fresh.at(i).sku.eq(sku) { return line_cents(cat.fresh.at(i), qty) }
  }
  for i in 0..cat.bulk.len() {
    if cat.bulk.at(i).sku.eq(sku) { return line_cents(cat.bulk.at(i), qty) }
  }
  return 0
}
fn weight_of(cat: view Catalog, sku: view String, qty: Int) -> Int {
  for i in 0..cat.fresh.len() {
    if cat.fresh.at(i).sku.eq(sku) { return line_grams(cat.fresh.at(i), qty) }
  }
  for i in 0..cat.bulk.len() {
    if cat.bulk.at(i).sku.eq(sku) { return line_grams(cat.bulk.at(i), qty) }
  }
  return 0
}
// The k-th sku of the catalog: fresh items first, then bulk items.
fn sku_at(cat: view Catalog, k: Int) -> String {
  if k < cat.fresh.len() { return String.from(cat.fresh.at(k).sku) }
  return String.from(cat.bulk.at(k - cat.fresh.len()).sku)
}

fn units_available(lots: view List<Lot>, sku: view String, day: Int) -> Int {
  var n = 0
  for i in 0..lots.len() {
    if lots.at(i).sku.eq(sku) && lots.at(i).last_day >= day { n = n + lots.at(i).qty }
  }
  return n
}
fn units_on_hand(lots: view List<Lot>) -> Int {
  var n = 0
  for i in 0..lots.len() { n = n + lots.at(i).qty }
  return n
}
// Takes qty units from the lots that expire first. The caller has checked units_available.
fn reserve(lots: mut List<Lot>, sku: view String, qty: Int, day: Int) {
  var left = qty
  while left > 0 {
    var best = -1
    for i in 0..lots.len() {
      if lots.at(i).sku.eq(sku) && lots.at(i).qty > 0 && lots.at(i).last_day >= day {
        if best < 0 || lots.at(i).last_day < lots.at(best).last_day { best = i }
      }
    }
    let take = min(left, lots.at(best).qty)
    lots.at(best).qty = lots.at(best).qty - take
    left = left - take
  }
}
// Removes the lots whose last sellable day is before day.
fn discard_expired(cat: view Catalog, lots: mut List<Lot>, day: Int, t: mut Tally) {
  var i = 0
  while i < lots.len() {
    if lots.at(i).last_day < day {
      t.wasted = t.wasted + lots.at(i).qty
      t.waste_cents = t.waste_cents + value_of(cat, lots.at(i).sku, lots.at(i).qty)
      let _ = lots.remove(i)
    } else {
      i = i + 1
    }
  }
}
// Receives one delivery of every item; returns its cost in cents.
fn restock(cat: view Catalog, lots: mut List<Lot>, day: Int) -> Int {
  var cost = 0
  for i in 0..cat.fresh.len() {
    lots.push(Lot { sku: String.from(cat.fresh.at(i).sku), last_day: day + cat.fresh.at(i).shelf_days, qty: FRESH_LOT })
    cost = cost + line_cents(cat.fresh.at(i), FRESH_LOT)
  }
  for i in 0..cat.bulk.len() {
    lots.push(Lot { sku: String.from(cat.bulk.at(i).sku), last_day: NEVER, qty: BULK_LOT })
    cost = cost + line_cents(cat.bulk.at(i), BULK_LOT)
  }
  return cost
}
// Fills the order when the stock allows it; false means the order must wait.
fn try_fill(cat: view Catalog, lots: mut List<Lot>, o: view Order, day: Int, t: mut Tally) -> Bool {
  if units_available(lots, o.sku, day) < o.qty { return false }
  reserve(lots, o.sku, o.qty, day)
  t.filled = t.filled + 1
  t.revenue = t.revenue + value_of(cat, o.sku, o.qty)
  t.grams = t.grams + weight_of(cat, o.sku, o.qty)
  return true
}

fn catalog() -> Catalog {
  var fresh = List<Fresh>.new()
  fresh.push(Fresh { sku: "milk", cents: 129, shelf_days: 6, grams: 1000 })
  fresh.push(Fresh { sku: "bread", cents: 245, shelf_days: 3, grams: 500 })
  fresh.push(Fresh { sku: "salad", cents: 310, shelf_days: 4, grams: 250 })
  var bulk = List<Bulk>.new()
  bulk.push(Bulk { sku: "rice", cents_per_kg: 189 })
  bulk.push(Bulk { sku: "flour", cents_per_kg: 95 })
  return Catalog { fresh: move fresh, bulk: move bulk }
}

fn check(name: Text, ok: Bool) { if ok { print("PASS {name}") } else { print("FAIL {name}") } }
fn checks() {
  let cat = catalog()
  let milk = Fresh { sku: "milk", cents: 250, shelf_days: 1, grams: 300 }
  check("fresh line price", line_cents(milk, 4) == 1000)
  check("bulk line weight", line_grams(Bulk { sku: "rice", cents_per_kg: 189 }, 2) == 2000)
  let m = money(1205)
  check("money format", m.eq("12.05"))
  check("catalog lookup", value_of(cat, "salad", 3) == 930)
  var q = Backlog<Order> { items: List<Order>.new(), cap: 1 }
  let first = q.offer(Order { id: 1, sku: String.from("x"), qty: 1, day: 0 })
  let second = q.offer(Order { id: 2, sku: String.from("x"), qty: 1, day: 0 })
  check("backlog capacity", first && !second && q.len() == 1)
  var lots = List<Lot>.new()
  lots.push(Lot { sku: String.from("x"), last_day: 5, qty: 3 })
  lots.push(Lot { sku: String.from("x"), last_day: 9, qty: 4 })
  reserve(lots, "x", 4, 1)
  check("earliest expiry first", lots.at(0).qty == 0 && lots.at(1).qty == 3)
  var t = Tally { orders: 0, filled: 0, waiting: 0, cancelled: 0, revenue: 0, grams: 0, wasted: 0, waste_cents: 0, received: 0 }
  discard_expired(cat, lots, 6, t)
  check("empty expired lot dropped", t.wasted == 0 && lots.len() == 1)
  discard_expired(cat, lots, 9, t)
  check("lot still sellable on last day", t.wasted == 0 && lots.len() == 1)
  discard_expired(cat, lots, 10, t)
  check("expired lot discarded", t.wasted == 3 && lots.len() == 0)
  var r = Rng { state: 1 }
  let draw = r.next(1000)
  check("rng first draw", draw == 838)
}

fn main() {
  let cat = catalog()
  var lots = List<Lot>.new()
  var backlog = Backlog<Order> { items: List<Order>.new(), cap: BACKLOG_CAP }
  var rng = Rng { state: 2026 }
  var totals = Tally { orders: 0, filled: 0, waiting: 0, cancelled: 0, revenue: 0, grams: 0, wasted: 0, waste_cents: 0, received: 0 }
  var next_id = 1
  let skus = cat.fresh.len() + cat.bulk.len()
  print("warehouse: 30 days, {skus} skus, backlog cap {BACKLOG_CAP}")
  for day in 0..30 {
    var t = Tally { orders: 0, filled: 0, waiting: 0, cancelled: 0, revenue: 0, grams: 0, wasted: 0, waste_cents: 0, received: 0 }
    discard_expired(cat, lots, day, t)
    if day % RESTOCK_EVERY == 0 { t.received = restock(cat, lots, day) }
    for _ in 0..backlog.len() {
      let o = backlog.pop_front()
      if day - o.day > MAX_WAIT {
        t.cancelled = t.cancelled + 1
      } else if !try_fill(cat, lots, o, day, t) {
        let _ = backlog.offer(move o)
      }
    }
    let arrivals = 2 + rng.next(3)
    for _ in 0..arrivals {
      let k = rng.next(skus)
      let qty = 1 + rng.next(6)
      let o = Order { id: next_id, sku: sku_at(cat, k), qty: qty, day: day }
      next_id = next_id + 1
      t.orders = t.orders + 1
      if !try_fill(cat, lots, o, day, t) {
        if backlog.offer(move o) {
          t.waiting = t.waiting + 1
        } else {
          t.cancelled = t.cancelled + 1
        }
      }
    }
    totals.add(t)
    print("day {fmt.zero_pad(day, 2)}  orders {t.orders}  filled {t.filled}  revenue {money(t.revenue)}  grams {t.grams}  wasted {t.wasted}  stock {units_on_hand(lots)}  backlog {backlog.len()}")
    if backlog.len() > 0 { print("        waiting: {backlog.render()}") }
  }
  print("\ntotals")
  print("  orders {totals.orders}, filled {totals.filled}, backordered {totals.waiting}, cancelled {totals.cancelled}")
  print("  revenue {money(totals.revenue)}, restock cost {money(totals.received)}")
  print("  shipped {totals.grams} g, wasted {totals.wasted} units worth {money(totals.waste_cents)}")
  print("  on hand {units_on_hand(lots)} units, still waiting {backlog.len()}\n")
  checks()
}
