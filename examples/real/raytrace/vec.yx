// Three-component vectors of Float, used for points, directions and RGB colors.
import std.math

pub struct V3 { x: Float, y: Float, z: Float }

pub fn v3(x: Float, y: Float, z: Float) -> V3 {
  return V3 { x: x, y: y, z: z }
}

impl V3 {
  fn add(view self, o: view V3) -> V3 { return V3 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z } }
  fn sub(view self, o: view V3) -> V3 { return V3 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z } }
  fn scale(view self, k: Float) -> V3 { return V3 { x: self.x * k, y: self.y * k, z: self.z * k } }
  fn mul(view self, o: view V3) -> V3 { return V3 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z } }
  fn dot(view self, o: view V3) -> Float { return self.x * o.x + self.y * o.y + self.z * o.z }
  fn length(view self) -> Float { return self.dot(self).sqrt() }
  fn unit(view self) -> V3 {
    let n = self.length()
    return self.scale(1.0 / n)
  }
  // self - 2 (self . n) n, for a unit normal n
  fn reflect(view self, n: view V3) -> V3 {
    return self.sub(n.scale(2.0 * self.dot(n)))
  }
}
