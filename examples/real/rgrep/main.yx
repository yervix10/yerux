// rgrep: a grep-like line filter over a fixed embedded text, driven by a fixed session of command lines.
// Options: -i (fold ASCII case of the line and of the pattern), -n (line numbers), -c (count only), -v (invert),
// -o (print only matches; with several -e patterns, each pattern's matches in -e order), -m N (stop after N
// selected lines), -e PATTERN (repeatable; a line is selected when any pattern matches), `--` (end of options).
// Without -e the first operand is the pattern. Exit status: 0 a line was selected, 1 none, 2 usage error.
// Patterns are checked with std.regex.check before use; the check runs on the pattern as written, before -i folds it.
import std.args
import std.io
import std.regex
import std.text

// The text searched by every run.
fn input_lines() -> List<String> {
  let raw = String.from("alpha beta 42\nGamma delta\nthe quick brown fox\nERROR: disk full at 10:42\nerror: timeout after 30s\nwarning: low memory\nBeta release notes\nx = 7; y = 13\n-x-ray scan\nfox and hound\n(none) here")
  return raw.split("\n")
}

// The fixed session: each entry is one command line (the program name `rg` is added in front).
fn session() -> List<String> {
  var s = List<String>.new()
  s.push("error")
  s.push("-i error")
  s.push("-n -i ERROR")
  s.push("-c o")
  s.push("-v e")
  s.push("-on [0-9]+")
  s.push("-io err[a-z]*")
  s.push("-m 2 e")
  s.push("-m 1 -c e")
  s.push("-m 0 e")
  s.push("-e warn -e fox")
  s.push("-n -e \\(none\\)")
  s.push("-c -v -e [0-9]+")
  s.push("-o -e [A-Z][a-z]*")
  s.push("-- -x")
  s.push("-m abc e")
  s.push("-x e")
  s.push("-e")
  s.push("-e a(b")
  s.push("\\d+")
  s.push("error extra")
  return s
}

// argv words of one session line: the program name, then the whitespace-free words of the line.
fn words(line: view String) -> List<String> {
  var out = List<String>.new()
  out.push("rg")
  let parts = line.split(" ")
  var i = 0
  while i < parts.len() {
    out.push(String.from(parts.at(i)))
    i = i + 1
  }
  return out
}

fn valued_options() -> List<String> {
  var v = List<String>.new()
  v.push("e")
  v.push("m")
  return v
}

fn known_flag(name: view String) -> Bool {
  return name == "i" || name == "n" || name == "c" || name == "v" || name == "o"
}

fn emit(line: view String, subject: view String, idx: Int, search: view List<String>, numbered: Bool, only: Bool, invert: Bool) {
  let prefix = if numbered { "{idx + 1}:" } else { String.new() }
  if !only {
    print("{prefix}{line}")
    return
  }
  if invert { return }
  var k = 0
  while k < search.len() {
    let found = regex.find_all(search.at(k), subject)
    var m = 0
    while m < found.len() {
      if found.at(m).len() > 0 { print("{prefix}{found.at(m)}") }
      m = m + 1
    }
    k = k + 1
  }
}

fn run(argv: view List<String>, lines: view List<String>) -> Int {
  let p = args.parse_with(argv, valued_options(), false)
  if p.errors.len() > 0 {
    print("rg: {p.errors.at(0)}")
    return 2
  }
  var f = 0
  while f < p.flags.len() {
    if !known_flag(p.flags.at(f)) {
      print("rg: unknown option '{p.flags.at(f)}'")
      return 2
    }
    f = f + 1
  }
  var o = 0
  var pats = List<String>.new()
  while o < p.options.len() {
    let name = String.from(p.options.at(o).0)
    if name == "e" {
      pats.push(String.from(p.options.at(o).1))
    } else if name != "m" {
      print("rg: unknown option '{name}'")
      return 2
    }
    o = o + 1
  }
  let operands = args.positionals(p)
  var first = 0
  if pats.len() == 0 {
    if operands.len() == 0 {
      print("rg: missing pattern")
      return 2
    }
    pats.push(String.from(operands.at(0)))
    first = 1
  }
  if operands.len() > first {
    print("rg: unexpected operand '{operands.at(first)}'")
    return 2
  }
  var max = -1
  match args.option_int_checked(p, "m") {
    Err(msg) => {
      print("rg: {msg}")
      return 2
    }
    Ok(found) => {
      match found {
        Some(n) => {
          if n < 0 {
            print("rg: -m needs a count of 0 or more")
            return 2
          }
          max = n
        }
        None => {}
      }
    }
  }
  var k = 0
  while k < pats.len() {
    match regex.check(pats.at(k)) {
      Err(msg) => {
        print("rg: invalid pattern '{pats.at(k)}': {msg}")
        return 2
      }
      Ok(_) => {}
    }
    k = k + 1
  }
  let fold = args.flag(p, "i")
  let numbered = args.flag(p, "n")
  let count_only = args.flag(p, "c")
  let invert = args.flag(p, "v")
  let only = args.flag(p, "o")
  var search = List<String>.new()
  var q = 0
  while q < pats.len() {
    if fold { search.push(pats.at(q).to_lower()) } else { search.push(String.from(pats.at(q))) }
    q = q + 1
  }
  var selected = 0
  var idx = 0
  while idx < lines.len() {
    if max >= 0 && selected == max { break }
    let line = lines.at(idx)
    let subject = if fold { line.to_lower() } else { String.from(line) }
    var hit = false
    var s = 0
    while s < search.len() && !hit {
      if regex.is_match(search.at(s), subject) { hit = true }
      s = s + 1
    }
    if hit != invert {
      selected = selected + 1
      if !count_only { emit(line, subject, idx, search, numbered, only, invert) }
    }
    idx = idx + 1
  }
  if count_only { print("{selected}") }
  if selected == 0 { return 1 }
  return 0
}

fn main() {
  let lines = input_lines()
  let cmds = session()
  var c = 0
  while c < cmds.len() {
    print("$ rg {cmds.at(c)}")
    let code = run(words(cmds.at(c)), lines)
    print("exit {code}")
    c = c + 1
  }
}
