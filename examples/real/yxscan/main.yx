import std.env
import std.io
import options
import scanner
import sources

fn run() -> Int {
    let argv = env.args()
    if argv.len() == 2 && (argv.at(1) == "--help" || argv.at(1) == "-h") {
        print(options.usage())
        return 0
    }
    match options.parse(argv) {
        Err(message) => {
            io.eprintln("yxscan: {message}")
            io.eprintln(options.usage())
            return 2
        }
        Ok(opts) => {
            let needle = scanner.prepare(opts)
            let totals = sources.run(opts, needle)
            if totals.failed {
                return 2
            }
            if !opts.wc && totals.selected == 0 {
                return 1
            }
        }
    }
    return 0
}

fn main() {
    io.run_status(run)
}
