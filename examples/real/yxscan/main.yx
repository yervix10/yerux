import std.env
import std.io
import options
import scanner
import sources

fn run() -> Int {
    match env.args_utf8() {
        Ok(argv) => { return run_with_args(argv) }
        Err(error) => {
            io.eprintln("yxscan: {error}")
            return 2
        }
    }
}

fn run_with_args(argv: view List<String>) -> Int {
    if argv.len() == 2 && (argv.at(1) == "--help" || argv.at(1) == "-h") {
        print(options.usage())
        return 0
    }
    match options.parse(argv) {
        Err(message) => {
            io.eprintln("yxscan: {message}")
            io.eprintln(String.from(options.usage()))
            return 2
        }
        Ok(opts) => {
            let needle = scanner.prepare(opts)
            let totals = sources.run(opts, needle)
            if totals.failed {
                return 2
            }
            if !opts.wc && totals.selected == 0 {
                return 1
            }
        }
    }
    return 0
}

fn main() {
    io.run_status(run)
}
