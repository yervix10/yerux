// Addresses of edlite commands: `N`, `.`, `$`, `+N`, `-N`, `A,B`, `%` and the empty address (the current line).
import buffer

// The line range of a command. `count` is how many addresses were written (0, 1 or 2).
pub struct Range { start: Int, end: Int, count: Int }

fn is_digit(b: Int) -> Bool {
  return b >= 48 && b <= 57
}

// The decimal number at `pos`, or None when there is no digit there. Advances `pos` past the digits.
fn number(line: view String, pos: mut Int) -> Option<Int> {
  if pos >= line.len() || !is_digit(line.byte(pos)) {
    return None
  }
  var v = 0
  while pos < line.len() && is_digit(line.byte(pos)) {
    v = v * 10 + (line.byte(pos) - 48)
    pos = pos + 1
  }
  return Some(v)
}

// One address: a number, `.`, `$`, optionally followed by offsets; a bare offset counts from the current line.
// None when no address starts at `pos`.
fn one(line: view String, pos: mut Int, ed: view buffer.Editor) -> Option<Int> {
  var v = 0
  var have = false
  if pos < line.len() {
    let c = line.byte(pos)
    if c == 46 {
      v = ed.cur
      have = true
      pos = pos + 1
    } else if c == 36 {
      v = ed.count()
      have = true
      pos = pos + 1
    } else {
      match number(line, pos) {
        Some(n) => {
          v = n
          have = true
        }
        None => {}
      }
    }
  }
  while pos < line.len() && (line.byte(pos) == 43 || line.byte(pos) == 45) {
    if !have {
      v = ed.cur
      have = true
    }
    let minus = line.byte(pos) == 45
    pos = pos + 1
    var k = 1
    match number(line, pos) {
      Some(n) => { k = n }
      None => {}
    }
    v = if minus { v - k } else { v + k }
  }
  if !have {
    return None
  }
  return Some(v)
}

// The range written at the start of `line`, leaving `pos` at the command letter.
// Forms: `%` (all lines), `A`, `A,B`, `,B` (line 1 to B), `A,` (A to the current line), and nothing (the current line).
pub fn range(line: view String, pos: mut Int, ed: view buffer.Editor) -> Range {
  if pos < line.len() && line.byte(pos) == 37 {
    pos = pos + 1
    return Range { start: 1, end: ed.count(), count: 2 }
  }
  var start = ed.cur
  var end = ed.cur
  var count = 0
  match one(line, pos, ed) {
    Some(a) => {
      start = a
      end = a
      count = 1
    }
    None => {}
  }
  if pos < line.len() && line.byte(pos) == 44 {
    pos = pos + 1
    if count == 0 {
      start = 1
    }
    count = 2
    match one(line, pos, ed) {
      Some(b) => { end = b }
      None => { end = ed.cur }
    }
  } else if count == 1 {
    end = start
  }
  return Range { start: start, end: end, count: count }
}

// A single address that must be present (the destination of `m` and `t`).
pub fn address(line: view String, pos: mut Int, ed: view buffer.Editor) -> Result<Int, String> {
  match one(line, pos, ed) {
    Some(a) => { return Ok(a) }
    None => { return Err(String.from("destination address expected")) }
  }
}

// Index of the first byte at or after `from` that equals `delim`, or the length of `line`.
pub fn find_delim(line: view String, from: Int, delim: Int) -> Int {
  var i = from
  while i < line.len() {
    if line.byte(i) == delim {
      return i
    }
    i = i + 1
  }
  return line.len()
}
