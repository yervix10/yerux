// Turns a Json value back into text: compact (one line) or pretty (two-space indent). Strings are re-escaped.
import std.text
import value

pub fn compact(v: view value.Json) -> String {
  var out = String.new()
  emit(out, v, false, 0)
  return out
}

pub fn pretty(v: view value.Json) -> String {
  var out = String.new()
  emit(out, v, true, 0)
  return out
}

fn indent(out: mut String, level: Int) {
  for i in 0..level { out.push_str("  ") }
}

pub fn quote(s: view String) -> String {
  var out = String.new()
  out.push_byte(34)
  for c in s.chars() {
    let n = c.to_int()
    if n == 34 { out.push_str("\\\"") }
    else if n == 92 { out.push_str("\\\\") }
    else if n == 10 { out.push_str("\\n") }
    else if n == 9 { out.push_str("\\t") }
    else if n == 13 { out.push_str("\\r") }
    else if n < 32 {
      out.push_str("\\u00")
      out.push_byte(hex_digit(n / 16))
      out.push_byte(hex_digit(n % 16))
    } else { out.push_char(c) }
  }
  out.push_byte(34)
  return out
}

fn hex_digit(n: Int) -> Int {
  if n < 10 { return 48 + n }
  return 97 + n - 10
}

// A Float prints like an Int when it has no fraction (3.0 is `3.0`), so a round trip keeps its type.
pub fn number(f: Float) -> String {
  return "{f}"
}

fn emit(out: mut String, v: view value.Json, pretty: Bool, level: Int) {
  match v {
    Null => { out.push_str("null") }
    Bool(b) => {
      if b { out.push_str("true") } else { out.push_str("false") }
    }
    Int(n) => { out.push_int(n) }
    Float(f) => { out.push_str(number(f)) }
    Str(s) => { out.push_str(quote(s)) }
    Arr(items) => {
      if items.len() == 0 {
        out.push_str("[]")
        return
      }
      out.push_str("[")
      for i in 0..items.len() {
        if i > 0 { out.push_str(",") }
        if pretty {
          out.push_str("\n")
          indent(out, level + 1)
        }
        emit(out, items.at(i), pretty, level + 1)
      }
      if pretty {
        out.push_str("\n")
        indent(out, level)
      }
      out.push_str("]")
    }
    Obj(entries) => {
      if entries.len() == 0 {
        out.push_str("{{}}")
        return
      }
      out.push_str("{{")
      for i in 0..entries.len() {
        if i > 0 { out.push_str(",") }
        if pretty {
          out.push_str("\n")
          indent(out, level + 1)
        }
        out.push_str(quote(entries.at(i).key))
        if pretty { out.push_str(": ") } else { out.push_str(":") }
        emit(out, entries.at(i).value, pretty, level + 1)
      }
      if pretty {
        out.push_str("\n")
        indent(out, level)
      }
      out.push_str("}}")
    }
  }
}
