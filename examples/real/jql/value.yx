// What the query tool shares: the failure type and a few helpers over `std.json` values.
import std.json

// Every failure of the program: where it happened (a byte offset into the text that was being read, or -1) and why.
pub struct Fault { offset: Int, message: String }

pub fn fault(offset: Int, message: view String) -> Fault {
  return Fault { offset: offset, message: String.from(message) }
}

// Parses the input document, keeping the offset of a syntax error.
pub fn read(text: view String) -> Result<json.Value, Fault> {
  match json.parse(text) {
    Ok(v) => { return Ok(move v) }
    Err(e) => { return Err(fault(e.offset, e.message)) }
  }
}

pub fn truthy(v: view json.Value) -> Bool {
  match v {
    Null => { return false }
    Bool(b) => { return b }
    _ => { return true }
  }
}
