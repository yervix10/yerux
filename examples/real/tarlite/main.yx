// tarlite: a tar-like single-file archive with CRC-32 checks (the format and the name rules are in archive.yx).
//
//   tarlite create ARCHIVE FILE...   store the named regular files; each name is the path as given, normalized
//   tarlite list ARCHIVE             one line per entry: MODE SIZE CRC32-hex NAME (MODE: octal, four digits)
//   tarlite verify ARCHIVE           "ok N entries", or the first damaged entry as an error
//   tarlite extract ARCHIVE DIR      recreate the entries under DIR, creating directories as needed; an existing
//                                    path is never overwritten, and nothing is written when a name clashes
// Exit status: 0 ok; 1 a corrupt or truncated archive, a CRC mismatch, an unsafe name or an I/O error (the message
// is on standard error as "tarlite: ..."); 2 a usage error.
import archive
import std.env
import std.fmt
import std.fs
import std.io
import std.path

fn fail(msg: view String, code: Int) {
  io.eprintln("tarlite: {msg}")
  io.exit(code)
}

// The entries of an archive file; every failure is a message for standard error.
fn load(path: view String) -> Result<List<archive.Entry>, String> {
  let bytes = match fs.read_bytes(path) {
    Ok(b) => move b
    Err(e) => { return Err("cannot read {path}: {e}") }
  }
  match archive.decode(bytes) {
    Ok(entries) => { return Ok(move entries) }
    Err(e) => { return Err("{path}: {e}") }
  }
}

fn cmd_create(argv: view List<String>) -> Int {
  if argv.len() < 4 {
    fail("usage: tarlite create ARCHIVE FILE...", 2)
    return 2
  }
  var entries = List<archive.Entry>.new()
  for i in 3..argv.len() {
    let raw = String.from(argv.at(i))
    let name = match archive.canonical_name(raw) {
      Ok(n) => move n
      Err(e) => {
        fail("{raw}: {e}", 1)
        return 1
      }
    }
    for j in 0..entries.len() {
      if entries.at(j).name.eq(name) {
        fail("{name}: given more than once", 1)
        return 1
      }
    }
    let meta = match fs.metadata(raw) {
      Ok(m) => move m
      Err(e) => {
        fail("cannot stat {raw}: {e}", 1)
        return 1
      }
    }
    if !meta.kind.eq(fs.FileKind.File) {
      fail("{raw}: not a regular file", 1)
      return 1
    }
    let data = match fs.read_bytes(raw) {
      Ok(d) => move d
      Err(e) => {
        fail("cannot read {raw}: {e}", 1)
        return 1
      }
    }
    entries.push(archive.new_entry(name, meta.mode, move data))
  }
  match fs.write_bytes(argv.at(2), archive.encode(entries)) {
    Ok(_) => { return 0 }
    Err(e) => {
      fail("cannot write {argv.at(2)}: {e}", 1)
      return 1
    }
  }
}

fn entry_line(e: view archive.Entry) -> String {
  return "{fmt.pad_left(fmt.format_int(e.mode, 8), 4, '0')} {e.data.len()} {fmt.hex_padded(e.crc, 8)} {e.name}"
}

fn cmd_list(argv: view List<String>) -> Int {
  if argv.len() != 3 {
    fail("usage: tarlite list ARCHIVE", 2)
    return 2
  }
  let entries = match load(argv.at(2)) {
    Ok(e) => move e
    Err(e) => {
      fail(e, 1)
      return 1
    }
  }
  for i in 0..entries.len() {
    print(entry_line(entries.at(i)))
  }
  return 0
}

fn cmd_verify(argv: view List<String>) -> Int {
  if argv.len() != 3 {
    fail("usage: tarlite verify ARCHIVE", 2)
    return 2
  }
  let entries = match load(argv.at(2)) {
    Ok(e) => move e
    Err(e) => {
      fail(e, 1)
      return 1
    }
  }
  print("ok {entries.len()} entries")
  return 0
}

// True when one name is a directory prefix of the other ("a" and "a/b" cannot both be extracted).
fn clash(a: view String, b: view String) -> Bool {
  return a.starts_with("{b}/") || b.starts_with("{a}/")
}

fn cmd_extract(argv: view List<String>) -> Int {
  if argv.len() != 4 {
    fail("usage: tarlite extract ARCHIVE DIR", 2)
    return 2
  }
  let dir = String.from(argv.at(3))
  let entries = match load(argv.at(2)) {
    Ok(e) => move e
    Err(e) => {
      fail(e, 1)
      return 1
    }
  }
  // Every target is checked before the first write.
  for i in 0..entries.len() {
    let target = "{dir}/{entries.at(i).name}"
    for j in 0..i {
      if clash(entries.at(i).name, entries.at(j).name) {
        fail("{entries.at(i).name}: clashes with {entries.at(j).name}", 1)
        return 1
      }
    }
    match fs.symlink_metadata(target) {
      Ok(_) => {
        fail("{target}: already exists", 1)
        return 1
      }
      Err(e) => {
        if e.kind != io.IoErrorKind.NotFound {
          fail("cannot inspect {target}: {e}", 1)
          return 1
        }
      }
    }
  }
  for i in 0..entries.len() {
    let target = "{dir}/{entries.at(i).name}"
    match fs.create_dir_all(path.parent(target)) {
      Ok(_) => {}
      Err(e) => {
        fail("cannot create directory for {target}: {e}", 1)
        return 1
      }
    }
    match fs.write_bytes(target, entries.at(i).data) {
      Ok(_) => {}
      Err(e) => {
        fail("cannot write {target}: {e}", 1)
        return 1
      }
    }
    match fs.set_permissions(target, entries.at(i).mode) {
      Ok(_) => {}
      Err(e) => {
        fail("cannot set permissions of {target}: {e}", 1)
        return 1
      }
    }
  }
  return 0
}

fn main() {
  let argv = match env.args_utf8() {
    Ok(a) => move a
    Err(e) => {
      fail("arguments: {e}", 2)
      return
    }
  }
  if argv.len() < 2 {
    fail("usage: tarlite create|list|verify|extract ...", 2)
    return
  }
  let cmd = String.from(argv.at(1))
  if cmd.eq("create") {
    io.exit(cmd_create(argv))
  } else if cmd.eq("list") {
    io.exit(cmd_list(argv))
  } else if cmd.eq("verify") {
    io.exit(cmd_verify(argv))
  } else if cmd.eq("extract") {
    io.exit(cmd_extract(argv))
  }
  fail("usage: tarlite create|list|verify|extract ...", 2)
}
