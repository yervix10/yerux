// Unit tests: `yerux test examples/real/schedsim/tests.yx`
import sim
import work

fn list(vals: view List<Int>) -> List<Int> {
  var out = List<Int>.new()
  for v in vals {
    out.push(v)
  }
  return out
}

fn two(a: Int, b: Int) -> List<Int> {
  var out = List<Int>.new()
  out.push(a)
  out.push(b)
  return out
}

fn three(a: Int, b: Int, c: Int) -> List<Int> {
  var out = List<Int>.new()
  out.push(a)
  out.push(b)
  out.push(c)
  return out
}

test "one server runs the jobs one after another" {
  let out = sim.run(two(0, 0), two(5, 3), 1)
  assert(out.makespan == 8)
  assert(out.total_wait == 5)
  assert(out.max_wait == 5)
  assert(out.busy.at(0) == 8)
  assert(out.events == 4)
}

test "two servers start both jobs at once" {
  let out = sim.run(two(0, 0), two(5, 3), 2)
  assert(out.makespan == 5)
  assert(out.total_wait == 0)
  assert(out.busy.at(0) == 5 && out.busy.at(1) == 3)
}

test "a late third job waits for the first free server" {
  let out = sim.run(three(1, 1, 1), three(2, 2, 2), 2)
  assert(out.makespan == 5)
  assert(out.total_wait == 2)
  assert(out.max_wait == 2)
}

test "events at the same time keep their creation order" {
  let a = sim.run(two(0, 0), two(4, 4), 1)
  let b = sim.run(two(0, 0), two(4, 4), 1)
  assert(a.digest == b.digest)
  assert(a.trace.at(0).eq("t=0 arrive job=0"))
  assert(a.trace.at(1).eq("t=0 arrive job=1"))
}

test "arrivals are increasing and start after time zero" {
  let arr = sim.arrivals(200, 9)
  assert(arr.at(0) >= 1)
  for i in 1..arr.len() {
    assert(arr.at(i) > arr.at(i - 1))
  }
}

test "service times lie in 1..40" {
  for j in 0..300 {
    let s = work.cost(7, j)
    assert(s >= 1 && s <= 40)
  }
}

test "the pool gives the same service times for any number of workers" {
  let one = work.run(300, 1, 5)
  let four = work.run(300, 4, 5)
  assert(one.done == 300 && four.done == 300)
  assert(one.digest == four.digest)
  for j in 0..300 {
    assert(one.svc.at(j) == four.svc.at(j))
  }
}

test "a run with more workers than jobs still finishes every job" {
  let pool = work.run(3, 8, 2)
  assert(pool.done == 3)
  assert(pool.svc.at(2) == work.cost(2, 2))
}
