// yerux test examples/real/webkv/tests.yx
import std.http.server
import std.io
import std.net
import app
import store

// A request as the server would parse it from the wire.
fn req(method: Text, path: Text, body: Text) -> server.Request {
  let payload = String.from(body)
  let raw = String.from("{method} {path} HTTP/1.1\r\nHost: t\r\nContent-Length: {payload.len()}\r\n\r\n{payload}")
  let cfg = server.config()
  match server.parse(raw, 0, cfg) {
    Done(r, used) => { return move r }
    Need(x) => { panic("incomplete request") }
    Reject(c, m) => { panic("rejected {c}: {m}") }
  }
}

// (a field of a temporary that owns memory cannot be read: keep the reply in a variable first)
fn status_of(a: view app.KvApp, method: Text, path: Text, body: Text) -> Int {
  let r = a.handle(req(method, path, body))
  return r.status
}

fn body_of(a: view app.KvApp, method: Text, path: Text, body: Text) -> String {
  let r = a.handle(req(method, path, body))
  return r.body.clone()
}

test "store keeps values, counts and deletes" {
  let s = store.new_store()
  assert(store.get(s, "a").is_none())
  assert(store.put(s, "a", "1"))
  assert(!store.put(s, "a", "2"))
  assert(store.get(s, "a").unwrap().eq("2"))
  assert(store.incr(s, "a", 5).unwrap() == 7)
  assert(store.incr(s, "fresh", 3).unwrap() == 3)
  assert(store.put(s, "text", "hello"))
  assert(store.incr(s, "text", 1).is_none())
  assert(store.delete(s, "a"))
  assert(!store.delete(s, "a"))
  let st = store.stats(s)
  assert(st.keys == 2)
  assert(st.deletes == 1)
  assert(st.misses == 1)
}

test "router: methods, keys and statuses" {
  let s = app.new_app()
  assert(status_of(s, "PUT", "/kv/k", "v") == 201)
  assert(status_of(s, "PUT", "/kv/k", "w") == 200)
  assert(status_of(s, "GET", "/kv/k", "") == 200)
  assert(body_of(s, "GET", "/kv/k", "").eq("w"))
  assert(status_of(s, "GET", "/kv/missing", "") == 404)
  assert(status_of(s, "DELETE", "/kv/k", "") == 204)
  assert(status_of(s, "PATCH", "/kv/k", "") == 405)
  assert(status_of(s, "GET", "/kv/", "") == 404)
  assert(status_of(s, "GET", "/kv/a%20b", "") == 404)
  assert(status_of(s, "GET", "/kv/a/b", "") == 404)
  assert(body_of(s, "POST", "/incr/n", " 12 ").eq("12\n"))
  assert(body_of(s, "POST", "/incr/n", "").eq("13\n"))
  assert(status_of(s, "POST", "/incr/n", "x") == 400)
  assert(status_of(s, "GET", "/incr/n", "") == 405)
  assert(status_of(s, "GET", "/health", "") == 200)
  assert(body_of(s, "GET", "/stats", "").starts_with("{{\"keys\":1"))
}

test "an Allow header names the methods of a path" {
  let a = app.new_app()
  let r = a.handle(req("PATCH", "/kv/k", ""))
  assert(r.status == 405)
  assert(r.headers.len() == 2)
}

// Send raw bytes to a running server and return the status line of the answer.
fn raw_status(port: Int, bytes: view String) -> String {
  let a = net.address("127.0.0.1", port).unwrap()
  let c = net.connect(a).unwrap()
  net.write(c, bytes).unwrap()
  let text = net.read(c, 4096).unwrap()
  let eol = text.find("\r\n")
  if eol < 0 { return String.from("(none)") }
  return text.slice(0, eol)
}

test "server answers malformed and oversized requests with 4xx" {
  let a = net.address("127.0.0.1", 0).unwrap()
  let listener = net.listen(a).unwrap()
  let bound = net.listener_local_addr(listener).unwrap()
  let port = bound.port
  var oversized = String.from("GET /health HTTP/1.1\r\nHost: t\r\nX-Pad: ")
  for i in 0..9000 { oversized.push_byte(97) }
  oversized.push_str("\r\n\r\n")
  var seen = List<String>.new()
  var cfg = server.config()
  cfg.workers = 2
  cfg.max_body = 65536
  cfg.max_connections = 5
  scope {
    let client = spawn move || {
      var out = List<String>.new()
      out.push(raw_status(port, "BROKEN\r\n\r\n"))
      out.push(raw_status(port, "GET /health HTTP/1.1\r\nHost: t\r\nContent-Length: nope\r\n\r\n"))
      out.push(raw_status(port, oversized))
      out.push(raw_status(port, "PUT /kv/x HTTP/1.1\r\nHost: t\r\nContent-Length: 999999\r\n\r\n"))
      out.push(raw_status(port, "GET /health HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n"))
      return out
    }
    let summary = server.serve(listener, Shared.new(app.new_app()), cfg, server.stop_handle())
    assert(summary.per_worker.len() == 2)
    assert(summary.connections == 5)
    assert(summary.requests == 1)
    seen = client.join().unwrap()
  }
  assert(seen.at(0).eq("HTTP/1.1 400 Bad Request"))
  assert(seen.at(1).eq("HTTP/1.1 400 Bad Request"))
  assert(seen.at(2).eq("HTTP/1.1 431 Request Header Fields Too Large"))
  assert(seen.at(3).eq("HTTP/1.1 413 Content Too Large"))
  assert(seen.at(4).eq("HTTP/1.1 200 OK"))
}
