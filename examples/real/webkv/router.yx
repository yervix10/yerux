// Routes: GET/PUT/DELETE /kv/<key>, POST /incr/<key>?by=N is spelled POST /incr/<key> with the amount as the body,
// GET /stats, GET /health.
import proto
import store

fn key_of(path: view String, prefix: Text) -> Option<String> {
  let p = String.from(prefix)
  if !path.starts_with(p) { return None }
  let key = path.slice(p.len(), path.len())
  if key.is_empty() || key.contains("/") { return None }
  for i in 0..key.len() {
    let b = key.byte(i)
    let ok = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 46 || b == 95
    if !ok { return None }
  }
  return Some(move key)
}

fn text_reply(status: Int, body: Text) -> proto.Reply {
  var b = String.from(body)
  b.push_str("\n")
  return proto.reply(status, "text/plain", b)
}

fn stats_json(st: view store.Stats) -> String {
  var j = String.from("{{\"keys\":")
  j.push_int(st.keys)
  j.push_str(",\"reads\":")
  j.push_int(st.reads)
  j.push_str(",\"misses\":")
  j.push_int(st.misses)
  j.push_str(",\"writes\":")
  j.push_int(st.writes)
  j.push_str(",\"deletes\":")
  j.push_int(st.deletes)
  j.push_str("}}")
  return j
}

pub fn handle(s: view store.Store, req: view proto.Request) -> proto.Reply {
  if req.path.eq("/health") {
    if !req.method.eq("GET") { return text_reply(405, "method not allowed") }
    return text_reply(200, "ok")
  }
  if req.path.eq("/stats") {
    if !req.method.eq("GET") { return text_reply(405, "method not allowed") }
    return proto.reply(200, "application/json", stats_json(store.stats(s)))
  }
  match key_of(req.path, "/kv/") {
    Some(key) => {
      if req.method.eq("GET") {
        match store.get(s, key) {
          Some(v) => { return proto.reply(200, "text/plain", v) }
          None => { return text_reply(404, "no such key") }
        }
      }
      if req.method.eq("PUT") {
        if store.put(s, key, req.body) { return text_reply(201, "created") }
        return text_reply(200, "replaced")
      }
      if req.method.eq("DELETE") {
        if store.delete(s, key) { return proto.reply(204, "text/plain", "") }
        return text_reply(404, "no such key")
      }
      return text_reply(405, "method not allowed")
    }
    None => {}
  }
  match key_of(req.path, "/incr/") {
    Some(key) => {
      if !req.method.eq("POST") { return text_reply(405, "method not allowed") }
      var by = 1
      if !req.body.is_empty() && !req.body.trim().parse_int(by) { return text_reply(400, "amount is not an integer") }
      match store.incr(s, key, by) {
        Some(n) => {
          var b = String.new()
          b.push_int(n)
          b.push_str("\n")
          return proto.reply(200, "text/plain", b)
        }
        None => { return text_reply(400, "value is not an integer") }
      }
    }
    None => {}
  }
  return text_reply(404, "no such route")
}
