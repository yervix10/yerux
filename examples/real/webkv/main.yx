// webkv: a small key-value HTTP server (std.http.server) and its own test client (std.http).
//
//   webkv                      self test: server + client threads on a loopback port, prints a report
//   webkv serve PORT [WORKERS [MAX_CONNECTIONS]]
//
// Routes: GET/PUT/DELETE /kv/<key>   POST /incr/<key> (body = amount, default 1)   GET /stats   GET /health
import std.env
import std.http.server
import std.io
import std.net
import app
import client
import store

fn selftest() -> Int {
  let workers = 3
  let clients = 4
  let rounds = 25
  let a = net.address("127.0.0.1", 0).unwrap()
  let listener = net.listen(a).unwrap()
  let bound = net.listener_local_addr(listener).unwrap()
  let port = bound.port
  let kv = Shared.new(app.new_app())
  let probe = kv.clone()
  var summary = server.Summary { connections: 0, requests: 0, per_worker: List<Int>.new() }
  let stop = server.stop_handle()
  var failed = 0
  scope {
    // the clients run in their own thread: the sequential script, then `clients` threads hammering one counter
    let driver = spawn move || {
      let addr = net.address("127.0.0.1", port).unwrap()
      var n = 0
      var bad = client.script(addr, n)
      var hs = List<JoinHandle<Int>>.new()
      let p = port
      let r = rounds
      for c in 0..clients {
        hs.push(spawn move || client.hammer(p, "total", r))
      }
      while !hs.is_empty() {
        let h = hs.remove(0)
        match h.join() {
          Ok(b) => { bad = bad + b }
          Err(e) => { bad = bad + 1 }
        }
      }
      bad = bad + client.expect("counter after the race", client.get(addr, "/kv/total"), 200, "100")
      bad = bad + client.expect("stats", client.get(addr, "/stats"), 200, "{{\"keys\":3,\"reads\":4,\"misses\":1,\"writes\":106,\"deletes\":1}}")
      return bad
    }
    // 20 scripted requests + clients * rounds + 2 final checks, one connection each
    var cfg = server.config()
    cfg.workers = workers
    cfg.max_body = 65536
    cfg.max_connections = 20 + clients * rounds + 2
    summary = server.serve(listener, move kv, cfg, stop)
    match driver.join() {
      Ok(b) => { failed = b }
      Err(e) => { failed = 1000 }
    }
  }
  print("workers: {summary.per_worker.len()}  connections served: {summary.connections}")
  let s = store.stats(probe.get().st)
  print("store: keys={s.keys} writes={s.writes} deletes={s.deletes}")
  if failed == 0 { print("selftest passed") } else { print("selftest FAILED: {failed}") }
  return failed
}

pub fn pick_workers(n: Int) -> Int {
  if n < 1 { return 1 }
  if n > 16 { return 16 }
  return n
}

fn serve_cli(port: Int, workers: Int, max_conns: Int) -> Int {
  let a = net.address("127.0.0.1", port).unwrap()
  let listener = match net.listen(a) {
    Ok(l) => move l,
    Err(e) => {
      print("cannot listen")
      return 1
    }
  }
  print("listening on 127.0.0.1:{port} with {pick_workers(workers)} workers")
  var cfg = server.config()
  cfg.workers = pick_workers(workers)
  cfg.max_body = 65536
  cfg.max_connections = max_conns
  let summary = server.serve(listener, Shared.new(app.new_app()), cfg, server.stop_handle())
  print("served {summary.connections} connections")
  return 0
}

fn main() {
  let argv = env.args()
  if argv.len() >= 2 && argv.at(1).eq("serve") {
    var port = 8080
    var workers = 4
    var max_conns = 0
    if argv.len() >= 3 && !argv.at(2).parse_int(port) { print("bad port"); return }
    if argv.len() >= 4 && !argv.at(3).parse_int(workers) { print("bad workers"); return }
    if argv.len() >= 5 && !argv.at(4).parse_int(max_conns) { print("bad connection count"); return }
    let rc = serve_cli(port, workers, max_conns)
    if rc != 0 { env.exit(rc) }
    return
  }
  let failed = selftest()
  if failed != 0 { env.exit(1) }
}
