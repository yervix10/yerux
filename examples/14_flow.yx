// Control flow and small types: for / break / continue / labels, tuples, Char, richer match.
enum Token { Num(Int), Plus, Minus, Other }

fn classify(c: Char) -> Token {
  match c {
    '0'..='9' => { return Token.Num(c.to_int() - 48) }
    '+' => { return Token.Plus }
    '-' => { return Token.Minus }
    _ => { return Token.Other }
  }
}

// a tuple return value, taken apart with `let (a, b) = ...`
fn eval(src: view String) -> (Int, Int) {
  var total = 0
  var sign = 1
  var seen = 0
  for c in src.chars() {
    match classify(c) {
      Num(n) => {
        total = total + sign * n
        seen = seen + 1
      }
      Plus => { sign = 1 }
      Minus => { sign = -1 }
      Other => { continue }
    }
  }
  return (total, seen)
}

fn first_pair_with_sum(nums: view List<Int>, want: Int) -> (Int, Int) {
  var found = (-1, -1)
  outer: for i in 0..nums.len() {
    for j in i + 1..nums.len() {
      if nums.at(i) + nums.at(j) == want {
        found = (i, j)
        break outer
      }
    }
  }
  return found
}

fn main() {
  let src = String.from("12 + 7 - 3x")
  let (value, digits) = eval(src)
  print(value)
  print(digits)

  var nums = List<Int>.new()
  for i in 0..=5 step 1 { nums.push(i * i) }
  let (a, b) = first_pair_with_sum(nums, 25)
  print(a)
  print(b)

  // iterate in place, and by move (the loop owns each element)
  for mut n in nums { n = n + 1 }
  var words = List<String>.new()
  words.push(String.from("héllo"))
  words.push(String.from("wörld"))
  for w in move words {
    defer print("done with a word")
    if w.len() > 100 { break }
    print(w)
  }

  // guards, or-patterns, ranges and tuple patterns
  for k in 0..12 step 5 {
    match (k % 2 == 0, k) {
      (true, 0) => { print("zero") }
      (true, n) if n > 5 => { print("big even") }
      (true, _) | (false, 1..=3) => { print("even or small odd") }
      (false, _) => { print("odd") }
    }
  }
}
