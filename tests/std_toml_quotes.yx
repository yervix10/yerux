// std.toml quote edges: basic strings with escapes, literal strings, unterminated
// strings (not values), quoted keys and quoted table headers (both unquoted),
// '#' inside strings is data, and arrays whose elements carry quotes.
import std.toml

fn main() {
  // basic string escapes
  print(toml.get_string("a = \"x\\ty\"", "a"))
  print(toml.get_string("a = \"x\\ny\"", "a"))
  print(toml.get_string("a = \"x\\\"y\"", "a"))
  print(toml.get_string("a = \"x\\\\y\"", "a"))
  print(toml.get_string("a = \"\"", "a"))
  print(toml.get_string("a = \"with # hash\"", "a"))
  print(toml.get_string("a = \"with = eq\"", "a"))
  // literal string keeps backslashes
  print(toml.get_string("a = 'x\\ty'", "a"))
  print(toml.get_string("a = 'no \"escapes\"'", "a"))
  // unterminated strings
  print(toml.get_string("a = \"open", "a"))
  print(toml.get_string("a = 'open", "a"))
  print(toml.get_string("a = \"x\\", "a"))
  // quoted key is unquoted on lookup
  print(toml.has("\"key\" = 1", "key"))
  print(toml.get_int("\"key\" = 1", "key"))
  print(toml.has("key = 1", "\"key\""))
  // a quoted table header names the same table as a bare one
  print(toml.has("[\"srv\"]\nport = 8080", "srv.port"))
  print(toml.has("[srv]\nport = 8080", "srv.port"))
  // comment vs string: '#' inside a quoted value is data
  print(toml.get_string("a = \"# not comment\" # comment", "a"))
  print(toml.has("a = \"# not comment\" # comment", "a"))
  // arrays: quotes protect ',', ']' and '#'
  let arr = toml.get_array("a = [\"x,y\", \"z]w\", \"v#w\"]", "a")
  print(arr.len())
  print(arr.at(0))
  print(arr.at(1))
  print(arr.at(2))
  let lit = toml.get_array("a = ['x,y', 'z]w']", "a")
  print(lit.len())
  print(lit.at(0))
  print(lit.at(1))
  // comment stripped outside quotes, kept inside
  let mixed = toml.get_array("a = [1, 2 # two\n]", "a")
  print(mixed.len())
  print(mixed.at(0))
  print(mixed.at(1))
  // ']' inside a single-quoted literal does not close a multi-line array
  let litml = toml.get_array("a = [']',\n 2]", "a")
  print(litml.len())
  print(litml.at(0))
  print(litml.at(1))
  // the same shape with double quotes survives
  let dqml = toml.get_array("a = [\"]x\",\n 2]", "a")
  print(dqml.len())
  print(dqml.at(0))
  print(dqml.at(1))
  // text after the matching ']' makes the value invalid
  let trail = toml.get_array("a = [1] trailing", "a")
  print(trail.len())
}
