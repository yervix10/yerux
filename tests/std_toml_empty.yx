// std.toml empties and silent failures: empty document, whitespace-only and
// comment-only input, bare values reading as "", empty arrays, absent keys,
// empty vs malformed table headers. The getters report no error position
// (toml.check does: tests/std_toml_check.yx).
import std.toml

fn main() {
  // empty / blank / comment-only documents
  print(toml.has("", "a"))
  print(toml.has("   ", "a"))
  print(toml.has("# only a comment", "a"))
  print(toml.get_string("", "a").len())
  print(toml.get_int("", "a"))
  print(toml.get_bool("", "a"))
  print(toml.get_array("", "a").len())
  print(toml.get_string_opt("", "a").is_some())
  print(toml.get_int_opt("", "a").is_some())
  print(toml.get_bool_opt("", "a").is_some())
  // present key, empty value
  print(toml.has("a = \"\"", "a"))
  print(toml.get_string("a = \"\"", "a").len())
  print(toml.get_string_opt("a = \"\"", "a").is_some())
  // empty array
  let empty_arr = toml.get_array("a = []", "a")
  print(empty_arr.len())
  print(toml.has("a = []", "a"))
  // bare value: has is true, get_string reads ""
  print(toml.has("a = xyz", "a"))
  print(toml.get_string("a = xyz", "a").len())
  print(toml.get_string_opt("a = xyz", "a").is_some())
  // absent keys
  print(toml.has("b = 1", "a"))
  print(toml.get_int("b = 1", "a"))
  print(toml.get_string_opt("b = 1", "a").is_some())
  // `[ ]` and `[]` are both malformed headers
  print(toml.has("[ ]\nk = 3", "k"))
  print(toml.get_int("[ ]\nk = 3", "k"))
  // a malformed header ends the lookup: only keys before it are reachable
  print(toml.has("[]\nk = 3", "k"))
  print(toml.get_int("x = 9\n[]\nk = 3", "x"))
  print(toml.get_int("[]\nx = 9", "x"))
  // malformed table header aborts: no line, no offset, just "not found"
  print(toml.has("[bad\ny = 1", "y"))
  print(toml.get_int("[bad\ny = 1", "y"))
  print(toml.get_int("x = 9\n[bad\ny = 1", "x"))
  print(toml.get_int("[bad\ny = 1", "x"))
  // keys before the bad header are still reachable
  print(toml.get_int("x = 9\n[bad\ny = 1", "x"))
  // an unterminated multi-line array is not a value; later keys are still found
  let unter = toml.get_array("a = [1,\n 2\nb = 3", "a")
  print(unter.len())
  print(toml.get_int("a = [1,\n 2\nb = 3", "b"))
}
