// A local variable, parameter or loop variable may have the name of an imported module: inside its scope the
// name is the variable; outside (and in the initializer of its own `let`) it is the module again.
import lib
import std.path

fn describe(path: view String) -> Int {
  return path.len()
}

fn first_component(path: view String, lib: Int) -> Int {
  return lib + path.len()
}

fn main() {
  print(lib.twice(4))
  let joined = path.join("a", "b")
  print(joined)
  if true {
    let path = String.from("shadowed")
    print(path.len())
  }
  print(path.file_name("x/y.txt"))
  let lib = lib.twice(5)
  print(lib + 1)
  var total = 0
  for path in 0..3 {
    total = total + path
  }
  print(total)
  print(describe("four"))
  print(first_component("ab", 10))
  if true {
    let path = path.join("p", "q")
    print(path)
  }
  print(path.extension("a.b"))
}
