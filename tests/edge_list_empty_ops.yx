// Empty-list edges: every operation on zero elements, then the same after one push/pop.
fn main() {
  var l = List<Int>.new()
  print("{l.len()} {l.is_empty()} {l.is_sorted()}")
  l.clear()
  l.sort()
  l.reverse()
  l.truncate(0)
  l.truncate(5)
  print("{l.len()} {l.is_empty()} {l.is_sorted()}")
  let cp = l.copy()
  let sl = l.slice(0, 0)
  print("{cp.len()} {sl.len()} {cp.is_empty()}")
  print("{l.contains(0)} {l.index_of(0)}")
  var empty_other = List<Int>.new()
  l.extend(move empty_other)
  print(l.len())
  l.push(7)
  print("{l.len()} {l.get(0)}")
  var empty_other2 = List<Int>.new()
  l.extend(move empty_other2)
  print("{l.len()} {l.get(0)}")
  let only = l.remove(0)
  print("{only} {l.len()} {l.is_empty()}")
  l.insert(0, 42)
  print("{l.len()} {l.get(0)}")
  let popped = l.pop()
  print("{popped} {l.len()}")
  l.push(1)
  let sw = l.swap_remove(0)
  print("{sw} {l.len()}")

  // Extend: non-empty into empty, empty into non-empty.
  var a = List<Int>.new()
  var b = List<Int>.new()
  b.push(1)
  b.push(2)
  a.extend(move b)
  print("{a.len()} {a.at(0)} {a.at(1)}")
  var e = List<Int>.new()
  a.extend(move e)
  print("{a.len()} {a.at(0)} {a.at(1)}")

  // Strings: empty list, empty elements and join.
  var es = List<String>.new()
  let j0 = es.join(",")
  print("[{j0}] {es.len()}")
  es.push(String.from(""))
  let j1 = es.join(",")
  print("[{j1}] {es.len()} {es.at(0).len()}")
  es.push(String.from(""))
  let j2 = es.join("-")
  print("[{j2}] {es.len()}")
  let first = es.remove(0)
  print("{first.len()} {es.len()}")
  let last = es.pop()
  print("{last.len()} {es.len()}")
  es.push(String.from("x"))
  es.at(0).push_str("")
  print("[{es.at(0)}] {es.at(0).len()}")

  // Nested empty lists.
  var nested = List<List<Int>>.new()
  nested.push(List<Int>.new())
  print("{nested.len()} {nested.at(0).len()} {nested.at(0).is_empty()}")
  nested.at(0).push(9)
  print(nested.at(0).len())
  nested.at(0).clear()
  print("{nested.len()} {nested.at(0).len()}")
  nested.clear()
  print(nested.len())

  // Empty list of owned strings cleared twice.
  var owned = List<String>.new()
  owned.push(String.from("a"))
  owned.push(String.from("b"))
  owned.clear()
  owned.clear()
  print("{owned.len()} {owned.is_empty()}")
  owned.push(String.from("c"))
  print(owned.at(0))
}
