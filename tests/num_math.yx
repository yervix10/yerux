// Math builtins (implemented in Yerux, no libm).
fn main() {
    print(sqrt(2.0))
    print(sqrt(0.0))
    print(sqrt(-1.0))
    print(sin(0.0))
    print(sin(1.0))
    print(sin(-1.0))
    print(sin(100.0))
    print(cos(0.0))
    print(cos(1.0))
    print(cos(3.141592653589793))
    print(tan(0.5))
    print(atan2(1.0, 1.0))
    print(atan2(1.0, -1.0))
    print(atan2(-1.0, -1.0))
    print(atan2(0.0, -1.0))
    print(atan2(0.0, 0.0))
    print(pow(2.0, 10.0))
    print(pow(2.0, 0.5))
    print(pow(2.0, -2.0))
    print(pow(10.0, 15.0))
    print(pow(-2.0, 3.0))
    print(pow(5.0, 0.0))
    print(exp(0.0))
    print(exp(1.0))
    print(exp(-1.0))
    print(exp(710.0))
    print(exp(-800.0))
    print(ln(1.0))
    print(ln(10.0))
    print(ln(0.0))
    print(ln(-1.0))
    print(ln(2.718281828459045))
    print(abs(-3.25))
    print(abs(3.25))
    print(floor(-2.5))
    print(floor(2.5))
    print(ceil(-2.5))
    print(ceil(2.1))
    print(min(1.5, 2.5))
    print(max(1.5, 2.5))
    print(min(2.0, 0.0 / 0.0))
    let x = 2.0
    print(x.sqrt())
    print(x.pow(3.0))
    print(x.ln())
    print(sqrt(2.0f32))
    print(sin(1.0f32))
    print(exp(1.0f32))
    var acc = 0.0
    var i = 1
    while i <= 10 {
        acc = acc + sin(i.to_float()) * cos(i.to_float() / 3.0)
        i = i + 1
    }
    print(acc)
}
