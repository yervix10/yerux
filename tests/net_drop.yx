import std.fs
import std.io
import std.net

struct Connection { stream: net.TcpStream, listener: net.TcpListener }

fn open_fds() -> Int {
  let entries = fs.read_dir("/proc/self/fd").unwrap()
  return entries.len()
}

fn bound_port(listener: view net.TcpListener) -> Int { unsafe {
  // Read the port assigned by the kernel after binding to port 0.
  let address = __alloc(16)
  let length = __alloc(4)
  __store8(length, 16)
  __store8(length + 1, 0)
  __store8(length + 2, 0)
  __store8(length + 3, 0)
  let result = __syscall(51, listener.fd, address, length, 0, 0, 0)
  assert_eq(result, 0)
  let port = __load8(address + 2) * 256 + __load8(address + 3)
  __free(length)
  __free(address)
  return port
} }

fn early_return(local: view net.SocketAddr, remote: view net.SocketAddr, before: Int) -> Result<Int, io.IoError> {
  let listener = net.listen(local)?
  if listener.fd >= 0 {
    let stream = net.connect(remote)?
    assert_eq(open_fds(), before + 2)
    return Ok(1)
  }
  return Ok(0)
}

fn propagate_bind_failure(local: view net.SocketAddr, occupied: view net.SocketAddr, before: Int) -> Result<Int, io.IoError> {
  let listener = net.listen(local)?
  assert_eq(open_fds(), before + 1)
  let conflict = net.listen(occupied)?
  return Ok(0)
}

fn conditional_move(addr: view net.SocketAddr, take: Bool, before: Int) {
  var survivors = List<net.TcpListener>.new()
  scope {
    let listener = net.listen(addr).unwrap()
    let fd = listener.fd
    assert_eq(open_fds(), before + 1)
    if take {
      scope { let moved = move listener }
      assert_eq(open_fds(), before)
      let reused = net.listen(addr).unwrap()
      assert_eq(reused.fd, fd)
      survivors.push(move reused)
    }
    assert_eq(open_fds(), before + 1)
  }
  // A stale destructor on the moved-from listener would close the reused fd.
  assert_eq(open_fds(), before + survivors.len())
  survivors.clear()
  assert_eq(open_fds(), before)
}

fn explicit_close(local: view net.SocketAddr, remote: view net.SocketAddr, before: Int) { unsafe {
  let listener = net.listen(local).unwrap()
  let stream = net.connect(remote).unwrap()
  assert_eq(open_fds(), before + 2)
  assert_eq(net.close_stream(move stream).unwrap(), 0)
  assert_eq(net.close_listener(move listener).unwrap(), 0)
  assert_eq(open_fds(), before)

  let broken = net.connect(remote).unwrap()
  // Fault injection. Close the raw descriptor so close_stream sees EBADF.
  assert_eq(__syscall(3, broken.fd, 0, 0, 0, 0, 0), 0)
  match net.close_stream(move broken) {
    Ok(code) => { panic("close should report EBADF") }
    Err(error) => { assert_eq(error.code, 9) }
  }
  assert_eq(open_fds(), before)
} }

fn worker_panic(local: view net.SocketAddr, remote: view net.SocketAddr, before: Int) {
  let addr = net.address("127.0.0.1", remote.port).unwrap()
  let captured = net.listen(local).unwrap()
  let reached_panic = Shared.new(Atomic.new(false))
  scope {
    let witness = reached_panic.clone()
    let worker = spawn move {
      let stream = net.connect(addr).unwrap()
      assert(captured.fd >= 0)
      assert_eq(open_fds(), before + 2)
      witness.store(true)
      panic("recoverable socket test")
    }
    assert(worker.join().is_err())
  }
  assert(reached_panic.load())
  assert_eq(open_fds(), before)
}

fn main() {
  let baseline = open_fds()
  let local = net.address("127.0.0.1", 0).unwrap()
  scope {
    let server = net.listen(local).unwrap()
    let remote = net.address("127.0.0.1", bound_port(server)).unwrap()
    let before = baseline + 1
    assert_eq(open_fds(), before)

    scope {
      let client = net.connect(remote).unwrap()
      let accepted = net.accept(server).unwrap()
      assert_eq(open_fds(), before + 2)
    }
    assert_eq(open_fds(), before)

    assert_eq(early_return(local, remote, before).unwrap(), 1)
    assert_eq(open_fds(), before)
    assert(propagate_bind_failure(local, remote, before).is_err())
    assert_eq(open_fds(), before)
    let invalid = net.address("256.0.0.1", 0).unwrap()
    assert(net.connect(invalid).is_err())
    assert(net.listen(invalid).is_err())
    assert_eq(open_fds(), before)

    conditional_move(local, false, before)
    conditional_move(local, true, before)

    scope {
      var connections = List<Connection>.new()
      for _ in 0..3 {
        let stream = net.connect(remote).unwrap()
        let listener = net.listen(local).unwrap()
        connections.push(Connection { stream: move stream, listener: move listener })
      }
      assert_eq(open_fds(), before + 6)
    }
    assert_eq(open_fds(), before)

    explicit_close(local, remote, before)
    worker_panic(local, remote, before)
  }
  assert_eq(open_fds(), baseline)
  print("socket cleanup ok")
}
