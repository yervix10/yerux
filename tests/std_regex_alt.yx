import std.regex

fn show(p: view String, t: view String) {
  print("{p} on {t}: {regex.is_match(p, t)} at {regex.find(p, t)}")
}

fn bad(p: view String) {
  let r = regex.check(p)
  match move r {
    Ok(n) => { print("ok {n} groups: {p}") }
    Err(e) => { print("error: {e}") }
  }
}

fn main() {
  show("^(north|south)$", "north")
  show("^(north|south)$", "south")
  show("^(north|south)$", "east")
  show("^(north|south)$", "northeast")
  show("cat|dog", "hotdog")
  show("a|b|c", "xxc")
  show("gr(a|e)y", "grey")
  show("(ab)+c", "ababc")
  show("(ab)+c", "abac")
  show("x(yz)*w", "xyzyzw")
  show("colou?r", "color")
  let c = regex.captures("([0-9]|[a-z]+)-(north|south)", "id-south")
  print("{c.len()} {c.at(0)} {c.at(1)} {c.at(2)}")
  let d = regex.captures("(a)|(b)", "b")
  print("{d.len()} [{d.at(1)}] [{d.at(2)}]")
  print(regex.replace("(red|green)", "red and green and blue", "X"))
  print("{regex.split(" *(,|;) *", "a , b;c").len()}")
  print("{regex.find_all("^a", "aaa").len()}")
  bad("(nor")
  bad("nor)")
  bad("a||b")
  bad("|a")
  bad("a|")
  bad("()")
  bad("[abc")
  bad("[]")
  bad("[z-a]")
  bad("*a")
  bad("a**")
  bad("a+?")
  bad("a\\")
  bad("\\d+")
  show("a\\.b", "a.b")
  show("a\\.b", "axb")
  bad("^*")
  bad("(a(b)c)")
  bad("")
}
