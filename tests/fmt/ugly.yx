print(apply( |x| x+k,2))
let g=||k
print(g())
}

type   Byte  =  Int< 0..255 >
fn   clampb(n:Int)->Byte{
if n<0{return 0}
let x: Int<0..9> =n
return   n}
fn   asb(n:Int)->Int{
let b=n   as Int<0..255>   else{return -1}
let c = n as Int<..9>
return b+c}
