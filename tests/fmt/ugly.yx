fn apply(f:view fn(Int)->Int,x:Int)->Int{return f(x)}
fn pick(flag:Bool)->fn(Int,Int)->Int{
if flag{return |a,b|a+b}
return move|a:Int,b:Int|->Int{return a*b}}
fn closures(){
