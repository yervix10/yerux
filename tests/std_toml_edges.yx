// std.toml edge cases: integers with _ and 0x/0o/0b, literal strings, \u escapes, quoted keys, overflow default
import std.toml
fn main() {
  print(toml.get_string("", "a").len())
  print(toml.get_int("", "a"))
  print(toml.get_int("a = 9223372036854775808", "a"))
  print(toml.get_int("a = -5", "a"))
  print(toml.get_int("a = 1_000", "a"))
  print(toml.get_int("a = 0x10", "a"))
  print(toml.get_int("a = \"7\"", "a"))
  print(toml.get_bool("a = true", "a"))
  print(toml.get_bool("a = True", "a"))
  print(toml.get_bool("a = true # c", "a"))
  print(toml.get_string("a = \"x # y\" # c", "a"))
  print(toml.get_string("a = 'lit'", "a"))
  print(toml.get_string("a = \"unterminated", "a"))
  print(toml.get_string("a = \"é😀\"", "a"))
  print(toml.get_string("a = \"\\u00e9\"", "a"))
  print(toml.get_string("[t]\nb = \"in\"\n[u]\nb = \"other\"", "t.b"))
  print(toml.get_string("[t]\nb = \"in\"\n[u]\nb = \"other\"", "u.b"))
  print(toml.get_string("a = \"1\"\na = \"2\"", "a"))
  print(toml.get_string("a.b = \"dotted\"", "a.b"))
  print(toml.get_string("\"quoted key\" = \"v\"", "quoted key"))
  print(toml.get_array("a = []", "a").len())
  print(toml.get_array("a = [1, 2,", "a").len())
  print(toml.get_array("a = [\"x,y\", \"z\"]", "a").len())
  print(toml.get_array("a = [[1,2],[3]]", "a").len())
  print(toml.get_string("a = \"\"\"multi\nline\"\"\"", "a"))
  print(toml.get_string("[bad\na = \"x\"", "a"))
  print(toml.get_string("a=\"x\"\r\nb=\"y\"\r\n", "b"))
  var big = String.new()
  for i in 0..20000 { big.push_str("k{i} = {i}\n") }
  print(toml.get_int(big, "k19999"))
}
