// `yerux test`: every `test` block is built and run on its own
fn clamp(x: Int, lo: Int, hi: Int) -> Int {
  if x < lo { return lo }
  if x > hi { return hi }
  return x
}

fn main() {
  print("main is not run by `yerux test`")
}

test "clamp inside the range" {
  assert_eq(clamp(5, 0, 10), 5)
}

test "clamp below and above" {
  assert_eq(clamp(0 - 3, 0, 10), 0)
  assert_eq(clamp(99, 0, 10), 10)
  assert(clamp(99, 0, 10) != 99)
}

test "booleans and strings" {
  assert_eq(1 < 2, true)
  let s = String.from("abc")
  assert(s.eq("abc"))
  assert_eq(s.len(), 3)
}

test "defer runs inside a test" {
  var n = 0
  defer assert_eq(n, 1)
  n = n + 1
}
