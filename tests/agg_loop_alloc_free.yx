// Many short-lived Lists: blocks must be recycled through the free lists
fn make(n: Int) -> List {
  var l = List.new()
  var k = 0
  while k < n {
    l.push(k)
    k = k + 1
  }
  return l
}

fn main() {
  var i = 0
  var total = 0
  while i < 50000 {
    let l = make(i % 40)
    total = total + l.len()
    if l.len() > 0 {
      total = total + l.get(l.len() - 1)
    }
    i = i + 1
  }
  print(total)
}
