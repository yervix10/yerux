// What range types let the optimizer prove: checked arithmetic and bounds checks that disappear.
type Byte = Int<0..255>

fn mix(a: Byte, b: Byte, t: Byte) -> Int<0..130050> {
  return a * (255 - t) + b * t
}

fn invert(i: Byte) -> Byte {
  return 255 - i
}

fn twice(x: Byte) -> Int<0..510> {
  return invert(x) + x
}

fn lut_get(l: view List<Int>, i: Byte) -> Int {
  if l.len() < 256 { return -1 }
  return l.get(i)
}

fn lut_unchecked_len(l: view List<Int>, i: Byte) -> Int {
  return l.get(i)
}

fn narrowed(n: Int) -> Int {
  if n < 0 { return 0 }
  if n > 1000 { return 0 }
  let m: Int<0..1000> = n
  return m * m
}

fn main() {
  var l = List<Int>.new()
  for k in 0..256 { l.push(k * 3) }
  print(mix(255, 0, 0))
  print(mix(10, 20, 128))
  print(twice(5))
  print(lut_get(l, 255))
  print(lut_unchecked_len(l, 7))
  print(narrowed(31))
  print(narrowed(-4))
  print(narrowed(2000))
}
