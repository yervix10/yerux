struct Tag<T> { value: T }
impl<T: Copy> Drop for Tag<T> {
  fn drop(mut self) { print("drop") }
}

fn forward<T: Copy>(value: Tag<T>) -> Tag<T> { return value }
fn consume<T: Copy>(value: Tag<T>) { print("consume") }

fn main() {
  let original = Tag<Int> { value: 1 }
  let handed_off = forward(move original)
  consume(move handed_off)

  // The Drop impl does not apply to this instantiation. Its String still needs a move.
  let owned = Tag<String> { value: String.from("owned") }
  let moved = move owned
  print(moved.value)
  print("done")
}
