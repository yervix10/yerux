import std.net

fn main() {
  let addr = net.address("127.0.0.1", 0).unwrap()
  let listener = net.listen(addr).unwrap()
  let bound = net.listener_local_addr(listener).unwrap()
  let stream = net.connect(bound).unwrap()
  let peer = net.accept(listener).unwrap()
  match net.read(stream, 1) {
    Ok(data) => { panic("read returned while the peer was idle") }
    Err(e) => { assert_eq(e.code, 110) }
  }
  assert_eq(net.close_stream(move peer).unwrap(), 0)
  print("stalled socket read timed out")
}
