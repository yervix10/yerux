// std.fmt, std.path, std.time
import std.fmt
import std.path
import std.time

fn p(x: String) {
  print("[{x}]")
}

fn main() {
  p(fmt.format_int(255, 16))
  p(fmt.format_int(-255, 2))
  p(fmt.format_int(0, 7))
  p(fmt.format_int(35, 36))
  p(fmt.format_int_upper(48879, 16))
  p(fmt.format_int(-9223372036854775807 - 1, 10))
  p(fmt.format_int(-9223372036854775807 - 1, 16))
  p(fmt.hex(4096))
  p(fmt.bin(10))
  p(fmt.oct(64))
  p(fmt.format_bits(-1, 16))
  p(fmt.format_bits(-2, 2))
  p(fmt.format_bits(5, 10))
  p(fmt.pad_left("7", 3, '0'))
  p(fmt.pad_left("long", 2, ' '))
  p(fmt.pad_right("ab", 5, '.'))
  p(fmt.pad_left("é€", 4, '*'))
  p(fmt.center("mid", 8, '-'))
  p(fmt.center("mid", 2, '-'))
  p(fmt.zero_pad(5, 4))
  p(fmt.zero_pad(-5, 4))
  p(fmt.zero_pad(12345, 2))
  p(fmt.hex_padded(255, 4))
  p(fmt.group(1234567, ","))
  p(fmt.group(-1000, "_"))
  p(fmt.group(999, ","))
  p(fmt.group(0, ","))
  p(fmt.fixed(3.14159, 2))
  p(fmt.fixed(2.0, 3))
  p(fmt.fixed(-0.5, 0))
  p(fmt.fixed(0.5, 0))
  p(fmt.fixed(-0.001, 2))
  p(fmt.fixed(1234.5678, 1))
  p(fmt.fixed(0.05, 1))
  p(fmt.fixed(99.99, 1))
  p(fmt.fixed(1.0 / 0.0, 2))
  p(fmt.percent(0.256, 1))
  p(fmt.bytes_human(12))
  p(fmt.bytes_human(1536))
  p(fmt.bytes_human(5 * 1024 * 1024))

  p(path.join("a", "b.txt"))
  p(path.join("a/", "b"))
  p(path.join("a", "/abs"))
  p(path.join("", "b"))
  p(path.join("a", ""))
  p(path.parent("a/b/c.txt"))
  p(path.parent("c.txt"))
  p(path.parent("/c"))
  p(path.parent("/"))
  p(path.parent("a/b/"))
  p(path.parent("a//b"))
  p(path.file_name("a/b/c.txt"))
  p(path.file_name("a/b/"))
  p(path.file_name("/"))
  p(path.file_name(""))
  p(path.stem("a/b.tar.gz"))
  p(path.stem(".bashrc"))
  p(path.extension("a/b.tar.gz"))
  p(path.extension(".bashrc"))
  p(path.extension("noext"))
  p(path.extension("dir.d/file"))
  p(path.with_extension("a/b.txt", "md"))
  p(path.with_extension("a/b", "md"))
  p(path.with_extension("a/b.txt", ""))
  print(path.is_absolute("/x"))
  print(path.is_absolute("x/y"))
  let comps = path.components("/usr//local/bin/")
  p(comps.join("|"))
  p(path.normalize("a/./b/../c//d"))
  p(path.normalize("/../a/b/.."))
  p(path.normalize("../../x"))
  p(path.normalize("a/.."))
  p(path.normalize("/"))

  print(time.millis(5))
  print(time.seconds(2) + time.micros(3))
  print(time.as_millis(time.seconds(3)))
  print(time.as_secs(time.minutes(2)))
  print(time.as_secs_float(time.millis(1500)))
  print(time.hours(1))
  p(time.format(850))
  p(time.format(12500))
  p(time.format(3200000))
  p(time.format(time.millis(1500)))
  p(time.format(time.seconds(125)))
  p(time.format(time.seconds(3723)))
  p(time.format(-time.millis(40)))
  var w = time.stopwatch()
  time.sleep(time.millis(5))
  print(w.elapsed() >= time.millis(5))
  print(w.elapsed_ms() >= 5)
  let l1 = w.lap()
  let l2 = w.lap()
  print(l1 >= time.millis(5))
  print(l2 >= 0)
  w.restart()
  print(w.elapsed() < time.seconds(5))
  let took = time.measure(|| { time.sleep(time.millis(2)) })
  print(took >= time.millis(2))
}
