// std.math: the constants e and tau, their relation to pi and their printed precision
import std.math
import std.fmt

fn main() {
  print(math.e())
  print(math.tau())
  print(math.tau() == 2.0 * math.pi())
  print(math.tau() / 2.0 == math.pi())
  print(math.e() > 2.718)
  print(math.e() < 2.719)
  print(math.tau() > 6.283)
  print(math.tau() < 6.284)
  print(fmt.fixed(math.e(), 9))
  print(fmt.fixed(math.tau(), 9))
  print(math.e() - math.e() == 0.0)
  print(math.tau() * 0.0 == 0.0)
}
