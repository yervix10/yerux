// deep recursion with many live values across calls (callee-saved save/restore), many parameters
fn depth(n: Int, a: Int, b: Int, c: Int) -> Int {
  if n == 0 { return a + b + c }
  let x = a * 3 + n
  let y = b + x % 7
  let z = c - y % 5
  let r = depth(n - 1, y % 1000, z % 1000, x % 1000)
  return (r + x + y + z + n) % 1000003
}
fn eight(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int {
  let s1 = a * 1 + b * 2 + c * 3 + d * 4
  let s2 = e * 5 + f * 6 + g * 7 + h * 8
  let m = depth(3, s1 % 100, s2 % 100, a)
  return s1 - s2 + m + a + b + c + d + e + f + g + h
}
fn ack(m: Int, n: Int) -> Int {
  if m == 0 { return n + 1 }
  if n == 0 { return ack(m - 1, 1) }
  return ack(m - 1, ack(m, n - 1))
}
fn fib(n: Int) -> Int {
  if n < 2 { return n }
  let a = fib(n - 1)
  let b = fib(n - 2)
  return a + b
}
fn main() {
  print(depth(1000, 1, 2, 3))
  print(depth(10000, 5, 6, 7))
  print(eight(1, 2, 3, 4, 5, 6, 7, 8))
  print(eight(-1, 20, -30, 40, -50, 60, -70, 80))
  print(ack(2, 3))
  print(ack(3, 5))
  print(fib(27))
  var k = 0
  var sum = 0
  while k < 20 {
    sum = sum + eight(k, k + 1, k + 2, k + 3, k + 4, k + 5, k + 6, k + 7) % 1000
    k = k + 1
  }
  print(sum)
}
