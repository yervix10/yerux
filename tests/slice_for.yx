// `for x in v[from..to]` walks part of an array, a List or a slice in place (bounds checked first).
fn total(xs: view [Int]) -> Int {
  var t = 0
  for x in xs[1..] { t = t + x }
  return t
}

fn main() {
  var a = [1, 2, 3, 4, 5, 6]
  for x in a[1..4] { print(x) }
  for mut x in a[4..] { x = x * 10 }
  print(a[4] + a[5])
  var l = List<Int>.new()
  for i in 0..5 { l.push(i) }
  var t = 0
  for x in l[..3] { t = t + x }
  print(t)
  print(total(a))
  var n = 0
  for x in a[2..2] { n = n + 1 }
  print(n)
  var hi = 7
  for x in a[5..hi] { print(x) }
}
