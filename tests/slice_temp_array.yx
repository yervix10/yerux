// A slice of a temporary array or List (`[4, 5, 6][1..3]`, `make()[0..2]`) is lent to a `view [T]` parameter;
// the temporary lives in a hidden variable for the call. `mut` still needs a variable.
fn total(xs: view [Int]) -> Int {
  var t = 0
  var i = 0
  while i < xs.len() { t = t + xs[i]; i = i + 1 }
  return t
}
fn make() -> List<Int> {
  var l = List<Int>.new()
  l.push(7)
  l.push(8)
  l.push(9)
  return l
}
fn bump(xs: mut [Int]) { xs[0] = xs[0] + 100 }
fn main() {
  print(total([4, 5, 6][1..3]))
  print(total(make()[0..2]))
  print(total([1, 2, 3, 4][2..]))
  print(total([1, 2, 3][..2]))
  print(total([1, 2, 3][0..0]))
}
