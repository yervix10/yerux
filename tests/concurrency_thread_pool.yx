fn main() {
  let total = Shared.new(Atomic<Int>.new(0))
  var pool = thread_pool_new(4)
  pool.parallel_for(0, 1000, |i| total.get().add(i))
  print(total.get().load())
  total.get().store(0)
  pool.parallel_for(0, 1000, |i| total.get().add(i))
  print(total.get().load())
  let squares = thread_pool_map(pool, 10, 15, |i| i * i)
  print(squares.len())
  print(squares.get(0) + squares.get(4))
  pool.close()
}
