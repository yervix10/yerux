// Range values in structs, enums, lists, tuples, closures, generics, traits and conversions.
type Byte = Int<0..255>

struct Px { r: Byte, g: Byte }

enum Opt { Some(Byte), Nothing }

trait Name { fn name(view self) -> Int }

impl Name for Int { fn name(view self) -> Int { return self + 1 } }

fn id<T: Copy>(x: T) -> T { return x }

fn main() {
  let b: Byte = 5
  print("value {b}")
  print(b.to_float())
  let p = Px { r: 10, g: b }
  print(p.r + p.g)
  var q = p
  q.r = 200
  print(q.r)
  let o = Opt.Some(b)
  match o { Opt.Some(v) => { print(v + 1) }
  Opt.Nothing => { print(0) } }
  print(id(b))
  let c = (b, 7)
  print(c.0)
  var l = List<Byte>.new()
  l.push(b)
  l.set(0, 9)
  for x in l { print(x * 2) }
  let f = |v: Byte| v + 1
  print(f(250))
  print(b.name())
  assert_eq(b, 5)
  let w = b.to_int8()
  print(w)
  var r = 0
  for k in 0..b { r = r + k }
  print(r)
}
