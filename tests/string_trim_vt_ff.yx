// trim / trim_start / trim_end treat \v (11) and \f (12) as ASCII whitespace, like space, \t, \n, \r.
fn main() {
  var s = String.new()
  s.push_byte(11)
  s.push_byte(12)
  s.push_byte(32)
  s.push_str("a b")
  s.push_byte(9)
  s.push_byte(12)
  s.push_byte(11)
  s.push_byte(13)
  s.push_byte(10)
  let t = s.trim()
  print("[{t}]")
  print(t.len())
  print(s.trim_start().len())
  print(s.trim_end().len())
  var o = String.new()
  o.push_byte(11)
  o.push_byte(12)
  print(o.trim().len())
  var k = String.new()
  k.push_byte(14)
  k.push_str("x")
  print(k.trim().len())
}
