// moving the scrutinee away while a payload name of `match` is alive
enum Msg { Text(String), Nums(List<Int>), Quit }
fn mgrow(m: mut Msg, k: Int) {
  match mut m {
    Text(s) => { s.push_str("!") }
    Nums(l) => { l.push(k) }
    Quit => { }
  }
}
fn takes(m: Msg) { }
fn main() {
  var m = Msg.Text(String.from("abc"))
  match m {
    Text(s) => {
      takes(move m)
      print(s.len())
    }
    _ => { }
  }
}
