// std.regex: bounded repetition {n} {n,} {n,m}, and `]` first in a class (frictions 61 and 62)
import std.regex

fn show(r: view Result<Int, String>) {
  match r {
    Ok(n) => { print("ok {n}") }
    Err(e) => { print("err {e}") }
  }
}

fn main() {
  print(regex.find(r"a{2}", "aa"))
  print(regex.find(r"a{2}", "a"))
  print(regex.find(r"a\{2}", "a{{2}}"))
  print(regex.find(r"^a{2}$", "aaa"))
  print(regex.find(r"^a{2,}$", "aaaa"))
  print(regex.find(r"^a{1,3}b$", "aaab"))
  print(regex.find(r"^a{1,3}b$", "aaaab"))
  print(regex.find(r"^(ab){2}$", "abab"))
  print(regex.find(r"^[0-9]{3}-[0-9]{2,4}$", "123-4567"))
  print(regex.find(r"^a{0}b$", "b"))
  print(regex.find(r"x{", "x{{"))
  print(regex.find("[]]", "a]"))
  print(regex.find("[^]]", "]a"))
  show(regex.check("[]"))
  show(regex.check("[]]"))
  show(regex.check(r"{2}"))
  show(regex.check(r"a{3,2}"))
  show(regex.check(r"a{2}{3}"))
  show(regex.check(r"a{500}"))
  show(regex.check(r"^{2}"))
}
