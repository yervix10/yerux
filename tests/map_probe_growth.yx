// A constant hash starts in the last bucket and forces a wrapped probe before growth.
struct Key { id: Int }

impl Hash for Key {
  fn hash(view self) -> Int { return 7 }
}
impl Equal for Key {
  fn eq(view self, other: view Key) -> Bool { return self.id == other.id }
}

fn main() {
  var m = Map<Key, String>.new()
  for i in 0..4 {
    m.insert(Key { id: i }, "value {i}")
  }
  m.insert(Key { id: 1 }, String.from("replacement"))
  print(m.len())
  print(m.find_hashed(7, Key { id: 9 }))
  for i in 4..14 {
    m.insert(Key { id: i }, "value {i}")
  }
  print(m.len())
  let replaced = m.take(Key { id: 1 })
  print(replaced)
  print(m.contains(Key { id: 1 }))
  for i in 2..14 {
    print(m.vals.at(m.find(Key { id: i })))
  }
}
