import std.kv
import std.fs

fn main() {
    let path = String.from("/tmp/yerux_std_kv_test.db")
    match fs.remove_file(path) { Ok(_) => {} Err(_) => {} }
    let store = kv.Store { path: String.from(path) }
    match kv.set(store, "name", "Yerux") { Ok(_) => {} Err(_) => { print("write error") } }
    match kv.set_int(store, "answer", 42) { Ok(_) => {} Err(_) => { print("write error") } }
    match kv.set_bool(store, "enabled", true) { Ok(_) => {} Err(_) => { print("write error") } }
    match kv.get(store, "name") {
        Ok(value) => {
            match value { Some(name) => { print(name) } None => { print("missing") } }
        }
        Err(_) => { print("missing") }
    }
    match kv.get_int(store, "answer") {
        Ok(value) => {
            match value { Some(number) => { print(number) } None => { print("missing") } }
        }
        Err(_) => { print("missing") }
    }
    match kv.get_bool(store, "enabled") {
        Ok(value) => {
            match value { Some(flag) => { print(flag) } None => { print("missing") } }
        }
        Err(_) => { print("missing") }
    }
    match kv.get(store, "absent") {
        Ok(value) => { match value { None => { print("absent") } Some(_) => { print("unexpected") } } }
        Err(_) => { print("unexpected") }
    }
    // delete and keys
    match kv.delete(store, "name") { Ok(removed) => { print(removed) } Err(_) => { print("delete error") } }
    match kv.delete(store, "name") { Ok(removed) => { print(removed) } Err(_) => { print("delete error") } }
    match kv.get(store, "name") {
        Ok(value) => { match value { None => { print("deleted") } Some(_) => { print("still there") } } }
        Err(_) => { print("unexpected") }
    }
    match kv.set(store, "name", "again") { Ok(_) => {} Err(_) => { print("write error") } }
    match kv.keys(store) {
        Ok(names) => { print(names.len()) for k in names { print(k) } }
        Err(_) => { print("keys error") }
    }
    match fs.remove_file(path) { Ok(_) => {} Err(_) => {} }
}
