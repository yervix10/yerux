// A nested tuple pattern inside `Some` over an owned payload borrows the parts (friction 44).
fn pair(a: view String, b: view String) -> Option<(String, String)> {
  if a.len() == 0 { return None }
  return Some((String.from(a), String.from(b)))
}

enum Shape {
  Named((String, Int)),
  Anon,
}

fn main() {
  let p: Option<(String, String)> = Some((String.from("left"), String.from("right")))
  match p {
    Some((x, y)) => { print("{x}-{y}") }
    None => { print("none") }
  }
  match p {
    Some((x, _)) => { print(x) }
    None => { print("none") }
  }
  let q: Option<(String, Int)> = Some((String.from("n"), 7))
  match q {
    Some((s, n)) => { print("{s}={n}") }
    None => { print("none") }
  }
  let r = pair("a", "b")
  match r {
    Some((u, v)) => { print(u + "+" + v) }
    None => { print("none") }
  }
  let e = pair("", "b")
  match e {
    Some((u, v)) => { print(u) }
    None => { print("none") }
  }
  temporaries()
  let sh = Shape.Named((String.from("sq"), 4))
  match sh {
    Shape.Named((name, side)) => { print("{name} {side}") }
    Shape.Anon => { print("anon") }
  }
}

fn split(s: view String) -> Option<(String, String)> {
  if s.len() < 2 { return None }
  return Some((String.from(s), String.from("tail")))
}

fn temporaries() {
  match split("ab") {
    Some((x, y)) => { print("{x} {y}") }
    None => { print("none") }
  }
  match split("a") {
    Some((x, _)) => { print(x) }
    None => { print("none") }
  }
}
