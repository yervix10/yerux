// `f(x) == "text"`: a String call result on the left of `==`/`!=` is stored in a hidden variable, so the
// comparison borrows a place (friction 267).
fn name() -> String {
  return String.from("bob")
}

fn id(n: Int) -> String {
  return String.from("id-{n}")
}

fn padded() -> String {
  var s = String.from("  bob  ")
  return s.trim()
}

fn main() {
  assert(name() == "bob")
  assert(name() != "alice")
  print(name() == "bob")
  print(name() == "alice")
  if id(7) == "id-7" { print("match") }
  if padded() == "bob" { print("trimmed") }
  var total = 0
  if name() == "bob" { total = total + 1 }
  if name() == "bob" { total = total + 1 }
  print(total)
  let other = String.from("bob")
  print(name() == other)
  print(name().eq(other) == false)
}
