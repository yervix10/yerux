// std.unicode: is_combining at both ends of every documented range, just outside each of them,
// and on plain ASCII/UTF-8 characters
import std.unicode

fn at(c: Char) {
  print("{c.to_int()}: {unicode.is_combining(c)}")
}

fn main() {
  print(unicode.is_combining('a'))
  print(unicode.is_combining('é'))
  print(unicode.is_combining('😀'))

  // U+0300..U+033F (768..879), the first documented block
  at(Char.from_int(768))
  at(Char.from_int(879))
  at(Char.from_int(767))
  at(Char.from_int(880))

  // U+1AB0..U+1AFF (6832..6911)
  at(Char.from_int(6832))
  at(Char.from_int(6911))
  at(Char.from_int(6831))
  at(Char.from_int(6912))

  // U+1DC0..U+1DFF (7616..7679)
  at(Char.from_int(7616))
  at(Char.from_int(7679))
  at(Char.from_int(7615))
  at(Char.from_int(7680))

  // U+20D0..U+20FF (8400..8447)
  at(Char.from_int(8400))
  at(Char.from_int(8447))
  at(Char.from_int(8399))
  at(Char.from_int(8448))

  // U+FE20..U+FE2F (65056..65071)
  at(Char.from_int(65056))
  at(Char.from_int(65071))
  at(Char.from_int(65055))
  at(Char.from_int(65072))

  // scalar-value extremes
  at(Char.from_int(0))
  at(Char.from_int(1114111))
}
