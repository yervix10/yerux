// Raw runtime coverage. Both heap words are aligned and stay live until both workers join.
fn work(counter: Int, ready: Int, label: view String) -> Int { unsafe {
  if __atomic_fetch_add(ready, 1) == 1 {
    __futex_wake(ready, 1)
  } else {
    while __atomic_load(ready) != 2 {
      __futex_park(ready, 1)
    }
  }
  var sum = 0
  for i in 0..1000 {
    var scratch = List<Int>.new()
    scratch.push(i)
    sum = sum + scratch.get(0)
    __atomic_fetch_add(counter, 1)
  }
  return sum + label.len()
} }

fn main() { unsafe {
  let counter = __alloc(8)
  __atomic_store(counter, 0)
  let ready = __alloc(8)
  __atomic_store(ready, 0)
  assert(__futex_park(ready, 1) == -11)
  assert(__futex_wake(ready, 1) == 0)
  let first = String.from("first")
  let second = String.from("second")
  let a = __thread_start(move || work(counter, ready, first))
  let b = __thread_start(move || work(counter, ready, second))
  print(__thread_wait(a))
  print(__thread_wait(b))
  print(__atomic_load(counter))
  print(__atomic_cmpxchg(counter, 0, 3))
  print(__atomic_cmpxchg(counter, 2000, 7))
  print(__atomic_fetch_add(counter, 2))
  print(__atomic_load(counter))
  __free(ready)
  __free(counter)
} }
