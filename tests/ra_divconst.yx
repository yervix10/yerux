// division / modulo by constants (magic-number multiplication) against the checked idiv semantics
fn run(x: Int) {
  print(x / 2)
  print(x % 2)
  print(x / 3)
  print(x % 3)
  print(x / 5)
  print(x % 5)
  print(x / 6)
  print(x % 6)
  print(x / 7)
  print(x % 7)
  print(x / 9)
  print(x % 9)
  print(x / 10)
  print(x % 10)
  print(x / 11)
  print(x % 11)
  print(x / 12)
  print(x % 12)
  print(x / 16)
  print(x % 16)
  print(x / 25)
  print(x % 25)
  print(x / 60)
  print(x % 60)
  print(x / 100)
  print(x % 100)
  print(x / 127)
  print(x % 127)
  print(x / 128)
  print(x % 128)
  print(x / 255)
  print(x % 255)
  print(x / 641)
  print(x % 641)
  print(x / 1000)
  print(x % 1000)
  print(x / 1000003)
  print(x % 1000003)
  print(x / 65536)
  print(x % 65536)
  print(x / 2147483647)
  print(x % 2147483647)
  print(x / (-2))
  print(x % (-2))
  print(x / (-3))
  print(x % (-3))
  print(x / (-5))
  print(x % (-5))
  print(x / (-7))
  print(x % (-7))
  print(x / (-10))
  print(x % (-10))
  print(x / (-16))
  print(x % (-16))
  print(x / (-100))
  print(x % (-100))
  print(x / (-1000003))
  print(x % (-1000003))
  print(x / (-2147483647))
  print(x % (-2147483647))
  print(x / (-2147483648))
  print(x % (-2147483648))
  print(x / 1000000007)
  print(x % 1000000007)
}
fn main() {
  run(0)
  run(1)
  run(-1)
  run(2)
  run(-2)
  run(3)
  run(7)
  run(-7)
  run(100)
  run(-100)
  run(999999)
  run(-999999)
  run(1000003)
  run(2147483647)
  run(-2147483648)
  run(2147483648)
  run(4294967296)
  run(123456789012345)
  run(-123456789012345)
  run(9223372036854775807)
  run((-9223372036854775807 - 1))
  run((-9223372036854775807))
  run(9223372036854775806)
  run(4611686018427387904)
  var i = -50
  var acc = 0
  while i < 50 {
    acc = acc + i / 7 + i % 7 + i / (-3) + i % (-3)
    i = i + 1
  }
  print(acc)
}
