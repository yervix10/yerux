// std.math: Int helpers
import std.math

fn main() {
  print(math.abs(-5))
  print(math.sign(-9))
  print(math.sign(0))
  print(math.min(3, 4))
  print(math.max(3, 4))
  print(math.clamp(15, 0, 10))
  print(math.clamp(-3, 0, 10))
  print(math.clamp(4, 0, 10))
  print(math.clamp_float(2.5, 0.0, 1.0))
  print(math.gcd(12, 18))
  print(math.gcd(-12, 18))
  print(math.gcd(0, 0))
  print(math.lcm(4, 6))
  print(math.lcm(0, 6))
  print(math.ipow(2, 62))
  print(math.ipow(3, 0))
  print(math.ipow(-2, 5))
  print(math.isqrt(0))
  print(math.isqrt(99))
  print(math.isqrt(100))
  print(math.isqrt(9223372036854775807))
  print(math.isqrt(3037000499 * 3037000499 - 1))
  print(math.div_floor(-7, 2))
  print(math.mod_floor(-7, 2))
  print(math.div_floor(7, -2))
  print(math.mod_floor(7, -2))
  print(math.is_prime(97))
  print(math.is_prime(91))
  print(math.is_prime(2))
  print(math.is_prime(1))
  print(math.lerp(10.0, 20.0, 0.25))
  print(math.pi())
  print(math.to_degrees(math.pi()))
  print(math.to_radians(180.0))
}
