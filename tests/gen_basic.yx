trait Describe { fn describe(view self) -> String }
struct Point { x: Int, y: Int }
impl Describe for Point {
    fn describe(view self) -> String {
        var s = String.from("P(")
        s.push_int(self.x)
        s.push_str(",")
        s.push_int(self.y)
        s.push_str(")")
        return s
    }
}
impl Ordered for Point {
    fn cmp(view self, other: view Point) -> Int {
        if self.x < other.x { return -1 }
        if self.x > other.x { return 1 }
        return 0
    }
}
struct Pair<A, B> { a: A, b: B }
enum Maybe<T> { Some(T), None }

fn max<T: Ordered + Copy>(a: T, b: T) -> T {
    if a < b { return b }
    return a
}
fn show_it<T: Show>(x: view T) {
    let s = x.show()
    print(s)
}
fn first<A: Copy, B: Copy>(p: Pair<A, B>) -> A { return p.a }
fn find(l: view List, v: Int) -> Maybe<Int> {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return Maybe.Some(i) }
        i = i + 1
    }
    return Maybe.None
}
fn main() {
    print(max(3, 9))
    let p = Point { x: 1, y: 2 }
    let q = Point { x: 5, y: 0 }
    let m = max(p, q)
    show_it(m.x)
    let d = m.describe()
    print(d)
    print(max("abc", "abd"))
    let pr = Pair { a: 7, b: true }
    print(first(pr))
    var l = List.new()
    l.push(4)
    l.push(8)
    match find(l, 8) {
        Some(i) => { print(i) }
        None => { print("none") }
    }
    match find(l, 9) {
        Some(i) => { print(i) }
        None => { print("none") }
    }
}
