fn classify(n: Int) -> Int {
  if n < 0 {
    if n < -100 { return -2 } else { return -1 }
  } else {
    if n == 0 { return 0 }
    if n > 100 {
      if n > 1000 { return 3 }
      return 2
    }
  }
  return 1
}
fn main() {
  print(classify(-500))
  print(classify(-5))
  print(classify(0))
  print(classify(50))
  print(classify(500))
  print(classify(5000))
}
