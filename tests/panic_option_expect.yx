// Option.expect panics with exactly the message given.
fn find(l: view List<Int>, x: Int) -> Option<Int> {
  var i = 0
  while i < l.len() {
    if l.get(i) == x { return Some(i) }
    i = i + 1
  }
  return None
}

fn main() {
  var l = List<Int>.new()
  l.push(10)
  print(find(l, 10).expect("ten is present"))
  print(find(l, 11).expect("eleven is missing"))
}
