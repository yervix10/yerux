struct Guard { id: Int }
impl Drop for Guard { fn drop(mut self) { print(900 + self.id) } }

fn work(n: Int) -> Int {
  defer print(100)
  let g = Guard { id: n }
  defer print(200)
  if n > 1 { return n }
  print(1)
  return 0
}

fn main() {
  print(work(2))
  print(work(0))
  for i in 0..4 {
    defer print(i + 10)
    if i == 1 { continue }
    if i == 3 { break }
    print(i)
  }
}
