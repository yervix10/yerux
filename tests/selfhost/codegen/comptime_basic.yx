// comptime: scalar expressions and pure functions evaluated by the compiler
fn fib(n: Int) -> Int {
  var a = 0
  var b = 1
  var i = 0
  while i < n {
    let t = a + b
    a = b
    b = t
    i = i + 1
  }
  return a
}

fn fact(n: Int) -> Int {
  if n <= 1 { return 1 }
  return n * fact(n - 1)
}

fn is_prime(n: Int) -> Bool {
  if n < 2 { return false }
  var d = 2
  while d * d <= n {
    if n % d == 0 { return false }
    d = d + 1
  }
  return true
}

fn main() {
  let k = comptime fib(40)
  comptime assert(fact(5) == 120)
  let big = comptime (fact(10) + 1) * 2
  let ok = comptime fib(40) > 100
  let p = comptime is_prime(1_000_003)
  print(k)
  print(big)
  if ok { print("big") }
  if p { print("prime") }
  for i in 0..3 {
    print(i + comptime 10)
  }
  assert_eq(comptime fact(3), 6)
}
