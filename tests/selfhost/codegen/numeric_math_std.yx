import std.math
fn main() {
  print(math.pi())
  print(math.abs(-4))
  print(math.sign(-9))
  print(math.min(2, 5))
  print(math.clamp(15, 0, 10))
  print(math.clamp_float(1.5, 0.0, 1.0))
  print(math.gcd(12, 18))
  print(math.lcm(4, 6))
  print(math.ipow(3, 4))
  print(math.isqrt(99))
  print(math.div_floor(-7, 2))
  print(math.mod_floor(-7, 3))
  print(math.is_prime(97))
  print(math.lerp(0.0, 10.0, 0.25))
  print(math.to_degrees(math.pi()))
  print(math.tau())
}
