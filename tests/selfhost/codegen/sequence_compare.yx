fn main() {
  var a = List<Int>.new()
  var b = List<Int>.new()
  a.push(1)
  a.push(2)
  b.push(1)
  b.push(3)
  print(a == b)
  print(a != b)
  print(a < b)
  print(b <= a)
  var s = List<String>.new()
  var t = List<String>.new()
  s.push(String.from("x"))
  t.push(String.from("x"))
  print(s == t)
  t.push(String.from("y"))
  print(s < t)
}
