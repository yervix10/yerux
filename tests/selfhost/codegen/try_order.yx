fn a(x: Int) -> Result<Int, String> {
  print(x)
  if x > 5 { return Err("big") }
  return Ok(x)
}
fn add(x: Int, y: Int) -> Int { return x + y }
fn run(p: Int, q: Int) -> Result<Int, String> {
  let r = add(a(p)?, a(q)?)
  var total = 0
  total = a(q)? + a(p)?
  return Ok(r + total)
}
fn main() {
  print(run(1, 2).is_err())
  print(run(1, 7).is_err())
  print(run(8, 2).is_err())
}
