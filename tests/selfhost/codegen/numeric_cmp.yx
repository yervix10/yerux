fn main() {
  let a: UInt64 = 18446744073709551615
  let b: UInt64 = 1
  print(a.cmp(b))
  print(b.cmp(a))
  print(b.cmp(b))
  let x: Int32 = 5
  print(x.cmp(7))
  let n = 3
  print(n.cmp(2))
  let f = 1.5
  print(f.cmp(2.5))
  print(f.cmp(f))
  let nan = 0.0 / 0.0
  print(nan.cmp(1.0))
  print(nan.cmp(nan))
}
