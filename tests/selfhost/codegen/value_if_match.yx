enum Shape { Circle(Int), Rect(Int, Int), Empty }

fn area(s: Shape) -> Int {
  return match s {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h,
    Empty => 0,
  }
}

fn label(n: Int) -> String {
  let s = if n < 0 { String.from("neg") } else if n == 0 { String.from("zero") } else { String.from("pos") }
  return s
}

fn pick(xs: view List<Int>, d: Int) -> Int {
  return if xs.len() > 0 { xs.get(0) } else { d }
}

fn early(n: Int) -> Int {
  let v = if n > 0 { n * 2 } else { return -1 }
  return v + 1
}

fn guarded(n: Int) -> String {
  return match n {
    0 => String.from("zero"),
    k if k < 0 => String.from("negative"),
    _ => {
      let t = n * 10
      String.from("big {t}")
    },
  }
}

fn opt(o: Option<Int>) -> Int {
  let r = match o { Some(v) => v + 1, None => 0 }
  return r
}

fn main() {
  let a = if 3 > 2 { 10 } else { 20 }
  print(a)
  print(area(Shape.Circle(2)))
  print(area(Shape.Rect(3, 4)))
  print(area(Shape.Empty))
  print(label(-5))
  print(label(0))
  print(label(7))
  var xs = List<Int>.new()
  print(pick(xs, 99))
  xs.push(5)
  print(pick(xs, 99))
  print(early(4))
  print(early(-4))
  print(guarded(0))
  print(guarded(-3))
  print(guarded(4))
  print(opt(Some(4)))
  print(opt(None))
  let nested = if a > 5 { if a > 50 { "huge" } else { "mid" } } else { "small" }
  print(nested)
  let total = (if a > 5 { 1 } else { 2 }) + (match a { 10 => 100, _ => 200 })
  print(total)
}
