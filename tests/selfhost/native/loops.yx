fn collatz(n: Int) -> Int {
  var x = n
  var steps = 0
  while x != 1 {
    if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
    steps = steps + 1
  }
  return steps
}

fn is_prime(n: Int) -> Bool {
  if n < 2 { return false }
  for d in 2..n {
    if d * d > n { return true }
    if n % d == 0 { return false }
  }
  return true
}

fn power(base: Int, exp: Int) -> Int {
  var result = 1
  for i in 0..exp { result = result * base }
  return result
}

fn main() {
  print(collatz(27))
  var count = 0
  for n in 1..=50 {
    if is_prime(n) { count = count + 1 }
  }
  print(count)
  print(power(3, 13))
  var total = 0
  for i in 0..5 {
    for j in 0..5 {
      if j == 3 { continue }
      if i == 3 { break }
      total = total + i * j
    }
  }
  print(total)
  let neg = 0 - 12345
  print(neg)
  print(is_prime(97))
  print(9223372036854775807)
  print(-9223372036854775807 - 1)
  print(7 / 2 * 2 + 7 % 2)
}
