enum Maybe<T> { Some(T), None }

fn show(m: view Maybe<String>) -> Int {
  match m {
    Some(s) => { return s.len() }
    None => { return -1 }
  }
}

fn unwrap_or_empty(m: Maybe<String>) -> String {
  match move m {
    Some(s) => { return s }
    None => { return String.new() }
  }
}

struct Holder { name: String, extra: Maybe<List<String>> }

enum Tree {
  Leaf,
  Node(Box<Tree>, Int, Box<Tree>),
}

fn insert(t: Tree, v: Int) -> Tree {
  match move t {
    Leaf => { return Tree.Node(Box.new(Tree.Leaf), v, Box.new(Tree.Leaf)) }
    Node(l, x, r) => {
      if v < x {
        return Tree.Node(Box.new(insert(l.take(), v)), x, move r)
      }
      return Tree.Node(move l, x, Box.new(insert(r.take(), v)))
    }
  }
}

fn sum(t: view Tree) -> Int {
  match t {
    Leaf => { return 0 }
    Node(l, x, r) => { return sum(l.get()) + x + sum(r.get()) }
  }
}

fn depth(t: view Tree) -> Int {
  match t {
    Leaf => { return 0 }
    Node(l, _, r) => {
      let a = depth(*l)
      let b = depth(*r)
      if a > b { return a + 1 }
      return b + 1
    }
  }
}

fn main() {
  var a = Maybe.Some(String.from("hello"))
  print(show(a))
  let n = Maybe<String>.None
  print(show(n))
  let s = unwrap_or_empty(move a)
  print(s)
  var xs = List<Maybe<String>>.new()
  xs.push(Maybe.Some(String.from("x")))
  xs.push(Maybe.None)
  xs.push(Maybe.Some(String.from("yz")))
  var total = 0
  for i in 0..xs.len() {
    total = total + show(xs.at(i))
  }
  print(total)
  var h = Holder { name: String.from("h"), extra: Maybe.Some(List<String>.new()) }
  match mut h.extra {
    Some(l) => { l.push(String.from("a")) }
    None => { }
  }
  match h.extra {
    Some(l) => { print(l.len()) }
    None => { print(-5) }
  }
  var t = Tree.Leaf
  var vs = List.new()
  for k in 0..9 { vs.push((k * 4 + 5) % 9 + 1) }
  for v in vs {
    t = insert(move t, v)
  }
  print(sum(t))
  print(depth(t))
}
