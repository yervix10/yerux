//! Geometry helpers for the doc test.

/// A point in the plane.
///
/// ```yerux
/// let p = Point { x: 1, y: 2 }
/// ```
pub struct Point {
  x: Int,
  y: Int,
}

impl Point {
  /// Sum of both coordinates.
  fn total(view self) -> Int {
    return self.x + self.y
  }
}

/// Adds two numbers: a < b & c.
pub fn add(a: Int, b: Int) -> Int {
  return a + b
}

fn internal_helper() -> Int {
  return 0
}

/// Primary colors.
pub enum Color {
  Red,
  Green,
}

fn main() {
  print(add(1, 2))
}
