// Empty-string edge cases: construction, search, slicing, parsing and append on length zero.
fn main() {
  var a = String.new()
  let b = String.from("")
  print("{a.len()} {b.len()} {a.is_empty()} {b.is_empty()}")
  print("{a.char_count()} {b.char_count()}")
  let eq0 = a.eq("")
  let eq1 = a.eq("x")
  let eq2 = b.eq("")
  print("{eq0} {eq1} {eq2}")
  let c = String.from("xy")
  let ab = String.concat(a, b)
  let d = String.concat(a, c)
  let e = String.concat(c, b)
  let f = String.concat(c, c)
  print("[{ab}] [{d}] [{e}] {f}")
  let f0 = a.find("")
  let f1 = a.find("x")
  let c0 = a.contains("")
  let c1 = a.contains("x")
  print("{f0} {f1} {c0} {c1}")
  let sw0 = a.starts_with("")
  let ew0 = a.ends_with("")
  let sw1 = a.starts_with("x")
  let ew1 = a.ends_with("x")
  print("{sw0} {ew0} {sw1} {ew1}")
  let bf0 = b.find("")
  let bf1 = b.find_from("", 0)
  let bf2 = b.find_from("", 1)
  print("{bf0} {bf1} {bf2}")
  let z = a.slice(0, 0)
  let t0 = a.trim()
  let t1 = a.trim_start()
  let t2 = a.trim_end()
  print("[{z}] [{t0}] [{t1}] [{t2}]")
  let up = a.to_upper()
  let lo = a.to_lower()
  print("{up.len()} {lo.len()}")
  let r0 = a.repeat(0)
  let r1 = a.repeat(3)
  let r2 = c.repeat(0)
  print("{r0.len()} {r1.len()} {r2.len()}")
  var n = 77
  let ok = a.parse_int(n)
  print("{ok} {n}")
  a.push_str("")
  a.push_str(b)
  a.push_slice(b, 0, 0)
  print("{a.len()} {a.is_empty()}")
  a.push_str("z")
  a.push_slice(c, 1, 1)
  print("[{a}] {a.len()}")
  a.clear()
  print("{a.len()} {a.is_empty()} [{a}]")
  let lines = a.lines()
  print(lines.len())
  let csv = String.from(",,")
  let parts = csv.split(",")
  let joined = parts.join("")
  print("{parts.len()} [{joined}]")
  let rep1 = a.replace("", "x")
  let rep2 = a.replace("x", "")
  print("[{rep1}] [{rep2}]")
  let same = a == b
  print(same)
}
